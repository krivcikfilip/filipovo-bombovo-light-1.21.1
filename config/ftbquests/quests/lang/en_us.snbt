	file.0000000000000001.title: "Filipovo Bombovo 2"
	quest.000E386D7BC7F029.quest_desc: [
		"V packu jsou tři velké nábytkové mody:"
		"&bHandcrafted&r – útulný nábytek, polštáře a trofeje. &bAnother Furniture&r – židle, závěsy, lampy a truhlíky. &bRefurbished Furniture&r – kuchyně a elektronika, která opravdu funguje."
		"Na židle, lavice a pohovky si sedneš pravým tlačítkem. Začni jednoduchými židlemi, nakonec postavíš kuchyni s elektřinou a počítač."
	]
	quest.000E386D7BC7F029.title: "Zařiď si dům"
	quest.0011C08473D8DB95.quest_desc: [
		"Velká pole se ručně dělají pomalu. Pluh (&ePlow&r) a secí stroj (&eSeeder&r) jsou vozíky, které táhneš za sebou."
		"Polož vozík a klikni na něj – zapřáhneš ho za sebe. Na ochočeného koně nebo osla ho zapřáhneš kliknutím na zvíře. Shift + pravé tlačítko vozík odepne."
		"Pluh při jízdě orá (Shift + pravé tlačítko ho zapne a vypne). Do secího stroje dej semínka (Shift + pravé tlačítko) a při jízdě sám zasévá."
	]
	quest.0011C08473D8DB95.title: "Pluh a secí stroj"
	quest.001F249EA19734C4.quest_desc: [
		"Mušle (&eSeashell&r) leží v písku na plážích."
		"Když mušli použiješ, otevře se. Většinou je v ní syrové maso slávky, ale někdy i zlato, smaragd nebo diamant."
	]
	quest.001F249EA19734C4.title: "Mušle"
	quest.004F4917EDAB53F4.quest_desc: [
		"Vyrob všech 25 vín a moštů z &bVinery&r."
		"Odměnou je prapor (&eCompletionist Banner: Vinery&r). Postavený dává hráčům v okolí regeneraci II."
		"&cPozor:&r Po vypití vína &eA Bottle of 'Creepers Crush'&r za pár sekund vybuchneš!"
	]
	quest.004F4917EDAB53F4.quest_subtitle: "Expert"
	quest.004F4917EDAB53F4.title: "Vinařský mistr"
	quest.00AB5A5A7384DF35.quest_desc: [
		"&bMacaw's Bridges&r: lanové, kamenné a kmenové mosty, schody a pilíře."
		"Lanový most (&eRope Oak Bridge&r) vyrobíš z vláken a dubových půlbloků."
		"Kleště (&ePliers&r) udělají v zábradlí vchod. Funguje to jen u mostu širokého aspoň 2 bloky."
	]
	quest.00AB5A5A7384DF35.title: "Mosty"
	quest.00B57FB3254DE29B.quest_desc: [
		"Uranová tyč (&eUranium Rod&r) svítí a slouží jako jaderné palivo."
		"Vyrobíš ji z 6 uranu, 2 železných ingotů a ohnivé tyče."
	]
	quest.00B57FB3254DE29B.title: "Uranová tyč"
	quest.00D565CED22D6E58.quest_desc: [
		"&bFarmer's Delight&r je základ skoro všech jídelních modů v packu. Přidává nové plodiny, nůž, prkénko, hrnec a stovky jídel."
		"V téhle kapitole se naučíš sbírat plodiny, krájet, vařit v hrnci a nakonec připravit hostiny pro celý tým."
		"&aTip:&r Recept na každé jídlo najdeš v JEI. Najeď myší na předmět a zmáčkni R (recept) nebo U (k čemu se hodí)."
		"&aTip:&r Hodně receptů v packu mění doplňky (hlavně &bCreate Food&r a &bExtraDelight&r). Když se recept liší od popisu, věř JEI."
	]
	quest.00D565CED22D6E58.quest_subtitle: "Začátečník"
	quest.00D565CED22D6E58.title: "Farmer's Delight"
	quest.00EB9BE4780EAA4D.quest_desc: [
		"&bCreate: Hypertubes&r přidává trubky, které tě vysají a rychle přenesou jinam."
		""
		"Trubky (&eHypertube Block&r) vyrobíš z mosazných plátů a skleněných tabulí, 16 kusů najednou. Vstup (&eHypertube Entrance Block&r) složíš z trychtýře (&eHypertube Funnel&r), ozubeného kolečka a chytré šachty."
		""
		"Trychtýř je z mosazného plátu, trubky a sušené chaluhy."
		""
		"Stavba: polož trubku, klikni na ni pravým tlačítkem s další trubkou v ruce a druhou trubku polož jinde. Mezi nimi vznikne oblouk z trubek z tvého inventáře."
		""
		"Do vstupu vlezeš, když se u něj skrčíš (Shift). Vstup se musí točit aspoň 16 RPM (otáček za minutu). Čím rychleji se točí, tím rychleji cestuješ. Z trubky vyskočíš levým Shiftem."
		""
		"&aVíc najdeš v kapitole Pohyb a výbava.&r"
	]
	quest.00EB9BE4780EAA4D.quest_subtitle: "Rychlá doprava po základně"
	quest.00EB9BE4780EAA4D.title: "Hypertrubky"
	quest.01065B3FDB875A0D.quest_desc: [
		"Na ostrovech Endu žije &eEnderiophage&r, podivný stroj, který loví endermany. Padá z něj &eCapsid&r."
		"Z capsidu, 2 železných nugetů a 2 bloků &eEnderitu&r vyrobíš 3 rakety (&eEnderiophage Rocket&r). Fungují jako rachejtle pro let s Krovkami."
	]
	quest.01065B3FDB875A0D.title: "Raketa z Endu"
	quest.01348E95F8E0B8F7.quest_desc: [
		"&bCreate Goggles&r spojí tlakovou láhev s náprsníkem. V pracovním stole dej vedle sebe náprsník a měděnou láhev."
		"Máš pak brnění i vzduch v jednom slotu. Jde to s koženým, kroužkovým, železným, zlatým i diamantovým náprsníkem."
	]
	quest.01348E95F8E0B8F7.title: "Obrněná láhev"
	quest.01462C87F35C6D36.quest_desc: [
		"Teď už jen plná střela nestačí – každý cíl chce jinou střelu."
		""
		"Průbojná střela (&eArmor Piercing (AP) Shot&r) prorazí víc bloků. Je z litiny, železa a desky."
		""
		"Šrapnel (&eShrapnel Shell&r) po výbuchu rozhází kuličky do šířky. Potřebuje zapalovač."
		""
		"Kartáč (&eBag of Grapeshot&r) se hned po výstřelu rozsype na kuličky. Ničí měkké bloky, třeba dřevo."
		""
		"Kuličky (&eShot Balls&r) uděláš z 8 železných nugetů a 1 železného ingotu, dostaneš 2. &aTip:&r JEI ukáže i kouřový granát a granát s tekutinou."
	]
	quest.01462C87F35C6D36.title: "Další střely"
	quest.01575952918DB3F0.quest_desc: [
		"Větrák foukající přes &elávu&r taví vše, co by roztavila pec: písek na sklo, drť na ingoty. Palivo nepotřebuje."
		"Lávu dej před větrák a předměty za ni na pás nebo desku. Místo lávy jde i ohňohořák s palivem. &cJídlo tady shoří!&r"
		"&aTip:&r Rychlost zpracování je pořád stejná. Víc předmětů najednou = víc práce za stejný čas."
	]
	quest.01575952918DB3F0.title: "Hromadné tavení"
	quest.01852B4DA09E1CAF.quest_desc: [
		"Kotel z lokokovu (&eLocometal Boiler&r) je válcový blok. Vypadá jako kotel parní lokomotivy."
		"Vyrábí se v mechanickém výrobníku (&eMechanical Crafter&r) ze sekaného lokokovu (&eSlashed Locometal&r), ohnivých tyčí a kbelíku. Vzniknou 4 kusy."
		"&aNa kotel patří komín (&eDouble Smokestack&a) z táboráku a železných nugetů.&r"
	]
	quest.01852B4DA09E1CAF.title: "Kotel lokomotivy"
	quest.01A9066153305CB7.quest_desc: [
		"Robustní plát (&eSturdy Sheet&r) je pevný plech z obsidiánu. Potřebuješ ho na vlakové pouzdro a na jízdní řády."
		"Nejdřív rozdrť obsidián v drtících kolech (&eCrushing Wheel&r) na obsidiánovou moučku (&ePowdered Obsidian&r)."
		"Pak přijde sekvenční montáž na pásu: dávkovač (&eSpout&r) přidá k moučce lávu a mechanický lis ji dvakrát stiskne. Přesné kroky ukáže JEI."
		"&aLávu do dávkovače přivedeš čerpadlem a potrubím, třeba z nádrže.&r"
	]
	quest.01A9066153305CB7.title: "Robustní plát"
	quest.01B1FF30FB495E55.quest_desc: [
		"Noví občané přicházejí dvěma způsoby: najmeš návštěvníka v krčmě, nebo se narodí dítě."
		"Dítě se narodí, když v kolonii bydlí muž a žena a někde je volná postel. Děti musí jíst a spát, aby vyrostly."
	]
	quest.01B1FF30FB495E55.title: "Pátý občan"
	quest.01B38CE1DFDA00BB.quest_desc: ["První stupeň (&eStack Upgrade Tier 1&r) dá 2× víc věcí do slotu. Vyrobíš ho ze startovního stupně a 4 železných bloků."]
	quest.01B38CE1DFDA00BB.title: "Stoh I"
	quest.01D47D7E782FD6F6.quest_desc: [
		"&bCreate: Aquatic Ambitions&r přidává mechanickou klec pro konduit (&eConduit&r) a nový druh zpracování větrákem."
		""
		"Prismarinovou slitinu (&ePrismarine Alloy&r) vyrobíš v míchačce z prismarinu a měděného nugetu. Jde to i na pracovním stole: 2 prismariny a 2 měděné nugety dají 1 slitinu."
		""
		"&aDvě slitiny nad sebou na pracovním stole dají tyč (&ePrismarine Alloy Rod&r).&r"
	]
	quest.01D47D7E782FD6F6.title: "Prismarinová slitina"
	quest.01D5F1E24E1632E9.quest_desc: [
		"Tyče potřebuješ do skoro všech elektrických strojů."
		""
		"Hoď ingot na vrch válcovací stolice (&eRolling Mill&r) a stolice z něj udělá 2 tyče. Z plátu udělá 2 dráty. Hotové věci vytáhneš pravým tlačítkem."
		""
		"&aStolici můžeš zautomatizovat: pás a dva trychtýře (&eFunnel&r) – jedním věci dovnitř, druhým ven.&r"
	]
	quest.01D5F1E24E1632E9.title: "Kovové tyče"
	quest.01DBB22F1284311F.quest_desc: [
		"I stavitel umí vyrábět jednoduché recepty 2 × 2. Nauč ho recept na pochodeň a bude si je dělat sám."
		"V jeho budově otevři učení receptů a vlož uhlí nad tyčku."
	]
	quest.01DBB22F1284311F.title: "Stavitel umí pochodně"
	quest.01DFBD2CD036D2E9.quest_desc: [
		"Andezitový jetpack (&eAndesite Jetpack&r) je první jetpack tohoto modu. Skládá se v mechanickém výrobníku a létá na palivo."
		""
		"Ve vzduchu drž mezerník a letíš. Shift + mezerník zapne vznášení. Mezerník ve vodě zapne rychlé plavání."
		""
		"Palivová nádrž (&eSmall Fueling Tank&r) se plní pravým kliknutím na lávu. Když ji máš v inventáři, sama dobíjí výbavu na palivo."
		""
		"&aNouzově: vezmi jetpack do druhé ruky a vyhoď na zem uhlí. Větší nádrž vyrobíš, když menší obložíš 4 robustními pláty (&eSturdy Sheet&r).&r"
	]
	quest.01DFBD2CD036D2E9.title: "Andezitový jetpack"
	quest.02132D7A3FE5C4FD.quest_desc: [
		"Desh je ruda z Měsíce. Těž ji pod povrchem a přetav na ingoty (&eDesh Ingot&r)."
		"Z deshe jsou lepší stroje, rychlejší kabely a raketa 2. stupně."
	]
	quest.02132D7A3FE5C4FD.title: "Desh"
	quest.023AF47BB34DE51D.quest_desc: [
		"Netheritový ingot vyrobíš ze 4 netheritových úlomků a 4 zlatých ingotů. Úlomky se tají z prastarých trosek (Ancient Debris) z Netheru."
		"Jak je najít, se dozvíš ve skupině &bPrůzkum a dimenze&r."
		"Netherit ale není konec. Mod &bAdvanced Netherite&r ho vylepší ještě ve čtyřech stupních."
	]
	quest.023AF47BB34DE51D.title: "Netherit"
	quest.024B5A4F8A4076A6.quest_desc: [
		"Mozzarellu (&eMozzarella&r) zamícháš v misce z kbelíku mléka a kbelíku vody."
		"Sýr potřebuješ do lasagní a těstovin. Místo ní můžeš použít i sýr z modu Meadow."
	]
	quest.024B5A4F8A4076A6.title: "Mozzarella"
	quest.0267E6B81389853E.quest_desc: [
		"&eVoid Worm&r je obří boss z modu &bAlex's Mobs&r. Žije v prázdnotě pod ostrovy Endu."
		"Vylákáš ho tak, že hodíš do prázdnoty Endu tajemného červa (&eMysterious Worm&r). Toho získáš, když dáš larvu krvavého komára (&eCrimson Mosquito Larva&r) do kapsidy (&eCapsid&r)."
		"Útoč hlavně na hlavu. Když zničíš článek těla, červ se rozdělí na dva. Bojuj na velké plošině a ber zbraně na dálku."
	]
	quest.0267E6B81389853E.title: "Červ prázdnoty"
	quest.02686FAD041600B7.quest_desc: [
		"Obsidián vznikne, když voda zateče na stojící lávu."
		"Vykopeš ho diamantovým (nebo ještě lepším) krumpáčem. Trvá to dlouho."
		"Úkol: získej obsidián do inventáře. Potřebuješ ho na portál do Netheru a na očarovací stůl."
	]
	quest.02686FAD041600B7.title: "Obsidián"
	quest.027937A8B366E796.quest_desc: [
		"Fluxový výrobník (&eFlux Crafter&r) funguje jako endový, ale potřebuje energii (FE). Dodávají mu ji fluxové alternátory (&eFlux Alternator&r) do 3 bloků kolem."
		"Alternátory napoj kabely na zdroj energie, třeba na generátor Mekanismu nebo alternátor z &bCreate Crafts \\& Additions&r."
		"&aTip:&r Vyrábí se v něm fluxová hvězda (&eFlux Star&r) a vylepšený redstonový ingot (&eEnhanced Redstone Ingot&r)."
	]
	quest.027937A8B366E796.title: "Fluxový výrobník"
	quest.027CFA1FDF58B7E9.quest_desc: [
		"Neptuniový nůž (&eNeptunium Knife&r) vyrobíš z neptuniového ingotu a klacku."
		"Neptunium vylovíš při rybaření. Najdeš ho i v truhle &eNeptune's Bounty&r, kterou můžeš vylovit z moře."
	]
	quest.027CFA1FDF58B7E9.title: "Neptuniový nůž"
	quest.027FCD1C8EC95894.quest_desc: [
		"Teď už jen přežívání nestačí – kolonie musí růst. Vylepši stavitelovu budovu na úroveň 2."
		"V „Možnosti budovy“ (&eBuild Options&r) klikni na „Vylepšit“ (&eUpgrade&r). Pak můžeš vylepšovat na úroveň 2 i ostatní budovy."
		"Vyšší úroveň znamená rychlejší postup dělníků a lepší nástroje. Chceš stavět dvě věci naráz? Postav druhého stavitele."
	]
	quest.027FCD1C8EC95894.quest_subtitle: "Pokročilý"
	quest.027FCD1C8EC95894.title: "Stavitel úrovně 2"
	quest.02885F2880471CF2.quest_desc: [
		"&bCreate: Winery&r má vlastní hrozny (&eRed Grapes&r, &eWhite Grapes&r). Keře rostou na pláních, loukách a v lesích."
		"Lis nad tyglíkem slisuje 3 hrozny na drť (&eRed Grape Pomace&r). Ze 3 jablek je jablečný mošt."
	]
	quest.02885F2880471CF2.title: "Hroznová drť"
	quest.028A67D144062F9C.quest_desc: [
		"Magnetické jeskyně jsou z šedého kamene galenitu (&eGalena&r) a rostou v nich obří krystaly."
		"Rudé neodymové krystaly přitahují kovové věci, modré je odpuzují."
		"&cŽelezná a netheritová výbava tě tu bude přitahovat i odstrkovat. Lepší je nekovová výbava.&r"
		"&cTeslovy baňky (&eTesla Bulb&r) dávají rány bleskem a při rozbití vybuchují.&r"
	]
	quest.028A67D144062F9C.title: "Magnetické jeskyně"
	quest.02914B43DFA290FD.quest_desc: [
		"&bSteam 'n' Rails&r přidává koleje s pražci z každého druhu dřeva. Vyrábí se jako běžná kolej, jen místo kamenné desky použij dřevěnou."
		"Z dubové desky tak vznikne dubová kolej (&eOak Train Track&r). Jezdí se po ní stejně, liší se jen vzhledem."
		"&aKolej z černého kamene (&eBlackstone Train Track&a) potřebuje zlaté nugety. Endová kolej (&eEnder Train Track&a) potřebuje desku z endových cihel. Kolej bez pražců (&eTieless Train Track&a) potřebuje skleněnou tabuli.&r"
	]
	quest.02914B43DFA290FD.title: "Dřevěné koleje"
	quest.02A6F289718BEABC.quest_desc: [
		"Vejce polož na zem pravým tlačítkem."
		"Vejce potřebuje teplo, a to znamená světlo. V teplém biomu stačí méně světla, ve studeném víc. &cVe tmě nebo ve vodě se líhnutí vrací zpět.&r"
		"Za pár minut se vylíhne mládě. Když jsi do 16 bloků, mnoho druhů tě rovnou přijme za pána."
	]
	quest.02A6F289718BEABC.title: "První vejce"
	quest.02BF723CE4303798.quest_desc: [
		"Boss bronzového dungeonu je &eSlider&r – obří kamenný blok, který po místnosti klouže a drtí tě."
		"&cZraníš ho jen krumpáčem!&r Uhýbej mu z cesty."
		"Po smrti upustí bronzový klíč (&eBronze Key&r). Jím otevřeš truhlu s pokladem za bossem."
	]
	quest.02BF723CE4303798.title: "Slider"
	quest.02D5E689BB8C186D.quest_desc: [
		"Nabíjecí tyč (&eRam Rod&r) zatlačí náboje do děla. Vyrobíš ji z beranidla (&eRam Head&r) a dvou klacků."
		""
		"Polož nálož (&ePowder Charge&r) jako blok před ústí děla a klikni na ni tyčí. Nálož se zasune dovnitř. Stejně potom zatlač i střelu."
		""
		"Nálože jsou vždy vzadu, střela před nimi. Tyč ti při práci bere hlad."
		"{@pagebreak}"
		"Na lafetě je ploška s kladívkem. Když do ní pustíš redstonový signál (třeba pákou), dělo se sestaví."
		""
		"Pak dej signál do plošky s hořícím dělem. Dělo vystřelí."
		""
		"Když signál z kladívka vypneš, dělo se rozloží a vrátí se do polohy, ve které bylo sestavené."
	]
	quest.02D5E689BB8C186D.quest_subtitle: "Začátečník"
	quest.02D5E689BB8C186D.title: "Nabij a vystřel"
	quest.02E51EF413620CED.quest_desc: [
		"Mod &bUnusual End&r přidává na vnější ostrovy nové biomy, stavby a moby."
		"Lesklý krystal (&eShiny Crystal&r) získáš z lesklého gloopstonu (&eShiny Gloopstone&r) v biomu &eGloopstone Highlands&r, z urn a z truhel."
		"Další věci z tohoto modu najdeš v kapitole &bEnd&r."
	]
	quest.02E51EF413620CED.title: "Neobvyklý End"
	quest.02F0724FBC56D9AE.quest_desc: [
		"Teď začíná lov bestií. Potřebuješ železnou nebo lepší zbroj, štít, jídlo a lektvary."
		"Bestiář (&eUltimate Bestiary&r) vyrobíš z knihy a 4 diamantů. Ke každé bestii píše, kolik má životů, kde žije, co umí a co z ní padá."
		"Z bestie padá buď trofej, nebo gramofonová deska. Někdy i její vzácný předmět."
		"&aTip:&r Když místo trofeje padne deska, musíš bestii porazit znovu."
	]
	quest.02F0724FBC56D9AE.quest_subtitle: "Pokročilý"
	quest.02F0724FBC56D9AE.title: "Bestiář"
	quest.02F4DADA6C28004C.quest_desc: [
		"Teď už nemusí být celá továrna jedna síť. Kinetický most (&eKinetic Bridge&r) posílá nastavené množství síly z jedné sítě do druhé a sítě zůstanou oddělené."
		""
		"Když přetížíš druhou síť, první běží dál. Kolik síly most posílá, nastavíš na panelu."
		""
		"&aTip:&r Když se přetíží zdrojová síť, dej před most přetěžovací spojku. Uvolní sílu, kterou by most zbytečně bral."
	]
	quest.02F4DADA6C28004C.quest_subtitle: "Pokročilý"
	quest.02F4DADA6C28004C.title: "Kinetický most"
	quest.0303961F2E1D2EC7.quest_desc: [
		"Železný krumpáč vykope i diamanty, zlato a redstone."
		"Opotřebovaný nástroj nevyhazuj. Na kovadlině ho opravíš materiálem (tady železem) nebo spojíš s druhým stejným nástrojem."
	]
	quest.0303961F2E1D2EC7.title: "Železný krumpáč"
	quest.030C7019A6B44DE0.quest_desc: [
		"Mystické místo (&eMystical Site&r) nemá dělníka. Je to krásná stavba, na kterou jsou občané pyšní – zvyšuje spokojenost podle své úrovně."
		"Výzkum &eAmbition&r stojí 1 diamant. Blok budovy: prkna, diamant a nástroj stavby."
	]
	quest.030C7019A6B44DE0.title: "Mystické místo"
	quest.032C65D57301B835.quest_desc: [
		"Automatická pec (&eAuto-smelting Upgrade&r) si sama bere rudy i palivo z batohu a hotové ingoty do něj vrací."
		"Vylepšíš ji z upgradu pece: přidej diamanty, zlato, násypky a redstone."
	]
	quest.032C65D57301B835.title: "Automatické tavení"
	quest.0354CD4F07ACE793.quest_desc: [
		"Prastará věž (&eAncient End Tower&r) je pozůstatek dávných obyvatel Endu."
		"Uvnitř stojí oltář golema (&eGolem Altar&r). Probudíš ho lahví dračího dechu (&eDragon's Breath&r)."
	]
	quest.0354CD4F07ACE793.title: "Prastará věž"
	quest.036FE13F02DFBBB6.quest_desc: [
		"Mřížka vzorů (&ePattern Grid&r) zapisuje recepty do vzorů (&ePattern&r)."
		"Výrobní vzor = recept z pracovního stolu. Zpracovací vzor = co dát do stroje a co se má vrátit (třeba ruda → ingot v peci)."
		"&aTip:&r Recept přeneseš z JEI tlačítkem + u receptu."
	]
	quest.036FE13F02DFBBB6.title: "Mřížka vzorů"
	quest.037CFE8B322BBA98.quest_desc: [
		"Stříbrný mrak (&eSterling Aercloud&r) se vznáší úplně nahoře, kam se těžko dostaneš."
		"&cKdyž na něj stoupneš, zasáhne ho blesk a změní ho na obyčejný studený mrak.&r Těž ho zespodu nebo z boku."
	]
	quest.037CFE8B322BBA98.title: "Stříbrný mrak"
	quest.03A064B77F4910E4.quest_desc: [
		"&bCreate: Escalated&r přidává pohyblivé chodníky a eskalátory. Pohání je rotace z hřídelí, stejně jako stroje z Create."
		""
		"Kovové schody (&eMetal Walkway Steps&r) vyrobíš z řetězů a železných plátů. Dřevěné (&eWooden Walkway Steps&r) z řetězů a dřevěných desek."
		""
		"Polož dvě hřídele a klikni na obě pravým tlačítkem se schody v ruce. Mezi nimi vznikne chodník. Špatný výběr zrušíš Shiftem + pravým tlačítkem."
		""
		"&aChodník rozšíříš, když ho propojíš s hřídelí hned vedle. Kliknutím hřídelí na prostřední díl přidáš další pohon.&r"
	]
	quest.03A064B77F4910E4.quest_subtitle: "Začátečník"
	quest.03A064B77F4910E4.title: "Pohyblivý chodník"
	quest.03A51D5C27EF7E8C.quest_desc: [
		"Jsi v Soumračném lese. Je tu pořád soumrak a hustý les plný zvířat i příšer."
		"Postup: Naga → Lich → potom tři větve (bažina, temný les, sníh) → vysočina."
		"Kapitola &bSoumračný les: výbava&r ukazuje zbroj, nástroje a kouzelné stromy z tohoto světa."
	]
	quest.03A51D5C27EF7E8C.quest_subtitle: "Začátečník"
	quest.03A51D5C27EF7E8C.title: "Do soumraku"
	quest.03ADAED401D0C90A.quest_desc: [
		"Pravěký kyj (&ePrimitive Club&r) je pomalá zbraň, která může cíl omráčit až na 15 sekund."
		"Vyrobíš ho z těžké kosti (&eHeavy Bone&r) a dvou cykasů (&eCycad&r). Těžké kosti padají z velkých dinosaurů."
		"&aTremorsaura ochočíš tak, že ho kyjem omráčíš a hned mu dáš salát. Musíš to zkusit několikrát.&r"
	]
	quest.03ADAED401D0C90A.title: "Pravěký kyj"
	quest.03D668B7C5C5B07E.quest_desc: [
		"Podzemní chatky jsou malé dřevěné domky v obyčejných jeskyních."
		"Najdeš je při průzkumu jeskyní. Mapu k chatce ti někdy prodá kartograf (vesničan) nebo ji najdeš v truhle v opuštěném dole."
		"&aV truhlách chatky bývají kamenné tabulky a někdy i kniha jeskyní.&r"
	]
	quest.03D668B7C5C5B07E.title: "Podzemní chatka"
	quest.03FC0A399C550309.quest_desc: [
		"Pumovnice (&eBomb Bay&r) shazuje TNT. Munice: TNT v inventáři letadla."
		"&aBomby neničí bloky, ale těžce zraní vše, co zasáhnou.&r"
	]
	quest.03FC0A399C550309.title: "Pumovnice"
	quest.0416DBEF41E814E7.quest_desc: [
		"Větrný generátor (&eWind Generator&r) se točí i v noci. Čím výš ho postavíš, tím víc energie dává."
		"Zabírá na výšku víc bloků, takže nad ním nech volné místo."
		"&aTip:&r Postav ho na vysokém kopci nebo na sloupu."
	]
	quest.0416DBEF41E814E7.title: "Větrná energie"
	quest.041DC559B39F9318.quest_desc: [
		"&eZinková ruda&r (&eZinc Ore&r) je v Overworldu ve výškách od −63 do 70. Ze zinku a mědi vznikne mosaz."
		"Surový zinek (&eRaw Zinc&r) roztav v peci na zinkový ingot."
		"&aTip:&r Zinek je i v kameni &eazurín&r (&eAsurine&r). Drtící kola z něj zinek vydrtí."
	]
	quest.041DC559B39F9318.title: "Zinek"
	quest.0431A78F9A1C7EB4.quest_desc: [
		"&bCreate Cafe&r přidává kávu, ledovou kávu a bubble tea."
		"Kávová zrna (&eCoffee Beans&r) občas vypadnou z trávy (bez nůžek). Opraž je v udírně."
	]
	quest.0431A78F9A1C7EB4.title: "Pražená káva"
	quest.0457977CB87A95F2.quest_desc: [
		"Vzpěra (&eGirder Strut&r) je kovový nosník, který se natáhne mezi dva bloky. Může vést i šikmo."
		""
		"Vyrobíš ji ze 3 kovových nosníků (&eMetal Girder&r) a 2 andezitových slitin. Dostaneš 6 kusů. Lanová verze (&eCable Girder Strut&r) má místo nosníků železné nugety."
		""
		"Vzpěra vede rovně a nedá se ohnout. Jak ji položit, ukáže ponder."
		""
		"&aTip: Kovový nosník, kovový držák i vzpěru zrezivíš praním: pošli je větrákem přes vodu.&r"
	]
	quest.0457977CB87A95F2.title: "Šikmé vzpěry"
	quest.0463B34D316CC6C6.quest_desc: [
		"Šrot (&eLegendary Scrap&r) dostaneš rozebráním trofeje nebo desky (2 kusy) nebo vzácného předmětu bestie (4 kusy) ve výrobní mřížce."
		"Zatím k ničemu není – autor modu ho chystá na budoucí vylepšení. &cTrofej si před rozebráním nech na splnění questu.&r"
	]
	quest.0463B34D316CC6C6.title: "Legendární šrot"
	quest.047B48B30E71BBC9.quest_desc: [
		"Věčný upgrade (&eEverlasting Upgrade&r): batoh se nedá zničit. Nezmizí na zemi, neshoří a nespadne do prázdna (void)."
		"Je drahý: základ upgradu, 4 hvězdy z Netheru a 4 krystaly Endu (&eEnd Crystal&r)."
	]
	quest.047B48B30E71BBC9.title: "Nezničitelný batoh"
	quest.048512DD5FBA5F1B.quest_desc: [
		"Vlasec (&eFishing Line&r) je z provázků a železného ingotu. Splávek (&eBobber&r) z hlíny a ulity nautila."
		"Obojí jde do prutu v rybářské krabičce."
	]
	quest.048512DD5FBA5F1B.title: "Vlasec a splávek"
	quest.048A7BC53AF26CA4.quest_desc: [
		"Okultní drahokam (&eOccult Gem&r) padá z Watchera, nebo ho najdeš v truhlách ruin."
		"Watcher vznikne, když kultisté obětují můru. &cUmí tě posednout: na chvíli vidíš jeho očima a nemůžeš se hýbat.&r"
		"&aZ drahokamu je i totem (&eTotem of Possession&r), kterým na chvíli ovládneš moba.&r"
	]
	quest.048A7BC53AF26CA4.title: "Okultní drahokam"
	quest.049756812944966F.quest_desc: [
		"Jaderné palivo (&eFissile Fuel&r) se vyrábí ve třech krocích."
		"1) Rozpouštěcí komora: fluorit + kyselina sírová = kyselina fluorovodíková. 2) Chemický infuzér: kyselina fluorovodíková + oxid uraničitý = fluorid uranový. 3) Izotopová odstředivka (&eIsotopic Centrifuge&r) z něj udělá palivo."
		"&aTip:&r Palivo ukládej do chemických nádrží. Samo radioaktivní není, ale v reaktoru z něj vzniká radioaktivní odpad."
	]
	quest.049756812944966F.title: "Jaderné palivo"
	quest.04AC6FE40E55F787.quest_desc: [
		"Termální odpařovací věž (&eThermal Evaporation Plant&r) odpařuje vodu a vyrábí solanku (&eBrine&r). Je to stavba z více bloků."
		"Postav věž 4×4 bloky, vysokou 3 až 18 bloků: plné dno a stěny z bloků &eThermal Evaporation Block&r, nahoře otevřená, uvnitř vzduch."
		"Do stěny dej jeden ovladač (&eThermal Evaporation Controller&r) a aspoň jeden ventil (&eThermal Evaporation Valve&r). Ventilem přiváděj vodu a odváděj solanku."
		"&aTip:&r Čím je věž teplejší, tím rychleji pracuje. Teplo dodá topení (&eResistive Heater&r) položené vedle ventilu."
	]
	quest.04AC6FE40E55F787.title: "Odpařovací věž"
	quest.04B7C8F9C5669640.quest_desc: [
		"Stroje Create umí vařit. Míchačka míchá těsta a omáčky, lis lisuje, dávkovač (&eSpout&r) nalévá tekutiny a pokladač (&eDeployer&r) skládá jídla."
		"Mody &bCreate Confectionery&r (sladkosti), &bCreate Food&r (dorty, koblihy), &bCreate Cafe&r (káva, bubble tea), &bCreate: Winery&r (víno) a &bSlice \\& Dice&r (krájení) přidávají hlavně recepty pro stroje."
		"&bCreate: Central Kitchen&r propojí stroje Create s kuchyní Farmer's Delight. Začni v kapitole &bCreate&r – potřebuješ míchačku, lis a dávkovač."
	]
	quest.04B7C8F9C5669640.quest_subtitle: "Začátečník"
	quest.04B7C8F9C5669640.title: "Jídlo a stroje"
	quest.04C2C9F2B68B6C82.quest_desc: [
		"Polož na prkénko kmen a klikni na něj sekerou. Dostaneš oloupaný kmen a kůru (&eTree Bark&r)."
		"Kůra se hodí do organického kompostu. Dá se z ní udělat i papír."
	]
	quest.04C2C9F2B68B6C82.title: "Kůra ze stromů"
	quest.04D28ABAB66EA4C1.quest_desc: [
		"Ropný skener (&eOil Scanner&r) zjistí, kolik ropy je v chunku, kde stojíš. Klikni pravým tlačítkem a chvíli počkej."
		""
		"Víc ropy bývá v savanách, pouštích, pustinách (&eBadlands&r), pláních a oceánech. Nejlepší je naleziště &eBottomless Supply&r – nikdy nedojde."
		""
		"Víc najdeš v kapitole Ropa a palivo."
	]
	quest.04D28ABAB66EA4C1.title: "Najdi ropu"
	quest.04F10C667940717C.quest_desc: [
		"Dálková čočka (&eRemote Lens&r) ti ukáže svět očima průvodčího."
		"Klikni čočkou na průvodčího, který nosí inženýrské brýle. Tím je spojíš a pak se můžeš dívat jeho očima."
		"Výroba: precizní strojek, oko Enderu a mosazný plát."
	]
	quest.04F10C667940717C.title: "Dálková čočka"
	quest.04F22E14E335CB83.quest_desc: [
		"Biopalivo (&eBiofuel&r) je jediné tekuté palivo, které ohňohořák se slámkou rozpálí doběla – stejně jako ohňodort (&eBlaze Cake&r). Jeden kbelík vydrží 20 minut."
		""
		"V míchačce smíchej 2 biomasy, cukr a uškvařenou mouku (&eCinder Flour&r). Vznikne 125 mB biopaliva. Do kbelíku ho naplníš dávkovačem (&eSpout&r)."
		""
		"&aFarma, lis, míchačky a potrubí k ohňohořákům = palivo, o které se nemusíš starat.&r"
	]
	quest.04F22E14E335CB83.quest_subtitle: "Pokročilý"
	quest.04F22E14E335CB83.title: "Biopalivo"
	quest.0515F989FEB30F97.quest_desc: [
		"Džunglové hrozny (&eRed Jungle Grapes&r) rostou divoce v džungli a v zalesněných badlands."
		"Jejich semínka se sázejí na mřížku (&eOak Lattice&r) – vyrobíš ji z klacků a prken. Réva po ní šplhá."
	]
	quest.0515F989FEB30F97.title: "Džunglová réva"
	quest.053FBD04F6E4E98F.quest_desc: [
		"Z bloků dynamické nádrže (&eDynamic Tank&r) se staví velká dutá nádrž na kapaliny i plyny. Plní a vypouští se přes ventil (&eDynamic Valve&r)."
		"Samotný blok nádrže je i součástí receptů – potřebuješ ho na tlakovou reakční komoru a chemický oxidátor."
		"&aTip:&r Místo některých bloků nádrže můžeš dát konstrukční sklo (&eStructural Glass&r) a vidět dovnitř."
	]
	quest.053FBD04F6E4E98F.title: "Dynamická nádrž"
	quest.0541B5302D997256.quest_desc: [
		"Drezína (&eHandcar&r) je malé vozítko na ruční pohon. Nepotřebuje stanici ani vlakové pouzdro."
		"Polož ji rovnou na koleje, nasedni a jeď. Jízda ti ubírá jídlo, protože jedeš vlastní silou. Montážním klíčem ji zase sebereš."
		"&aVýroba potřebuje mimo jiné ovládací prvky udělátka (&eContraption Controls&a) a andezitové pouzdro.&r"
	]
	quest.0541B5302D997256.title: "Drezína"
	quest.0549973DEA4119FD.quest_desc: [
		"Pevnost leží hluboko pod zemí. Je v ní portál do Endu."
		"Najdeš ji pomocí &eEndových očí&r: hoď oko do vzduchu a jdi směrem, kam letí."
		""
		"&bYUNG's Better Strongholds&r z ní udělal velké bludiště. Značkuj si cestu pochodněmi."
	]
	quest.0549973DEA4119FD.quest_subtitle: "Expert"
	quest.0549973DEA4119FD.title: "Pevnost"
	quest.056EA013915DFDF5.quest_desc: [
		"Dubové okno (&eResizeable Oak Window&r) vyrobíš ze základů okna (&eWindow Base&r: sklo obložené tyčkami) a dubového kmenu."
		"Závěs (&eWhite Curtain&r) vyrobíš ze 2 bloků bílé vlny. Okno zamkneš klíčem (&eWindow Key&r)."
	]
	quest.056EA013915DFDF5.title: "Okna a závěsy"
	quest.059E1862FD72887A.quest_desc: [
		"Uvař všechny čaje a kávy z &bHerbalBrews&r."
		"Odměnou je prapor (&eCompletionist Banner: Herbal Brews&r). Postavený dává hráčům v okolí extra srdíčka (pohlcení)."
	]
	quest.059E1862FD72887A.quest_subtitle: "Expert"
	quest.059E1862FD72887A.title: "Mistr čaje"
	quest.05A755283305A839.quest_desc: [
		"Teď už jedna rovná trasa nestačí – postavíš síť. Rozbočovač (&eHypertube Splitter&r) spojí až tři trubky, takže se trasa větví."
		""
		"Vyrobíš ho v mechanickém výrobníku ze dvou mosazných plátů, vysílače, trubky a tří trychtýřů."
		""
		"Když jím projíždíš, směr vybereš klávesami pro chůzi. Klíčem přepneš režimy, ve kterých posílá cestující vždy stejnou cestou."
		""
		"&aTrubkami cestují i vesničané, krávy, prasata, ovce, slepice, některé ryby a balíčky z Create.&r"
	]
	quest.05A755283305A839.quest_subtitle: "Pokročilý"
	quest.05A755283305A839.title: "Rozbočovač"
	quest.05BEB2E003546064.quest_desc: [
		"Energizér (&eBasic Energiser&r) nabíjí kovy a diamanty elektřinou. Vyrobíš ho z andezitového pouzdra a hromosvodu."
		""
		"Potřebuje elektřinu i otáčení. Předmět mu polož pod něj na odkládací desku nebo na pás."
		""
		"&aVíc najdeš v kapitole Elektřina.&r"
	]
	quest.05BEB2E003546064.title: "Energizér"
	quest.05C2800C8FB7FC81.quest_desc: [
		"&eMosazné pouzdro&r (&eBrass Casing&r): klikni mosazným ingotem na oloupaný kmen."
		"Je to kostra chytrých strojů: mechanický výrobník, mechanická paže, ovladač rychlosti otáček, prahový spínač."
	]
	quest.05C2800C8FB7FC81.title: "Mosazné pouzdro"
	quest.05C97E4775B26938.quest_desc: [
		"Úkol: přetav v peci železnou rudu na ingot. Pak jsi připravený na velké mody."
		"Nevíš, jak na to? Projdi kapitolu &ePrvní dny&r."
		"{@pagebreak}"
		"&bCreate&r (skupina Create): stroje na točivou sílu, továrny, vlaky. Skvělý první velký mod."
		"&bTechnika a úložiště&r: Mekanism (elektřina a zpracování rud), úložné systémy a truhly."
		"&bJídlo a farmaření&r: stovky nových jídel, farmy a vaření."
		"{@pagebreak}"
		"&bKolonie a stavění&r: MineColonies (vlastní vesnice s obyvateli) a dekorace."
		"&bPrůzkum a dimenze&r: Nether, End, Aether, Twilight Forest, nové stavby a příšery."
		"Kapitoly v této skupině (&bZačínáme&r) ti pomůžou s batohy, užitečnými mody, Quarkem a výbavou."
	]
	quest.05C97E4775B26938.quest_subtitle: "Rozcestník"
	quest.05C97E4775B26938.title: "Kam dál?"
	quest.05F07113D2C4B99B.quest_desc: [
		"Spoj velké a malé ozubené kolečko našikmo. Z velkého na malé = 2× rychleji, z malého na velké = 2× pomaleji."
		"&cPřevod nepřidá sílu!&r Když zrychlíš 2×, každý stroj za převodem bere 2× víc SU. Kapacita zdroje zůstane stejná."
		"Převody za sebou: 8 → 16 → 32 → 64 RPM. Nejvyšší rychlost je 256 RPM, rychlejší díl se rozbije."
	]
	quest.05F07113D2C4B99B.title: "Převody"
	quest.06153CE69ADF89A6.quest_desc: [
		"Imitační panel už znáš. &bCopycats+&r přidává desítky dalších tvarů: celý blok, svah, schody, plot, zídku, žebřík a další."
		""
		"Skoro všechny se dělají v kameníkovi ze zinkového ingotu. Z jednoho ingotu je imitační blok (&eCopycat Block&r), dva svahy (&eCopycat Slope&r) a u menších tvarů i víc kusů."
		""
		"Pravým tlačítkem s blokem v ruce imitaci „obarvíš“. Montážním klíčem materiál zase odebereš."
		"{@pagebreak}"
		"Některé tvary jdou ve výrobní mřížce přepnout na příbuzný tvar. Například svah na svislý svah a zpátky."
		""
		"&aTip: Shift + pravé tlačítko prázdnou rukou zapne nebo vypne propojené textury. Pak se sousední imitace spojí do jedné plochy.&r"
	]
	quest.06153CE69ADF89A6.title: "Imitace všech tvarů"
	quest.0629AB3D75EAA1A7.quest_desc: [
		"&eZnaková výbojka&r (&eNixie Tube&r): 2 elektronky dají 4 kusy. S redstone signálem ukáže jeho sílu."
		"Psací podložkou na ni napíšeš text, barvivem změníš barvu."
	]
	quest.0629AB3D75EAA1A7.title: "Znaková výbojka"
	quest.06496B8AA903F8F3.quest_desc: [
		"V labyrintu je tajný trezor. Uvnitř leží krumpáč &eMazebreaker&r."
		"Je to vzácný krumpáč, který najdeš jen tady."
	]
	quest.06496B8AA903F8F3.title: "Rozbíječ bludiště"
	quest.064B8C14D9682E88.quest_desc: [
		"Kabely (&eFluix ME Glass Cable&r) spojují zařízení AE2 do jedné sítě. Nejsou to trubky – předměty ani kapaliny jimi neposíláš."
		"Vyrobíš je z křemenného vlákna (&eQuartz Fiber&r) a fluixových krystalů."
		"&aTip:&r Barevné kabely se nespojí s kabely jiné barvy. Fluixový kabel se spojí se všemi."
	]
	quest.064B8C14D9682E88.title: "Kabely"
	quest.068F1B851310D081.quest_desc: [
		"Železo je nejdůležitější kov. Železnou rudu (béžové tečky v kameni) najdeš v jeskyních a v horách."
		"Rudu vykopej aspoň kamenným krumpáčem. Dostaneš surové železo – to v peci přetav na ingoty."
		"&aTip:&r Později ti mody &bCreate&r a &bMekanism&r z jedné rudy udělají víc ingotů."
	]
	quest.068F1B851310D081.quest_subtitle: "Pokročilý"
	quest.068F1B851310D081.title: "Železo"
	quest.069FF62E141DDE7C.quest_desc: [
		"Paměťová buňka neuloží neomezeně věcí. Má dvě omezení: bajty (kolik kusů) a typy (kolik různých předmětů)."
		"Každá buňka pojme nejvýš 63 různých předmětů. 4k buňka (&e4k ME Item Storage Cell&r) pojme 4× víc kusů než 1k, ale typů stejně."
		"&aTip:&r Buňku vylepšíš: v pracovním stole ji spoj s větší součástkou. Obsah zůstane a menší součástka se vrátí."
	]
	quest.069FF62E141DDE7C.title: "Bajty a typy"
	quest.06A9229F989167A6.quest_desc: [
		"&bCreate: Power Loader&r udrží chunk načtený, i když jsi daleko. Stroje v něm pak běží dál."
		""
		"Prázdný andezitový loader (&eEmpty Andesite Chunk Loader&r) vyrobíš ze skla, kotvy oživení (&eRespawn Anchor&r), hřídele a andezitových pouzder. Pak s ním klikni pravým tlačítkem na ghasta v Netheru."
		""
		"Chycený ghast loader oživí. Loader pak drží svůj chunk, dokud se točí dost rychle. Víc najdeš v kapitole Průmysl."
	]
	quest.06A9229F989167A6.title: "Načítání chunků"
	quest.06E5912FEDE5820E.quest_desc: [
		"Podzemní katakomby s hroby a zombie. Uvnitř je několik truhel, některé u náhrobků."
		"Jsou tu líhně zombie. Nejdřív je zakryj pochodněmi nebo vykopej, pak prohledej hroby."
	]
	quest.06E5912FEDE5820E.title: "Katakomby"
	quest.06EC08597591B28B.quest_desc: [
		"Těsto na dort namícháš z mléka, cukru, mouky, vejce a másla. Kbelík těsta upeč v peci – vznikne korpus (&eCake Base&r)."
		"Dávkovač naleje polevu přímo na korpus a dort (&eCake&r) je hotový. Jde to i na pracovním stole se sáčkem polevy."
	]
	quest.06EC08597591B28B.title: "Dort ze stroje"
	quest.06F5669E0FB186D7.quest_desc: [
		"Malá brambora (&eTiny Potato&r) v tebe věří!"
		"Vyrobíš ji z brambory a diamantového srdce. Klikni na ni a pohlaď ji."
	]
	quest.06F5669E0FB186D7.title: "Malá brambora"
	quest.070876E53DEB4AC0.quest_desc: [
		"Na serveru se hodí ochrana sítě. Správce zabezpečení (&eSecurity Manager&r) zakáže cizím hráčům všechno, co nepovolíš."
		"Bezpečnostní karta (&eSecurity Card&r) nastaví práva jednoho hráče: klikni s ní pravým tlačítkem a vyber, co smí. Kartu pak vlož do správce zabezpečení."
		"&aTip:&r Záložní karta (&eFallback Security Card&r) platí pro všechny hráče bez vlastní karty."
	]
	quest.070876E53DEB4AC0.title: "Zabezpečení sítě"
	quest.07225C11BC70DCB4.quest_desc: [
		"Sushi (&eSushi&r) vyrobíš z filetu a mořské trávy."
		"Mořskou trávu natrháš nůžkami pod vodou nebo ji občas vytáhneš prutem."
	]
	quest.07225C11BC70DCB4.title: "Sushi"
	quest.074B763EA6F0CBBD.quest_desc: [
		"Šablona + kus gravititové zbroje + stratusový ingot = kus stratusové zbroje. Vyrob helmu, hrudní plát, kalhoty a boty."
		"Celá sada dá vysoký skok a výpad do strany (&eStratus Dash&r) na vlastní klávese. Klávesu si nastav v ovládání."
	]
	quest.074B763EA6F0CBBD.title: "Stratusová zbroj"
	quest.07526533C5A0AB45.quest_desc: [
		"&bAlex's Caves&r přidává vzácné jeskynní biomy hluboko pod zemí."
		"V našem světě jich najdeš pět. Šestý, propastná rokle (&eAbyssal Chasm&r), vzniká jen pod hlubokým oceánem, a ten u nás uvnitř hranice světa není."
		"Každý biom má vlastní tvory, suroviny, výbavu a bosse. Některé jsou velmi nebezpečné."
		"Tady se naučíš jeskyně najít, přežít v nich a nakonec porazit jejich bosse."
		"&aTip: Začni hledáním podzemní chatky. Jsou v ní kamenné tabulky, které tě k jeskyním dovedou.&r"
	]
	quest.07526533C5A0AB45.quest_subtitle: "Začátečník"
	quest.07526533C5A0AB45.title: "Alex's Caves"
	quest.0762F81260536D87.quest_desc: [
		"Teď už neobarvuješ předměty po jednom v ruce. &bCreate: Dragons Plus&r přidává tekutá barviva."
		""
		"V mechanické míchačce (&eMechanical Mixer&r) smíchej barvivo s vodou. Vznikne tekuté barvivo. Z 1 barviva a 250 mB vody je 250 mB tekutého barviva, na kbelík tedy potřebuješ 4 barviva."
		""
		"Kbelík naplníš dávkovačem nebo přes kapalinový poklop (Shift + pravé tlačítko)."
		""
		"Vylij barvivo před větrák. Proud vzduchu přes něj hromadně obarví předměty."
		""
		"&aTip:&r Když tekuté barvivo steče do lávy, vznikne beton stejné barvy."
	]
	quest.0762F81260536D87.quest_subtitle: "Pokročilý"
	quest.0762F81260536D87.title: "Tekuté barvivo"
	quest.077C48CC2333F037.quest_desc: [
		"Energetická tavicí pec (&eEnergized Smelter&r) taví jako obyčejná pec, ale na energii a bez paliva."
		"Hodí se na tavení prachu z obohacovací komory. Zrychlíš ji vylepšením rychlosti."
		"&aTip:&r Z tavicí pece jde udělat továrna (&eBasic Smelting Factory&r), která taví víc věcí najednou."
	]
	quest.077C48CC2333F037.title: "Energetická tavicí pec"
	quest.079EB31754CF6EEE.quest_desc: [
		"Moa jsou velcí ptáci, na kterých můžeš létat. Inkubátor (&eIncubator&r) = 8 svatých kamenů a ambrosiová pochodeň."
		"Do inkubátoru dej vejce moa a jako palivo ambrosiové pochodně. Líhnutí chvíli trvá."
	]
	quest.079EB31754CF6EEE.title: "Inkubátor"
	quest.07AC3F601C826A8F.quest_desc: [
		"Mod &bSpice of Life: Onion&r odměňuje pestrou stravu. Pamatuje si posledních 32 snědených jídel a počítá z nich rozmanitost (&eDiversity&r)."
		"Nové a výživné jídlo rozmanitost zvedne. Když jíš pořád to samé, klesá."
		"Bonusy (výchozí nastavení): 3 – srdce navíc, 5 – síla, 7 – regenerace, 10 – rychlost, 13 – tuhost brnění, 18 – síla II, 25 a 31 – další srdce."
		"&cPozor:&r Po smrti se seznam snědených jídel vymaže. Rozmanitost uvidíš tlačítkem &eSOL&r v inventáři nebo v knize jídel (&eFood Book&r, z knihy a brambory)."
	]
	quest.07AC3F601C826A8F.title: "Pestrá strava"
	quest.07AE2E38F5D24BAE.quest_desc: [
		"Prkénko (&eCutting Board&r) slouží ke krájení. Vyrobíš ho z prken a klacků."
		"Polož prkénko, dej na něj surovinu (pravé tlačítko) a klikni na ni nožem. Kousky vyskočí ven."
		"&aTip:&r Sekerou nebo lopatou se na prkénku zpracují jiné věci. Všechny recepty ukáže JEI."
	]
	quest.07AE2E38F5D24BAE.title: "Prkénko"
	quest.07B07EC4FD29A63B.quest_desc: [
		"&bNether&r je horký podzemní svět plný lávy, ohně a nebezpečných mobů. Vede do něj portál z obsidiánu."
		"V této kapitole se na Nether připravíš, najdeš pevnost a bastion, vyrobíš netherit a otevřeš cestu do &bEndu&r."
		"Nether rozšiřují mody &bIncendium&r, &bJaden's Nether Expansion&r, &bJust-In NETHER&r, &bNether Exotics&r a &bMoog's Nether Structures&r. Každý má v kapitole svou větev."
	]
	quest.07B07EC4FD29A63B.title: "Nether a End"
	quest.07B497A2C6975754.quest_desc: [
		"Kamenná tabulka (&eCave Tablet&r) je zápis o jednom jeskynním biomu."
		"Najdeš ji v truhlách podzemních chatek a v ruinách uvnitř jeskynních biomů."
		"Sama ti cestu neukáže. Musíš ji přeložit na stole (&eSpelunkery Table&r)."
	]
	quest.07B497A2C6975754.title: "Kamenná tabulka"
	quest.07C44DC816E29C9E.quest_desc: [
		"Teď už nemusíš hledat naslepo. Hledač žil řekne jen druh rudy, přesné údaje zjistíš vzorkovacím vrtákem (&eSample Drill&r)."
		""
		"Polož ho na žílu a navrch dej měděnou tlakovou láhev (&eCopper Backtank&r) se vzduchem. Klikni na vrták a počkej. Pak na něj klikni atlasem žil (&eOre Vein Atlas&r)."
		""
		"Atlas si žílu zapamatuje a ukáže její polohu a velikost. Nekonečná žíla má značku ∞. Podle atlasu můžeš nastavit, co bude hledač hledat."
	]
	quest.07C44DC816E29C9E.title: "Průzkum žíly"
	quest.07CFDBE5FE338F70.quest_desc: [
		"Upgrade na ukládání (&eDeposit Upgrade&r) vysype věci z batohu do truhly."
		"Podrž Shift a klikni batohem pravým tlačítkem na truhlu. Ve filtru nastavíš, co se má vysypat."
		"Opačně funguje &eRestock Upgrade&r – ten si věci z truhly vezme."
	]
	quest.07CFDBE5FE338F70.title: "Vysypání do truhly"
	quest.07DA2662E05632A0.quest_desc: [
		"Postav první létající stroj – horkovzdušný balón:"
		"1. Postav plošinu a na ni fyzikální sestavovač a hořák."
		"2. Nad hořák postav z obalů balón. Hořák ho plní zespodu a horký vzduch se drží nahoře."
		"3. Vše slep lepidlem a sestav stroj pákou na sestavovači."
		"4. Dej hořáku redstonový signál, třeba pákou na plošině. Balón se nafoukne a stroj vzlétne."
		"{@pagebreak}"
		"&aČím výš letíš, tím je vztlak slabší. Stroj se ustálí ve výšce, kde se vztlak a váha vyrovnají. Silnějším signálem vystoupáš, slabším klesneš.&r"
		"&cBalón sám neumí letět dopředu. Na to potřebuješ vrtule.&r"
	]
	quest.07DA2662E05632A0.quest_subtitle: "Pokročilý"
	quest.07DA2662E05632A0.title: "Poprvé ve vzduchu"
	quest.07DBD3984A2C7CC1.quest_desc: [
		"Kotel (&eBrewing Cauldron&r) spojí několik nápojů do jedné lahve (&eFlask&r)."
		"Jako katalyzátor potřebuje bylinný výluh (&eHerbal Infusion&r). Ten vyrobíš ze sušeného zeleného, černého a oolong čaje."
	]
	quest.07DBD3984A2C7CC1.quest_subtitle: "Pokročilý"
	quest.07DBD3984A2C7CC1.title: "Bylinný kotel"
	quest.07E66A2F6B66C6DE.quest_desc: [
		"Kbelík vyrobíš ze 3 železných ingotů. Naber do něj vodu."
		"Voda uhasí oheň a zastaví lávu. Když vodu vyleješ pod sebe při pádu, nic se ti nestane."
		"Láva + voda = obsidián. Ten budeš brzy potřebovat."
	]
	quest.07E66A2F6B66C6DE.title: "Kbelík vody"
	quest.07EB4C85AB05F9E7.quest_desc: [
		"Střepy relikvie (&eRelic Scrap&r) padají z bloků fosilií."
		"V analyzátoru z nich dostaneš kamennou desku, figurky, rozbité zbraně nebo úlomky keramiky."
		"Slouží i jako palivo do archeologova stolu."
	]
	quest.07EB4C85AB05F9E7.title: "Střepy relikvie"
	quest.07F9BA4179BC2A64.quest_desc: [
		"Vrtací ložisko (&eBorehead Bearing&r) s kotouči (&eRock Cutting Wheel&r) je razicí štít. Kotouče těží bloky všude kolem sebe."
		"Kotouče se přichytí samy. Na stroji musí být i úložiště, třeba truhla – vytěžené bloky padají do něj. Když se zaplní, těžba se zastaví."
		"Ložisko se točí 4× pomaleji než vstupní rotace. Čím víc bloků těží najednou, tím je pomalejší – pomůže víc ložisek."
	]
	quest.07F9BA4179BC2A64.title: "Razicí štít"
	quest.08115C7028F2DE4B.quest_desc: [
		"Teď tě čeká první velký poklad. Města v Endu (&eEnd City&r) jsou vysoké purpurové věže s truhlami plnými diamantové a železné výbavy."
		"Hlídají je shulkeři – schovávají se ve schránkách a střílí střely, po kterých levituješ."
		"U některých měst kotví loď. Na ní visí krovky."
	]
	quest.08115C7028F2DE4B.quest_subtitle: "Pokročilý"
	quest.08115C7028F2DE4B.title: "Město v Endu"
	quest.081C745CB2712188.quest_desc: [
		"Upgrade &eInception Upgrade&r dovolí dát batoh do jiného batohu."
		"Potřebuješ hvězdu z Netheru, diamanty a ender oči."
	]
	quest.081C745CB2712188.title: "Batoh v batohu"
	quest.0834CBF4ADB3BB94.quest_desc: [
		"Pánev (&eSkillet&r) je přenosný sporák a zároveň dobrá zbraň."
		"Drž pánev v hlavní ruce a syrové jídlo v druhé ruce. Stoupni si k ohni nebo sporáku a drž pravé tlačítko."
		"&aTip:&r Se Shiftem pánev položíš jako blok. Na sporáku pak smaží jako táborák."
	]
	quest.0834CBF4ADB3BB94.title: "Pánev"
	quest.084E09719ACB63BD.quest_desc: [
		"Korbely (&eTankard&r) vyrobíš z prken a železných nugetů."
		"Pivo (&eBeer&r) vykvasíš z vody, pšenice, semínek pšenice a hnědé houby."
		"&cPozor:&r Alkohol dává efekt &eTipsy&r – obraz se houpe. Nepij ho před bojem."
	]
	quest.084E09719ACB63BD.title: "Pivo"
	quest.084E7F48FADDED14.quest_desc: [
		"&bFowl Play&r přidává ptáky: holuby, vrabce, kardinály, racky, tučňáky, jestřáby a další."
		"Strašák (&eScarecrow&r) ze 2 balíků slámy a 3 tyček ptáky odežene od tvého pole."
		"&aTip:&r Ptáci se bojí hráčů a jestřábů. Holuba můžeš ochočit."
	]
	quest.084E7F48FADDED14.title: "Strašák"
	quest.086EA0845D4864E3.quest_desc: [
		"Třešně (&eCherry&r) padají z listí třešní z Vinery. Ty rostou na pláních a loukách."
		"Třešňové víno (&eCherry Wine&r) je z červené šťávy a třešní. Dává neviditelnost."
	]
	quest.086EA0845D4864E3.title: "Třešňové víno"
	quest.08715D47AE4FAD9B.quest_desc: [
		"Dřevěným kbelíkem (&eWooden Bucket&r) podojíš krávy, ovce, kozy i vodní buvoly. Každé zvíře dá jiné mléko."
		"Vodní buvoli (&eWater Buffalo&r) žijí v savaně, u řek a v bažinách."
	]
	quest.08715D47AE4FAD9B.title: "Mléko z buvola"
	quest.08715D9FBB5F858D.quest_desc: [
		"&eTI-69&r ukáže kyslík, teplotu a gravitaci tam, kde stojíš."
		"Hodí se, když nevíš, jestli je někde bezpečno."
	]
	quest.08715D9FBB5F858D.title: "Kapesní měřák"
	quest.087C57D4FF8D745D.quest_desc: [
		"Uran (&eUranium Ore&r) je surovina pro jaderné palivo. Uran v rudě není tolik radioaktivní, aby ti ublížil."
		"Vytěžený uran (&eRaw Uranium&r) zpracuj na ingoty jako ostatní kovy."
		"&cPozor:&r Radioaktivní je jaderný odpad z reaktoru a látky z něj (polonium, plutonium). Nikdy je nevypouštěj ven."
	]
	quest.087C57D4FF8D745D.title: "Uran"
	quest.08872A8CC4E76912.quest_desc: [
		"Naftový motor (&eDiesel Engine&r) z modu &bCreate: Diesel Generators&r pálí kapalné palivo a dává silnou rotaci z jednoho bloku."
		""
		"Palivo do něj přiveď potrubím, kbelíkem ho nenaplníš. Rotace jde ven hřídelí. Redstonový signál motor zastaví."
		""
		"Na začátek stačí rostlinný olej nebo etanol. Víc najdeš v kapitole Ropa a palivo."
	]
	quest.08872A8CC4E76912.quest_subtitle: "Create: Diesel Generators"
	quest.08872A8CC4E76912.title: "Naftový motor"
	quest.08CF0C24381BE472.quest_desc: [
		"Vírník (&eGyrodyne&r) je vrtulník na lidský pohon. Nemá motor a nepotřebuje palivo – roztáčíš ho vlastní silou a ubírá ti jídlo."
		"Po nasednutí rotor roztlač. Na obrazovce uvidíš, kolik síly ještě chybí. Pak můžeš vzlétnout."
		"Výroba: 2 plachty, 2 trupy a vrtule."
	]
	quest.08CF0C24381BE472.title: "Vírník"
	quest.08D3FC2382DE7B16.quest_desc: [
		"Vnější ostrovy jsou velké a roste na nich chorus (&eChorus Plant&r). Biom &eEnd Highlands&r tvoří vysoké ostrovy. Stojí na nich města a prastaré věže."
		"Ovoce chorusu tě po snědení náhodně teleportuje. Upečené ovoce (&ePopped Chorus Fruit&r) je surovina na purpurové bloky."
	]
	quest.08D3FC2382DE7B16.title: "Vnější ostrovy"
	quest.09337300E7F07FE4.quest_desc: [
		"&bCreate: More Features&r umí vyrobit střelný prach bez creeperů."
		""
		"Ledek (&eSaltpeter&r) a síru (&eSulfur&r) získáš, když mlýnským kamenem (&eMillstone&r) meleš netherrack. Ledek dává i vápenec (&eLimestone&r), ale ten musíš rozdrtit drtícími koly (&eCrushing Wheel&r) – mlýnský kámen z vápence dělá něco jiného."
		""
		"Uhelný kolík (&eCoal Pin&r) vznikne, když drtícími koly drtíš uhlí. Ze 2 ledků, 1 síry a 1 kolíku vyrobíš 2 střelné prachy."
	]
	quest.09337300E7F07FE4.title: "Domácí střelný prach"
	quest.0944D09352C7F08C.quest_desc: [
		"Tekuté palivo si můžeš vypěstovat. Začíná se biomasou (&eBiomass&r)."
		""
		"Nejdřív lisuj semínka: mechanický lis nad tyglíkem (&eBasin&r) z jednoho semínka vymačká 100 mB oleje. Vznikne rostlinný olej (&ePlant Oil&r)."
		""
		"Pak v zahřáté míchačce smíchej 100 mB oleje s plodinami, listím, sazenicemi nebo květinami."
		""
		"&aZ biomasy uděláš lisem nad tyglíkem i pelety (&eBiomass Pellet&r). Jedna peleta hoří v peci jako 4 uhlí.&r"
	]
	quest.0944D09352C7F08C.title: "Biomasa"
	quest.0956CBD9DAEFE28F.quest_desc: [
		"&eŘetězový dopravník&r (&eChain Conveyor&r): velké ozubené kolečko a 4 andezitová pouzdra dají 2 kusy. Klikni řetězem na dva dopravníky a spojí se."
		"Přenáší rotaci a vozí balíčky. Spojení měří až 32 bloků, jeden dopravník má nejvýš 4 spojení."
		"S montážním klíčem v ruce se po řetězu můžeš svézt."
	]
	quest.0956CBD9DAEFE28F.title: "Řetězový dopravník"
	quest.096DF98B301100C4.quest_desc: [
		"Síťový nástroj (&eNetwork Tool&r) ukáže, kolik kanálů a energie síť používá a co v ní je."
		"Má v sobě i malý inventář na karty vylepšení."
		"&aTip:&r Stejné údaje uvidíš, když klikneš pravým tlačítkem na ovladač."
	]
	quest.096DF98B301100C4.title: "Síťový nástroj"
	quest.0989213F05520F08.quest_desc: [
		"Přenosné energetické rozhraní (&ePortable Energy Interface&r) dobíjí akumulátory na pohyblivé konstrukci (kontrapci), třeba na vlaku."
		""
		"Jedno rozhraní dej na konstrukci, druhé na pevné místo. Mezi nimi musí být mezera 1 nebo 2 bloky. Když konstrukce projede kolem, rozhraní se spojí a energie přeteče podle nastavení konektoru."
		""
		"&aRedstonový signál na pevném rozhraní spojení zakáže.&r"
	]
	quest.0989213F05520F08.title: "Energie pro stroje v pohybu"
	quest.09B7476C05882565.quest_desc: [
		"Batoh (&eBackpack&r) z modu &bSophisticated Backpacks&r je přenosná truhla. Vyrobíš ho z kůže, provázku a truhly."
		"Otevřeš ho klávesou &eB&r, i když je jen v inventáři. Můžeš ho nosit i ve slotu na záda."
		"Když podržíš Shift a klikneš s ním pravým tlačítkem na zem, položíš ho jako blok."
		"Vylepšené batohy a upgrady najdeš v kapitole &eBatohy a truhly&r."
	]
	quest.09B7476C05882565.title: "Batoh"
	quest.09CD40399DEDAC07.quest_desc: [
		"Cihelna (&eBrick yard&r) vypaluje v peci kamenné bloky (třeba hladký kámen) a dělá dřevěné uhlí pro ostatní řemeslníky."
		"Výzkum &eThe Flintstones&r stojí 64 cihel a potřebuje kameníka úrovně 1. Blok budovy: prkna, pec, kamenné cihly a nástroj stavby."
	]
	quest.09CD40399DEDAC07.title: "Cihelna"
	quest.09CF090107880D7A.quest_desc: [
		"Obří aligátor (&eVile Gator&r) žije v bažinách a v mangrovech. Objevuje se v noci."
		"&cKouše jedem a vyhazuje tě do vzduchu.&r Jeho trofej se jmenuje &eToxic Gator Trophy&r."
	]
	quest.09CF090107880D7A.title: "Zlý aligátor"
	quest.09F9F20A7E95E771.quest_desc: [
		"Pec (&eThe Furnace&r) je živá a plná ohně. Žije v &eNetherové pustině&r a přivolává ohnivé pomocníky (&eEmber&r)."
		"&cBez ohnivzdorného lektvaru nechoď.&r Může z ní padnout &eMolten Coal&r."
	]
	quest.09F9F20A7E95E771.title: "Živá pec"
	quest.09FC33824A470023.quest_desc: [
		"&eMechanický pás&r (&eMechanical Belt&r) vyrobíš ze 6 sušených chaluh. Klikni pásem na dvě hřídele a spojí se."
		"Pás vozí předměty i hráče. Hřídele spojené pásem se točí stejně rychle a stejným směrem, pás tedy přenáší i rotaci."
		"Pás může vést vodorovně, šikmo nebo svisle a měřit 2 až 20 bloků. Prázdnou rukou z něj předmět sebereš."
	]
	quest.09FC33824A470023.title: "Mechanický pás"
	quest.09FE5020E6E0C0A8.quest_desc: [
		"Háj plný sakur (třešní) s růžovým listím. Roste tu i bambus, břízy a cukrová třtina."
		"&aTip:&r Třešňové dřevo má krásnou růžovou barvu. Hodí se na stavby."
	]
	quest.09FE5020E6E0C0A8.title: "Sakurový háj"
	quest.0A0A4B1BA3463AA0.quest_desc: [
		"Jaderný reaktor z New Age dává obrovské množství tepla pro parní kotle."
		""
		"Reaktorový plášť (&eReactor Casing&r) se vyrábí sekvenční montáží z cihel: energizér, pokladač přidá železný plát, lis. Reaktorovou tyč (&eReactor Rod&r) sestavíš v mechanickém výrobníku z pláště, skla, zlatých plátů a jaderného paliva."
		""
		"&cReaktor je nebezpečný. Než ho spustíš, projdi kapitolu Elektřina.&r"
	]
	quest.0A0A4B1BA3463AA0.quest_subtitle: "Expert"
	quest.0A0A4B1BA3463AA0.title: "Jádro!"
	quest.0A25AEF4AB00B742.quest_desc: [
		"Úkol: otevři 50 nádob s kořistí."
		"Nejvíc truhel najdeš v dungeonech, dolech, pevnostech a chrámech. Hledej je ve skupině &bPrůzkum a dimenze&r."
	]
	quest.0A25AEF4AB00B742.quest_subtitle: "Pokročilý"
	quest.0A25AEF4AB00B742.title: "Lovec pokladů"
	quest.0A2AB0FB7111C443.quest_desc: [
		"Dělo potřebuje střelu a za ní prachové nálože. Víc náloží = delší dostřel, ale dělo jich vydrží jen omezeně."
		""
		"Plná střela (&eSolid Shot&r) je ze železných ingotů, nugetů a dřevěné desky."
		""
		"Nálož (&ePowder Charge&r) vznikne z prázdného pytlíku (&eEmpty Powder Charge&r) a lisovaného prachu (&ePacked Gunpowder&r). Pytlík je z vlny a dvou provázků. Lis nad tyglíkem slisuje 3 střelné prachy na lisovaný prach."
		""
		"&aVíc najdeš v kapitole Velká děla.&r"
	]
	quest.0A2AB0FB7111C443.title: "Střely a nálože"
	quest.0A2C744C5F982D43.quest_desc: [
		"Farmářský chléb (&eFarmer's Bread&r) upečeš v kamnech z těsta a kbelíku vody."
		"Hotový chléb jde položit na stůl jako blok – hezky vypadá v kuchyni."
	]
	quest.0A2C744C5F982D43.title: "Farmářský chléb"
	quest.0A414D66DA9DA4EC.quest_desc: [
		"Hmoždíř (&eMortar&r) vyrobíš ze 3 kamenů a paličku (&eStone Pestle&r) z kamene a klacku."
		"Vlož do hmoždíře surovinu a pak na něj opakovaně klikej paličkou. Drtí koření, kakao, barviva i mouku."
	]
	quest.0A414D66DA9DA4EC.title: "Hmoždíř"
	quest.0A4CF069574A7B26.quest_desc: [
		"Deska (&eClipboard&r) ukáže všechny požadavky všech občanů najednou."
		"Vyrobíš ji z tyček, kůže a nástroje stavby. Propojíš ji Shift + pravým tlačítkem na radnici."
		"&aTip:&r když kolonie stojí, mrkni na desku. Skoro vždycky někdo na něco čeká."
	]
	quest.0A4CF069574A7B26.title: "Deska s požadavky"
	quest.0A5761874E69DE1F.quest_desc: [
		"&eVelké mlýnské kolo&r (&eLarge Water Wheel&r): mlýnské kolo uprostřed a kolem něj 8 prken."
		"Točí se jen 4 RPM, ale dá 512 SU, tedy dvakrát víc než malé kolo. I tady stačí tekoucí voda na jedné straně."
		"&cZdroje na jedné síti se musí točit stejným směrem.&r Když se dva zdroje „perou“, díl mezi nimi se rozbije. Brýle ukážou, jestli všechny pomáhají."
	]
	quest.0A5761874E69DE1F.title: "Velké mlýnské kolo"
	quest.0A85DEB6F51EB76C.quest_desc: [
		"Boombox (&eBoombox&r) je přenosný jukebox. Hraje, i když ho neseš."
		"Vyrobíš ho z mědi, redstonu a jukeboxu."
	]
	quest.0A85DEB6F51EB76C.title: "Boombox"
	quest.0A8FE198AA1FCAA5.quest_desc: [
		"Žížaly (&eEarthworms&r) občas vypadnou, když kopeš hlínu nebo trávu (ne u vody). Larvy (&eGrubs&r) najdeš v písku. Pijavice (&eLeeches&r) najdeš v písku nebo bahně u vody na plážích a u řek."
		"Jsou to návnady na ryby z &bFish of Thieves&r."
	]
	quest.0A8FE198AA1FCAA5.title: "Žížaly"
	quest.0A9503D4A5B14983.quest_desc: [
		"&eDisplejový vysílač&r (&eDisplay Link&r) ukazuje živé informace: obsah truhly, stres sítě, stav kotle a další."
		"S vysílačem v ruce nejdřív klikni na cíl (cedule, displejová tabule, znaková výbojka). Pak ho polož na blok, ze kterého má číst. V okně vyber, co ukazovat."
	]
	quest.0A9503D4A5B14983.title: "Displejový vysílač"
	quest.0A98B9CD13C2954E.quest_desc: [
		"Antiprotonový nukleosyntetizátor (&eAntiprotonic Nucleosynthesizer&r) přeměňuje předměty pomocí antihmoty a hodně energie."
		"Například: uhlí → diamant, diamant → smaragd, cínový ingot → železný ingot, obsidián → plačící obsidián."
		"&aTip:&r Všechny přeměny ukáže JEI."
	]
	quest.0A98B9CD13C2954E.title: "Přeměna hmoty"
	quest.0AA521255311EC43.quest_desc: [
		"Postav varný stojan (&eBrewing Stand&r) z ohnivé tyče a 3 dlažebních kostek. Jako palivo do něj dej ohnivý prach."
		"Lahev vody + pekelná bradavice = základní lektvar (&eAwkward Potion&r). Ten + magmový krém (&eMagma Cream&r) = lektvar ohnivzdornosti."
		"S ohnivzdorností ti oheň ani láva neublíží. Magmový krém padá z magmových kostek v Netheru."
	]
	quest.0AA521255311EC43.title: "Vař lektvary"
	quest.0AD57DCC064682AA.quest_desc: [
		"Káď na hrozny (&eGrapevine Pot&r) vyrobíš z prken a dřevěných desek."
		"Pravým tlačítkem do ní dej 6 hroznů stejného druhu. Pak na ní skákej – hrozny rozšlapeš. V těžkém brnění to jde rychleji."
		"Hotovou šťávu (&eRed Grapejuice&r) nabereš prázdnou vinnou lahví."
	]
	quest.0AD57DCC064682AA.title: "Šlapání hroznů"
	quest.0AD8171FB7A23F2C.quest_desc: [
		"Sedačka (&eSeat&r) je místo pro cestující. Na jedoucím vlaku na ní můžeš sedět ty, kamarád i zvíře."
		"Sedačka přímo před ovládáním je místo strojvůdce. Usaď tam zvíře nebo vesničana a vlak bude moct jezdit sám."
		"&aZvíře na vodítku usadíš snadno: klikni s ním na sedačku. Výroba: vlna a dřevěná deska.&r"
	]
	quest.0AD8171FB7A23F2C.title: "Sedačky"
	quest.0AE805B7023BEC43.quest_desc: [
		"Čepice zálesáka (&eFrontiersman's Cap&r) tě zrychlí, když se plížíš."
		"Vyrob ji z 5 kusů medvědí srsti, &eKožené čapky&r a mývalího ocasu."
	]
	quest.0AE805B7023BEC43.title: "Čepice zálesáka"
	quest.0AF4D762993A34E5.quest_desc: [
		"Vlaková kolej (&eTrain Track&r) je kolej jen pro vlaky z Create. Obyčejné koleje pro vozíky nestačí."
		"Vyrábí se sekvenční montáží: na kamennou desku přidají pokladače dva nugety (železné nebo zinkové) a lis ji stiskne. Funguje i hladká kamenná nebo andezitová deska."
		"Pokládání: klikni kolejí na položenou kolej a pak na místo, kam má vést. Položí se celý úsek, i se zatáčkou nebo svahem. Když při tom držíš klávesu sprintu, vznikne co nejdelší oblouk."
		"&aKdyž držíš ve druhé ruce bloky, položí se pod koleje jako násyp.&r"
	]
	quest.0AF4D762993A34E5.title: "Polož koleje"
	quest.0AF5A8C96AA58998.quest_desc: [
		"Semínka zelí (&eCabbage Seeds&r) a rajčat (&eTomato Seeds&r) zasaď na pole zorané motykou. Cibuli zasadíš celou, jako mrkev."
		"Semínka padají z divokých plodin. Zelí a rajčata je dávají i při běžné sklizni."
		"&aTip:&r Zelí nakrájené nožem na prkénku dá dva listy (&eCabbage Leaf&r)."
	]
	quest.0AF5A8C96AA58998.title: "Vlastní záhon"
	quest.0B160C9C324C8643.quest_desc: [
		"Polož kolej až těsně k netherskému portálu. Na druhé straně se sama vytvoří navazující kolej a vlak pak projede do druhé dimenze."
		"&aV Netheru je každá vzdálenost 8× kratší. Trať přes Nether je nejrychlejší cesta na velkou dálku.&r"
	]
	quest.0B160C9C324C8643.title: "Vlakem do Netheru"
	quest.0B1ABC78B4910DB6.quest_desc: [
		"Trouba (&eOven&r) potřebuje teplo zespodu, stejně jako hrnec z Farmer's Delight."
		"Vejce v košíčku (&eEgg in a Basket&r) upeč na plechu z vejce a krajíce chleba (&eSlice of Bread&r)."
	]
	quest.0B1ABC78B4910DB6.title: "První pečení"
	quest.0B350F67A1EF82EF.quest_desc: [
		"Kráječ (&eSlicer&r) z modu &bSlice \\& Dice&r krájí jídlo místo tebe podle receptů krájecího prkénka."
		""
		"Vyrobíš ho z ozubeného kolečka, andezitového pouzdra a točny (&eTurntable&r). Postav ho nad pás, odkládací desku (&eDepot&r) nebo tyglík (&eBasin&r) a pravým tlačítkem do něj vlož nůž."
		""
		"&aVíc o jídle ze strojů najdeš v kapitole Create: kuchyně.&r"
	]
	quest.0B350F67A1EF82EF.quest_subtitle: "Slice \\& Dice"
	quest.0B350F67A1EF82EF.title: "Kráječ"
	quest.0B39729F1F845482.quest_desc: [
		"Velká výzva: sněz alespoň jednou každé hlavní jídlo z &bFarmer's Delight&r (27 jídel včetně hostin)."
		"Seznam uvidíš v postupu (Advancements) u úspěchu &eMaster Chef&r. Quest se splní sám."
		"&aTip:&r Některá jídla se v tomto packu vaří jinak než v původním modu. Vždy se řiď JEI."
	]
	quest.0B39729F1F845482.title: "Mistr kuchař"
	quest.0B470F01E40566A0.quest_desc: [
		"&bCreate Food&r přidává stovky jídel: dorty, koblihy, zmrzliny, pizzy, hamburgery…"
		"Cukrářský sáček (&eEmpty Piping Bag&r) vyrobíš z měděného nugetu, papíru a provázku. Plní se polevou a zdobí se jím dorty."
	]
	quest.0B470F01E40566A0.title: "Cukrářský sáček"
	quest.0B59FC92DD56421D.quest_desc: [
		"Obleč celý MekaSuit – helmu, hrudní díl, kalhoty a boty – a měj u sebe Meka-Tool."
		"Teď můžeš do obleku přidávat další moduly: jetpack, dýchání pod vodou, noční vidění, magnet a mnoho dalších."
		"&aTip:&r Na plné vybavení všemi moduly je advancement „True Dedication“."
	]
	quest.0B59FC92DD56421D.title: "Celý MekaSuit"
	quest.0B6619432A6F2DAA.quest_desc: [
		"Jaderný reaktor (&eFission Reactor&r) spaluje jaderné palivo a vyrábí obrovské teplo. Tím ohřívá vodu na páru, ze které turbína udělá energii."
		"Stavba: dutý kvádr z pláště (&eFission Reactor Casing&r), ve stěnách smí být sklo (&eReactor Glass&r). Uvnitř postav sloupy palivových článků (&eFission Fuel Assembly&r) a na vrch každého sloupu řídicí tyč (&eControl Rod Assembly&r)."
		"Do stěn dej porty (&eFission Reactor Port&r). Konfigurátorem jim nastavíš režim: vstup, výstup chladiva (pára) nebo výstup odpadu."
		"{@pagebreak}"
		"&cBezpečnost:&r Nad 1200 K se reaktor začne poškozovat. Když poškození dosáhne 100 %, může vybuchnout a zamořit okolí radiací."
		"Proto vždy měj dost vody na chlazení a odváděj páru. Začni s nízkým výkonem (&eRate Limit&r třeba 0,1 mB/t) a v okně sleduj teplotu. Tlačítkem &eSCRAM&r reaktor okamžitě vypneš."
		"&aTip:&r Nejdřív postav turbínu a odvod páry, teprve potom reaktor zapni."
	]
	quest.0B6619432A6F2DAA.quest_subtitle: "Expert"
	quest.0B6619432A6F2DAA.title: "Jaderný reaktor"
	quest.0B791AA9C750974C.quest_desc: [
		"Analyzátor (&eAnalyzer&r) rozebere fosilie, relikvie, zmrzlé maso a další věci."
		"Vyrobíš ho ze železných ingotů, střepů relikvie a fosilie."
		"&aNepotřebuje palivo ani energii. Stačí vložit věci a počkat.&r"
	]
	quest.0B791AA9C750974C.title: "Analyzátor"
	quest.0B7C5FD61AD7DAA6.quest_desc: [
		"Truhly v dungeonech a stavbách jsou z modu &bLootr&r. Každý hráč v nich najde vlastní kořist, takže nikdo nikomu nic nevybere."
		"&bCarry On&r: s prázdnýma rukama podrž Shift a klikni pravým tlačítkem na truhlu nebo zvíře. Zvedneš je i s obsahem."
		"{@pagebreak}"
		"&bPing Wheel&r: boční tlačítko myši (tlačítko 5) ukáže ostatním hráčům značku tam, kam se díváš. Klávesu změníš v nastavení ovládání."
		"Příkazem &e/tpa jméno&r požádáš kamaráda o teleport k němu. Kamarád musí žádost přijmout."
	]
	quest.0B7C5FD61AD7DAA6.title: "Hrajeme spolu"
	quest.0B8681E4F15C2DA9.quest_desc: [
		"Palcát je silná zbraň: čím z větší výšky na nepřítele skočíš, tím silněji udeříš."
		"Vyrobíš ho z těžkého jádra (&eHeavy Core&r) a větrné tyče (&eBreeze Rod&r). Obojí najdeš ve zkušebních komnatách (Trial Chambers)."
	]
	quest.0B8681E4F15C2DA9.title: "Palcát"
	quest.0BDF92643A52CF5E.quest_desc: [
		"Klikni kbelíkem na malého slizouna a máš slizouna v kbelíku (&eBucket of Slime&r)."
		"Začne poskakovat, když jsi ve slizovém chunku – tam se slizouni objevují."
	]
	quest.0BDF92643A52CF5E.title: "Sliz v kbelíku"
	quest.0BEF30D1EB408631.quest_desc: [
		"Akumulátor (&eAccumulator&r) je velká baterie. Bloky polož k sobě a spojí se do jednoho, až 3 × 3 bloky na šířku a 5 bloků na výšku. Každý blok pojme 2 000 000 ⚡."
		""
		"Na akumulátor dej dva konektory. Jeden nastav na vstup, druhý na výstup. Bloky nad a pod akumulátorem dostávají energii samy."
		""
		"&aVyrobíš ho z mosazného pouzdra, 2 kondenzátorů, měděné tyče a elektrového drátu (&eElectrum Wire&r). Víc najdeš v kapitole Elektřina.&r"
	]
	quest.0BEF30D1EB408631.title: "Ulož si energii"
	quest.0BF5C06D7849A3D8.quest_desc: [
		"Teď už nemusíš nabíjet přes ústí. Posuvný závěr (&eCast Iron Sliding Breech&r) se dává místo uzávěru a dělo nabíjíš zezadu."
		""
		"Odlij ho ve formě &eSliding Breech Cast Mould&r a vyvrtej. Pak do něj klikni klínem (&eCast Iron Sliding Breechblock&r). Teprve pak je hotový."
		""
		"Závěr otevřeš a zavřeš rotací. Do otevřeného závěru vlož náboje."
		""
		"&cPosuvný závěr vydrží jen omezený počet náloží: litinový 2, bronzový a ocelový 4. Ocelové dělo samo vydrží 8, s posuvným závěrem jen 4.&r"
	]
	quest.0BF5C06D7849A3D8.title: "Posuvný závěr"
	quest.0C0729A1A2624611.quest_desc: [
		"Perníkové těsto (&eGingerdough&r) namícháš z cukru, pšeničné mouky, škvárové mouky (&eCinder Flour&r) a medu."
		"Škvárová mouka je rozemletý netherrack. Lis z těsta vylisuje perníčka (&eGingerbread Man&r)."
	]
	quest.0C0729A1A2624611.title: "Perníček"
	quest.0C09E84EBF810AE8.quest_desc: ["Zlatá truhla (&eGold Chest&r) má 81 slotů. Železnou truhlu obklop 8 zlatými ingoty."]
	quest.0C09E84EBF810AE8.quest_subtitle: "Pokročilý"
	quest.0C09E84EBF810AE8.title: "Zlatá truhla"
	quest.0C445377FFA4B65F.quest_desc: [
		"Počítač (&eComputer&r) vyrobíš na dílenském stole. Potřebuje elektřinu."
		"Aplikace &eSmart Home&r zapne a vypne všechny spotřebiče ve stejné síti. Přejmenuj je na kovadlině, ať je poznáš."
		"Hra &ePaddle Ball&r se hraje proti počítači nebo proti jinému hráči na serveru."
	]
	quest.0C445377FFA4B65F.quest_subtitle: "Expert"
	quest.0C445377FFA4B65F.title: "Počítač"
	quest.0C4AC8C27334F441.quest_desc: [
		"Kanón (&eCannon&r) umí vystřelit skoro cokoliv. Klikni na něj a v jeho okně ho nabiješ."
		"Vyrobíš ho ze železných ingotů, prken a dávkovače."
	]
	quest.0C4AC8C27334F441.quest_subtitle: "Pokročilý"
	quest.0C4AC8C27334F441.title: "Kanón"
	quest.0C5863B302330B78.quest_desc: [
		"&eDvířka na předměty&r (&eItem Hatch&r): slitina + železný poklop. Polož je na trezor nebo truhlu."
		"Pravým klikem vložíš předmět z ruky do kontejneru. Shift + pravé tlačítko vloží vše kromě hotbaru."
	]
	quest.0C5863B302330B78.title: "Dvířka na předměty"
	quest.0C5B481E58571E10.quest_desc: [
		"&bCreate: Teleporters&r přidává teleporty pro hráče, předměty i bloky. Všechny potřebují redstonovou perlu (&eRedstone Pearl&r)."
		""
		"Perlu vyrobíš v mechanické míchačce nad zapáleným ohňohořákem (&eBlaze Burner&r): enderová perla a růženín (&eRose Quartz&r)."
		""
		"&aPerel budeš potřebovat hodně – do teleportérů, odkazů i portálů.&r"
	]
	quest.0C5B481E58571E10.quest_subtitle: "Začátečník"
	quest.0C5B481E58571E10.title: "Redstonová perla"
	quest.0C8AD702E64D0F5C.quest_desc: [
		"&bTwilight's Flavor \\& Delight&r přidává jídla z dimenze Twilight Forest: z jelenů, hydry, ghastů i z rostlin."
		"Pochodňové bobule (&eTorchberries&r) rostou v Twilight Forestu. Bobule mezi dvěma pšenicemi dá 8 sušenek (&eTorchberry Cookie&r)."
	]
	quest.0C8AD702E64D0F5C.title: "Sušenky z pochodňovníku"
	quest.0CB19429D18F7274.quest_desc: [
		"Ozdoby brnění (trims) dáš na brnění na kovářském stole: šablona ozdoby + kus brnění + materiál (třeba zlato, smaragd nebo měď)."
		"Šablony najdeš v truhlách různých staveb. Každá stavba má jiný vzor. Kopii šablony vyrobíš z 7 diamantů – recept ukáže JEI."
		"{@pagebreak}"
		"Mod &bTrimsEffects&r dává ozdobám efekty. Když máš stejný vzor na 3 kusech brnění, dostaneš efekt I. Na všech 4 kusech efekt II."
		"Například: Sentry = odolnost, Dune = rychlost, Coast = dýchání pod vodou, Eye = regenerace, Spire = síla, Snout = odolnost vůči ohni, Rib = spěch, Flow = skok."
		"&cPozor:&r efekty dostanou i příšery, které mají ozdobené brnění."
	]
	quest.0CB19429D18F7274.title: "Ozdoba s efektem"
	quest.0CD0E9F38624059C.quest_desc: [
		"&bCreate Deco&r: průmyslové dekorace – lampy, lávky, mříže a plechy."
		"Hlavní materiál je průmyslové železo (&eIndustrial Iron Ingot&r). Blok průmyslového železa (&eBlock of Industrial Iron&r) vyrobíš ze železného ingotu na řezačce kamene. Blok pak na pracovním stole rozložíš na 9 ingotů."
	]
	quest.0CD0E9F38624059C.title: "Create Deco"
	quest.0CE0A9C0706E91B5.quest_desc: [
		"Teď už nejde jen o suroviny – čekají tě dungeony. První je bronzový. Je schovaný uvnitř ostrovů a je postavený z vytesaného kamene (&eCarved Stone&r)."
		"Uvnitř jsou strážci (&eSentry&r) a truhly, které můžou být mimikové (&eChest Mimic&r) – ožijí a zaútočí."
	]
	quest.0CE0A9C0706E91B5.quest_subtitle: "Pokročilý"
	quest.0CE0A9C0706E91B5.title: "Bronzový dungeon"
	quest.0CFD5A588BD8DA42.quest_desc: [
		"Aether má sloty na doplňky: prsteny, přívěsky, rukavice a pláště. Otevřeš je tlačítkem v inventáři."
		"Zanitový prsten (&eZanite Ring&r) zrychlí těžbu, ale brzy se opotřebí."
		"&aTip:&r železný nebo zlatý prsten zmraz v mrazáku. Vznikne ledový prsten, se kterým zmrazíš vodu a lávu, po které jdeš."
	]
	quest.0CFD5A588BD8DA42.title: "Doplňky"
	quest.0D35853BB456C50C.quest_desc: [
		"S bičem (&eWhip&r) v ruce klikni na svého dospělého dinosaura a nasedneš na něj. Jde to jen u druhů, na kterých se dá jezdit."
		"&aNěkteré neochočené druhy jde bičem i ochočit.&r"
	]
	quest.0D35853BB456C50C.title: "Bič"
	quest.0D3C1234B02CF01B.quest_desc: [
		"Ekologický motor (&eEco Engine&r): spotřeba paliva −75 %, ale výkon motoru −20 %. Ideální na dlouhé lety."
		"Výroba: motor, zlaté ingoty, slizové koule a cihly."
	]
	quest.0D3C1234B02CF01B.title: "Ekologický motor"
	quest.0D5A06D9E10AD946.quest_desc: [
		"Teď přichází nejtěžší výzva komnat. Když vstoupíš se &eZlověstným znamením&r, líhně klání zesílí."
		"&eZlověstné znamení&r dostaneš vypitím &eZlověstné lahvičky&r. Ta padá z kapitána nájezdníků (nese prapor)."
		"Silné líhně dávají &eZlověstný klíč klání&r. Ten otevře zlověstnou pokladnici – jen v ní je &eTěžké jádro&r na Palcát."
	]
	quest.0D5A06D9E10AD946.quest_subtitle: "Expert"
	quest.0D5A06D9E10AD946.title: "Zlověstná pokladnice"
	quest.0D5F99EF889EBD90.quest_desc: [
		"S hotovým &eschématem&r (&eSchematic&r) v ruce uvidíš hologram stavby. Nástroji na obrazovce ho posuneš a otočíš."
		"Shift + pravé tlačítko otevře okno pro přesné souřadnice."
	]
	quest.0D5F99EF889EBD90.title: "Hologram stavby"
	quest.0D6109681D267D10.quest_desc: [
		"Míchačka rozdělí mléko na smetanu (&eHeavy Cream&r) a odtučněné mléko. Z kbelíku mléka je čtvrtina smetany."
		"Smetanu potřebuješ na polevu a z ní se dělá i máslo (smetana a sůl)."
	]
	quest.0D6109681D267D10.title: "Smetana"
	quest.0D9989530751181E.quest_desc: [
		"Obří duté stromy (&eHollow Tree&r) rostou v lesích Soumračného lesa. Uvnitř je truhla, kterou hlídají pavouci."
		"V truhle dutého stromu mohou být sazenice kouzelných stromů. Jinde je nenajdeš."
	]
	quest.0D9989530751181E.title: "Dutý strom"
	quest.0DD8CE3E9C0975C8.quest_desc: [
		"Magnetické víno (&eMagnetic Wine&r) je z červené džunglové šťávy a železného ingotu."
		"Dává efekt &eMagnet&r: předměty kolem tebe se k tobě samy přitahují."
	]
	quest.0DD8CE3E9C0975C8.title: "Magnetické víno"
	quest.0E13FAA3AE690562.quest_desc: [
		"&bCreate Big Cannons&r přidává obří děla, která se staví z bloků."
		""
		"Lafeta (&eCannon Mount&r) drží dělo, míří s ním a odpaluje ho. Vyrobíš ji ze železných plátů, hřídelí, andezitového pouzdra a střelného prachu."
		""
		"&aVíc najdeš v kapitole Velká děla.&r"
	]
	quest.0E13FAA3AE690562.quest_subtitle: "Create Big Cannons"
	quest.0E13FAA3AE690562.title: "Lafeta děla"
	quest.0E262795BB9E0E45.quest_desc: [
		"Teď už nábytek nejen stojí, ale i pracuje. Elektrické věci z &bRefurbished Furniture&r potřebují proud – i dílenský stůl."
		"Generátor (&eLight Electricity Generator&r) vyrobíš ze železných ingotů, redstonového bloku a vysoké pece. Pálí palivo jako pec, třeba uhlí."
		"Klíčem (&eWrench&r) klikni na generátor a potom na spotřebič – vznikne kabel. Tak propojíš dílenský stůl, světla i kuchyň."
	]
	quest.0E262795BB9E0E45.quest_subtitle: "Pokročilý"
	quest.0E262795BB9E0E45.title: "Elektřina"
	quest.0E371882C5EDFDBB.quest_desc: [
		"Doteď měla jedna imitace jeden materiál. Teď se naučíš skládat do jednoho bloku víc materiálů."
		""
		"Imitační miniblok (&eCopycat Byte&r) je osmina bloku. Z jednoho zinkového ingotu jich kameník udělá 8."
		""
		"Do jednoho bloku položíš až 8 minibloků a každý může mít jiný materiál. Tak postavíš třeba šachovnici nebo malé sochy."
		"{@pagebreak}"
		"Stejně fungují i imitační půlblok (&eCopycat Slab&r), deska (&eCopycat Board&r) a polovrstva (&eCopycat Half Layer&r)."
		""
		"Když budeš při plnění držet &eLevý Alt&r, materiál se dá do všech částí bloku najednou."
		""
		"&aTip: U vrstev a řezů klikni stejnou imitací znovu na položený blok. Imitace se tím zvětší.&r"
	]
	quest.0E371882C5EDFDBB.quest_subtitle: "Pokročilý"
	quest.0E371882C5EDFDBB.title: "Víc materiálů v jednom"
	quest.0E4D9C0EE8AC9173.quest_desc: [
		"Nádrž (&eTank Upgrade&r) změní část batohu na zásobník tekutin, třeba vody nebo lávy."
		"Vyrobíš ji z 8 skleněných bloků a základu upgradu."
	]
	quest.0E4D9C0EE8AC9173.title: "Nádrž"
	quest.0E81085B01C431D0.quest_desc: [
		"Vylepšení (&eAircraft Upgrade&r) vkládáš do slotů pro vylepšení v inventáři letadla. Každé letadlo jich má jiný počet."
		"Vylepšená vrtule (&eEnhanced Propeller&r): motor +5 %, odpor vzduchu −75 %. Výroba: vrtule a měděné ingoty."
		"&aPřesné hodnoty každého vylepšení ukáže jeho popisek.&r"
	]
	quest.0E81085B01C431D0.quest_subtitle: "Pokročilý"
	quest.0E81085B01C431D0.title: "Vylepšení"
	quest.0E94C2423F1BAF83.quest_desc: [
		"Rytířský prsten (&eKnightmetal Loop&r) = 4 ingoty rytířského kovu do kruhu."
		"Blok rytířského kovu + 3 ingoty + prsten = blok na řetězu (&eBlock and Chain&r). Hodíš ho jako kouli na řetězu – rozbíjí bloky i nepřátele."
	]
	quest.0E94C2423F1BAF83.title: "Blok na řetězu"
	quest.0EB4CCE9FA6F9B90.quest_desc: [
		"4 talismany života I dají talisman života II (&eCharm of Life II&r). Zachrání tě s víc životy."
		"V truhlách najdeš i talisman zachování (&eCharm of Keeping I&r). Když zemřeš, nechá ti část věcí."
	]
	quest.0EB4CCE9FA6F9B90.title: "Silnější talisman"
	quest.0EC41F50CFC86019.quest_desc: [
		"Pojízdná lafeta (&eCannon Carriage&r) je dělo na kolech. Dá se s ní jezdit, ale nedá se automatizovat."
		""
		"Vyrobíš ji z prken, hřídele a dvou párů kol (&ePair of Cannon Wheels&r)."
		""
		"Klikni na ni montážním klíčem a sestaví se nebo rozloží. Střílí se klávesou &eFire Controlled Cannon&r (najdeš ji v ovládání)."
	]
	quest.0EC41F50CFC86019.title: "Pojízdná lafeta"
	quest.0EC4C62BFE69F5CE.quest_desc: [
		"Divoký kávovník (&eWild Coffee Bush&r) roste v Netheru v čedičových deltách (&eBasalt Deltas&r)."
		"Kávová zrna (&eCoffee Beans&r) uvař v konvici s vodou na kávu (&eCoffee&r)."
	]
	quest.0EC4C62BFE69F5CE.title: "Káva z Netheru"
	quest.0EC5A2BE4F669CA2.quest_desc: [
		"Ocel (&eSteel Ingot&r) je hlavní materiál první rakety, skafandru i strojů."
		"V etrionické peci přepni režim na slévání a vlož železný ingot a uhlí. Dostaneš 1 ocel."
		"&aJiné cesty: míchačka z Create nad ohňohořákem (2 železa a uhlí dají 2 oceli) nebo metalurgický infuzér z Mekanismu.&r"
		"Všechna ocel v packu je stejný předmět, takže je jedno, kde ji vyrobíš."
	]
	quest.0EC5A2BE4F669CA2.title: "Ocel"
	quest.0ED17982949F025D.quest_desc: [
		"Nejtěžší bestie Overworldu. Jdi na ni s nejlepší výbavou a ohnivzdornými lektvary."
		"Fénixovo hnízdo s vajíčkem je v pustině. Rozbij vajíčko bez Něžného doteku a fénix se vylíhne."
		"&cKdyž ho porazíš, znovu se narodí jako mládě.&r Teprve z mláděte padá trofej (nebo deska) a někdy &ePhoenix Feather&r. S pírkem si po smrti necháš věci."
	]
	quest.0ED17982949F025D.quest_subtitle: "Expert"
	quest.0ED17982949F025D.title: "Fénix"
	quest.0EECD6E3DB70068B.quest_desc: [
		"&bAutumnity&r přidává podzimní javory. Rostou i v obyčejných lesích."
		"Oloupej javorový kmen sekerou. Někdy se objeví mízový kmen. Klikni na něj prázdnou lahvičkou a dostaneš mízu (&eSap Bottle&r)."
		"Mízu upeč v peci – vznikne sirup (&eSyrup Bottle&r)."
	]
	quest.0EECD6E3DB70068B.title: "Javorový sirup"
	quest.0F011EE8B29279EC.quest_desc: [
		"Energetická kostka (&eBasic Energy Cube&r) je baterie. Uloží přebytek z generátorů na později."
		"V okně kostky vidíš, kolik energie je uloženo. Jsou tam i sloty na nabíjení předmětů, třeba nástrojů."
		"&aTip:&r Která strana energii přijímá a která vydává, nastavíš v okně kostky (nastavení stran) nebo konfigurátorem."
	]
	quest.0F011EE8B29279EC.title: "Energetická kostka"
	quest.0F122AB75AC3194C.quest_desc: [
		"&bCreate Confectionery&r přidává čokolády, karamel, marshmallow a perník."
		"Mechanický lis rozdrtí kakaové boby na drcené kakao (&eCrushed Cocoa&r)."
	]
	quest.0F122AB75AC3194C.title: "Drcené kakao"
	quest.0F1C32B812A6A232.quest_desc: [
		"&bBakery&r přidává dorty, koláče, marmelády a sladké pečivo."
		"Pekařský stůl (&eCaking Station&r) vyrobíš z cihel, dřevěných desek a mouky. Váleček (&eRolling Pin&r) z prken a dřevěných desek."
		"Na stůl pokládáš těsto a tvaruješ ho přímo na něm: hnětením rukou, válečkem nebo nožem."
	]
	quest.0F1C32B812A6A232.title: "Pekárna"
	quest.0F31C8552DD5E2FC.quest_desc: [
		"Modulární naftový motor (&eModular Diesel Engine&r) se dá skládat za sebe do řady."
		""
		"Čím víc motorů spojíš, tím víc síly dají."
		""
		"Víc najdeš v kapitole Ropa a palivo."
	]
	quest.0F31C8552DD5E2FC.title: "Modulární motor"
	quest.0F6296204D05EA4E.quest_desc: [
		"&bCreate: Connected&r přidává chytré díly pro rozvod otáčení. Síť je všechno, co je spojené hřídelemi a ozubenými koly."
		""
		"Převodovka na 6 stran (&e6-way Gearbox&r) má hřídel na všech stranách. Horní a spodní hřídel se točí poloviční rychlostí."
		""
		"Paralelní převodovka (&eParallel Gearbox&r) obrátí směr otáčení, když ho vede rovně. Za roh ho pošle stejným směrem."
	]
	quest.0F6296204D05EA4E.quest_subtitle: "Začátečník"
	quest.0F6296204D05EA4E.title: "Nové převodovky"
	quest.0F881D21AC8BC3A0.quest_desc: [
		"Netheritový batoh (&eNetherite Backpack&r) je největší batoh v packu."
		"Vylepšíš ho na kovářském stole: šablona netheritového vylepšení + diamantový batoh + netheritový ingot."
	]
	quest.0F881D21AC8BC3A0.quest_subtitle: "Expert"
	quest.0F881D21AC8BC3A0.title: "Netheritový batoh"
	quest.0F9B65BFA7F5FE5E.quest_desc: [
		"Káď (&eVat&r) vyrobíš ze železa, prken, desky a plástve. Kvasí, pálí a chladí nápoje a jídla."
		"Bez ničeho pod kádí probíhá kvašení. Se zdrojem tepla pod ní (například sporák) pálení, s ledem pod ní chlazení."
		"Ocet (&eVinegar&r) vykvasíš z kbelíku vody, cukru a hnědé houby do lahve."
	]
	quest.0F9B65BFA7F5FE5E.title: "Kvasná káď"
	quest.0FAB99A19D67F2E2.quest_desc: ["Pánev, chléb a máslo na pracovním stole dají dva toasty (&eToast&r)."]
	quest.0FAB99A19D67F2E2.title: "Toast"
	quest.0FB01FFDEE8AF2E3.quest_desc: [
		"Lokokov můžeš obarvit. Nejdřív vyrob barvu: v míchačce smíchej barvivo, hroudu jílu a vodu."
		"Pak dej do tyglíku pod míchačkou lokokov a barvu – vyjde obarvený lokokov. Jedna dávka barvy stačí na 8 bloků."
		"&aKromě běžných barev jsou i zvláštní odstíny, třeba kaštanová (&eMaroon&a). Vzniknou smícháním dvou barev.&r"
	]
	quest.0FB01FFDEE8AF2E3.title: "Barvy na lokomotivu"
	quest.0FB7899971BB15D3.quest_desc: [
		"Drcením netherracku vznikne &euškvařená mouka&r (&eCinder Flour&r), občas i 2 kusy."
		"Je potřeba na ohňodort, který přehřeje ohňohořák (kapitola Energie a stres)."
	]
	quest.0FB7899971BB15D3.title: "Uškvařená mouka"
	quest.0FDC4EA57AF3151E.quest_desc: [
		"Střep života (&eLife Shard&r) je vzácný poklad zlatého dungeonu."
		"Když ho použiješ, dostaneš navždy jedno srdce navíc. Počet použitých střepů je omezený."
	]
	quest.0FDC4EA57AF3151E.title: "Střep života"
	quest.0FDD7A3027DDF870.quest_desc: [
		"&eNastavitelná řetězová řadící páka&r (&eAdjustable Chain Gearshift&r): řetězový pohon + elektronka."
		"Bez signálu se chová jako obyčejný pohon. S redstone signálem se pohony v řadě točí 2× rychleji (nebo 2× pomaleji, když páka není u zdroje)."
		"Slabší redstone signál nastaví poměr přesněji, mezi 1× a 2×."
	]
	quest.0FDD7A3027DDF870.title: "Řetězová řadící páka"
	quest.1003D1A10B9CAA0A.quest_desc: [
		"Sazenici ovocného stromu slož na pracovním stole z 8 kusů ovoce a libovolné sazenice."
		"Jabloň (&eApple Sapling&r) tedy vyrobíš z 8 jablek a sazenice. Zasaď ji a z jabloně pak sklízej jablka."
	]
	quest.1003D1A10B9CAA0A.title: "Vlastní sad"
	quest.1010B92DAFEAD040.quest_desc: [
		"Pod povrchem Měsíce jsou vesnice Lunariánů. Nepotřebují kyslík a obchodují s věcmi pro vesmír, třeba se skafandry."
		"&aNa všech planetách chodí i potulný obchodník (&eLunarian Wandering Trader&r). Za smaragdy prodává palivo, kyslík, rampy i vodu.&r"
	]
	quest.1010B92DAFEAD040.title: "Lunariáni"
	quest.101E5568443CC3E1.quest_desc: [
		"Z jedné okurky (&eCucumber&r) vyrobíš 3 plátky (&eSliced Cucumber&r)."
		"Plátky okurky jsou návnada na křečky."
	]
	quest.101E5568443CC3E1.title: "Plátky okurky"
	quest.101FDF3E23B99F1D.quest_desc: [
		"&eStresometr&r (&eStressometer&r) vznikne převedením tachometru v pracovním stole. Polož ho do sítě a podívej se na něj v brýlích."
		"Uvidíš kapacitu sítě, spotřebu a kolik SU zbývá. Teď už nestačí jen stavět, musíš počítat: sečti dopad strojů × jejich RPM."
		"Plánuj s rezervou. Když síť jede těsně pod 100 %, stačí přidat jeden stroj a zastaví se všechno."
		"&aTip:&r Komparátor u stresometru dá signál podle vytížení. Spojkou tak můžeš vypnout méně důležité stroje."
	]
	quest.101FDF3E23B99F1D.quest_subtitle: "Pokročilý"
	quest.101FDF3E23B99F1D.title: "Stresometr"
	quest.103648B84A37B1A4.quest_desc: [
		"Úkol pro experty: spawner s nejkratším čekáním, ovládaný redstonem, bez umělé inteligence příšer (No AI), bez podmínek a bez nutnosti hráče poblíž."
		"Potřebuješ: cukr a hodiny (kratší čekání), komparátor (ovládání redstonem), chorusové ovoce (No AI), kondukt (bez podmínek) a hvězdu z Netheru (bez hráče)."
	]
	quest.103648B84A37B1A4.quest_subtitle: "Expert"
	quest.103648B84A37B1A4.title: "Dokonalý spawner"
	quest.10376C3716ABC6C5.quest_desc: [
		"Perla sama teleport neudělá. Srdce každého teleportéru je kvantový mechanismus (&eQuantum Mechanism&r) a ten potřebuje teleportační šťávu (&eQuantum Fluid&r, v popiscích &eTelejuice&r)."
		""
		"Šťáva: v míchačce nad zapáleným ohňohořákem smíchej plod chorusu (&eChorus Fruit&r) a 250 mB vody. Chorus roste v Endu."
		""
		"Pokročilý díl (&eAdvanced Component&r): sekvenční montáží nasaď na diamant robustní plát (&eSturdy Sheet&r), pak redstonovou perlu a nakonec ho slisuj."
		""
		"Mechanismus: robustní plát naplň 250 mB šťávy, nasaď na něj pokročilý díl a slisuj. &aPak si vyrob teleportér z kapitoly Create: doplňky.&r"
	]
	quest.10376C3716ABC6C5.title: "Kvantový mechanismus"
	quest.103D2A9D5072E683.quest_desc: [
		"Strašidelný rytíř bez hlavy (&eHorseless Headsman&r). Objevuje se v noci v tajze, jen za úplňku."
		"Přivolává dýňové pomocníky. Může z něj padnout &ePumpkin Helmet&r – za úplňku ti dává sílu."
	]
	quest.103D2A9D5072E683.title: "Bezhlavý jezdec"
	quest.106214D113B10ACB.quest_desc: [
		"Šupina (&eCrocodile Scute&r) padá z krokodýla (&eCrocodile&r). Krokodýl žije v bažinách, v mangrovech a v řekách."
		"&cKrokodýl je nebezpečný.&r Umí tě chytit a táhnout pod vodu. Bojuj s ním na souši."
	]
	quest.106214D113B10ACB.title: "Krokodýlí šupina"
	quest.1068691698B9EBAD.quest_desc: [
		"Bezdrátový vysílač (&eWireless Transmitter&r) zpřístupní síť na dálku. Bezdrátová mřížka (&eWireless Grid&r) je mřížka v kapse."
		"Mřížku propojíš se sítí tak, že s ní klikneš Shift + pravým tlačítkem na zařízení sítě (třeba na ovladač). Mřížka potřebuje energii – nabij ji."
		"&aTip:&r Dosah vysílače zvětší vylepšení dosahu (&eRange Upgrade&r)."
	]
	quest.1068691698B9EBAD.title: "Bezdrátový přístup"
	quest.106B5E87470DDF24.quest_desc: [
		"V trollích jeskyních je trezor obalený obrovským obsidiánem. Prorazíš ho obrovým krumpáčem."
		"Uvnitř je lampa škváry (&eLamp of Cinders&r). Spálí trnité keře, které blokují cestu na náhorní plošinu."
	]
	quest.106B5E87470DDF24.title: "Lampa škváry"
	quest.106E035DA7025AB5.quest_desc: [
		"&bVinery&r je mod o vinařství. Divoké keře s hrozny rostou v lesích, na pláních, loukách, u řek a v horách."
		"Pravým tlačítkem hrozny z keře otrháš. Když keř rozbiješ, dostaneš semínka. Semínka vyrobíš i z hroznu na pracovním stole."
		"&aTip:&r V tajze, savaně a džungli rostou jiné odrůdy. Každá dá jinou šťávu."
	]
	quest.106E035DA7025AB5.title: "Vinné hrozny"
	quest.1073BB6F36E91DF8.quest_desc: [
		"Kraby najdeš na plážích. Chovat je můžeš pšenicí, kuřecím masem nebo rybou."
		"Úkol: chyť kraba do kbelíku s vodou."
	]
	quest.1073BB6F36E91DF8.title: "Krab"
	quest.10D4191E5B8AF825.quest_desc: [
		"V knihovně (&eLibrary&r) se dospělí učí. Roste jim inteligence, a díky ní se rychleji zlepšují v práci."
		"Výzkum &eKeen&r stojí 3 knihy a domy musí mít dohromady úroveň 3. Blok budovy: prkna, kniha a nástroj stavby."
	]
	quest.10D4191E5B8AF825.title: "Knihovna"
	quest.10EB7CF79B8049BF.quest_desc: [
		"Mod &bNether Exotics&r přidává do Netheru zvláštní ovocné stromy a rostliny."
		"&eKiwano&r dá na chvíli ohnivzdornost, ale i krátkou otravu. &ePitaya&r vyléčí efekt wither."
		"Z ovoce a lahve vyrobíš džus se stejným účinkem."
	]
	quest.10EB7CF79B8049BF.title: "Netherové ovoce"
	quest.10FBA5D8E433987F.quest_desc: [
		"Projdi portálem do Endu. Ocitneš se na ostrově s Enderovým drakem."
		"&cZ Endu se vrátíš jen tak, že draka porazíš, nebo zemřeš.&r Vezmi si luk, hodně šípů, bloky a dýni na hlavu proti endermanům."
		"Další postup najdeš v kapitole &bEnd&r."
	]
	quest.10FBA5D8E433987F.title: "End"
	quest.111653ECC04F72C7.quest_desc: [
		"Gravitační písek (&eGravisand&r) spadne jen po redstonovém signálu. Když spadnout nemůže, vyletí nahoru."
		"Z 8 písku a ender perly vyrobíš 8 kusů."
	]
	quest.111653ECC04F72C7.title: "Gravitační písek"
	quest.1123DB6E908ABE34.quest_desc: [
		"Trouba peče jen v nádobě. Plech (&eSheet Tray&r) je z těžké nášlapné desky. Pekáč (&eBaking Tray&r) a forma na chleba (&eLoaf Pan&r) mají navíc železné nugety."
		"Nádoba se při pečení nespotřebuje. Kterou nádobu recept chce, ukáže JEI."
	]
	quest.1123DB6E908ABE34.title: "Plechy na pečení"
	quest.112F5B3F213A69D5.quest_desc: [
		"Postav větrák, před něj vodu a za ni pošli pásem nebo hoď předměty. To je &ehromadné praní&r."
		"Štěrk dá při praní občas pazourek (25 %) a železný nuget (12,5 %). Rozdrcená ruda dá 9 nugetů a bonus."
		"&aTip:&r Praní také změní pšeničnou mouku na těsto a magmatický blok na obsidián."
	]
	quest.112F5B3F213A69D5.title: "Praní větrákem"
	quest.11386B75726DC221.quest_desc: [
		"Měj na sobě všech 7 efektů HerbalBrews najednou: &eBalanced&r, &eTough&r, &eDeeprush&r, &eFortune&r, &eFeral&r, &eLifeleech&r a &eBonding&r."
		"&eBonding&r dává čaj maté (&eYerba Mate Tea&r). Maté roste v horách a jeho čaj potřebuje v konvici hodně tepla."
		"&aTip:&r Džbán a lahev z kotle ti ušetří spoustu pití."
	]
	quest.11386B75726DC221.title: "Všechny efekty naráz"
	quest.1141CE3A9F03BC9B.quest_desc: [
		"Krumpáč ze svatého kamene (&eHolystone Pickaxe&r) vytěží zanitovou rudu."
		"Občas při těžbě sám vyhodí střípek ambrosia."
	]
	quest.1141CE3A9F03BC9B.title: "Kamenné nástroje"
	quest.115B43D6B4C08A36.quest_desc: [
		"Nabíječka (&eCharger&r) nabíjí certusový křemen. Vyrobíš ji ze železa a mědi."
		"Fluixový krystal (&eFluix Crystal&r): hoď do vody nabitý certus, redstone a netherový křemen. Vzniknou 2 fluixové krystaly."
	]
	quest.115B43D6B4C08A36.title: "AE2: nabíječka a fluix"
	quest.115E98BC83CF2F74.quest_desc: [
		"V trollích jeskyních je zářící úrodná půda (&eUberous Soil&r). Zasaď do ní kouzelné fazole."
		"Vyroste obří stonek až do mraků. Po něm vylez nahoru."
	]
	quest.115E98BC83CF2F74.title: "Fazolový stonek"
	quest.1199DD955BE9C191.quest_desc: [
		"Pila otočená nahoru zpracuje předměty na pásu nebo hozené na ni. Umí recepty kameníkovy pily i recepty Create (v JEI „Řezání“ / &eSawing&r)."
		"&aTip:&r Pila nařeže z 1 andezitové slitiny 6 hřídelí. V pracovním stole jsou to jen 4."
		"Když má výsledek víc možností, vyber ho filtrem na pile. Jinak se možnosti střídají."
	]
	quest.1199DD955BE9C191.title: "Pila na pásu"
	quest.11AF66399ED0C45B.quest_desc: [
		"Do automatického výrobníku (&eAutocrafter&r) vlož zapsané vzory (&ePattern&r). Recepty z pracovního stolu vyrobí sám."
		"Zpracovací vzory (třeba pro pec) posílá do bloku, na který je natočený. Výsledek se musí vrátit do sítě."
	]
	quest.11AF66399ED0C45B.title: "RS: automatická výroba"
	quest.11B86A6D7D25FD23.quest_desc: [
		"&bAquaculture Delight&r přidává rybí jídla do hrnce z Farmer's Delight."
		"Ryba s hranolky (&eFish and Chips&r) je ze smaženého okouna, pečené brambory, rajčatové omáčky a misky. Smaženého okouna uvaříš v hrnci z okounka (&eSmallmouth Bass&r), pšenice a vejce."
	]
	quest.11B86A6D7D25FD23.title: "Ryba s hranolky"
	quest.11BC9B4A7974BD0A.quest_desc: [
		"Stavební jádro (&eConstruction Core&r) = základní procesor + světlitový prach. Ničicí jádro (&eDestruction Core&r) = základní procesor + netherový křemen."
		"Jádra jsou v mřížce, importéru, exportéru a dalších zařízeních."
		"&aTip:&r Vyrob si jich rovnou několik."
	]
	quest.11BC9B4A7974BD0A.title: "Jádra"
	quest.1229C70B243EA935.quest_desc: [
		"Bionafta (&eBiodiesel&r) je nejlepší palivo bez ropy. V motoru je asi dvakrát silnější než olej nebo etanol."
		""
		"Teď už ruční plnění nestačí – motor palivo spaluje pořád. Postav linku, která bionaftu vyrábí sama:"
		"1. Pás doveze semínka (třeba z farmy s mechanickým sklízečem) do tyglíku pod lisem."
		"2. Do tyglíku s víkem sype trychtýř cukrovou třtinu a kostní moučku."
		"{@pagebreak}"
		"3. Olej a etanol přiveď čerpadly do tyglíku pod mechanickou míchačkou (&eMechanical Mixer&r). Ze 100 mB oleje a 100 mB etanolu vznikne 200 mB bionafty. Ohřev není potřeba."
		"4. Bionaftu odčerpej do nádrže a z ní potrubím do motoru."
		""
		"&aTip: Když motor stojí, zkontroluj brýlemi, jestli v nádrži není prázdno.&r"
	]
	quest.1229C70B243EA935.quest_subtitle: "Pokročilý"
	quest.1229C70B243EA935.title: "Automatická bionafta"
	quest.1237EF8B25F399B0.quest_desc: [
		"&bIron Chests&r přidává větší truhly: měděnou, železnou, zlatou, diamantovou, krystalovou a obsidiánovou."
		"Železnou truhlu (&eIron Chest&r) vyrobíš z obyčejné truhly a 8 železných ingotů."
		"&aTip:&r Každá další úroveň má víc slotů."
	]
	quest.1237EF8B25F399B0.title: "Lepší truhla"
	quest.1279320F05578C4E.quest_desc: [
		"Imitace (copycat) je blok, který převezme vzhled jiného bloku."
		""
		"Imitační panel (&eCopycat Panel&r) vyrobíš v kameníkovi ze zinkového ingotu. Z jednoho ingotu jsou 4 panely."
		""
		"Polož panel a klikni na něj pravým tlačítkem s plným blokem v ruce. Panel dostane vzhled toho bloku. Montážním klíčem materiál zase odebereš."
		""
		"Mod &bCopycats+&r přidává mnoho dalších tvarů. Víc najdeš v kapitole Dekorace."
	]
	quest.1279320F05578C4E.quest_subtitle: "Create: Copycats+"
	quest.1279320F05578C4E.title: "Imitace"
	quest.127DA37AC76625E8.quest_desc: [
		"Energizér (&eEnergizer&r) uloží 2 miliony energie a při rozbití si ji nechá."
		"Předmět nabiješ tak, že s ním klikneš na nabitý energizér. Tak nabiješ i jet suit."
	]
	quest.127DA37AC76625E8.title: "Energizér"
	quest.127EE9C4C7385DAA.quest_desc: [
		"Kompostér (&eComposter's Hut&r) dělá z odpadu (listí, sazenice, jídlo) kompost. Kompost potřebuje farmář a květinářka."
		"Výzkum &eBiodegradable&r stojí 64 kostní moučky a farmy musí mít dohromady úroveň 3."
		"Blok budovy potřebuje kompostovací sud (&eCompost Barrel&r) z prken, hlíny, železného ingotu a nástroje stavby."
		"&cV nastavení vyber, co kompostovat. S jídlem opatrně, ať občanům nezbude hlad.&r"
	]
	quest.127EE9C4C7385DAA.title: "Kompostárna"
	quest.12882C391B5773E9.quest_desc: ["Ananasovou smaženou rýži (&ePineapple Fried Rice&r) uvaříš v hrnci z ananasu, tří rýží, zelí a vejce."]
	quest.12882C391B5773E9.title: "Ananasová rýže"
	quest.129CD29E6F281D6F.quest_desc: [
		"&eSkladový ticker&r (&eStock Ticker&r): sklo, skladový vysílač a zlatý ingot. Před položením jím klikni na skladový vysílač."
		"Před ticker posaď zvíře na sedačku (třeba &eWhite Seat&r) nebo polož ohňohořák. To je &eskladník&r (&eStock Keeper&r). Klikni na něj a objednávej věci ze všech připojených truhel."
		"Objednané věci se zabalí do balíčků. Zadej adresu a balíčky dojedou k tobě."
	]
	quest.129CD29E6F281D6F.title: "Skladník"
	quest.12ACC46CF81BBEBD.quest_desc: [
		"Robit (&eRobit&r) je malý robotický pomocník. Chodí za tebou, sbírá předměty ze země a má v sobě pec i pracovní stůl."
		"Nabíjí se na nabíjecí podložce (&eChargepad&r). Je i součástí receptu na digitálního horníka."
		"&aTip:&r Robitovi můžeš změnit vzhled – je na to advancement „A New Coat of Paint“."
	]
	quest.12ACC46CF81BBEBD.title: "Robit"
	quest.12C438B96D649840.quest_desc: [
		"Nejhlubší jeskyně, skoro u dna světa. Z mnoha míst tu kape láva a jsou tu pruhy čediče a magmatu."
		"&cVezmi si ohnivzdorné lektvary a kbelík vody.&r"
	]
	quest.12C438B96D649840.title: "Plášťové jeskyně"
	quest.12E80B8178422378.quest_desc: [
		"Ohňohořák musíš krmit předměty. Hořák (&eBurner&r) také hřeje, ale pálí kapalné palivo z potrubí. Nemusíš do něj chytat ohniváka."
		""
		"Vyrobíš ho z prázdného ohňohořáku (&eEmpty Blaze Burner&r), mosazného ingotu, hřídele, 2 andezitových slitin a 2 křesadel."
		""
		"Palivo do něj přiveď potrubím. Jak silně hoří, nastavíš rukojetí k ventilu (např. &eCopper Valve Handle&r) přiloženou k hořáku."
		""
		"Hřeje tyglík i destilační věž."
		""
		"&aTip: Každé palivo hřeje jinak. Podrž Alt nad kbelíkem paliva a uvidíš jeho sílu v motoru i v hořáku.&r"
	]
	quest.12E80B8178422378.title: "Hořák na palivo"
	quest.12FE30D2E73AFB4A.quest_desc: [
		"Vystřelovač přísavek (&ePlunger Launcher&r) střílí přísavky na laně. Dvě přísavky se spojí a přitáhnou bloky k sobě."
		"Shift + pravé tlačítko přísavky odstraní. Když máš na zádech měděnou tlakovou láhev (&eCopper Backtank&r), bere si z ní vzduch."
	]
	quest.12FE30D2E73AFB4A.title: "Vystřelovač přísavek"
	quest.12FF04C83E462717.quest_desc: [
		"Lis (&eApple Press&r) vyrobíš ze sudu, železného poklopu a klacků."
		"V lisu nejdřív rozmačkáš jablka na kaši (&eApple Mash&r). Kaše s prázdnou vinnou lahví pak dá jablečný džus (&eApple Juice&r)."
		"Jablka padají i z jabloní z Vinery, které rostou na pláních a loukách."
	]
	quest.12FF04C83E462717.title: "Lis na jablka"
	quest.130430708095505D.quest_desc: [
		"&bAd Astra&r tě vezme do vesmíru: na Měsíc, Mars, Venuši, Merkur a planetu Glacio v jiné sluneční soustavě."
		"Cesta: energie → ocel → díly rakety → palivo a kyslík → start. Na každé planetě najdeš rudu na další, silnější raketu."
		"&aPrůvodce Astrodux vyrobíš z knihy, 4 modrých barviv a 4 železných ingotů.&r"
	]
	quest.130430708095505D.quest_subtitle: "Začátečník"
	quest.130430708095505D.title: "Ad Astra"
	quest.1304B5921B40BC01.quest_desc: [
		"Ve vesmíru a na většině planet není vzduch. Skafandr (&eSpace Helmet&r, &eSpace Suit&r, &eSpace Pants&r, &eSpace Boots&r) drží kyslík, který dýcháš."
		"Kyslík do něj nabereš v plniči kyslíku."
		"&cNa Venuši a Merkuru obyčejný skafandr nestačí. Spálíš se.&r"
	]
	quest.1304B5921B40BC01.title: "Skafandr"
	quest.133FB6189F8EB527.quest_desc: [
		"Plutonium vyrobí izotopová odstředivka z jaderného odpadu (10 mB odpadu = 1 mB plutonia)."
		"Peletu (&ePlutonium Pellet&r) vyrobíš stejně jako u polonia: v tlakové reakční komoře s vodou a fluoritovým prachem."
		"&aTip:&r Plutoniové pelety jsou potřeba na plášť SPS."
	]
	quest.133FB6189F8EB527.title: "Plutonium"
	quest.1351CB0356877C3A.quest_desc: [
		"Vylepšení stohování (&eStack Upgrade Tier 1&r) zvětší, kolik kusů se vejde do jednoho slotu."
		"Vyšší úrovně dávají ještě víc. Do jedné truhly se tak vejde obrovské množství věcí."
		"&aTip:&r První úroveň vyrobíš z kmenů a základu vylepšení."
	]
	quest.1351CB0356877C3A.title: "Víc kusů do slotu"
	quest.13707900F01BBA47.quest_desc: [
		"Netheritový věžový štít (&eNetherite Tower Shield&r) je nejodolnější obyčejný štít."
		"Vylepšíš ho na kovářském stole: šablona netheritového vylepšení + diamantový věžový štít + netheritový ingot."
	]
	quest.13707900F01BBA47.title: "Netheritový štít"
	quest.1378DD3144B79FFB.quest_desc: [
		"Bezdrátový přístupový bod (&eME Wireless Access Point&r) zpřístupní síť na dálku. Potřebuje kanál."
		"Bezdrátový terminál (&eWireless Terminal&r) propojíš se sítí tak, že ho vložíš do slotu v přístupovém bodu. Pak ho nabij."
	]
	quest.1378DD3144B79FFB.title: "AE2: bezdrátový terminál"
	quest.13C22BC2B5928A44.quest_desc: [
		"Elektrolytický separátor (&eElectrolytic Separator&r) rozloží kapalinu na dva plyny. Z vody udělá vodík (&eHydrogen&r) a kyslík (&eOxygen&r)."
		"Uvnitř je elektrolytické jádro (&eElectrolytic Core&r) z infuzní slitiny a prachu železa, zlata a osmia. Prach získáš v obohacovací komoře nebo drtiči."
		"Vodu dodáš kbelíkem do slotu v okně nebo potrubím. Každý plyn vystupuje z jiné strany stroje."
		"&aTip:&r Kyslík použiješ na 3× zpracování rud, vodík jako palivo pro jetpack nebo generátor."
	]
	quest.13C22BC2B5928A44.title: "Elektrolytický separátor"
	quest.13F241F6A474DD15.quest_desc: [
		"Dovozník (&eQIO Importer&r) a vývozník (&eQIO Exporter&r) se pokládají na blok, třeba na truhlu nebo stroj."
		"Dovozník bere věci z bloku do QIO, vývozník je z QIO do bloku dává. Ve filtrech nastavíš, které věci."
		"&aTip:&r Tak napojíš QIO na stroje – třeba vývozník na pec a dovozník na její výstup."
	]
	quest.13F241F6A474DD15.title: "QIO dovoz a vývoz"
	quest.1404272E770B75B9.quest_desc: [
		"Solární ohřívací deska (&eBasic Solar Heating Plate&r) přes den vyrábí teplo zadarmo."
		""
		"Stirlingův motor (&eStirling Engine&r) dej nad zdroj tepla, třeba nad trubku. Začne se pomalu točit. Čím víc tepla dostane, tím rychleji se točí."
	]
	quest.1404272E770B75B9.title: "Teplo ze slunce"
	quest.141A49BCFA3B8B74.quest_desc: [
		"&eOdkládací deska&r (&eDepot&r) je jako kousek pásu, který stojí na místě. Recept: andezitová slitina + andezitové pouzdro."
		"Pravým tlačítkem na ni předmět položíš nebo ho vezmeš. Lis, pokladač nebo dávkovač nad ní předmět zpracuje."
		"Mechanická paže z desky umí brát i na ni dávat."
	]
	quest.141A49BCFA3B8B74.title: "Odkládací deska"
	quest.1471BC58B5F70561.quest_desc: [
		"Senzor náklonu (&eGimbal Sensor&r) dává signál podle toho, jak je stroj nakloněný. Každá osa funguje zvlášť."
		"Signál vychází na straně, která je níž. Napoj ho na vrtule na okrajích stroje a nižší strana přidá tah – stroj se srovná."
		"Výroba: kompas, gyroskopický mechanismus a mosazné pouzdro."
	]
	quest.1471BC58B5F70561.title: "Senzor náklonu"
	quest.1485D33AAC76A723.quest_desc: [
		"Do džbánu (&eJug&r) naliješ až tři různé čaje."
		"Když se z něj napiješ, dostaneš efekty všech čajů naráz."
	]
	quest.1485D33AAC76A723.title: "Džbán"
	quest.148DDA5A227F283F.quest_desc: [
		"Madlo (&eIron Handle&r) se dá chytit. Drž na něm pravé tlačítko a přitáhneš se k němu, i na letící lodi."
		"Se Shiftem naopak táhneš za madlo celý stroj. Výroba: železný nuget nad andezitovou slitinou."
	]
	quest.148DDA5A227F283F.title: "Madlo"
	quest.1494BD5722A7C284.quest_desc: [
		"Houbový král (&eCrimson Mushlin King&r), v Bestiáři zvaný &eCrimson Spitter&r. Někdy se objeví v &eKarmínovém lese&r spolu s piglinem."
		"&cPlive jedovaté oblaky.&r Jeho trofej se jmenuje &eCrimson Spitter Trophy&r."
	]
	quest.1494BD5722A7C284.title: "Karmínový plivač"
	quest.14D32BDF464BEE96.quest_desc: [
		"Ruda alpské soli (&eAlpine Salt Ore&r) je v kamení na loukách. Vytav ji v peci."
		"Sůl uvaříš i v kotli (&eCookpot&r) z kalcitu nebo vápence s vodou."
	]
	quest.14D32BDF464BEE96.title: "Alpská sůl"
	quest.1500D77D473C0532.quest_desc: [
		"Lis nad tyglíkem &ezhutňuje&r: udělá každý recept, který zaplní celé pole 2×2 nebo 3×3, a pár receptů navíc. Třeba 9 nugetů na ingot."
		"Když dva recepty kolidují, vyber ten správný filtrem na lisu."
	]
	quest.1500D77D473C0532.title: "Lisování v tyglíku"
	quest.15015BC8E0D0DFA0.quest_desc: [
		"Zaměřovač bludiště (&eMaze Map Focus&r) obklop 8 papíry. Vznikne mapa bludiště."
		"Mapa ukazuje chodby labyrintu ve tvé výšce. Hledání Minoshrooma je s ní mnohem snazší."
	]
	quest.15015BC8E0D0DFA0.title: "Mapa bludiště"
	quest.152C87132AE12CA0.quest_desc: [
		"Otočné ložisko (&eSwivel Bearing&r) připojí ke stroji druhý fyzikální stroj, který se může otáčet. Hodí se na kormidlo, otočnou věž nebo natáčecí motor."
		"Připojí se k bloku před sebou. Bloky slep lepidlem a roztoč ozubené kolečko ložiska – část se sestaví."
		"Rotace z hřídele projde ložiskem dál. Redstonový signál ložisko odemkne a pak se točí volně."
		"Výroba: dřevěná deska, blok průmyslového železa a ozubené kolečko."
	]
	quest.152C87132AE12CA0.title: "Otočné ložisko"
	quest.1535A115E78C2EDA.quest_desc: [
		"Skarabeový drahokam (&eScarab Gem&r) je velmi vzácný drop z bloků fosilií."
		"Otevře sarkofág boha Anu a ochočí velké dravce."
		"&aNa kovářském stole z diamantového nástroje, drahokamu a šablony netheritového vylepšení vznikne skarabeový nástroj.&r"
	]
	quest.1535A115E78C2EDA.title: "Skarabeový drahokam"
	quest.1537A7BB912ACC66.quest_desc: [
		"Těsto na sušenky (&eSugar Cookie Dough&r) zamíchej v míse z mouky, cukru, másla a vejce."
		"Upeč ho v troubě na plechu. Dostaneš 8 sušenek (&eSugar Cookie&r)."
	]
	quest.1537A7BB912ACC66.title: "Cukrové sušenky"
	quest.1553F6644EFE7A67.quest_desc: [
		"Upgrade pece (&eSmelting Upgrade&r) přidá do batohu záložku s pecí. Tavíš i na cestách."
		"Vyrobíš ho z pece, železa, redstonu a základu upgradu."
	]
	quest.1553F6644EFE7A67.title: "Pec v batohu"
	quest.1571739776314EFB.quest_desc: [
		"Upeč a sesbírej všechno pečivo z &bBakery&r – chleby, dorty, koláčky, marmelády."
		"Odměnou je prapor pekárny (&eCompletionist Banner: Bakery&r). Když ho postavíš, dává hráčům v okolí odolnost (&eResistance&r)."
	]
	quest.1571739776314EFB.quest_subtitle: "Expert"
	quest.1571739776314EFB.title: "Mistr pekař"
	quest.159A780014313800.quest_desc: [
		"Lithium potřebuješ na indukční matici a na fúzní palivo."
		"Do odpařovací věže místo vody přiváděj solanku – vyrobí tekuté lithium. Rotační kondenzátor z něj udělá plyn a krystalizátor lithiový prach (&eLithium Dust&r)."
		"&aTip:&r Plynné lithium využije i solární neutronový aktivátor – vyrobí z něj tritium pro fúzi."
	]
	quest.159A780014313800.title: "Lithium"
	quest.15AE22C0495311AF.quest_desc: ["Syrové těstoviny (&eRaw Pasta&r) nakrájíš z těsta na prkénku se sekáčkem nebo semeleš v mlýnku."]
	quest.15AE22C0495311AF.title: "Těstoviny"
	quest.15C531AFA1EFF423.quest_desc: [
		"Každý zdroj v Create dává dvě věci: &erychlost&r (otáčky, RPM) a &esílu&r (stres, jednotka SU). Česky ve hře se stresu říká „kinetické napětí“."
		"Stroj bere SU podle vzorce &edopad × RPM&r. Lis má dopad 8: na 16 RPM bere 128 SU, na 64 RPM už 512 SU."
		"Zdroj má kapacitu taky „na RPM“: mlýnské kolo dá 32 × 8 RPM = 256 SU. Když spotřeba všech strojů přeroste kapacitu, celá síť se zastaví."
		"&aTip:&r Rychlejší stroj pracuje rychleji, ale bere víc SU. Čísla vždy ukážou brýle. Elektromotory a další zdroje přidávají addony (kapitola s addony Create)."
	]
	quest.15C531AFA1EFF423.quest_subtitle: "Začátečník"
	quest.15C531AFA1EFF423.title: "Rychlost a stres"
	quest.15EEE76E5EFA5A01.quest_desc: [
		"Poslední úroveň: biomy pod zemí. Musíš kopat nebo hledat hluboké jeskyně."
		"Podzemní džungle je jeskyně plná mechu, bahna a vody. Žijí tu axolotlové, želvy a žáby."
	]
	quest.15EEE76E5EFA5A01.quest_subtitle: "Expert"
	quest.15EEE76E5EFA5A01.title: "Podzemní džungle"
	quest.15F418EF7AE7A697.quest_desc: [
		"Sporák (&eStove&r) z HerbalBrews ohřívá konvici. Vyrobíš ho z táboráku, kamene a železných nugetů."
		"Některé čaje potřebují víc tepla. Ohnivý prášek vložený do konvice teplo zvýší."
	]
	quest.15F418EF7AE7A697.title: "Sporák na čaj"
	quest.15FE4F13185BE886.quest_desc: [
		"Teď už nemusíš všechno nosit sám. Kurýr nosí věci mezi skladištěm a budovami."
		"Kurýrovu budovu (&eCourier's Hut&r) vyrobíš z prken, kožených bot a nástroje stavby. Se železnými botami dostaneš 2 kusy."
		"Kurýr s budovou úrovně 1 unese najednou 1 stoh věcí, s úrovní 2 dva stohy, s úrovní 3 čtyři a s úrovní 4 osm."
	]
	quest.15FE4F13185BE886.title: "Kurýr"
	quest.1612DECA357B9384.quest_desc: [
		"Tyhle doplňky rozšiřují &bFarmer's Delight&r o nové plodiny, nápoje, stroje a jídla. Jejich jídla se vaří v hrnci a krájí na prkénku z Farmer's Delight."
		"Začni doplňky s plodinami, které rostou kolem tebe. Pak přijdou nápoje a kvašení a nakonec jídla z Netheru, Endu a Twilight Forestu."
		"&aTip:&r Některá jídla z doplňků dávají efekt &eComfort&r (pohoda). Ten tě léčí, i když máš hlad."
	]
	quest.1612DECA357B9384.quest_subtitle: "Začátečník"
	quest.1612DECA357B9384.title: "Ještě víc jídla"
	quest.16309B0623D18A64.quest_desc: ["Diamantová truhla (&eDiamond Chest&r) má 108 slotů. Vyrobíš ji ze zlaté truhly, 2 diamantů a 6 skleněných bloků."]
	quest.16309B0623D18A64.title: "Diamantová truhla"
	quest.167F05D58B87C6FF.quest_desc: [
		"Z červené drti dozraje třeba &eMerlot&r, z bílé &eChardonnay&r, z moštu cider."
		"&cPozor:&r Víno většinou dává zpomalení a odolnost, někdy i nevolnost."
	]
	quest.167F05D58B87C6FF.title: "Merlot"
	quest.16ADA60EE8CAECDD.quest_desc: [
		"&eLepič&r (&eSticker&r) přilepí blok před sebou, když dostane redstone signál. Další signál blok zase pustí."
		"Tak může udělátko blok vzít, odvézt a nechat jinde."
	]
	quest.16ADA60EE8CAECDD.title: "Lepič"
	quest.16DDDA7A9840A51F.quest_desc: [
		"Plátno (&eCanvas&r) vyrobíš ze 4 kusů slámy (čtverec 2×2)."
		"Z plátna a klacků je košík (&eBasket&r). Z plátna jsou i cedule (&eCanvas Sign&r) a koberec (&eCanvas Rug&r)."
	]
	quest.16DDDA7A9840A51F.title: "Plátno"
	quest.1706288B6DC8DAA7.quest_desc: [
		"Teď už nepotřebuješ velký prismarinový prstenec kolem konduitu. Klec konduitu (&eConduit Cage&r) ho nahradí jedním blokem."
		""
		"Vyrobíš ji z konduitu, 5 prismarinových tyčí, 2 slitin a potrubí. Konduit vyrobíš ze srdce moře a 8 ulit loděnky (&eNautilus Shell&r)."
		""
		"Klec probudíš, když do ní zespodu napumpuješ kapalinu. S vodou dává efekt konduitu (&eConduit Power&r), jiné kapaliny dávají jiné efekty."
		""
		"&aVe slotu režimu vybereš, koho efekt zasáhne, třeba jen hráče nebo jen příšery.&r"
	]
	quest.1706288B6DC8DAA7.quest_subtitle: "Pokročilý"
	quest.1706288B6DC8DAA7.title: "Klec konduitu"
	quest.17108170F267612B.quest_desc: [
		"Madla, třeba mosazná (&eBrass Grab Bars&r), a schůdky, třeba mosazné (&eBrass Steps&r), dodají vagonu detaily."
		"Vyrábí se z mosazi, mědi nebo andezitové slitiny, v pracovním stole i v kamenořezu."
	]
	quest.17108170F267612B.title: "Madla a schůdky"
	quest.171B8B781FBD92CF.quest_desc: [
		"Kartáčová střela (&eGrape Shot&r) má krátký dostřel, ale je zničující proti posádce."
		"Výroba: střelný prach obklopený železnými nugety."
	]
	quest.171B8B781FBD92CF.title: "Kartáčová střela"
	quest.1735099CA4BA0CD3.quest_desc: [
		"Chata v lese nebo v tajze. Obsadili ji nájezdníci a jsou tu i jejich líhně."
		"&cNájezdníci střílí z kuší.&r Vezmi si štít."
	]
	quest.1735099CA4BA0CD3.title: "Lovecká chata"
	quest.173A30ED082BF6DD.quest_desc: [
		"Kodex dej doprostřed pracovního stolu a kolem něj 8 papírů. Vznikne mapa jeskyně (&eCave Biome Map&r)."
		"Mapa ukazuje cestu k nejbližšímu biomu, o kterém je kodex. Chvíli trvá, než ho najde."
		"Teď už nehledáš naslepo. Vyber si biom a vydej se tam! Každý biom je samostatná větev této kapitoly."
	]
	quest.173A30ED082BF6DD.quest_subtitle: "Pokročilý"
	quest.173A30ED082BF6DD.title: "Mapa jeskyně"
	quest.175163EF3C19610D.quest_desc: [
		"Banán (&eBanana&r) občas padá z &eTropického listí&r. Je to vzácné – asi jednou z 200 listů."
		"Nelámej listí nůžkami ani s Něžným dotekem, pak banán nepadá. Očarování &eŠtěstí&r šanci zvýší."
		"&aTip:&r Banány milují gorily a kapucínské opičky."
	]
	quest.175163EF3C19610D.title: "Banány!"
	quest.1763001FABDABD05.quest_desc: [
		"&bMeadow&r je mod o horském životě: sýry, nové krávy a vodní buvoli, horské květiny a sůl."
		"Najdi biom louka – je vysoko v horách a je plný květin. Tam najdeš alpskou sůl a pasou se tam huňaté krávy."
	]
	quest.1763001FABDABD05.title: "Horská louka"
	quest.176851D13ABD371F.quest_desc: [
		"Obří létající loď nájezdníků z &bCreate: Structures Arise&r. Vznáší se vysoko na nebi (asi ve výšce 160–190 bloků)."
		"Na palubě jsou nájezdníci, jejich líhně a líhně přízraků. Truhel je tu přes 40."
		"&aTip:&r Nahoru se dostaneš na Krovkách nebo po vysokém sloupu."
	]
	quest.176851D13ABD371F.title: "Vzducholoď nájezdníků"
	quest.17786125353785CC.quest_desc: [
		"Teď už nevaříš na pár kliknutí. Kvašení trvá i několik herních dní."
		"Kvasná káď (&eFermentation Vat&r) je z mědi. Víko (&eVat Lid&r) z mědi a dřevěného tlačítka."
		"Kvašení probíhá v krocích: nalij tekutinu (třeba ocet), vlož suroviny, později přidej sůl a zavři víko. Některé recepty trvají i několik dní."
		"Co a kdy přidat a jestli má být víko zavřené, ukáže JEI u každého receptu."
	]
	quest.17786125353785CC.quest_subtitle: "Expert"
	quest.17786125353785CC.title: "Kvasná káď"
	quest.1799673E36FB5277.quest_desc: [
		"&eMosazný tunel&r (&eBrass Tunnel&r) má filtr na každé straně a třídí věci podle druhu."
		"Tunely na souběžných pásech se spojí a rozdělují předměty mezi všechny pásy. Režim nastavíš na panelu: rozdělit, střídat (&eRound Robin&r), nejbližší, náhodně, synchronizovat."
	]
	quest.1799673E36FB5277.title: "Mosazný tunel"
	quest.17A4B36DCC49C0DE.quest_desc: ["Pondie (&eRaw Pondie&r) žije v řekách a v lesních biomech."]
	quest.17A4B36DCC49C0DE.title: "Pondie"
	quest.17B60BB5EB1ED5D9.quest_desc: [
		"Skříňka (&eCabinet&r) je úložný blok do kuchyně. Vyrobíš ji z dřevěných desek a poklopů."
		"Uloží věci jako truhla. Existuje ve všech druzích dřeva."
	]
	quest.17B60BB5EB1ED5D9.title: "Kuchyňská skříňka"
	quest.17D8685C44295A82.quest_desc: [
		"Pokladač s nožem v ruce (režim použití) krájí suroviny na krájecím prkénku. Mechanická paže na prkénko suroviny přikládá."
		"Krájet umí i mechanická pila. Nakrájej tak lososa na plátky (&eRaw Salmon Slice&r)."
	]
	quest.17D8685C44295A82.title: "Krájení stroji"
	quest.17DAB904B622395E.quest_desc: ["Armáda o 80 strážných. Žádný nájezdník už nemá šanci."]
	quest.17DAB904B622395E.title: "Centurion"
	quest.17EAEAF24D858EFB.quest_desc: [
		"Sekerou kácíš stromy mnohem rychleji."
		"Díky modu &bFallingTree&r stačí useknout spodní kmen a spadne celý strom. Každý kmen ale sekeru trochu opotřebuje."
	]
	quest.17EAEAF24D858EFB.title: "Sekera"
	quest.17F8A6E5CE08C8F9.quest_desc: [
		"Ve škole (&eSchool&r) se učí děti. Vyrostou z nich chytřejší dělníci a jsou spokojenější."
		"Výzkum &eHigher Learning&r stojí 3 knihy a potřebuješ domy s úrovněmi dohromady aspoň 3. Blok budovy vyrobíš z prken, 2 pírek a nástroje stavby."
	]
	quest.17F8A6E5CE08C8F9.title: "Škola"
	quest.17F8EDD1CB3ED485.quest_desc: [
		"Líheň vylepšíš tak, že na ni klikneš pravým tlačítkem s předmětem v ruce."
		"&eLucerna duší&r zařídí, že líheň funguje i za světla. Kolem farmy si tak můžeš svítit."
		""
		"Další vylepšení: &ecukr&r zkrátí čekání, &ezkvašené pavoučí oko&r přidá víc příšer naráz."
	]
	quest.17F8EDD1CB3ED485.title: "Líheň za světla"
	quest.181738C4B83D13CD.quest_desc: [
		"Měj v inventáři ohnivý krumpáč nebo meč a aspoň jeden kus ohnivé zbroje."
		"Ohnivá zbroj pálí útočníky. Ohnivý meč zapaluje a ohnivý krumpáč rovnou taví rudy."
		"&aTip:&r ohnivou výbavu vyrobíš i ze železné – dej železnou věc do stolu s ohnivou krví nebo slzami."
	]
	quest.181738C4B83D13CD.title: "Ohnivá výbava"
	quest.18175758F4C6687F.quest_desc: [
		"Rotační dělo (&eRotary Cannon&r) rychle pálí. Munice: střelný prach v inventáři letadla."
		"Výroba: dávkovač, průmyslová ozubená kola a měděný ingot."
	]
	quest.18175758F4C6687F.title: "Rotační dělo"
	quest.1824D157B51A373E.quest_desc: [
		"Do vinné lahve (&eWine Bottle&r) se stáčí šťáva i hotové víno. Ze 2 skleněných lahví vyrobíš 4 vinné lahve."
		"Měj jich vždy pár po ruce."
	]
	quest.1824D157B51A373E.title: "Vinné lahve"
	quest.182B5E7724CC5142.quest_desc: [
		"V pokladu mosazného dungeonu můžeš najít kus bouřkové zbroje (&eStormforged&r) nebo kovářskou šablonu na ni."
		"Šablona + jadeitová zbroj + bouřková deska (&eSquall Plate&r) na kovářském stole = bouřková zbroj. Skoro tě nejde odhodit a odhazuje útočníky."
	]
	quest.182B5E7724CC5142.title: "Bouřková zbroj"
	quest.18384BABEECF3578.quest_desc: [
		"Galenitová rukavice (&eGalena Gauntlet&r) se drží v druhé ruce. V hlavní ruce měj železný nebo netheritový nástroj."
		"Rukavice ho vystřelí asi 20 bloků daleko. Nástroj zraní moby nebo sám těží bloky, na které je určený."
		"Vyrobíš ji z lisovaného galenitu, &eTelecore&r, rudého neodymového ingotu a slizu &eFerrouslimeball&r (padá z Ferrouslime)."
	]
	quest.18384BABEECF3578.title: "Galenitová rukavice"
	quest.184A1714E7677BFB.quest_desc: [
		"&bSophisticated Storage&r: truhly a sudy, do kterých jdou vkládat vylepšení – stejně jako do batohu."
		"Sofistikovanou truhlu vyrobíš z obyčejné truhly a páky."
		"&aTip:&r Truhly a sudy jdou vylepšovat na měděné, železné, zlaté, diamantové a netheritové. Vyšší úroveň = víc slotů i víc míst na vylepšení."
	]
	quest.184A1714E7677BFB.title: "Sophisticated Storage"
	quest.1852415B0533B8C3.quest_desc: [
		"Poraz všechny bosse Aetheru tak, že tě ani jednou nezasáhnou."
		"Za bezchybné vítězství padají zvláštní odměny – třeba &eMedal of Honor&r od Královny Valkýr nebo &eSun Core&r od ducha slunce."
	]
	quest.1852415B0533B8C3.title: "Šampion Aetheru"
	quest.18807DC53DB15281.quest_desc: [
		"Postav druhý teleportér a v okně obou nastav stejnou frekvenci."
		"Oba teleportéry potřebují energii. Vejdi do rámu a přeneseš se k tomu druhému."
		"&aTip:&r Frekvence může být soukromá, nebo veřejná pro všechny hráče."
	]
	quest.18807DC53DB15281.title: "Projdi teleportérem"
	quest.18816F193EB4C844.quest_desc: [
		"Drtící kola zvládnou i suroviny z &bMekanismu&r: osmium, cín, olovo a uran. Praním z drti dostaneš 9 nugetů."
		"&aTip:&r Mekanism má vlastní, ještě výnosnější zpracování rud (kapitola Mekanism)."
	]
	quest.18816F193EB4C844.title: "Rudy z Mekanismu"
	quest.1885FF3AA50F7563.quest_desc: [
		"QIO (&eQuantum Item Orchestration&r) je digitální úložiště Mekanismu bez kabelů. Všechno spojuje frekvence."
		"Do pole disků (&eQIO Drive Array&r) vlož disky (&eQIO Drive&r). Panel (&eQIO Dashboard&r) ukazuje obsah a má v sobě pracovní stůl. V okně každého bloku nastav stejnou frekvenci."
		"&aTip:&r Bloky QIO mohou stát daleko od sebe. Stačí jim stejná frekvence."
	]
	quest.1885FF3AA50F7563.title: "QIO úložiště"
	quest.1895A796885301F6.quest_desc: [
		"Ropná pumpa tahá ropu z podloží. Hlavní díly jsou ložisko (&ePumpjack Bearing&r), hlava (&ePumpjack Head&r) a klika (&ePumpjack Crank&r)."
		""
		"Ložisko vyrobíš z mechanického ložiska, zinkových ingotů a andezitových slitin. Klika se skládá v mechanickém výrobníku."
		""
		"Ložiska budeš potřebovat dvě. Návod na stavbu krok za krokem najdeš v kapitole Ropa a palivo."
	]
	quest.1895A796885301F6.title: "Ropná pumpa"
	quest.18CDF21619413D48.quest_desc: ["Na Měsíci je i sýrová ruda (&eMoon Cheese Ore&r). Padá z ní sýr (&eCheese&r), který se dá jíst."]
	quest.18CDF21619413D48.title: "Měsíční sýr"
	quest.18D431CC01E4F168.quest_desc: [
		"&eMechanický píst&r (&eMechanical Piston&r) posouvá bloky před sebou. Jak daleko, určují &eprodlužovací ojnice&r (&ePiston Extension Pole&r) za ním. Bez nich se nehne."
		"Směr a rychlost určuje rotace, řadící páka ho pošle zpátky. Lepivý píst (&eSticky Mechanical Piston&r) bloky i přitáhne."
		"Když se zastaví, udělátko se změní zpátky na bloky. Na panelu pístu to jde změnit."
	]
	quest.18D431CC01E4F168.title: "Mechanický píst"
	quest.18E22BCDB12A379F.quest_desc: [
		"V háji úloh (&eQuest Grove&r) stojí obří beran (&eQuesting Ram&r). Chce sníst vlnu všech 16 barev."
		"Dej mu postupně jednu vlnu od každé barvy. Odmění tě bloky drahých kovů a trofejí."
	]
	quest.18E22BCDB12A379F.title: "Úlohový beran"
	quest.18E46CDD1738ED1D.quest_desc: [
		"Pizzu (&ePizza&r) slož na pracovním stole ze sýra, rajčatové omáčky, pšenice a dvou přísad navrch. Které přísady se hodí, ukáže JEI."
		"Pizzu polož jako blok a nakrájej ji nožem na kousky."
	]
	quest.18E46CDD1738ED1D.title: "Pizza"
	quest.18FFBBAA6C5B544A.quest_desc: [
		"Kasárny (&eBarracks&r) mají až 4 kasárenské věže a v každé až 5 strážných. To je až 20 strážných na malém místě."
		"Výzkum &eTactic Training&r stojí 3 bloky železa a strážní věže musí mít dohromady úroveň aspoň 3. Blok budovy: prkna, blok železa a nástroj stavby."
	]
	quest.18FFBBAA6C5B544A.title: "Kasárny"
	quest.190750F8E4472BF4.quest_desc: [
		"Když občan zemře, zůstane po něm hrob. Hrobník na hřbitově (&eGraveyard&r) hroby sbírá, takže kolonie truchlí kratší dobu."
		"Výzkum &eRemembrance&r stojí 8 kostí a radnice musí mít úroveň 2. Blok budovy: kámen, kost a nástroj stavby."
		"&aTip:&r hrobník může mrtvého občana i oživit. Šanci zvýší vyšší úroveň hřbitova, mystické místo a výzkum."
	]
	quest.190750F8E4472BF4.title: "Hřbitov"
	quest.192E963AA4039C95.quest_desc: [
		"Do síta (&eSifter&r) vlož písek, hlínu nebo štěrk."
		"Většinou z nich vypadnou obyčejné věci, ale občas i fosilie, úlomek keramiky (&ePottery Shard&r) nebo vzácně jantar."
		"&aJe to pomalejší, ale bezpečná cesta k fosiliím bez kopání.&r"
	]
	quest.192E963AA4039C95.title: "Síto"
	quest.1932A1E98A5367D7.quest_desc: [
		"Míchaný salát (&eMixed Salad&r) se nevaří. Slož ho na pracovním stole ze zelí, rajčete, řepy a misky."
		"Míchaný salát dává na chvíli regeneraci. Hodí se, když potřebuješ rychle doplnit zdraví."
	]
	quest.1932A1E98A5367D7.title: "Míchaný salát"
	quest.193B1F3E6F82C26B.quest_desc: [
		"Ovocné stromy z Pam's rostou v lesích. Ovoce visí na stromě jako malý blok."
		"Zralé ovoce utrhneš pravým tlačítkem. Strom pak plodí znovu."
	]
	quest.193B1F3E6F82C26B.title: "Ovocné stromy"
	quest.19563EC35BF2FE1B.quest_desc: [
		"Síť AE2 potřebuje energii. Akceptor energie (&eEnergy Acceptor&r) převádí FE z jiných modů na energii AE (2 FE = 1 AE)."
		"Napoj ho na zdroj FE, třeba na generátor Mekanismu, a polož ho do sítě."
		"&aTip:&r Bez cizího zdroje energie použij vibrační komoru (&eVibration Chamber&r). Spaluje palivo jako pec."
	]
	quest.19563EC35BF2FE1B.title: "Energie pro síť"
	quest.1966A23814567DDD.quest_desc: [
		"Teď už elektřinu jen nepřenášíš – začínáš s ní vyrábět. Teslova cívka nabíjí suroviny a mění je na nové."
		""
		"Pod teslovu cívku dej odkládací desku (&eDepot&r) a polož na ni zlatý ingot. Cívka ho nabije a vznikne elektrum (&eElectrum Ingot&r). Stejně se nabíjí zlatá tyč, drát, plát nebo blok."
		"{@pagebreak}"
		"Elektrum potřebuješ na elektrový drát do akumulátoru a na silné vedení."
		""
		"&aNabíjecí recepty najdeš v JEI pod „Charging“. Z obyčejné knihy cívka udělá i očarovanou knihu (&eChanneling&r) – stojí to ale 1 000 000 ⚡.&r"
	]
	quest.1966A23814567DDD.quest_subtitle: "Pokročilý"
	quest.1966A23814567DDD.title: "Elektrum nabíjením"
	quest.196EBDD4F25169D0.quest_desc: [
		"Teď vyraz za velkými stavbami. Jsou dál a některé hlídají nepřátelé."
		"Hrad z modu &bIntegrated Dungeons and Structures&r stojí v lese, březovém lese, na nížině nebo horské louce. Žijí v něm vesničané."
		"Je v něm knihovna, ložnice, sklady i trůnní sál – a desítky truhel."
	]
	quest.196EBDD4F25169D0.quest_subtitle: "Pokročilý"
	quest.196EBDD4F25169D0.title: "Hrad"
	quest.196F458F6FD8019D.quest_desc: [
		"Odraž nájezd a seber mytickou knihu (&eAncient Tome&r). Padá z nájezdníků."
		"Když přijde zpráva o nájezdu, připrav se: vezmi zbraň a pomoz strážným."
		"Kolonie, která nájezd přežije bez mrtvých občanů, je spokojenější. Mytickou knihu potřebuje zaklínač a výzkum."
	]
	quest.196F458F6FD8019D.title: "Odraz nájezd"
	quest.197A35FB09EDEE74.quest_desc: [
		"Dva základní kuchyňské bloky. Oba polož na stůl nebo na zem."
		"Do míchací misky (&eCrafting Bowl&r) vkládej suroviny pravým tlačítkem. Pak ji pravým tlačítkem míchej, dokud není hotovo."
		"Krájecí prkénko (&eCutting Board&r) potřebuje nůž nebo sekáček – o tom je další úkol."
	]
	quest.197A35FB09EDEE74.title: "Miska a prkénko"
	quest.1984239AF845A437.quest_desc: [
		"Parní píšťala (&eSteam Whistle&r) na vlaku houká. Přidej ji na vlak před sestavením a za jízdy zmáčkni klávesu sprintu."
		"Výroba: zlatý plát a měděný ingot."
	]
	quest.1984239AF845A437.title: "Tú tú!"
	quest.198A9F732E3C23A9.quest_desc: [
		"Dort očarování (&eCake o' Enchanting&r) přepne plamenné stroje do super režimu."
		""
		"Mechanickým lisem v tyglíku (&eBasin&r) slisuj vejce, cukr a lapis. Vznikne základ dortu. Dávkovačem (&eSpout&r) ho polij 1 000 mB tekutých zkušeností."
		""
		"Nakrm dortem očarovávač nebo kováře a stroj začne vřít. Dort jde do druhého zásobníku stroje – ten trubkou nenaplníš."
	]
	quest.198A9F732E3C23A9.title: "Dort očarování"
	quest.19936261DDBD3E53.quest_desc: [
		"Wither je boss, kterého si vyvoláš sám: 4 bloky duší písku do tvaru T a na ně 3 lebky wither kostlivců."
		"&cWither ničí bloky kolem sebe. Bojuj s ním hluboko pod zemí nebo daleko od základny!&r"
		"Po smrti upustí hvězdu Netheru (&eNether Star&r). Z ní vyrobíš maják a v Incendiu s ní vyvoláš dalšího bosse."
	]
	quest.19936261DDBD3E53.quest_subtitle: "Expert"
	quest.19936261DDBD3E53.title: "Wither"
	quest.19A55250631AA143.quest_desc: [
		"Měj v kolonii 30 strážných. Taková armáda zvládne i velké nájezdy."
		"Vylepšuj kasárny i věže na úroveň 5 a dělej bojové výzkumy ve větvi &eCombat&r."
	]
	quest.19A55250631AA143.quest_subtitle: "Expert"
	quest.19A55250631AA143.title: "Poručík"
	quest.19A84226A3F57276.quest_desc: [
		"&bMacaw's Furniture&r: stoly, židle, skříně, šuplíky, kuchyňské linky a dřezy."
		"Psací stůl (&eOak Desk&r) je z kmenů a plotů. Na skříň (&eOak Wardrobe&r) potřebuješ dvířka (&eCabinet Door&r) z tyček, truhly a železného nugetu."
		"&aTip:&r skříně a šuplíky jsou zároveň úložné truhly."
	]
	quest.19A84226A3F57276.title: "Nábytek Macaw's"
	quest.19B3B287D9587A80.quest_desc: [
		"Uklidňující salát (&eSerene Salad&r) ruší omráčení a pomáhá ochočit některé dinosaury."
		"Recept: kapradinový výhonek (&eFiddlehead&r), stromová hvězda, piniové oříšky (&ePine Nuts&r) a miska."
		"Výhonky získáš jen od Grottoceratopse, když sní kudrnatou kapradinu (&eCurly Fern&r)."
		"&aVallumraptora ochočíš takto: dej do truhly nugetky. Když si je ukradne a sní, může se uklidnit. Pak mu dej salát.&r"
	]
	quest.19B3B287D9587A80.title: "Uklidňující salát"
	quest.19DA1802E27114B4.quest_desc: [
		"Dva ruční nástroje pro začátek, než postavíš stroje."
		""
		"Kladivo (&eHammer&r): vezmi ingot do druhé ruky a použij kladivo (pravé tlačítko). Ze železného, měděného, zlatého nebo mosazného ingotu tak vyklepeš plát."
		""
		"Štípačky (&eWire Cutters&r) se používají stejně. Z prken nastříhají 4 klacky. S modem &bCreate Crafts \\& Additions&r stříhají z plátů i dráty."
		""
		"&aTip: Všechny recepty ukáže JEI v záložkách Hammering a Wire Cutting.&r"
	]
	quest.19DA1802E27114B4.title: "Kladivo a štípačky"
	quest.19DF9F56491C83F0.quest_desc: [
		"Chemická vstřikovací komora (&eChemical Injection Chamber&r) je třetí stupeň: z bloku rudy udělá 4 střepy (např. &eIron Shard&r), ze 3 vytěžených rud 8. Potřebuje chlorovodík."
		"Střepy dej do čisticí komory – udělá z nich hrudky – a dál pokračuj linkou jako u 3× zpracování."
		"Chlorovodík přiveď trubkou z chemického infuzéru. Nouzově jde vložit sůl do slotu na plyn."
		"&aTip:&r Vstřikovací komora udělá ze střelného prachu sirný prach (&eSulfur Dust&r). Bude se hodit na kyselinu sírovou."
	]
	quest.19DF9F56491C83F0.title: "4× rudy: vstřikovací komora"
	quest.19E80DAA7656656D.quest_desc: [
		"Teď už jeden pohon nestačí – mosazná výbava spojí vodu i palivo a dělá z nich páru. Potřebuje parní motorek z tohoto modu (&eSteam Engine&r)."
		""
		"&cNepleť si ho s velkým parním strojem z Create – tohle je jen součástka.&r"
		""
		"Vyrobíš ho sekvenční montáží. Na mosazný plát pokladač nasadí ozubené kolečko, velké ozubené kolečko, vrtuli a andezitovou slitinu. Celé se to opakuje třikrát."
		""
		"&aZ parního motorku vyrobíš mosazný jetpack (quest v kapitole Create: doplňky), mosazný exoskelet a přenosný vrták (&ePortable Drill&r).&r"
	]
	quest.19E80DAA7656656D.quest_subtitle: "Pokročilý"
	quest.19E80DAA7656656D.title: "Parní motorek"
	quest.1A08153DA1E42C9B.quest_desc: [
		"Glacio je zamrzlá planeta u Proximy Centauri. Má dýchatelný vzduch, takže tu přežiješ i bez skafandru."
		"&cJe tu ale velká zima.&r Najdeš tu i ledové střepy pro kryopalivo."
	]
	quest.1A08153DA1E42C9B.title: "Glacio"
	quest.1A1B9479A0E6A955.quest_desc: [
		"Mumie se objevuje v noci v poušti a v pustině."
		"&cMá kouzelný amulet, kterým mění druh útoků.&r Může z ní padnout &eMummy Wraps&r. S nimi na hlavě tě nic neotráví a nemáš hlad."
	]
	quest.1A1B9479A0E6A955.title: "Mumie"
	quest.1A6B556D20C994F0.quest_desc: ["Těsto (&eCornbread Batter&r) slož ze dvou kukuřic, mléka a vejce. Upeč ho v peci, udírně nebo na táboráku."]
	quest.1A6B556D20C994F0.title: "Kukuřičný chléb"
	quest.1A6C8FD8A0D3C1E1.quest_desc: [
		"Razítkovač (&eInscriber&r) lisuje pomocí lisů z meteoritu plošné spoje a procesory."
		"Vyrobíš ho ze železa, pístu a mědi."
	]
	quest.1A6C8FD8A0D3C1E1.title: "AE2: razítkovač"
	quest.1A760F58BAC41BD4.quest_desc: [
		"&eDrtící kolo&r (&eCrushing Wheel&r) vyrobíš v mechanickém výrobníku (mřížka 5×5, dá 2 kola)."
		"Polož 2 kola s mezerou 1 bloku. Musí se točit proti sobě, aby předměty vtahovala do mezery. Předměty hoď nebo vlož shora."
		"Drtí rudy s bonusy a umí i vše, co mlýnský kámen. Každé kolo bere 8 SU na RPM, pár tedy 16. Návod je v kapitole Zpracování rud."
	]
	quest.1A760F58BAC41BD4.title: "Drtící kola"
	quest.1A7BA8E9D9FF9F38.quest_desc: [
		"Jantar (&eAmber&r) visí ze stropu jeskyně. Vytěžíš ho jen krumpáčem s očarováním Hedvábný dotek, jinak z něj nic nepadne. Dinosauří maso (&eDinosaur Chop&r) padá z velkých dinosaurů."
		"Maso si opeč. &aZ opečeného masa vyrobíš 12 dinosauřích nugetek (&eDinosaur Nugget&r).&r"
	]
	quest.1A7BA8E9D9FF9F38.title: "Jantar a maso"
	quest.1A7EC3312DFC255D.quest_desc: [
		"Anu je hlavní boss modu. Bojuje starodávným mečem a na dálku střílí ohnivé koule."
		"Po smrti upustí starodávný klíč (&eAncient Key&r) a zůstane po něm mrtvé tělo."
	]
	quest.1A7EC3312DFC255D.quest_subtitle: "Expert"
	quest.1A7EC3312DFC255D.title: "Porazit Anu"
	quest.1A985373EB0F1932.quest_desc: [
		"Lano (&eRope&r) vyrobíš ze dvou kusů slámy nad sebou. Dostaneš 4 kusy."
		"Po laně se dá šplhat. Rajčata po něm rostou do výšky."
		"&aTip:&r Ze 4 lan uděláš záchrannou síť (&eSafety Net&r), která tlumí pád."
	]
	quest.1A985373EB0F1932.title: "Lano"
	quest.1AA1223E5333EA03.quest_desc: [
		"&eOsmium&r je hlavní kov Mekanismu. Jeho ruda (&eOsmium Ore&r) se vyskytuje v kameni skoro v jakékoli výšce."
		"Vytěžené osmium (&eRaw Osmium&r) přetav v peci na osmiový ingot (&eOsmium Ingot&r)."
		"&aTip:&r Mekanism přidává i rudy cínu, olova, uranu a fluoritu. Zatím je jen schovávej, budou se hodit."
	]
	quest.1AA1223E5333EA03.title: "Osmium"
	quest.1AB1710DBADB6A2E.quest_desc: [
		"&bThe Aether&r je nebeská dimenze plovoucích ostrovů. Má vlastní dřevo, kámen, rudy, zvířata a tři dungeony s bossy."
		"V kapitole projdeš celý postup: od prvních nástrojů přes bronzový, stříbrný a zlatý dungeon až po nejlepší výbavu."
		"Po ní můžeš pokračovat kapitolou &bDeep Aether&r."
	]
	quest.1AB1710DBADB6A2E.title: "Nebe nad hlavou"
	quest.1ADF4E050B7F36F4.quest_desc: ["Ingot &eNetherite-Emerald Ingot&r vyrobíš z ingotu &eNetherite-Gold Ingot&r a 4 smaragdů."]
	quest.1ADF4E050B7F36F4.title: "Netherit-smaragd"
	quest.1AE902323AFA0109.quest_desc: [
		"Chyť do kbelíku všech 10 druhů ryb z &bFish of Thieves&r: splashtail, pondie, islehopper, ancientscale, plentifin, wildsplash, devilfish, battlegill, wrecker a stormfish."
		"Wildsplash žije v oceánech, na plážích, v džungli a v bujných jeskyních."
	]
	quest.1AE902323AFA0109.quest_subtitle: "Expert"
	quest.1AE902323AFA0109.title: "Sběratel ryb"
	quest.1B09069D85D56ADE.quest_desc: [
		"Do diskové jednotky (&eDisk Drive&r) vlož disk (&e1k Storage Disk&r) – pojme 1 000 předmětů."
		"V mřížce (&eGrid&r) vidíš všechno, co je v síti, a můžeš to vkládat i brát."
	]
	quest.1B09069D85D56ADE.title: "RS: disky a mřížka"
	quest.1B0C81A88186DBA9.quest_desc: [
		"Luxtructosaurus je nemrtvý dinosaurus zavřený v sopce. Má 600 bodů zdraví a oheň mu neublíží."
		"&cDupe, kope a máchá ocasem, který ti vyřadí štít. Když zuří, chrlí oheň. Během boje sopky kolem vybuchují.&r"
		"Po smrti z něj zbudou tektonické úlomky (&eTectonic Shard&r)."
	]
	quest.1B0C81A88186DBA9.quest_subtitle: "Expert"
	quest.1B0C81A88186DBA9.title: "Luxtructosaurus"
	quest.1B29C1AD4CB94C39.quest_desc: [
		"Postav aspoň jednu rezidenci na úrovni 1."
		"Pak domy postupně vylepšuj. V domě vyšší úrovně bydlí víc lidí a jsou spokojenější."
		"&aTip:&r v radnici je volba, která bezdomovce sama přidělí do volných domů."
	]
	quest.1B29C1AD4CB94C39.quest_subtitle: "Začátečník"
	quest.1B29C1AD4CB94C39.title: "Dům, sladký dům"
	quest.1B2CD46894452D3D.quest_desc: [
		"Postav větrný mlýn se 128 plachtami. Točí se pak nejvyšší rychlostí 16 RPM a dá 8 192 SU."
		"Výkon mlýna závisí jen na počtu plachet. Tvar mlýna je jedno, počítají se jen bloky plachet."
		"&aTip:&r Velký mlýn drží pohromadě lepidlo nebo radiální šasi (kapitola Stroje a automatizace)."
	]
	quest.1B2CD46894452D3D.title: "Silný vítr"
	quest.1B5E779959EC8E19.quest_desc: [
		"Stromová hvězda (&eTree Star&r) roste na pradávných stromech."
		"Je to oblíbené jídlo mnoha dinosaurů. Grottoceratopse s ní rozmnožíš."
	]
	quest.1B5E779959EC8E19.title: "Stromová hvězda"
	quest.1B5F5A5EEF3D8840.quest_desc: [
		"Svitek zdrojů (&eResource Scroll&r) nosíš s sebou. Ukazuje, co stavitel ještě potřebuje, takže nemusíš běhat k jeho budově."
		"Vyrobíš ho z tyček, 2 kůží a nástroje stavby. Propojíš ho Shift + pravým tlačítkem na stavitelovu budovu."
	]
	quest.1B5F5A5EEF3D8840.title: "Svitek zdrojů"
	quest.1B79F1EED8E99AA2.quest_desc: [
		"Lokokov (&eLocometal&r) je sada kovových bloků pro stavbu opravdových lokomotiv: plechy, kotle, dýmnice, okna i dveře."
		"Kamenořez udělá z jednoho železného bloku 8 kusů nýtovaného lokokovu (&eRiveted Locometal&r). Další tvary pak vybereš v kamenořezu."
		"&aNěkteré bloky mají více variant. Podrž Alt a vyber si.&r"
	]
	quest.1B79F1EED8E99AA2.title: "Lokokov"
	quest.1B7FAC3BB1E9969D.quest_desc: [
		"Teď už nejde o průzkum, ale o boj s bossem. Magnetron je vzácný a silný strážce magnetických jeskyní."
		"Zpočátku se jen nenápadně kutálí."
		"Když tě uvidí, postaví si z okolních bloků obří tělo. &cKovadliny a pily v okolí použije jako zbraně.&r"
		"Po smrti se rozpadne a zůstane po něm srdce ze železa (&eHeart of Iron&r)."
	]
	quest.1B7FAC3BB1E9969D.quest_subtitle: "Expert"
	quest.1B7FAC3BB1E9969D.title: "Magnetron"
	quest.1B981390DC9EE5D3.quest_desc: [
		"&bCreate: Central Kitchen&r propojí Create s kuchyní Farmer's Delight."
		"Ohňohořák (&eBlaze Burner&r) funguje jako zdroj tepla pro hrnec. Mechanická paže (&eMechanical Arm&r) do hrnce vkládá misky a hotové jídlo vybírá (umí to i trychtýř)."
		"Zkus si tak automaticky uvařit dýňovou polévku (&ePumpkin Soup&r)."
	]
	quest.1B981390DC9EE5D3.title: "Automatická kuchyně"
	quest.1B9A1BD470E4E831.quest_desc: [
		"Mod &bMedieval Buildings End Edition&r staví v Endu středověké domy, svatyně, pyramidy, lodě a hrady."
		"Najdi jeden z jeho domů."
	]
	quest.1B9A1BD470E4E831.title: "Středověký End"
	quest.1B9AD1A92F3D1580.quest_desc: [
		"Skenovací nástroj (&eScan Tool&r) uloží stavbu do souboru. Vyrobíš ho ze 2 tyček a železného ingotu."
		"Levým tlačítkem označ první roh, pravým druhý roh. Pak klikni pravým do vzduchu – otevře se okno, kde sken pojmenuješ a uložíš."
		"Tlačítko &eShow Resources&r ukáže, z jakých bloků se stavba skládá a kolik jich je."
		"&aTip:&r jestli ti stavitel smí postavit tvůj vlastní sken, záleží na nastavení serveru."
	]
	quest.1B9AD1A92F3D1580.quest_subtitle: "Pokročilý"
	quest.1B9AD1A92F3D1580.title: "Skenovací nástroj"
	quest.1BA076A1293B13A5.quest_desc: [
		"Jednokolejka (&eMonorail Train Track&r) je jediná kolejnice na nosníku. Vypadá moderně a hodí se do měst."
		"Vyrábí se z kovového nosníku (&eMetal Girder&r): pokladače přidají kovový držák a železný plát, lis vše stiskne. Vznikne 6 kusů."
		"Jezdí po ní jednokolejkový podvozek (&eMonobogey&r) z nabídky podvozků."
	]
	quest.1BA076A1293B13A5.title: "Jednokolejka"
	quest.1BB353FBE065ECBE.quest_desc: [
		"Teď přichází nejtěžší část lesa. Porážka hydry, Ur-Ghasta a Sněhové královny zruší kyselý déšť nad vysočinou."
		"Vysočina (&eTwilight Highlands&r) jsou vysoké hory na okraji lesa."
	]
	quest.1BB353FBE065ECBE.quest_subtitle: "Expert"
	quest.1BB353FBE065ECBE.title: "Velké finále"
	quest.1BEFC0DE050F0E96.quest_desc: [
		"Ze shulkerů padají schránky (&eShulker Shell&r). 2 schránky a truhla dají shulkerovou krabici (&eShulker Box&r)."
		"Shulkerová krabice si po rozbití nechá všechny věci uvnitř. Můžeš ji nosit v inventáři i s obsahem."
	]
	quest.1BEFC0DE050F0E96.title: "Schránky shulkerů"
	quest.1C0665A5EFA28D42.quest_desc: [
		"Velkého dravce (třeba tyranosaura) ochočíš skarabeovým drahokamem."
		"Vodní dravce ochočíš vodním drahokamem (&eAquatic Scarab Gem&r) ze skarabeového drahokamu a dominikánského jantaru."
	]
	quest.1C0665A5EFA28D42.title: "Král zvířat"
	quest.1C18A627DCED2FB4.quest_desc: [
		"Geigerův počítač (&eGeiger Counter&r) měří radiaci v okolí. Dozimetr (&eDosimeter&r) ukáže, kolik radiace jsi už dostal ty."
		"Když počítač ukazuje zvýšenou radiaci, odejdi a vezmi si ochranný oblek."
		"&aTip:&r Radiace v okolí časem sama klesá."
	]
	quest.1C18A627DCED2FB4.title: "Měření radiace"
	quest.1C4648E68A43F12A.quest_desc: [
		"Přenosný motor (&ePortable Engine&r) je zdroj rotace přímo na lodi. Pálí paliva jako pec, třeba uhlí nebo dřevo."
		"Výroba: železný plát, sestava motoru a vysoká pec. Barvivem ho v pracovním stole přebarvíš."
		"Směr otáčení se dá přepnout. Palivo do něj můžeš dodávat i automaticky."
		"&aOhňodort (&eBlaze Cake&a) ho přetopí na vyšší výkon.&r"
	]
	quest.1C4648E68A43F12A.title: "Přenosný motor"
	quest.1C48601519B5B200.quest_desc: [
		"Kuřecí koláč (&eChicken Pot Pie&r) slož z pekáče, syrového kuřete, brambory, mrkve a těsta."
		"Spojuje maso a zeleninu, takže dobře zasytí."
	]
	quest.1C48601519B5B200.title: "Kuřecí koláč"
	quest.1C6FF91D4AC58B74.quest_desc: [
		"&eParní motor&r (&eSteam Engine&r): zlatý plát, andezitová slitina a blok mědi. Polož ho na nádrž, nádrž se tím stane &ekotlem&r."
		"Klikni na motor hřídelí, tím vznikne výstup. Kotel potřebuje &evodu&r (čerpadlem), &eteplo&r (ohňohořáky pod nádrží) a &evelikost&r (aspoň 4 bloky nádrže)."
		"Brýle na kotli ukážou jeho úroveň a co chybí. Motor na plný výkon dá 16 384 SU při 64 RPM, to je jako 64 mlýnských kol. Návod je v kapitole Energie a stres."
	]
	quest.1C6FF91D4AC58B74.quest_subtitle: "Expert"
	quest.1C6FF91D4AC58B74.title: "Parní motor"
	quest.1C8F386969125047.quest_desc: [
		"&eOhňodort&r (&eBlaze Cake&r) udělá hořák &epřehřátý&r. Přehřátý hořák dá kotli 2 úrovně tepla místo jedné."
		"Lis v tyglíku slisuje uškvařenou mouku, vejce a cukr na &ekorpus&r (&eBlaze Cake Base&r). Dávkovač na něj nalije 250 mB lávy."
		"Hořák dort sní a chvíli hoří naplno. Krm ho pokladačem nebo paží. &aTip:&r Míchačka nad tyglíkem s přehřátým hořákem udělá z dlažebního kamene lávu (50 mB z kusu)."
	]
	quest.1C8F386969125047.title: "Ohňodort"
	quest.1C96E293C768332B.quest_desc: [
		"Kovářská šablona (&eSmithing Template&r) na vylepšení netheritu leží v truhlách bastionu."
		"Při vylepšení se šablona spotřebuje. Kopii vyrobíš ze šablony, 7 diamantů a 1 bloku netherracku – dostaneš 2 šablony."
	]
	quest.1C96E293C768332B.title: "Netheritová šablona"
	quest.1C9EA56BAC5D63F4.quest_desc: [
		"Když otevřeš 100 nádob s kořistí, dostaneš trofej (&eCentennial Trophy&r)."
		"Postav si ji doma na čestné místo."
	]
	quest.1C9EA56BAC5D63F4.quest_subtitle: "Expert"
	quest.1C9EA56BAC5D63F4.title: "Trofej"
	quest.1CB72875A95987F4.quest_desc: [
		"Teď už nemusíš volit mezi průrazem a výbuchem. Průbojný granát (&eArmor Piercing (AP) Shell&r) prorazí bloky a vybuchne až uvnitř opevnění."
		""
		"Složí ho mechanický výrobník z litiny, železa, &ePacked Guncotton&r a desky."
		""
		"Zapalovač se mu dává zespodu. Proto použij setrvačný zapalovač (&eInertia Fuze&r), který funguje i zespodu. Nárazový zapalovač tam nefunguje."
		""
		"Setrvačný zapalovač je z kamenného tlačítka, vratné pružiny (&eRecoil Spring&r) a redstonu. Pružinu uděláš z pružinového drátu (&eSpring Wire&r): pila ho nařeže ze železného plátu a lis ho 3× slisuje (sekvenční montáž)."
	]
	quest.1CB72875A95987F4.title: "Průbojný granát"
	quest.1CC00E126A7BE00D.quest_desc: [
		"Teď z balicího stolu uděláš první dárek."
		""
		"Balicí papír (&eRed Wrapping Paper&r) vyrobíš z 8 papírů a červeného barviva. Do balicího stolu vlož věc, kterou chceš darovat, a balicí papír. Za chvíli vznikne zabalený dárek (&eRed Present&r)."
		""
		"&aKdo dárek drží v ruce a klikne pravým tlačítkem, rozbalí ho a dostane věc uvnitř.&r"
	]
	quest.1CC00E126A7BE00D.title: "Zabal dárek"
	quest.1CC441BF06A026DE.quest_desc: [
		"Rozhraní (&eME Interface&r) je jako malá truhla napojená na síť. Nastavíš v něm, co má mít vždy na skladě, a samo si to ze sítě doplní."
		"Ostatní stroje a trubky si z něj mohou brát. Věci, které do nenastaveného rozhraní vložíš, jdou do sítě."
		"&aTip:&r Rozhraní je klíčem k pokročilým trikům s podsítěmi. Najdeš je v průvodci AE2."
	]
	quest.1CC441BF06A026DE.title: "Rozhraní"
	quest.1CF15D4B968968A7.quest_desc: [
		"Jaderná bomba (&eNuclear Bomb&r) zničí obrovské okolí a všechny kolem ozáří."
		"&cNikdy ji neodpaluj blízko své nebo cizí základny!&r"
		"&aZapálenou bombu ještě zneškodníš: klikni na ni pravým tlačítkem s nůžkami.&r"
	]
	quest.1CF15D4B968968A7.title: "Jaderná bomba"
	quest.1D0A6772A9C68AD9.quest_desc: [
		"Pekař (&eBakery&r) peče chleba, sušenky, dýňový koláč a dort. Pekař umí i speciální chleby."
		"Blok budovy vyrobíš z prken, pšenice a nástroje stavby. V nastavení pekárny vybereš, co má péct."
	]
	quest.1D0A6772A9C68AD9.title: "Pekárna"
	quest.1D259BC31020E5EE.quest_desc: [
		"P2P tunel (&eME P2P Tunnel&r) je jako portál mezi dvěma místy. Přenáší kanály, předměty, kapaliny, energii nebo redstone."
		"Typ změníš kliknutím na tunel: kabelem = kanály, truhlou nebo násypkou = předměty, kbelíkem = kapaliny, redstonovou součástkou = redstone."
		"Vstup a výstup propojíš paměťovou kartou (&eMemory Card&r): Shift + pravým tlačítkem na vstup, pak pravým na výstup."
		"&aTip:&r ME P2P tunel přenese 32 kanálů i přes obyčejný kabel."
	]
	quest.1D259BC31020E5EE.title: "P2P tunely"
	quest.1D3F45164E8BDD8E.quest_desc: [
		"&bCreate: Diesel Generators&r přidává motory na kapalné palivo, těžbu ropy a její zpracování."
		""
		"Pár pojmů: &eMotor&r mění palivo na rotaci. &ePalivo&r je hořlavá kapalina, kterou motor pomalu spaluje."
		""
		"&emB&r je jednotka kapaliny: 1 kbelík = 1 000 mB. &eSU&r je síla otáčení, kterou motor dává a stroje Create spotřebovávají. Inženýrské brýle ti ukážou, kolik jí zbývá."
		"{@pagebreak}"
		"Cesta kapitolou:"
		"&aZačátečník&r – ruční nástroje, první motor a palivo ze semínek."
		"&aPokročilý&r – linka, která palivo vyrábí sama, a těžba ropy."
		"&aExpert&r – destilační věž, obří motor a celá naftová elektrárna."
		""
		"&aTip: K hlavním strojům má mod animovaný návod (ponder). Najeď myší na předmět a podrž W.&r"
	]
	quest.1D3F45164E8BDD8E.quest_subtitle: "Create: Diesel Generators"
	quest.1D3F45164E8BDD8E.title: "Ropa a palivo"
	quest.1D57C8E7CA0E63C1.quest_desc: [
		"Vozík s pracovním stolem (&eMinecart with Workbench&r) vyrobíš z vozíku a pracovního stolu."
		"Existuje i vozík s jukeboxem (&eMinecart with Jukebox&r)."
		"&aObojí jezdí po obyčejných kolejích pro vozíky, ne po vlakových.&r"
	]
	quest.1D57C8E7CA0E63C1.title: "Vozík s pracovním stolem"
	quest.1D60740D417E799A.quest_desc: [
		"Kotel pije hodně vody. Každá úroveň kotle potřebuje 10 mB vody za tick (200 mB za sekundu)."
		"Čerpadlo dodá tím víc, čím rychleji se točí. Na 256 RPM stačí jedno čerpadlo zhruba na 12 úrovní."
		"Otevřený konec potrubí ve vodě vodu nasává, ale bere zdrojové bloky. Nekonečnou vodu dá hadicová kladka v jezeře nebo moři."
	]
	quest.1D60740D417E799A.title: "Voda pro kotel"
	quest.1D612EB2C3CFC37F.quest_desc: [
		"Korálový kámen (&eCoralstone&r) vyrobíš z 8 &eKamenných cihel&r a &eUlity loděnky&r (dá 8 kusů)."
		"Když leží vedle bloku korálu, časem se změní na korálový kámen té barvy."
	]
	quest.1D612EB2C3CFC37F.title: "Korálový kámen"
	quest.1D76860F67F0A92A.quest_desc: [
		"&eSchématický stůl&r (&eSchematic Table&r) nahraje uložený soubor na prázdné schéma. Vlož prázdné schéma a vyber soubor ze seznamu."
		"Soubory jsou ve složce &eschematics&r ve složce hry. Můžeš tam dát i schémata od kamarádů."
	]
	quest.1D76860F67F0A92A.title: "Schématický stůl"
	quest.1D7A5D198B0058FC.quest_desc: [
		"&bCreate: Trading Floor&r umí obchodovat s vesničany automaticky. Už nemusíš klikat na každý obchod."
		""
		"Obchodní stolek (&eTrading Depot&r) vyrobíš z odkládací desky (&eDepot&r) a 2 elektronek (&eElectron Tube&r)."
		""
		"Polož ho hned vedle pracovního bloku vesničana. Když vesničan příště pracuje u svého bloku, obchoduje se stolkem."
	]
	quest.1D7A5D198B0058FC.quest_subtitle: "Create: Trading Floor"
	quest.1D7A5D198B0058FC.title: "Obchodní stolek"
	quest.1DAD7B6372D9A028.quest_desc: [
		"Pevné bramborové dělo (&eMounted Potato Cannon&r) je blok, který střílí stejnou munici jako ruční bramborové dělo."
		"Rotace dělo nabije, redstonový signál ho odpálí. Při trvalém signálu střílí pořád. Munici mu můžeš dodávat i automaticky."
		"Vyrábí se v mechanickém výrobníku."
	]
	quest.1DAD7B6372D9A028.title: "Ozbrojená loď"
	quest.1DB3DE0E96A64A9D.quest_desc: [
		"Elektřina (⚡, v jiných modech FE) je energie, která běží po drátech. Dostane se daleko a pohání i stroje z jiných modů, třeba Mekanism nebo AE2."
		""
		"Create jinak pracuje s otáčením. Rychlost otáčení je RPM. Síla otáčení je SU – každý stroj nějaké SU spotřebuje a zdroj jich má jen omezeně."
		"{@pagebreak}"
		"Elektřinu přidávají dva mody: &bCreate Crafts \\& Additions&r (alternátor, elektromotor, teslova cívka, akumulátor) a &bCreate: New Age&r (generátor s magnety, energizér, teplo a jaderný reaktor)."
		""
		"Každá linka má tři úrovně: &eZačátečník&r, &ePokročilý&r a &eExpert&r. Milníky (šestiúhelníky) ukazují, kdy přecházíš na další úroveň."
		""
		"&aKaždý mod má své vlastní dráty a konektory. Kolik energie stroj má, ti ukážou inženýrské brýle.&r"
	]
	quest.1DB3DE0E96A64A9D.title: "Elektřina v Create"
	quest.1DC9248C9E16C280.quest_desc: [
		"Kondenzátor (&eCapacitor&r) je elektrická součástka. Tady ho potřebuješ jako díl do elektromotoru, teslovy cívky, akumulátoru a elektrické pumpy."
		""
		"Vyrobíš ho z měděného plátu, zinkového plátu (&eZinc Sheet&r) a redstonové pochodně. Zinkový plát vylisuješ mechanickým lisem ze zinkového ingotu."
	]
	quest.1DC9248C9E16C280.title: "Kondenzátor"
	quest.1DC954F94CC95321.quest_desc: [
		"&eOvládací prvky udělátka&r (&eContraption Controls&r) zapnou a vypnou pracovní díly za jízdy."
		"Filtrem vybereš, které díly ovládají. Dají se přilepit kamkoli na udělátko."
	]
	quest.1DC954F94CC95321.title: "Ovládání udělátka"
	quest.1DD3E07AE2357B51.quest_desc: [
		"Podzemní komplex z mědi a tufu. Najdeš ho hluboko pod zemí."
		"&cHledej dál od spawnu, v nově objevené krajině.&r Ve starší části světa se komnaty negenerovaly."
		"&eLíheň klání&r posílá vlny příšer. Když je porazíš, dostaneš &eKlíč klání&r. Tím odemkneš &ePokladnici&r s odměnou."
		""
		"&cPozor na fičáky&r – střílí větrné náboje, které tě odhodí."
	]
	quest.1DD3E07AE2357B51.title: "Komnaty klání"
	quest.1DDEEAB4023C18AF.quest_desc: [
		"Plantážník pěstuje cukrovou třtinu, kaktusy a bambus – to, co farmář neumí."
		"Výzkum &eLet It Grow&r stojí 16 kompostu a farmy musí mít dohromady úroveň 3. Plantáž (&ePlantation&r) vyrobíš z prken, kaktusu a nástroje stavby."
		"Plantážní pole (&ePlantation Field&r) z tyček, železného ingotu, prken a nástroje stavby označí, kde má pracovat."
	]
	quest.1DDEEAB4023C18AF.title: "Plantáž"
	quest.1DF14DEAF5C79808.quest_desc: [
		"&bCreate Aeronautics&r udělá ze staveb z Create skutečné fyzikální stroje. Mají váhu, padají, plavou a létají. Fyziku počítají mody &bSimulated&r a &bSable&r."
		"V kapitole postavíš nejdřív balón, pak loď s vrtulemi a řízením, auto na kolech a nakonec loď, která se řídí sama."
		"&aPotřebuješ základy Create: hřídele, ložiska a vteřinové lepidlo.&r Server dovoluje létání, takže tě za let na lodi nevyhodí."
		"&cNa tomto serveru jde najednou sestavit nejvýš 8192 bloků.&r"
	]
	quest.1DF14DEAF5C79808.quest_subtitle: "Začátečník"
	quest.1DF14DEAF5C79808.title: "Fyzika!"
	quest.1E5E40B7BB2E150B.quest_desc: [
		"Externí úložiště (&eExternal Storage&r) připojí do sítě truhlu, sud nebo šuplíky. Jejich obsah uvidíš v mřížce."
		"Hodí se, když už máš velký sklad a nechceš ho stěhovat."
		"&aTip:&r Prioritou nastavíš, kam má síť ukládat nejdřív."
	]
	quest.1E5E40B7BB2E150B.title: "Externí úložiště"
	quest.1E5FC879D1E956F5.quest_desc: [
		"Merkur je planeta nejblíž Slunci. &cBez netheritového skafandru uhoříš.&r"
		"&aSolární panely tu vyrábějí nejvíc energie ze všech planet.&r"
	]
	quest.1E5FC879D1E956F5.title: "Merkur"
	quest.1E62DAA1817C3927.quest_desc: [
		"Syřidlo (&eRennet&r) uvaříš v kotli z vejce a soli. Do kotle dej i skleněnou lahev a nezapomeň na vodu."
		"Syřidlo srazí mléko na sýr."
	]
	quest.1E62DAA1817C3927.title: "Syřidlo"
	quest.1E65E80601757681.quest_desc: [
		"Starý důl s kolejemi a dřevěnými trámy. Najdeš ho pod zemí."
		"&bYUNG's Better Mineshafts&r mění jeho vzhled podle biomu – v poušti, v džungli, v ledu nebo v houbách vypadá pokaždé jinak."
		""
		"&aTip:&r Na kolejích stojí vozíky s truhlami. Kolejnice si můžeš sebrat."
	]
	quest.1E65E80601757681.title: "Opuštěný důl"
	quest.1E7CFD8C2165F2B1.quest_desc: [
		"Tři druhy procesorů: logický (&eLogic Processor&r), výpočetní (&eCalculation Processor&r) a inženýrský (&eEngineering Processor&r)."
		"V razítkovači: vytištěný obvod nahoru, redstone doprostřed, vytištěný křemík dolů."
	]
	quest.1E7CFD8C2165F2B1.title: "AE2: procesory"
	quest.1E80E387181E8EF2.quest_desc: [
		"Čtvrtý stupeň (&eStack Upgrade Tier 4&r) dá 16× víc věcí do slotu. Potřebuje 8 netheritových bloků."
		"S tímhle je batoh skoro celý sklad."
	]
	quest.1E80E387181E8EF2.title: "Stoh IV"
	quest.1E91A4D045624FE0.quest_desc: [
		"Kotel (&eCookpot&r) postav na zdroj tepla a nalij do něj vodu. Vaří se v něm syřidlo, sůl a jídla."
		"Lis na sýr (&eCheese Press&r) z mléka a syřidla udělá sýr."
	]
	quest.1E91A4D045624FE0.title: "Sýrárna"
	quest.1EB58E7BEBA11C7C.quest_desc: [
		"Síťový vysílač (&eNetwork Transmitter&r) a přijímač (&eNetwork Receiver&r) spojí části sítě bez kabelů."
		"Síťovou kartu (&eNetwork Card&r) propoj s přijímačem (Shift + pravé tlačítko na přijímač) a vlož ji do vysílače."
		"&aTip:&r Na vysílač i přijímač potřebuješ netheritové ingoty."
	]
	quest.1EB58E7BEBA11C7C.title: "Síť bez kabelů"
	quest.1ECA32B112D22771.quest_desc: [
		"Kniha od &bAlex's Mobs&r (&eAnimal Dictionary&r). Popisuje každé zvíře: kde žije, co z něj padá a jak ho ochočit."
		"Při prvním připojení ji dostaneš zdarma. Když ji ztratíš, vyrob ji z knihy, zeleného barviva a jedné věci ze zvířete (například &eCrocodile Scute&r)."
	]
	quest.1ECA32B112D22771.title: "Zvířecí slovník"
	quest.1ECB4E0543C0EAFE.quest_desc: [
		"&bAero Islands&r přidává rudu aerolit (&eAerolite&r). Najdeš ji pod zemí ve většině biomů Overworldu."
		"Z rudy padají aerolitové větvičky (&eAerolite Twig&r). Jsou velmi lehké. Když větvičku sníš, chvíli levituješ."
		"&aZ větviček se dá složit stavební blok – viz další quest.&r"
	]
	quest.1ECB4E0543C0EAFE.title: "Aerolit"
	quest.1EDED2CFE86A31A2.quest_desc: [
		"Sejf (&eSafe&r) je úložiště, které otevře jen jeho majitel nebo hráč se správným klíčem (&eKey&r)."
		"Sejf vyrobíš ze shulkerové schránky a netheritového ingotu. Klíč ze zlatého ingotu a 2 zlatých nuggetů."
	]
	quest.1EDED2CFE86A31A2.quest_subtitle: "Expert"
	quest.1EDED2CFE86A31A2.title: "Sejf"
	quest.1EE74F754E2B7C28.quest_desc: [
		"Totem nesmrtelnosti tě jednou zachrání před smrtí, když ho držíš v ruce. Pak zmizí."
		"Padá z vyvolávačů (Evoker) v lesních sídlech a při nájezdech na vesnici."
		"Úkol: přežij smrt díky totemu."
	]
	quest.1EE74F754E2B7C28.title: "Totem nesmrtelnosti"
	quest.1F1F4ABB800C30BA.quest_desc: [
		"Tepelný generátor (&eHeat Generator&r) je tvůj první zdroj energie pro Mekanism."
		"Spaluje hořlavé věci (uhlí, dřevo) vložené do slotu. Energii dává i z lávy, která leží hned vedle něj."
		"&aTip:&r Energii z generátoru odveď kabelem do strojů. Místo něj můžeš použít i alternátor (&eAlternator&r) z &bCreate Crafts \\& Additions&r."
	]
	quest.1F1F4ABB800C30BA.title: "Tepelný generátor"
	quest.1F2B75676A4A2FB3.quest_desc: [
		"Infuzní slitina (&eInfused Alloy&r) je měděný ingot napuštěný redstonem v infuzéru."
		"Potřebuješ ji na solární panely, vylepšení strojů a separátor. Pokročilý obvod (&eAdvanced Control Circuit&r) = základní obvod + 2 slitiny."
		"&aTip:&r Slitinou klikni pravým tlačítkem na kabel nebo trubku Mekanismu a vylepšíš je na vyšší úroveň přímo na místě."
	]
	quest.1F2B75676A4A2FB3.title: "Infuzní slitina"
	quest.1F53AB763F9A12F8.quest_desc: [
		"Zelené místo uprostřed pouště. Jsou tu jezírka, palmy, mech a lekníny."
		"&aTip:&r Oáza je dobré místo na první základnu v poušti – je tu voda i dřevo."
	]
	quest.1F53AB763F9A12F8.title: "Oáza"
	quest.1F772FD3F8A900AA.quest_desc: [
		"Kouzelný les. Na zemi tu rostou malé ametystové krystaly."
		"&aTip:&r V těchto tajemných biomech se staví &eVěže mágů&r (kapitola Stavby a města)."
	]
	quest.1F772FD3F8A900AA.title: "Měsíční háj"
	quest.1F8D32F7B0484959.quest_desc: [
		"Po smrti draka se na okraji hlavního ostrova objeví malá brána (&eEnd Gateway&r) v rámu z podloží."
		"Hoď do ní perlu Enderu, nebo do ní vleť. Přenese tě asi 1000 bloků daleko na vnější ostrovy."
		"&aTip:&r u brány na druhé straně si postav malou plošinu, ať najdeš cestu zpátky."
	]
	quest.1F8D32F7B0484959.quest_subtitle: "Začátečník"
	quest.1F8D32F7B0484959.title: "Brána do dálky"
	quest.1F962FC2F60B47C0.quest_desc: [
		"Nakládané okurky (&ePickle&r) vykvasíš v kádi ze 4 okurek, octa a soli."
		"&aTip:&r Ve stejné kádi vznikne i sýr, tofu nebo pivo. Recepty ukáže JEI."
	]
	quest.1F962FC2F60B47C0.title: "Nakládané okurky"
	quest.1F9F08E1CD995DFE.quest_desc: [
		"Malý podzemní dungeon. &bYUNG's Better Dungeons&r ho přestavěl, takže vypadá líp než v obyčejném Minecraftu."
		"Uprostřed je líheň, která pořád vyrábí příšery. Kolem jsou truhly."
		""
		"&aTip:&r Hledej v jeskyních. Takové sklepy jsou pod zemí skoro všude."
	]
	quest.1F9F08E1CD995DFE.title: "Sklep s líhní"
	quest.1FB7AE3697519BA6.quest_desc: [
		"Ochoč jakékoli zvíře. Nejsnadnější je vlk (kost) nebo kočka (syrová ryba)."
		"Když se kolem zvířete objeví srdíčka, je tvoje. Pravým tlačítkem ho posadíš nebo zase zvedneš."
	]
	quest.1FB7AE3697519BA6.title: "První mazlíček"
	quest.1FD06D0076ECC595.quest_desc: [
		"Přístupový bod k inventáři (&eInventory Access Port&r) inventář „prodlouží“. Stroje připojené k bodu pracují s inventářem za ním."
		""
		"Inventářový most (&eInventory Bridge&r) spojí dva inventáře najednou. Na jeho filtrech nastavíš, co jde do kterého."
		""
		"Body ani most nemají vlastní místo na věci. Nedají se napojit za sebe. Redstonovým signálem je vypneš."
	]
	quest.1FD06D0076ECC595.title: "Přístup k inventářům"
	quest.1FEE6BF16DCA4AA8.quest_desc: [
		"Na pláních občas stojí stan pivních slavností."
		"Je vzácný, tak se při cestování po pláních rozhlížej."
	]
	quest.1FEE6BF16DCA4AA8.title: "Pivní slavnosti"
	quest.1FFA9E28D28D4823.quest_desc: ["Odšťavňovač (&eJuicer&r) a dvě jablka na pracovním stole dají jablečný džus (&eApple Juice&r)."]
	quest.1FFA9E28D28D4823.title: "Jablečný džus"
	quest.200C1A8BE1D1081B.quest_desc: [
		"Radnice (&eTown Hall&r) je srdce kolonie. Jedna je v truhle tábora, další se vyrábí z prken a 2 nástrojů stavby."
		"Položením radnice kolonii založíš. Území kolem ní je chráněné, cizí hráči tam nemůžou kopat."
		"V radnici přidáš kamarády do kolonie (karta „Oprávnění“ – &ePermissions&r)."
	]
	quest.200C1A8BE1D1081B.title: "Radnice"
	quest.201417C283881981.quest_desc: [
		"Hrnec na marmeládu (&eJam Pot&r) postav na zdroj tepla, třeba na táborák."
		"Dej do něj 2 jahody a cukr. Během vaření ho pravým tlačítkem míchej, ať se nepřipálí. Hotovou marmeládu nabereš do sklenice (&eJar&r)."
		"Marmelády (jahodová, jablečná, čokoládová, ze sladkých a svítivých bobulí) se dávají na dorty, koláčky a chleba."
	]
	quest.201417C283881981.title: "Marmeláda"
	quest.20234661248DAEDE.quest_desc: [
		"Ve světě žije hodně nových zvířat a příšer. Přidávají je mody &bAlex's Mobs&r, &bNaturalist&r, &bCritters and Companions&r, &bAdorable Hamster Pets&r a &bBen's Sharks&r."
		"Některá zvířata jsou hodná, jiná útočí. Ze spousty z nich padají věci na užitečnou výbavu."
		""
		"&aTip:&r Když se podíváš na zvíře, nahoře na obrazovce uvidíš jeho jméno."
	]
	quest.20234661248DAEDE.quest_subtitle: "Začátečník"
	quest.20234661248DAEDE.title: "Divočina"
	quest.202427093C8C028C.quest_desc: [
		"Průmyslová turbína (&eIndustrial Turbine&r) mění páru na energii. Je to velká dutá stavba z pláště (&eTurbine Casing&r)."
		"Půdorys musí být čtverec s lichou délkou strany, třeba 5×5 nebo 7×7."
		"Uprostřed je sloup rotorů (&eTurbine Rotor&r) s lopatkami (&eTurbine Blade&r). Na nejvyšší rotor patří rotační jednotka (&eRotational Complex&r) a kolem ní celá vrstva tlakových rozdělovačů (&ePressure Disperser&r) bez mezer."
		"Nad ni polož cívky (&eElectromagnetic Coil&r) – musí se dotýkat sebe navzájem i rotační jednotky. Výpusti (&eTurbine Vent&r) dej do stěn na úroveň rotační jednotky nebo výš."
		"{@pagebreak}"
		"Páru přiveď a energii odveď přes ventil (&eTurbine Valve&r)."
		"&aTip:&r Kondenzátory (&eSaturating Condenser&r) nad rotační jednotkou vrátí páru zpět jako vodu – ta se hodí pro reaktor."
	]
	quest.202427093C8C028C.title: "Průmyslová turbína"
	quest.20306B10C2AEC952.quest_desc: [
		"Solární generátor (&eSolar Generator&r) vyrábí energii zadarmo, ale jen přes den a když nad ním je volná obloha."
		"Vyrobíš ho ze solárních panelů (&eSolar Panel&r), infuzní slitiny, železa, osmia a energetické tablety."
		"&aTip:&r V noci nevyrábí nic. Přebytek ze dne ukládej do energetické kostky."
	]
	quest.20306B10C2AEC952.title: "Solární energie"
	quest.2031402DF8DA5288.quest_desc: [
		"Poskytovatel vzorů (&eME Pattern Provider&r) posílá suroviny podle vzorů do sousedních bloků. Molekulární sestavovač (&eMolecular Assembler&r) vedle něj vyrábí recepty z pracovního stolu."
		"Výrobní jednotka (&eCrafting Unit&r) je základ výrobního procesoru (CPU), který zakázky řídí."
		"Vyrobitelnou věc pak v terminálu vyber a zadej počet. Pokud ji už máš, klikni na ni prostředním tlačítkem myši."
	]
	quest.2031402DF8DA5288.title: "AE2: automatická výroba"
	quest.2037D325447D35E8.quest_desc: [
		"Polož radnici nástrojem stavby. Tím vznikne tvoje kolonie a přijdou první 4 občané."
		"Při pokládání si vybereš styl – podle něj budou vypadat všechny budovy. Pro začátečníky jsou určené styly &eColonial&r, &eMinecolonies Original&r a &eUrban Birch&r."
		"Styl změníš i později: klikni na radnici a vpravo použij tlačítko u nápisu &eColony Pack&r."
		"&cKaždý hráč může mít jen jednu kolonii.&r"
	]
	quest.2037D325447D35E8.quest_subtitle: "Začátečník"
	quest.2037D325447D35E8.title: "Založ kolonii"
	quest.205A22B0D40FE3D8.quest_desc: [
		"Z kbelíku mléka a 4 lahví vyrobíš 4 lahve mléka (&eMilk Bottle&r). Každá odstraní jeden efekt."
		"Melounový džus (&eMelon Juice&r) slož na pracovním stole z plátku melounu, cukru a lahve. Trochu tě vyléčí."
		"&aTip:&r Lahve mléka můžeš dávat do receptů místo celého kbelíku."
	]
	quest.205A22B0D40FE3D8.title: "Nápoje"
	quest.206C5A47BC3C3162.quest_desc: [
		"Hluboko v chrámu odpočívá faraon. Je to pouštní zombie se zvláštní hlavou."
		"Když ho porazíš, kletba zmizí a &eÚnava z těžby&r v chrámu přestane."
	]
	quest.206C5A47BC3C3162.title: "Kletba faraona"
	quest.20C251FB37133E11.quest_desc: [
		"Píst motoru (&eEngine Piston&r) je hlavní díl naftového motoru. Na jeden motor potřebuješ dva."
		""
		"Vyrobíš ho z andezitové slitiny, hřídele a zinkového nugetu. Jeden recept dá 2 písty."
		""
		"K motoru (&eDiesel Engine&r) dál potřebuješ blok mosazi, nádrž, křesadlo a dvě desky z leštěného černokamene. Motor vyrobíš v questu Naftový motor v kapitole Create: doplňky."
	]
	quest.20C251FB37133E11.title: "Píst motoru"
	quest.20E6D71E52C6ECE0.quest_desc: [
		"&bCandlelight&r je mod o slavnostních večeřích: jídla na talíři, prostírání a nábytek."
		"Měděná pánev (&eCooking Pan&r) funguje jako pekáč a velký hrnec (&eCooking Pot&r) jako hrnec z Farm \\& Charm. Oba musí stát na zdroji tepla."
		"Talíř (&ePlate&r) polož na stůl. Na něj se servírují hotová jídla."
	]
	quest.20E6D71E52C6ECE0.title: "Candlelight"
	quest.20F9DC538CC7BA8C.quest_desc: [
		"&eSchématikanón&r (&eSchematicannon&r) postaví stavbu ze schématu sám. Vlož do něj schéma, vedle něj dej truhlu s materiálem a do kanónu střelný prach."
		"V jeho okně stavbu spustíš. Co chybí, ukáže seznam."
		"&aTip:&r Skladník (kapitola Logistika) umí objednat materiál podle seznamu, který kanón vytiskne na psací podložku."
	]
	quest.20F9DC538CC7BA8C.quest_subtitle: "Expert"
	quest.20F9DC538CC7BA8C.title: "Schématikanón"
	quest.20FD1BABA4B4B8C4.quest_desc: ["Diamantový batoh (&eDiamond Backpack&r) – zlatý batoh obklop 8 diamanty."]
	quest.20FD1BABA4B4B8C4.title: "Diamantový batoh"
	quest.2103713AC7D6D81B.quest_desc: [
		"Jedna z největších a nejvzácnějších staveb z &bMoog's Nether Structures&r je megapevnost (&eMega Fortress&r)."
		"Je obrovská a dobře hlídaná. Vezmi si s sebou zásoby jako do pevnosti."
	]
	quest.2103713AC7D6D81B.title: "Megapevnost"
	quest.2112E5008308E352.quest_desc: [
		"Gyroskop (&eGyroscope&r) úplně vyruší vliv větru a trochu stabilizuje let. Výroba: kompas a 2 komparátory."
		"&aZa deště a bouřky fouká silnější vítr, tam se gyroskop hodí nejvíc.&r"
	]
	quest.2112E5008308E352.title: "Gyroskop"
	quest.2134C2200F0418B5.quest_desc: [
		"&bHandcrafted&r: nábytek ve všech druzích dřeva, na který si můžeš sednout nebo lehnout."
		"Kladivo (&eHammer&r) ze železných ingotů a tyček mění vzhled a tvar skříněk, polic, pultů, šuplíků a lišt. Klikni s ním pravým tlačítkem na blok."
		"Pokračuj v kapitole &eNábytek&r."
	]
	quest.2134C2200F0418B5.title: "Handcrafted"
	quest.216425DD9F954A11.quest_desc: [
		"Battlegill (&eRaw Battlegill&r) žije u oceánských monumentů, základen nájezdníků a zkušebních komnat."
		"&cPozor:&r U monumentů číhají strážci."
	]
	quest.216425DD9F954A11.title: "Battlegill"
	quest.216FB69BA4750C32.quest_desc: [
		"Křemík (&eSilicon&r) vyrobíš tavením netherového křemene v peci."
		"Potřebuješ ho na procesory a paměťové části disků."
		"&aTip:&r Vyrob si ho rovnou víc – spotřebuješ ho hodně."
	]
	quest.216FB69BA4750C32.title: "Křemík"
	quest.216FCC85C3552923.quest_desc: [
		"Nastav jedné mechanické paži 10 nebo víc výstupů. Jedna paže tak obslouží celou řadu strojů, třeba 10 tyglíků nebo hořáků."
		"Režim rozdělování nastavíš na panelu: střídat, střídat bez přeskakování, nebo přednost má první cíl."
		"Teď už máš všechno: zdroje, linky, třídění. Spoj je s balíčkovou logistikou a továrna pojede sama."
	]
	quest.216FCC85C3552923.quest_subtitle: "Expert"
	quest.216FCC85C3552923.title: "Velká linka"
	quest.2182B3E8FC048E0F.quest_desc: [
		"Cukrová dutina je jeskyně ze sladkostí: čokolády, dortu, zmrzliny a lízátek."
		"Tečou tu řeky fialové limonády a světlo dávají gumová sluníčka (&eSundrop&r)."
		"&cNe všechno je přátelské. Sladcí tvorové a čarodějnice (Licowitch) tě napadnou.&r"
	]
	quest.2182B3E8FC048E0F.title: "Cukrová dutina"
	quest.218C0CAE470E19F4.quest_desc: [
		"Na stůl polož tabulku a papír. Na tabulce se ukážou runy."
		"Kliknutím runu odhalíš. Když přes slovo přejedeš lupou, uvidíš jeho překlad."
		"&cMáš jen 5 pokusů, pak se tabulka zničí.&r"
		"Když hledané slovo uhodneš třikrát, vznikne kodex (&eCave Codex&r)."
	]
	quest.218C0CAE470E19F4.title: "Přelož tabulku"
	quest.2191E820963D5D20.quest_desc: [
		"Kamenné nástroje vydrží déle a kopou rychleji. Kamenný krumpáč už vykope i železnou rudu."
		"Potřebuješ dlažební kámen (ten padá z kamene) a klacky."
		"Meč se hodí na první noc – příšery v noci vylézají ze tmy."
	]
	quest.2191E820963D5D20.title: "Doba kamenná"
	quest.21B9938EBAF97B65.quest_desc: [
		"Některé bloky Domum Ornamentum se vyrábí na pracovním stole."
		"Létající koberec (&eWhite Floating Carpet&r) ze 2 vln a vlákna visí ve vzduchu. Krémové cihly (&eCream Bricks&r) jsou z pískovce a cihel."
	]
	quest.21B9938EBAF97B65.title: "Létající koberec"
	quest.21CA35C14F2E6A18.quest_desc: [
		"Odkaz (&eMechanical Wolf Link&r) přivolá vlka. Vyrobíš ho v mechanickém výrobníku z mosazných plátů, andezitové slitiny, precizního strojku, procesoru a redstonového vysílače."
		""
		"Nasaď si ho do slotu doplňků na hlavu (&eCurios&r). Objeví se vlk a bude tě chránit. Pravým kliknutím na vlka otevřeš jeho moduly."
		""
		"Zraněného vlka opravíš montážním klíčem. Když vlk zemře, po chvíli se znovu objeví i se svými moduly."
	]
	quest.21CA35C14F2E6A18.title: "Přivolej vlka"
	quest.21CED49F0735483D.quest_desc: [
		"Klíč (&eWrench&r) ze &bSupplementaries&r otáčí položené bloky. Hodí se na schody, truhly nebo trubky."
		"Vyrobíš ho ze 4 měděných ingotů."
	]
	quest.21CED49F0735483D.title: "Klíč na otáčení"
	quest.21F02C2AE4035F0B.quest_desc: [
		"&eAndezitový trychtýř&r (&eAndesite Funnel&r): slitina nad sušenou chaluhou dá 2 kusy. Bere předměty z truhly nebo stroje, nebo je do nich dává."
		"Normálně položený z truhly bere. Položený se Shiftem do ní dává. Klíčem ho otočíš i později. Na pásu bere nebo dává podle směru pásu."
		"Bere po 1 kuse a redstone ho zastaví. &cMezi dvěma truhlami přímo nepřesouvá,&r mezi ně dej pás nebo šachtu."
	]
	quest.21F02C2AE4035F0B.title: "Andezitový trychtýř"
	quest.21F0992BCF690C6B.quest_desc: [
		"Vozítko (&eTier 1 Rover&r) jezdí rychle po nerovném terénu. Má 2 sedadla, 16 slotů a rádio."
		"Tankuje se palivem jako raketa: Shift + pravé tlačítko a palivo do levého slotu."
	]
	quest.21F0992BCF690C6B.title: "Vozítko"
	quest.223568BB6E5E207E.quest_desc: [
		"Dubový větrný mlýn z modu &bCreate: Structures Overhaul&r. Najdeš ho v lese, v květinovém lese nebo na nížině."
		"Je postavený z dílů &bCreate&r. V sudech můžeš najít i díly Create, třeba ozubená kola nebo ložisko větrného mlýna (&eWindmill Bearing&r)."
	]
	quest.223568BB6E5E207E.title: "Větrný mlýn"
	quest.2246E8001D012D5D.quest_desc: [
		"Magnet (&eMagnet Upgrade&r) přitahuje věci ze země do batohu, i když jsou kousek od tebe."
		"Vylepšíš na něj upgrade na sbírání: přidej ender perly, železo, redstone a lapis lazuli."
	]
	quest.2246E8001D012D5D.title: "Magnet"
	quest.226910D90DB810B4.quest_desc: [
		"Jetpack (&eJetpack&r) ti dovolí létat. Nosí se na hrudi místo brnění a pohání ho vodík."
		"Naplníš ho v elektrolytickém separátoru – vlož ho do slotu u výstupu vodíku. Nebo ho naplň z chemické nádrže."
		"&aTip:&r Režim (normální, vznášení, vypnuto) přepneš klávesou &eChest Mode Switch&r, výchozí je G. Změnit ji můžeš v Nastavení → Ovládání."
	]
	quest.226910D90DB810B4.title: "Jetpack"
	quest.2270C4D43A5F9FF3.quest_desc: [
		"Továrna (&eBasic Smelting Factory&r) zpracovává víc věcí naráz: základní 3, pokročilá 5, elitní 7 a ultimátní 9."
		"Továrnu jde udělat z většiny jednoduchých strojů: tavicí pece, obohacovací komory, drtiče, infuzéru, čisticí a vstřikovací komory a dalších."
		"&aTip:&r Jedna továrna ušetří místo za několik samostatných strojů."
	]
	quest.2270C4D43A5F9FF3.title: "Továrny"
	quest.2271FC4269645CC3.quest_desc: [
		"Vzducholoď (&eAirship&r) je pomalá, ale snadno se řídí. Je to ideální první letadlo. Výroba: 6 plachet, 2 trupy a motor."
		"Polož ji na volnou zem a nasedni. Shift + pravé tlačítko otevře její inventář."
		"Do slotu na palivo dej to, co hoří v peci: uhlí, dřevo nebo prkna. Funguje i ohnivý prach (&eBlaze Powder&r)."
		"&aPoškozené letadlo opravíš kliknutím pravým tlačítkem. Každé kliknutí trochu opraví a stojí trochu jídla.&r"
	]
	quest.2271FC4269645CC3.title: "Vzducholoď"
	quest.2288FBE4D168F5D3.quest_desc: [
		"&eOvladač rychlosti otáček&r (&eRotation Speed Controller&r): precizní strojek na mosazném pouzdře."
		"Bere rotaci ze své osy a předá ji velkému ozubenému kolečku nad sebou. Rychlost nastavíš přesně na panelu na boku."
		"&cOvladač nepřidá sílu:&r vyšší rychlost = vyšší spotřeba SU strojů za ním."
	]
	quest.2288FBE4D168F5D3.title: "Ovladač rychlosti"
	quest.229A36DD1EE599A9.quest_desc: [
		"&ePřevodovka&r (&eGearbox&r): 4 ozubená kolečka kolem andezitového pouzdra. Pošle rotaci do 4 stran v jedné rovině."
		"Strany do rohu se točí zrcadlově, rovný směr se obrátí. &eSvislou převodovku&r (&eVertical Gearbox&r) dostaneš převedením v pracovním stole."
	]
	quest.229A36DD1EE599A9.title: "Převodovka"
	quest.229B974E7AACEBD5.quest_desc: [
		"Teď už jedna baterie nestačí. Postav banku, která podrží továrnu v chodu, i když zdroje nejedou. Úkol splníš, když baterii nabiješ doplna."
		""
		"Baterie má zadní výstup. Po nabití nebo vybití se spojí s předním vstupem, takže baterie za sebou se nabíjejí a vybíjejí postupně. Řetěz tak běží déle."
		""
		"Víc síly najednou dostaneš, když baterie zapojíš vedle sebe (paralelně). Signál do jedné baterie v řetězu zapne všechny."
		"{@pagebreak}"
		"Baterie si náboj drží i jako předmět. Nabitou baterií klikni na vybíjející se baterii a dobiješ ji. Pokladač nebo mechanická paže to zvládne sám."
		""
		"Stav nabití přečte komparátor, přesněji prahový spínač (&eThreshold Switch&r). Displejový vysílač (&eDisplay Link&r) ho ukáže na tabuli."
	]
	quest.229B974E7AACEBD5.quest_subtitle: "Expert"
	quest.229B974E7AACEBD5.title: "Bateriová banka"
	quest.22ACB06ED8E0C1C4.quest_desc: [
		"Navštiv všechny biomy Aetheru: čtyři nebeské lesy a louky z Aetheru i nové biomy z Deep Aetheru."
		"Výzva pro trpělivé průzkumníky."
	]
	quest.22ACB06ED8E0C1C4.title: "Průzkumník Aetheru"
	quest.22B4D65B1580E767.quest_desc: [
		"Fluorit (&eFluorite&r) najdeš hluboko pod zemí, níž než Y = 23. Rudu zpracuj v obohacovací komoře – z bloku rudy dá 6 kusů."
		"Z fluoritu se vyrábí kyselina fluorovodíková na jaderné palivo. Jeho prach je potřeba na pelety z polonia a plutonia."
		"&aTip:&r Fluoritový prach (&eFluorite Dust&r) dostaneš v drtiči."
	]
	quest.22B4D65B1580E767.title: "Fluorit"
	quest.22CD459C6B1AF1BA.quest_desc: [
		"Ruční výroba je minulost – teď síť vyrábí sama. Výrobní procesor (CPU) řídí jednu zakázku. Je to plný kvádr z výrobních bloků bez děr a musí v něm být aspoň jedno výrobní úložiště (&e1k Crafting Storage&r)."
		"Úložiště určuje, jak velkou zakázku CPU zvládne. Koprocesor (&eCrafting Co-Processing Unit&r) ji zrychlí. Volné místo vyplň výrobní jednotkou (&eCrafting Unit&r)."
		"&aTip:&r Jedno CPU = jedna zakázka. Chceš vyrábět dvě věci naráz? Postav dvě CPU."
	]
	quest.22CD459C6B1AF1BA.quest_subtitle: "Expert"
	quest.22CD459C6B1AF1BA.title: "Výrobní procesor"
	quest.22D2094C2218685E.quest_desc: [
		"&bCreate Crafts \\& Additions&r přidává elektřinu. Začíná se válcovací stolicí (&eRolling Mill&r)."
		""
		"Stolici roztoč a hoď na ni měděný plát. Udělá z něj 2 měděné dráty (&eCopper Wire&r). Z ingotů dělá tyče."
		""
		"&aVíc najdeš v kapitole Elektřina.&r"
	]
	quest.22D2094C2218685E.title: "Měděný drát"
	quest.22E4E0531E537739.quest_desc: [
		"Ruda aerolitu (&eAerolite&r) se nedá sebrat celá – vždy z ní padají větvičky, i s Hedvábným dotekem."
		"Z 9 větviček ale složíš stavební blok (&eQuickslate&r)."
	]
	quest.22E4E0531E537739.title: "Blok z aerolitu"
	quest.22F37CCA8027E8F0.quest_desc: [
		"&eUdělátko&r (&eContraption&r) je skupina bloků, které se hýbou spolu. Hýbe s nimi píst, ložisko, kladka, jeřáb nebo vozík."
		"Na udělátko dej pracovní díly: vrták, pilu, sklízeč, pluh, pokladač. Pracují, když se udělátko hýbe. Truhla na udělátku sbírá, co vytěží."
		"V této kapitole postavíš farmy a výrobní linky, které běží bez tebe."
	]
	quest.22F37CCA8027E8F0.quest_subtitle: "Začátečník"
	quest.22F37CCA8027E8F0.title: "Stroje, které se hýbou"
	quest.231050E81D48DFF6.quest_desc: [
		"Teď už nechytáš jen na večeři, ale na poklady. Diamantový prut (&eDiamond Fishing Rod&r) vydrží nejdéle ze všech běžných prutů."
		"Kombinuj ho se zlatým háčkem a dobrou návnadou."
	]
	quest.231050E81D48DFF6.quest_subtitle: "Pokročilý"
	quest.231050E81D48DFF6.title: "Diamantový prut"
	quest.2316F8EF3647AB01.quest_desc: [
		"Nejvzácnější čokoláda. Do míchačky s ohřevem dej cukr, kakaové boby, mléko a dračí dech."
		"Dračí dech nabereš do lahví u Enderdraka v Endu."
	]
	quest.2316F8EF3647AB01.quest_subtitle: "Expert"
	quest.2316F8EF3647AB01.title: "Rubínová čokoláda"
	quest.231B25E6DC5E3D1D.quest_desc: [
		"Základ upgradu (&eUpgrade Base&r) potřebuje skoro každý upgrade batohu."
		"Vyrobíš ho z provázku, železných ingotů a kůže."
	]
	quest.231B25E6DC5E3D1D.title: "Základ upgradu"
	quest.2359A21812B76933.quest_desc: [
		"Teď už nestačí péct maso na ohni. Hrnec (&eCooking Pot&r) je srdce kuchyně: vaří polévky, guláše a hlavní jídla až ze 6 surovin."
		"Hrnec potřebuje teplo zespodu: sporák, táborák, oheň nebo magmatický blok. Mezi teplo a hrnec smíš dát i násypku."
		"Do okna dej suroviny a do políčka pro nádobu misku (nebo jinou nádobu, kterou recept chce). Hotové jídlo si vezmi z výstupu."
		"&aTip:&r Na hotový hrnec můžeš kliknout rovnou miskou v ruce. Rozbitý hrnec si jídlo uvnitř pamatuje."
	]
	quest.2359A21812B76933.quest_subtitle: "Pokročilý"
	quest.2359A21812B76933.title: "Hrnec"
	quest.2363AB666B892877.quest_desc: [
		"Konfigurátor (&eConfigurator&r) nastavuje strany strojů: která strana je vstup a která výstup."
		"Režimy přepínáš Shift + kolečkem myši. V režimu &eConfigurate&r pravým tlačítkem zjistíš, co strana dělá, a Shift + pravým ji změníš. V režimu &eWrench&r stroj Shift + pravým sebereš."
		"&aTip:&r Stejné nastavení je i v okně stroje. Tam zapneš i automatický výstup (&eAuto-eject&r), který hotové věci sám vysune ven."
	]
	quest.2363AB666B892877.title: "Konfigurátor"
	quest.236A0E8A50259E25.quest_desc: [
		"Medvěda nejdřív nakrm medem (&ePlástev medu&r nebo lahev medu). Pak je chvíli klidný."
		"V tu chvíli mu dej &eSyrového lososa&r. Na ochočeném medvědovi můžeš jezdit do boje."
	]
	quest.236A0E8A50259E25.title: "Ochočený grizzly"
	quest.236FCF3FD695C20F.quest_desc: [
		"New Age umí pracovat i s teplem. Tepelné trubky (&eHeat Pipe&r) rozvádějí teplo od zdroje ke strojům."
		""
		"Vyrobíš je z terakoty, měděného plátu a zinkových nugetů. Kolik tepla trubka má, ukážou inženýrské brýle."
		""
		"&cKdyž se blok přehřeje, změní se na lávu. Teplo musí mít kam odtékat.&r"
	]
	quest.236FCF3FD695C20F.title: "Tepelné trubky"
	quest.2380CAF13A3E7EB4.quest_desc: [
		"Mod &bSpartan Shields&r přidává štíty z mnoha materiálů. Hrubý dřevěný štít (&eCrude Wooden Shield&r) je základ všech malých štítů."
		"Vyrobíš ho z prken a klacku."
		"V popisku štítu uvidíš, jak moc tě chrání a jestli umí úder štítem (&eShield Bash&r)."
	]
	quest.2380CAF13A3E7EB4.title: "Dřevěný štít"
	quest.23D9C12A4EEAF74F.quest_desc: [
		"Lom (&eSimple Quarry&r) je velká jáma, kterou vykope lomař. Je to bezpečnější než důl, ale dává hlavně obyčejný kámen."
		"Vyrobíš ho z prken, sudu, železného krumpáče a nástroje stavby. Pak v dole najmi lomaře a přiřaď ho k lomu."
		"Větší lom (&eMedium Quarry&r) se vyrábí s diamantovým krumpáčem."
	]
	quest.23D9C12A4EEAF74F.title: "Lom"
	quest.23EB1763E43128D2.quest_desc: [
		"&cBěžící reaktor vyzařuje smrtelné záření.&r Chrání tě celá kožená zbroj – všechny 4 díly najednou. Místo kožené čepice můžeš mít inženýrské brýle."
		""
		"Záření neprojde reaktorovými bloky (plášť, sklo, tyče, vstup paliva, výdech tepla)."
		""
		"&aNejbezpečnější je reaktor celý obestavět reaktorovým pláštěm nebo sklem.&r"
	]
	quest.23EB1763E43128D2.title: "Ochrana před zářením"
	quest.23F4D33CDB434143.quest_desc: [
		"Teď už jeden chunk nestačí. Mosazný chunk loader (&eBrass Chunk Loader&r) udrží načtených víc chunků najednou."
		""
		"Prázdný mosazný loader vyrobíš v mechanickém výrobníku (&eMechanical Crafter&r). Pak s ním klikni pravým tlačítkem na ghasta, aby ho chytil."
		""
		"Na panelu nastavíš oblast 1×1, 3×3 nebo 5×5 chunků. Větší oblast potřebuje vyšší rychlost otáčení."
		""
		"&aTip:&r Na pohyblivé konstrukci (kontrapci) načítá 3×3 chunky kolem sebe i bez otáčení. Vedle vlakové stanice načte okolí, jen když u ní stojí vlak."
	]
	quest.23F4D33CDB434143.quest_subtitle: "Pokročilý"
	quest.23F4D33CDB434143.title: "Mosazný chunk loader"
	quest.23FACF5661E5970D.quest_desc: [
		"Tahle kapitola navazuje na kapitolu &bMekanism&r. Naučíš se tu vyrábět hodně energie, skladovat ji a nakonec postavit jaderný a fúzní reaktor."
		"Mekanism počítá energii v joulech (J), jiné mody ve FE. Převádí se samo – kabely Mekanismu napojíš i na stroje z jiných modů."
		"&aTip:&r Začni jednoduchými generátory. Reaktory jsou na konci a jsou &cnebezpečné&r – čti pozorně každý quest."
	]
	quest.23FACF5661E5970D.quest_subtitle: "Začátečník"
	quest.23FACF5661E5970D.title: "Velká energie"
	quest.240DEC40914BA885.quest_desc: [
		"Brokovnice (&eShot Gum&r) střílí dvě žvýkačky naráz. Odrážejí se od stěn."
		"Střelivo jsou hromádky žvýkaček (&eGumball Pile&r) z Gumbeepera. Jedna hromádka = 5 výstřelů."
		"Na výrobu potřebuješ i cukrové sklo (&eSugar Glass&r) z cukru a mátového prášku (&ePeppermint Powder&r)."
	]
	quest.240DEC40914BA885.title: "Žvýkačková brokovnice"
	quest.241C32F9DFF5B7FE.quest_desc: [
		"Postav rám portálu z obsidiánu (&eObsidian&r). Nejmenší rám je 4 bloky široký a 5 bloků vysoký. Zapal ho křesadlem (&eFlint and Steel&r) a projdi."
		"&cV Netheru nespi v posteli – vybuchne!&r Voda se tu hned vypaří."
		"Vezmi si jídlo, bloky na stavění a křesadlo. Když ti ghast portál zhasne, zapal ho znovu."
	]
	quest.241C32F9DFF5B7FE.quest_subtitle: "Začátečník"
	quest.241C32F9DFF5B7FE.title: "Vítej v pekle"
	quest.2422C9231860840B.quest_desc: [
		"Některé imitace nejsou jen ozdoba. Imitační dveře (&eCopycat Door&r) se otvírají jako normální dveře, ale vypadají jako blok, který do nich dáš."
		""
		"Imitační falešný blok (&eCopycat Ghost Block&r) vypadá jako pevný blok, ale projdeš jím. Hráči ani zvířata do něj nenarazí."
		""
		"Obojí se vyrábí v kameníkovi ze zinkového ingotu."
		""
		"&aTip: Dej do dveří i falešného bloku stejný materiál jako do zdi okolo. Vchod do tajné místnosti pak nikdo nenajde.&r"
	]
	quest.2422C9231860840B.title: "Tajný vchod"
	quest.243C9CD339138611.quest_desc: [
		"Konvice musí stát na zdroji tepla – na sporáku (&eStove&r) z HerbalBrews nebo na sporáku z Farmer's Delight."
		"Konvice potřebuje vodu a teplo. Vodu doplníš kbelíkem nebo lahví vody, teplo zvýšíš ohnivým práškem. Pak vlož sušený čaj a skleněnou lahev."
		"Zelený čaj (&eGreen Tea&r) dává efekt &eBalanced&r: hráči v okolí dostanou extra srdíčka (pohlcení)."
	]
	quest.243C9CD339138611.title: "Šálek čaje"
	quest.244925CF4F62B334.quest_desc: [
		"Alkoholtester (&eBreathalyzer&r) ukáže, jak moc jsi opilý."
		"Celý kroj z pivních slavností (klobouk &eBrewfest Hat&r, oblečení a boty) tě před opilostí úplně ochrání."
	]
	quest.244925CF4F62B334.title: "Dechová zkouška"
	quest.245522639AA69B7C.quest_desc: ["Vylepši diamantový nůž a diamantovou vařečku (&eDiamond Spoon&r) na kovářském stole na netheritové. Quest se splní, až budeš mít netheritový nůž i netheritovou vařečku (&eNetherite Spoon&r)."]
	quest.245522639AA69B7C.title: "Pekelná kuchyně"
	quest.246226A6919CF5ED.quest_desc: [
		"&eAndezitové pouzdro&r (&eAndesite Casing&r) je kostra mnoha strojů."
		"Kmen nejdřív oloupej sekerou (pravé tlačítko). Pak vezmi andezitovou slitinu a klikni s ní pravým na oloupaný kmen nebo oloupané dřevo."
		"&aTip:&r Stejně vznikne měděné pouzdro (měděný ingot) a mosazné pouzdro (mosazný ingot)."
	]
	quest.246226A6919CF5ED.title: "Andezitové pouzdro"
	quest.2466107434EDA5CF.quest_desc: [
		"&bQuark&r přidává stovky malých vylepšení. Spousta z nich funguje sama:"
		"Dvojité dveře se otevírají spolu. Cedulku upravíš pravým kliknutím. Motyka sklidí trávu a rostliny v širším pruhu."
		"Po žebříku sjedeš rychleji, když se díváš dolů. Žebřík položíš i na žebřík pravým kliknutím – sjede dolů."
		"{@pagebreak}"
		"V inventáři a truhlách jsou nová tlačítka: třídění věcí a rychlé přesouvání. V truhle můžeš i hledat."
		"Nechtěný předmět zničíš, když ho v inventáři vezmeš a klikneš s ním pravým tlačítkem na kbelík lávy. Stojan na brnění má ruce."
		"&aTip:&r Když v JEI najedeš na věc z Quarku, často u ní najdeš krátký popis."
	]
	quest.2466107434EDA5CF.quest_subtitle: "Začátečník"
	quest.2466107434EDA5CF.title: "Co umí Quark"
	quest.247DCD80771AE99F.quest_desc: [
		"Mars je studený, nemá vzduch a gravitace je slabší než na Zemi. Skafandr nutný!"
		"Těž tu ostrum a ledové střepy (&eIce Shard&r)."
	]
	quest.247DCD80771AE99F.title: "Mars"
	quest.2484C5CB65073016.quest_desc: [
		"Třídicí strom (&eSorting Tree&r) má třídicí motor (&eSortingwood Engine&r)."
		"Přesouvá věci mezi truhlami v okolí – každý předmět dá do truhly, kde už stejný předmět je. Udělá ti pořádek ve skladu."
	]
	quest.2484C5CB65073016.title: "Třídicí strom"
	quest.24A488E86EFC654A.quest_desc: [
		"Jáma bestií (&eBeast Pit&r) přivolá bestii. Vyrobíš ji ze 4 &eBřidlic&r, &eStřelného prachu&r a &eTáboráku s ohněm duší&r."
		"Polož ji do biomu, kde bestie žije, a zapal ji &eKřesadlem&r. Jáma pak láká bestii toho biomu."
		"&cPotřebuješ kolem volné místo.&r Nejlíp funguje na otevřeném prostranství."
	]
	quest.24A488E86EFC654A.title: "Jáma bestií"
	quest.24AC0C3876E683EA.quest_desc: [
		"Palačinka (&ePancake&r) se vyrábí ze sirupu, mléka, vajíčka a 2 pšenic."
		"Je to dobré jídlo na cesty."
	]
	quest.24AC0C3876E683EA.title: "Palačinka"
	quest.24AF5E7C455DC8DD.quest_desc: [
		"Kapucínská opička (&eCapuchin Monkey&r) žije v džungli a v mangrovech."
		"Ochočíš ji banány. Ochočená opička tě následuje a bojuje za tebe – může ti sedět na rameni a házet kameny."
	]
	quest.24AF5E7C455DC8DD.title: "Opičí kamarád"
	quest.24C55D6018F0CD54.quest_desc: [
		"Zlatý batoh (&eGold Backpack&r) má hodně místa a víc slotů na upgrady."
		"Železný batoh obklop 8 zlatými ingoty."
		"Teď se vyplatí pokročilé upgrady: pec v batohu a nádrž."
	]
	quest.24C55D6018F0CD54.quest_subtitle: "Pokročilý"
	quest.24C55D6018F0CD54.title: "Zlatý batoh"
	quest.24C9A0CB3EB5832B.quest_desc: [
		"Encyklopedii motýlů nejde vyrobit. Koupíš ji od obchodníka."
		"Potulný obchodník ji někdy prodává za 15 smaragdů a knihu. Knihovník na třetí úrovni za 8 diamantů a knihu."
	]
	quest.24C9A0CB3EB5832B.title: "Encyklopedie motýlů"
	quest.251BE5D224975F45.quest_desc: [
		"Kuše střílí silněji než luk a dá se nabít dopředu."
		"Úkol: vystřel z kuše."
	]
	quest.251BE5D224975F45.title: "Kuše"
	quest.25285995619DF2FA.quest_desc: [
		"Nejlepší varna (&eNetherite Brewing Station&r). Vylepšíš měděnou varnu v kovářském stole s netheritovým ingotem a netheritovou šablonou."
		"Jen v ní uvaříš whisky &eSmokey Reverie, Barrel-Aged&r, &eJameson Malt Whiskey&r a nejsilnější nápoj &eDark Brew&r."
		"Za položení netheritové varny dostaneš prapor &bBrewery&r (zrychluje těžení v okolí)."
	]
	quest.25285995619DF2FA.quest_subtitle: "Expert"
	quest.25285995619DF2FA.title: "Netheritová varna"
	quest.2530D3E139815622.quest_desc: [
		"Drž levé tlačítko na kmeni stromu. Dřevo vykopeš i rukou."
		"Z kmene vyrobíš prkna a ze dvou prken 4 klacky."
		"&aTip:&r Mod &bFallingTree&r: když kácíš sekerou, spadne celý strom najednou. Když přitom držíš Shift, vykácíš jen jeden blok."
	]
	quest.2530D3E139815622.title: "Dřevo a klacky"
	quest.255C2262759FDE55.quest_desc: [
		"Křesadlo zapálí oheň – a hlavně portál do Netheru."
		"Vyrobíš ho ze železného ingotu a pazourku. Pazourek občas padá ze štěrku."
	]
	quest.255C2262759FDE55.title: "Křesadlo"
	quest.258C41DC54629FC2.quest_desc: [
		"Mosazný dron (&eBrass Drone&r) z &bCreate Stuff 'N Additions&r je létající pomocník. Sleduje tě, když máš u sebe ovladač (&eDrone Controller&r)."
		""
		"Dron se skládá v mechanickém výrobníku z vrtulí, redstonového vysílače, andezitové slitiny a precizního strojku. Ovladač vyrobíš z propojeného ovladače a mosazi."
		""
		"&aOvladačem zapínáš moduly dronu a měníš jeho vzdálenost. Víc najdeš v kapitole Pohyb a výbava.&r"
	]
	quest.258C41DC54629FC2.quest_subtitle: "Létající pomocník"
	quest.258C41DC54629FC2.title: "Mosazný dron"
	quest.25BA58C7E5732811.quest_desc: [
		"&bRechiseled&r: dláto (&eChisel&r) mění vzhled bloků. Vyrobíš ho ze železného ingotu a tyčky."
		"Klikni s dlátem pravým tlačítkem, vlož blok a vyber nový vzhled. Tlačítko &eChisel all&r přetesá celý stoh najednou."
		"Funguje na kámen, cihly, prkna, kovové bloky a další."
	]
	quest.25BA58C7E5732811.title: "Dláto Rechiseled"
	quest.25C749FBB31AD3CD.quest_desc: [
		"&eElektronka&r (&eElectron Tube&r): leštěný růženín nad železným plátem."
		"Elektronky jsou v pokladači, mechanickém výrobníku, mosazném trychtýři a tunelu i v chytré šachtě."
	]
	quest.25C749FBB31AD3CD.title: "Elektronka"
	quest.25F9B0107687D8D5.quest_desc: [
		"Kompost Leteos (&eLeteos Compost&r) slož na pracovním stole z písku duší (nebo půdy duší), kořenů z Netheru, shnilého masa a kostní moučky. Přesný recept ukáže JEI."
		"Položený kompost se časem změní na oživující půdu (&eResurgent Soil&r). Rostliny na ní rostou rychleji."
	]
	quest.25F9B0107687D8D5.title: "Nether kompost"
	quest.2606C94E702C3ADD.quest_desc: [
		"Rostlinný olej vylisuješ lisem s ohřevem z mrkve, brambory a další zeleniny."
		"Těsto na koblihy (&ePastry Base&r) je upečené sladké těsto s máslem. V míchačce s ohřevem ho usmažíš v oleji na korpus koblihy (&eDonut Base&r)."
		"Dávkovač ho poleje polevou – a máš koblihu (&eDonut&r)."
	]
	quest.2606C94E702C3ADD.title: "Kobliha"
	quest.265DA304798D57F5.quest_desc: [
		"Magnetický lom (&eMagnetic Quarry&r) sám vytěží celou oblast až dolů."
		"Za blok lomu dej do obdélníku 4 magnetická světla (&eMagnetic Light&r). Až mezi nimi přeskakují blesky, polož dovnitř drtič (&eMagnetic Quarry Smasher&r)."
		"Světla vyrobíš z &eNotor Gizmo&r (padá z Notora) a železa. Drtič potřebuje &eHeavyweight&r z Boundroida."
		"Vytěžené věci vylétají horem z bloku lomu."
	]
	quest.265DA304798D57F5.title: "Magnetický lom"
	quest.26A164A10E41AD0D.quest_desc: [
		"Kávová zrna upraž v peci. Ze 3 pražených zrn uvaříš v hrnci kávu (&eCoffee&r) do lahve."
		"&aTip:&r S mlékem, medem nebo čokoládou vzniknou další druhy kávy."
	]
	quest.26A164A10E41AD0D.title: "Káva"
	quest.26C1E6461DA533FA.quest_desc: [
		"Ze sušeného zeleného a černého čaje vyrob smíšený blok (&eMixed Tea Leaf Block&r). Když uschne, dá čaj oolong (&eDried Oolong Tea&r)."
		"Oolong (&eOolong Tea&r) dává efekt &eFortune&r – víc štěstí a lepší kořist."
	]
	quest.26C1E6461DA533FA.title: "Oolong"
	quest.26D17DBEE0CAA00D.quest_desc: [
		"Konstruktor (&eConstructor&r) pokládá bloky ze sítě do světa. Destruktor (&eDestructor&r) bloky před sebou ničí a ukládá je do sítě."
		"Ve filtrech nastavíš, které bloky."
		"&aTip:&r Destruktor s vylepšením Štěstí (&eFortune I Upgrade&r a vyšší) dává víc surovin z rud."
	]
	quest.26D17DBEE0CAA00D.title: "Stavění a ničení"
	quest.26DAEBDC131C1CB2.quest_desc: [
		"&ePřebalovač&r (&eRe-Packager&r) vznikne z balíkovače v pracovním stole. Spojí části jedné objednávky zpátky do jednoho balíčku."
		"Hodí se, když suroviny musí dorazit pohromadě a ve správném pořadí, třeba do mechanických výrobníků."
	]
	quest.26DAEBDC131C1CB2.title: "Přebalovač"
	quest.26DFF1520613ED2E.quest_desc: [
		"Orel bělohlavý (&eBald Eagle&r) žije v horských lesích. Ochočíš ho rybím olejem."
		"Se sokolnickou rukavicí (&eFalconry Glove&r, ze 4 kůží a medvědí srsti) ho můžeš nosit na ruce a posílat na nepřátele."
	]
	quest.26DFF1520613ED2E.title: "Sokolník"
	quest.26E7676350B4D31F.quest_desc: [
		"Vařenou rýži (&eCooked Rice&r) uvaříš v hrnci z rýže."
		"Je základem rolek, smažené rýže i velkých hostin."
	]
	quest.26E7676350B4D31F.title: "Vařená rýže"
	quest.270663EA49DDC090.quest_desc: [
		"&bStorage Drawers&r jsou šuplíky na velké množství jednoho předmětu. Co je uvnitř, vidíš přímo zepředu."
		"Šuplík (&eOak Drawers 1x1&r) vyrobíš z dubových prken a truhly. Jsou i verze se 2 a 4 přihrádkami."
		"Pravým tlačítkem vložíš předmět z ruky. Rychlým dvojklikem pravým tlačítkem vložíš všechny stejné předměty z inventáře. Levým tlačítkem věci bereš."
	]
	quest.270663EA49DDC090.title: "Šuplíky"
	quest.2708985238B14648.quest_desc: [
		"&eVozík portálového jeřábu&r (&eGantry Carriage&r) jezdí po &ehřídeli jeřábu&r (&eGantry Shaft&r) a veze přilepené bloky."
		"Směr jízdy určuje natočení hřídele a směr její rotace. Hřídel s redstone signálem vozík zastaví."
		"Jeřáby jdou skládat na sebe, pak se udělátko hýbe ve 2 nebo 3 osách."
	]
	quest.2708985238B14648.title: "Portálový jeřáb"
	quest.271355B075257F85.quest_desc: [
		"Nucleeper je jaderný creeper. Před výbuchem se mu zavírá jádro, houká siréna a bliká."
		"&cMusíš ho zabít dřív, než se jádro zavře. Jeho výbuch je atomový!&r"
		"Někdy z něj padne štěpné jádro (&eFissile Core&r)."
	]
	quest.271355B075257F85.title: "Nucleeper"
	quest.272D595C8A6C5B4C.quest_desc: [
		"Rezidence (&eResidence&r) je dům pro občany. Vyrobíš ji z prken, pochodně a nástroje stavby."
		"Každá úroveň domu přidá jedno místo, takže dům úrovně 5 ubytuje 5 občanů. Strážní v domech nebydlí, spí ve svých věžích."
		"&cBez volné postele do kolonie nikdo nový nepřijde.&r"
	]
	quest.272D595C8A6C5B4C.title: "Domy pro občany"
	quest.274483F993429856.quest_desc: [
		"Zesílená slitina (&eReinforced Alloy&r) je infuzní slitina napuštěná diamantem v infuzéru."
		"Zdrojem infuze je obohacený diamant nebo diamantový prach (&eDiamond Dust&r) z drtiče. Celý diamant infuzér nevezme."
		"&aTip:&r Elitní obvod (&eElite Control Circuit&r) = pokročilý obvod + 2 zesílené slitiny."
	]
	quest.274483F993429856.title: "Zesílená slitina"
	quest.27997AC89B597764.quest_desc: [
		"Klec umí i zpracovávat předměty. Nejcennější surovinou pro ni je podezřelý kámen (&eSuspicious Rock&r)."
		""
		"Když v mlýnském kameni meleš vápenec (&eLimestone&r), dostaneš vápníkový prášek (&eCalcium Rich Powder&r) a s šancí 5 % i podezřelý kámen. Vápenec vznikne, když se láva potká s tekoucím medem."
		""
		"&aVápníkový prášek, štěrk a 100 mB lávy slisuj v tyglíku pod mechanickým lisem a dostaneš kalcit.&r"
	]
	quest.27997AC89B597764.title: "Podezřelý kámen"
	quest.27A43D68759F5362.quest_desc: [
		"Železný prut (&eIron Fishing Rod&r) vydrží déle než dřevěný. Vyrobíš ho ze železa, klacků a provázku."
		"Pruty z Aquaculture se úplně nerozbijí. Opotřebovaný prut jen přestane fungovat, dokud ho neopravíš."
	]
	quest.27A43D68759F5362.title: "Lepší prut"
	quest.27D396D26F794EFB.quest_desc: [
		"&bDeep Aether&r rozšiřuje Aether o nové biomy, stromy, jídlo, kombinátor, mosazný dungeon a bosse &eEye of the Storm&r."
		"Navazuje na kapitolu &bAether&r. Nejlepší výbava odsud potřebuje i gravitit a poklad ze zlatého dungeonu."
	]
	quest.27D396D26F794EFB.title: "Hlubší Aether"
	quest.27D745F535B0521B.quest_desc: [
		"Medové lepidlo (&eHoney Glue&r) je pohodlnější lepidlo pro fyzikální stroje. Lepí jen je, obyčejné stroje z Create ne."
		"Vyrobíš ho dávkovačem: naplň železný plát medem."
		"Klikni na dva rohy – vznikne slepený kvádr. Ctrl + kolečko myši ho zvětší nebo zmenší, s klávesou Alt položíš roh i do vzduchu."
		"&aU složitých staveb je lepší než vteřinové lepidlo, protože nepřilepí nic navíc.&r"
	]
	quest.27D745F535B0521B.title: "Medové lepidlo"
	quest.27DDECAD836CD91D.quest_desc: [
		"&bBrewery&r je mod o vaření piva a whisky. Pivo se vaří ve varně (&eWooden Brewing Station&r) – má kotel, pec a tlačítko časovače."
		"Do kotle nalij kbelík vody a do pece přilož palivo. Pak vlož suroviny a stiskni tlačítko časovače. Co chybí, ti varna ukáže, když se na ni podíváš."
		"Chmel (&eHops&r) najdeš divoký v tajze (&eWild Hops&r). Můžeš ho i zasadit a pěstovat."
	]
	quest.27DDECAD836CD91D.title: "Pivovar"
	quest.27EC6B1B36F86C2C.quest_desc: [
		"Polymerová deska (&ePolymer Plate&r) je velmi odolný materiál."
		"Recept: toxická pasta (&eToxic Paste&r, padá z Gammaroache), láhev radonu (&eBottle of Radon&r), sirný prach a železný ingot. Vzniknou 4 desky."
		"Radon nabereš prázdnou lahví z geotermálního průduchu, ze kterého stoupá zelený plyn. Sirný prach vytěžíš ze sirných krystalů."
	]
	quest.27EC6B1B36F86C2C.title: "Polymerová deska"
	quest.27FA0642458E86BB.quest_desc: [
		"&bPam's HarvestCraft 2&r přidává přes sto plodin, desítky ovocných stromů a stovky jídel."
		"Jídla se vyrábějí na pracovním stole pomocí kuchyňského nářadí. Nářadí se při vaření nespotřebuje a zůstane ti."
		"Plodiny najdeš v divokých zahrádkách (třeba &eWindy Garden&r), ovoce na stromech v lesích."
	]
	quest.27FA0642458E86BB.quest_subtitle: "Začátečník"
	quest.27FA0642458E86BB.title: "Pam's HarvestCraft 2"
	quest.28012E59F5AED886.quest_desc: [
		"Okoun (&eRaw Perch&r) je ryba z modu &bUpgrade Aquatic&r. Syrového okouna získáš, když ho ve vodě zabiješ."
		"Okouna s houbami (&ePerch with Mushrooms&r) uvaříš z okouna, kolonie červených hub, rýže a rajčete."
	]
	quest.28012E59F5AED886.title: "Okoun s houbami"
	quest.28142123F7EB3642.quest_desc: [
		"Semínka pšenice padají z trávy. Motykou udělej z hlíny pole a semínka zasaď."
		"Pole potřebuje vodu blízko sebe, jinak roste pomalu."
		"Zralou úrodu sklidíš pravým kliknutím – rostlina se sama znovu zasadí (mody &bRightClickHarvest&r a &bQuark&r)."
	]
	quest.28142123F7EB3642.title: "Políčko"
	quest.28147E35103238FC.quest_desc: [
		"Železný štít (&eIron Plated Shield&r) vyrobíš z dřevěného štítu a 4 železných ingotů."
		"Stejně fungují i další kovy z packu. JEI ti ukáže, které."
		"&aTip:&r Na štít můžeš dát vlajku (prapor), jako na obyčejný štít."
	]
	quest.28147E35103238FC.title: "Železný štít"
	quest.281652550AB417EB.quest_desc: [
		"&eVětrné ložisko&r (&eWindmill Bearing&r) + aspoň 8 bloků plachet = větrný mlýn. &eVětrné plachty&r (&eWindmill Sail&r) se lepí samy, lepidlo nepotřebují."
		"Postav plachty před ložisko a klikni na ložisko pravým. Každých 8 plachet = 1 RPM, nejvíc 16 RPM (128 plachet). Za každé RPM dá 512 SU."
		"&aTip:&r Jako plachta se počítá i vlna, tu ale musíš přilepit. Směr otáčení nastavíš na panelu ložiska."
	]
	quest.281652550AB417EB.title: "Větrný mlýn"
	quest.282FAAB07B21947C.quest_desc: [
		"Truhly v dungeonech, chrámech a jiných stavbách patří modu &bLootr&r."
		"Každý hráč v nich najde vlastní kořist. Když truhlu vybere kamarád, ty v ní pořád najdeš svoje věci."
		"Úkol: otevři první takovou truhlu."
	]
	quest.282FAAB07B21947C.title: "Truhla jen pro tebe"
	quest.2833C0B4A3AC7833.quest_desc: [
		"Organický kompost (&eOrganic Compost&r) slož z hlíny, slámy, kostní moučky a buď shnilého masa, nebo kůry."
		"Polož ho na zem a čekej. Postupně se změní na bohatou půdu (&eRich Soil&r). Rychleji to jde na slunci, u vody a vedle hub, podzolu nebo podhoubí."
		"Bohatá půda občas sama pohnojí rostlinu nad sebou. Motykou z ní uděláš bohatou ornici (&eRich Soil Farmland&r)."
	]
	quest.2833C0B4A3AC7833.title: "Bohatá půda"
	quest.2866C3C4C4C90E33.quest_desc: [
		"Alchymistický stůl (&eAlchemy Bench&r) mění vzácné bloky: bloky diamantů, zlata, železa, smaragdů, mědi, ametystu nebo světlitu."
		"Vyrobíš ho z pracovního stolu, varného stojanu, oltáře očarování a dřevěných půlbloků."
	]
	quest.2866C3C4C4C90E33.title: "Alchymistický stůl"
	quest.286DF6CFF7B640F2.quest_desc: [
		"Ze šupin nagy vyrobíš tuniku (8 šupin) a kalhoty (7 šupin)."
		"Tunika má Ochranu před ohněm III, kalhoty Ochranu III. Šupiny padají jen z nagy, takže ji možná budeš muset porazit vícekrát."
	]
	quest.286DF6CFF7B640F2.title: "Zbroj ze šupin"
	quest.28B0FE898EF00ADE.quest_desc: [
		"Elektromotor (&eElectric Motor&r) dělá opak alternátoru: z elektřiny vyrábí otáčení."
		""
		"Rychlost nastavíš kolečkem myši na zadní straně. Čím rychleji se točí, tím víc elektřiny spotřebuje. Vyrobíš ho v mechanickém výrobníku ze 3 měděných cívek, kondenzátoru, mosazných plátů, železné tyče a andezitové slitiny."
		""
		"&aVíc najdeš v kapitole Elektřina.&r"
	]
	quest.28B0FE898EF00ADE.title: "Z elektřiny otáčení"
	quest.28BE31C616FE2CF2.quest_desc: [
		"Vyrob celou gravititovou zbroj: helmu, hrudní plát, kalhoty, boty a rukavice (&eGravitite Gloves&r). Quest chce všech 5 kusů."
		"S celou sadou skáčeš mnohem výš a nezraní tě pád."
	]
	quest.28BE31C616FE2CF2.title: "Vzdoruj gravitaci"
	quest.28DFD5172B4A1EED.quest_desc: [
		"Teď už nemusíš kuličky sbírat sám. Lucerna zkušeností (&eExperience Lantern&r) je nasává z okolí, i z hráčů. Čím víc jich má, tím víc svítí."
		""
		"Vyrobíš ji z bloku zkušeností (&eBlock of Experience&r), houby a měděného pouzdra (&eCopper Casing&r)."
		""
		"&aTip:&r Hodí se k farmě na moby. Funguje i na pohyblivé konstrukci (kontrapci)."
	]
	quest.28DFD5172B4A1EED.title: "Lucerna zkušeností"
	quest.28E70663009E1387.quest_desc: [
		"Květinářka (&eFlower Shop&r) pěstuje květiny pomocí kompostu."
		"Výzkum &eFlower Power&r stojí 64 kompostu a kompostárny musí mít dohromady úroveň 3. Blok budovy: prkna, vlčí mák a nástroj stavby."
	]
	quest.28E70663009E1387.title: "Květinářství"
	quest.292AE2FBE9208159.quest_desc: [
		"Piglinský kat (&ePiglin Executioner&r) žije v &eNetherové pustině&r."
		"&cKdyž prohrává, volá si na pomoc pigliny.&r Může z něj padnout &eExecutioner Cowl&r."
	]
	quest.292AE2FBE9208159.title: "Kat"
	quest.293A782207EE6DCF.quest_desc: [
		"&bMacaw's Roofs&r: šikmé střechy všech tvarů. Dřevěné (třeba &eOak Roof&r) vyrobíš z kmenů nebo prken a tyčky, kamenné a terakotové na řezačce kamene."
		"Kladivo na střechy (&eRoofing Hammer&r) přepíná tvar vrcholu střechy. Klikni s ním pravým tlačítkem na horní díl."
		"&aTip:&r každá střecha má díly: obyčejný, strmý, horní, dolní a podkrovní. Kombinuj je."
	]
	quest.293A782207EE6DCF.quest_subtitle: "Pokročilý"
	quest.293A782207EE6DCF.title: "Střechy"
	quest.296C1852C112730D.quest_desc: [
		"Teď už zesílené pláty nestačí. Netheritové pláty (&eNetherite Plates&r) vzniknou, když pokladač nasadí netheritový ingot na zesílené pláty. Přidají zbroj, zdraví, odolnost proti odhození a ohni."
		""
		"Kvantový pohon (&eQuantum Drive&r) vlka teleportuje k cíli. Léčivé pouzdro (&eRegenerative Casing&r) vzniká nasazením precizního strojku na zesílené pláty a vlk se s ním sám léčí."
		""
		"&aObsaď všech 9 slotů: přidej raketu (&eBooster Rocket&r), světlo (&eMounted Light&r) a radar (&eMob Radar&r), který ukáže nepřátele i přes zdi.&r"
	]
	quest.296C1852C112730D.quest_subtitle: "Expert"
	quest.296C1852C112730D.title: "Plně vybavený vlk"
	quest.296D7A7FF5E8C659.quest_desc: [
		"Lasagne (&eLasagne&r) upečeš v kamnech z boloňské omáčky, těstovin a sýra."
		"Z jednoho pečení jsou dvě. Polož je na talíř a máš hlavní chod."
	]
	quest.296D7A7FF5E8C659.title: "Lasagne"
	quest.29A51CAD8561B3A5.quest_desc: [
		"Teleportér bez cíle nikam nevede. Cíl si pamatuje odkaz (&eTp Link&r). Vyrobíš ho z vysílače, redstonové perly, mosazného plátu a pokročilého dílu."
		""
		"Jdi na cílové místo a klikni odkazem pravým tlačítkem na blok. Nad ním nech volné místo. Pak odkaz vlož do teleportéru."
		""
		"Do teleportéru napumpuj šťávu, každý skok spotřebuje 250 mB. Stoupni si na něj a počkej, až se nabije."
		""
		"&cCíl musí být ve stejné dimenzi a v dosahu (výchozí je 450 bloků). Vzdálenost uvidíš v okně teleportéru.&r"
	]
	quest.29A51CAD8561B3A5.title: "Odkaz a první skok"
	quest.29AB76AAC9528C20.quest_desc: [
		"Z DNA savců (třeba mamuta) kultivátor vyrobí injekci s embryem."
		"Injekcí klikni na dospělého savce: krávu, prase, ovci, koně a další. Zvíře za čas porodí pravěké mládě."
	]
	quest.29AB76AAC9528C20.title: "Pravěcí savci"
	quest.29AC80F7B18A7A59.quest_desc: [
		"Piglini (prasečí lidé v Netheru) na tebe nezaútočí, když máš na sobě aspoň jeden kus zlaté zbroje."
		"Stačí zlatá helma (&eGolden Helmet&r) z 5 zlatých ingotů."
		"&cPozor:&r když otevřeš jejich truhlu nebo rozbiješ zlatý blok, rozzlobí se i tak."
	]
	quest.29AC80F7B18A7A59.title: "Zlatá zbroj"
	quest.29BB6DB665039749.quest_desc: [
		"Nejjednodušší dělo je z kovaného železa. Uzávěr (&eWrought Iron Cannon End&r) a komoru (&eWrought Iron Cannon Chamber&r) vyrobíš na pracovním stole ze železných plátů a střelného prachu. Uzávěr potřebuje navíc železný ingot."
		""
		"Tyhle bloky se po položení samy spojí. Postav je vodorovně na lafetu: vzadu uzávěr, před ním dvě komory. Přesné místo ukáže ponder lafety (podrž &eW&r)."
		""
		"&cŽelezné dělo vydrží jen 1 nálož.&r Dřevěné dělo (&eLog Cannon Chamber&r) je ještě slabší – může prasknout už při jedné náloži."
	]
	quest.29BB6DB665039749.title: "Železné dělo"
	quest.29D8A152629539DA.quest_desc: [
		"Teleportér (&eTeleporter&r) tě přenese k jinému teleportéru, i do jiné dimenze. Spotřebuje energii podle vzdálenosti."
		"Postav svislý rám 3 bloky široký a 4 vysoký s prázdným otvorem 1×2 uprostřed. Samotný teleportér patří doprostřed spodní řady. Zbytek rámu je z 9 bloků &eTeleporter Frame&r."
		"&aTip:&r Srdcem teleportéru je teleportační jádro (&eTeleportation Core&r) z atomové slitiny, diamantu, zlata a endových perel."
	]
	quest.29D8A152629539DA.title: "Teleportér"
	quest.29F8EF6357FE6F95.quest_desc: [
		"Železný batoh (&eIron Backpack&r) je zase o kus větší."
		"Vyrobíš ho z měděného batohu a 4 železných ingotů (nebo z obyčejného batohu a 8 ingotů)."
	]
	quest.29F8EF6357FE6F95.title: "Železný batoh"
	quest.2A13571F48EAD5EC.quest_desc: [
		"Vesnice s vesničany. &bTowns and Towers&r a &bRepurposed Structures&r jim dávají jiný vzhled v každém biomu."
		"S vesničany můžeš obchodovat za smaragdy. Knihovník prodává očarované knihy."
		""
		"&aTip:&r Postav si u vesnice postel. Při útoku nájezdníků vesnici braň."
	]
	quest.2A13571F48EAD5EC.title: "Vesnice"
	quest.2A23DA3AA9F9DD39.quest_desc: [
		"Průmyslové železo je tmavý kov pro velké tovární haly."
		""
		"V kameníkovi udělej ze železného ingotu 2 bloky průmyslového železa (&eBlock of Industrial Iron&r). Z bloku ve výrobní mřížce dostaneš 9 ingotů průmyslového železa."
		""
		"Z ingotu pak v kameníkovi vyrobíš lávky (&eIndustrial Iron Catwalk&r), mřížky, žebříky a další díly."
		""
		"&aTip: Z jednoho železného ingotu je tak 18 ingotů průmyslového železa. Je to levný materiál na velké stavby.&r"
	]
	quest.2A23DA3AA9F9DD39.title: "Průmyslové železo"
	quest.2A481C1B043C7691.quest_desc: [
		"Štika (&ePike&r) žije v řekách a bažinách."
		"Klikni na ni &eKbelíkem vody&r a chytíš ji živou (&eBucket of Pike&r). Štiky mají spoustu různých barev."
	]
	quest.2A481C1B043C7691.title: "Štika v kbelíku"
	quest.2A510456ED3D8581.quest_desc: ["Vylepši radnici na úroveň 5. Bude to chlouba celé kolonie."]
	quest.2A510456ED3D8581.title: "Mistrovská radnice"
	quest.2A6A93CF28B60138.quest_desc: [
		"Rafinovaný obsidián (&eRefined Obsidian Ingot&r) je velmi pevný kov."
		"Postup: obsidián rozdrť v drtiči na prach. V infuzéru ho napusť diamantem – vznikne rafinovaný obsidiánový prach (&eRefined Obsidian Dust&r). Ten stlač v osmiovém kompresoru na ingot."
		"&aTip:&r Z rafinovaného obsidiánu jsou nejsilnější nástroje a brnění z &bMekanism Tools&r."
	]
	quest.2A6A93CF28B60138.title: "Rafinovaný obsidián"
	quest.2A8C437262AA3434.quest_desc: [
		"Královna (&eValkyrie Queen&r) sedí na vrcholu dungeonu. Klikni na ni pravým tlačítkem a vyber souboj – musíš mít u sebe 10 medailí."
		"Útočí zblízka a sesílá blesky. Po smrti ti dá stříbrný klíč (&eSilver Key&r) k pokladu."
		"V pokladu bývá Valkýří zbroj, se kterou můžeš na chvíli létat, a kámen regenerace."
	]
	quest.2A8C437262AA3434.title: "Královna Valkýr"
	quest.2AAD58D70F5DBEB8.quest_desc: [
		"Etrionická vysoká pec (&eEtrionic Blast Furnace&r) má dva režimy: tavení (4 věci naráz) a slévání, ve kterém vyrábí ocel."
		"Recept potřebuje železné pláty. Udělej si kompresor (&eCompressor&r) ze železa a pístů a vylisuj v něm pláty ze železných ingotů."
		"Pláty se ve hře ukážou jako &eIron Sheet&r z Create. Je to totéž. &aVyrobí je i mechanický lis z Create.&r"
	]
	quest.2AAD58D70F5DBEB8.title: "Etrionická pec"
	quest.2ABFF9CC8FEEBC20.quest_desc: [
		"Voda je v tomto packu živější. &bUpgrade Aquatic&r přidává ryby, rostliny a mořské příšery. &bBen's Sharks&r přidává hodně druhů žraloků."
		"Pod vodou ti dochází vzduch. Vezmi si lektvar dýchání pod vodou."
		"&aTip:&r &eHelma z želvoviny&r ti díky Upgrade Aquatic dává dýchání pod vodou celou dobu, dokud ji nosíš. Jen se přitom opotřebovává."
	]
	quest.2ABFF9CC8FEEBC20.quest_subtitle: "Začátečník"
	quest.2ABFF9CC8FEEBC20.title: "Pod hladinou"
	quest.2AC35C9341CB4233.quest_desc: [
		"&bUpgrade Aquatic&r přidává nové mořské tvory, korály a naplavené dřevo."
		"Kmeny naplaveného dřeva leží na plážích, u řek, v bažinách a v oceánech. Ze 4 kmenů vyrobíš 3 bloky dřeva (&eDriftwood&r)."
	]
	quest.2AC35C9341CB4233.title: "Naplavené dřevo"
	quest.2AD7900C07F16CE8.quest_desc: [
		"Praním písku dostaneš hroudu jílu (25 %). Červený písek dá zlaté nugety, duší písek křemen."
		"Drtící kola později udělají ze štěrku písek. Kámen → štěrk → písek → praní je jednoduchá linka bez těžení."
	]
	quest.2AD7900C07F16CE8.title: "Praní písku"
	quest.2AEBE01A3EDB2B09.quest_desc: [
		"&bSlice \\& Dice&r přidává kráječ (&eSlicer&r) – vyrobíš ho z ozubeného kola, andezitového pláště a otočného stolu."
		"Postav ho nad pás, odkládací desku (&eDepot&r) nebo tyglík a pravým tlačítkem do něj vlož nůž nebo sekeru. Pak krájí jídlo podle receptů krájecího prkénka."
	]
	quest.2AEBE01A3EDB2B09.title: "Kráječ"
	quest.2B031643B535337D.quest_desc: [
		"Perly jsou vzácné. Dá ti je jen vydra (&eOtter&r), která žije v řekách."
		"Dej vydře škeble (&eClam&r). Chytíš je rybařením nebo padají z utopenců. Vydra škebli otevře a občas v ní najde perlu."
		"Náhrdelník (&ePearl Necklace 1&r) ze 4 perel nos na krku: zrychlí plavání a utopenci a strážci tě hůř uvidí."
	]
	quest.2B031643B535337D.quest_subtitle: "Expert"
	quest.2B031643B535337D.title: "Perlový náhrdelník"
	quest.2B03B4A0BBF02287.quest_desc: [
		"Upgrade na krmení (&eFeeding Upgrade&r) ti dá najíst z jídla v batohu, když dostaneš hlad."
		"Recept je dražší: zlaté jablko, zlatá mrkev, třpytivý meloun a ender perla."
		"&aTip:&r Dej do batohu hodně různých jídel. Pestrá strava ti přidá srdíčka (viz quest &eKniha jídel&r)."
	]
	quest.2B03B4A0BBF02287.title: "Batoh tě nakrmí"
	quest.2B130A00EEB13DBE.quest_desc: [
		"Mod &bDeep Aether&r přidává do Aetheru nové biomy, moby, materiály a dungeon s bossem."
		"Nebeský jadeit (&eSkyjade Gemstone&r) je jeho první nový materiál. Rudu vytěžíš zanitovým krumpáčem a přetavíš v peci."
		"Pokračuj kapitolou &bDeep Aether&r."
	]
	quest.2B130A00EEB13DBE.title: "Deep Aether"
	quest.2B1A08CB82494159.quest_desc: [
		"Biohmota (&eBio Goo&r) je palivo kultivátoru."
		"Vyrobíš ji z vejce, pšenice, shnilého masa a kbelíku mléka."
	]
	quest.2B1A08CB82494159.title: "Biohmota"
	quest.2B20D90E96A04453.quest_desc: [
		"Rybář chytá ryby a občas i poklady. Budovu (&eFisher's Hut&r) vyrobíš z prken, rybářského prutu a nástroje stavby."
		"Potřebuje vodu aspoň 7 × 7 bloků a hlubokou aspoň 1 blok. Budova musí stát ve stejné výšce jako voda a nejvýš 10 bloků od ní."
		"Rybář potřebuje rybářský prut."
	]
	quest.2B20D90E96A04453.title: "Rybář"
	quest.2B23ECEB6D927D69.quest_desc: [
		"Tekuté hnojivo (&eLiquid Fertilizer&r) namícháš v míchačce ze stromového hnojiva (&eTree Fertilizer&r) a vody."
		"Pusť ho potrubím do postřikovačů nad polem. Plodiny pod nimi rostou jako po kostní moučce – úplně bez práce."
	]
	quest.2B23ECEB6D927D69.quest_subtitle: "Expert"
	quest.2B23ECEB6D927D69.title: "Tekuté hnojivo"
	quest.2B350DF3371EA66E.quest_desc: [
		"Toustovač (&eLight Toaster&r) ze železa a redstonu opeče krajíc chleba na toust (&eToast&r)."
		"&cToustovač potřebuje elektřinu.&r Připoj ho klíčem ke generátoru."
	]
	quest.2B350DF3371EA66E.title: "Toustovač"
	quest.2B3D90A1C372943A.quest_desc: [
		"Na kovadlině opravíš nástroje, spojíš očarované knihy s výbavou a přejmenuješ předměty."
		"Vyrobíš ji ze 3 železných bloků a 4 železných ingotů. Každé použití stojí zkušenosti."
	]
	quest.2B3D90A1C372943A.title: "Kovadlina"
	quest.2B485AB49CC0FB8B.quest_desc: [
		"Víko slévárny (&eBasin Foundry Lid&r) změní tyglík na tavicí pec. Vyrobíš ho ze 4 andezitových slitin."
		""
		"Polož víko na tyglík a pod tyglík ohňohořák. Musí hořet, jinak se nic neroztaví."
		""
		"Hoď do tyglíku litinu. Z každého ingotu je 90 mB tekuté litiny. Čerpadlem (&eMechanical Pump&r) ji odvedeš trubkami."
	]
	quest.2B485AB49CC0FB8B.title: "Tavení kovu"
	quest.2B537CA0CE39D081.quest_desc: [
		"Silo z Farm \\& Charm usuší ječmen, kukuřici i oves. Sušené obilí je základ všech piv a whisky."
		"Ječmenné pivo, ovesné pivo i pivo z kopřiv vaříš ve dřevěné varně stejně jako pšeničné."
	]
	quest.2B537CA0CE39D081.title: "Sušené obilí"
	quest.2B5EF4CE0EBFB280.quest_desc: [
		"Otevři 25 truhel, sudů nebo vozíků z &bLootru&r."
		"Truhly ve stavbách se nevyplatí přeskakovat. Můžou v nich být očarované knihy, diamanty i vzácné kovářské šablony."
	]
	quest.2B5EF4CE0EBFB280.title: "Lovec pokladů"
	quest.2B5F98DEC04CABD5.quest_desc: [
		"Nether máš zvládnutý, další cíl je End. Cesta tam vede přes portál v pevnosti (&eStronghold&r) v Overworldu."
		"Hoď oko Enderu do vzduchu (pravé tlačítko). Poletí směrem k pevnosti. Jdi za ním a házej znovu."
		"Když oko spadne dolů, pevnost je přímo pod tebou. Mod &bYUNG's Better Strongholds&r z ní udělal velké bludiště. Najdi místnost s portálem a do prázdných rámů vlož oči Enderu."
	]
	quest.2B5F98DEC04CABD5.quest_subtitle: "Expert"
	quest.2B5F98DEC04CABD5.title: "Sleduj oko"
	quest.2B63BDD79EEBA111.quest_desc: [
		"Disková jednotka (&eME Drive&r) s paměťovými buňkami + terminál (&eME Terminal&r) = všechny věci na jedné obrazovce s vyhledáváním."
		"Zařízení spoj kabely a dodej energii. Ovladač (&eME Controller&r) potřebuješ, až bude mít síť víc než 8 zařízení – vysvětlení najdeš v kapitole &bApplied Energistics 2&r."
	]
	quest.2B63BDD79EEBA111.title: "AE2: první síť"
	quest.2B676C6E27D0DDA2.quest_desc: [
		"Stavitel je nejdůležitější občan. Staví a vylepšuje všechny ostatní budovy."
		"Stavitelovu budovu (&eBuilder's Hut&r) vyrobíš z prken, dveří a nástroje stavby. Polož ji nástrojem stavby – najdeš ji v kategorii &eFundamentals&r."
		"Je to jediná budova, kterou si stavitel postaví sám bez hotové chaty. Ostatní dělníci začnou pracovat, až je jejich budova aspoň na úrovni 1."
	]
	quest.2B676C6E27D0DDA2.title: "Stavitelova budova"
	quest.2B7B8E0ECBF5B9E7.quest_desc: [
		"&eZapouzdřený řetězový pohon&r (&eEncased Chain Drive&r): andezitové pouzdro a 3 železné nugety."
		"Pohony položené v řadě si předávají rotaci a všechny se točí stejným směrem. Část řady může být otočená o 90°."
	]
	quest.2B7B8E0ECBF5B9E7.title: "Řetězový pohon"
	quest.2B8091C7A70DA971.quest_desc: [
		"Pluh (&ePilot&r) je mříž na předku lokomotivy. Je to ozdoba, která dodá lokomotivě opravdový vzhled."
		"Kovový pluh (&eMetal Pilot&r) je ze železných plátů a nugetů. Jsou i verze z andezitu, mosazi, mědi a leštěných kamenů."
	]
	quest.2B8091C7A70DA971.title: "Pluh lokomotivy"
	quest.2B84F53E5BFE7866.quest_desc: [
		"Teď už nejde jen o to víno vyrobit. Víno stárne, jen když je uložené – ve stojanu na víno (&eOak Wine Rack&r) nebo v bedně na víno."
		"Čím je víno starší, tím silnější a delší efekt dává. Nejlépe zraje ve sklepě, kam nesvítí obloha."
		"&aTip:&r Na lahvi vidíš, kolik je vínu let."
	]
	quest.2B84F53E5BFE7866.quest_subtitle: "Pokročilý"
	quest.2B84F53E5BFE7866.title: "Zrání vína"
	quest.2BA4DA1562241157.quest_desc: [
		"Ur-Ghast je obří ghast. Střílí ohnivé koule a pláče ohnivými slzami."
		"Bij ho, dokud ho past drží u země. Upustí ohnivé slzy (&eFiery Tears&r), karminit a trofej."
	]
	quest.2BA4DA1562241157.title: "Ur-Ghast"
	quest.2BC5BCCC13435C52.quest_desc: [
		"&bThe Twilight Forest&r je dimenze věčného soumraku plná lesů, staveb a bossů."
		"Bossové jdou v pevném pořadí. Oblasti dál v lese jsou prokleté (tma, mráz, oheň, kyselý déšť), dokud neporazíš správného bosse."
		"Co máš splnit, aby kletba zmizela, ukážou pokroky (&eAdvancements&r) Twilight Forest."
	]
	quest.2BC5BCCC13435C52.title: "Soumračný les"
	quest.2BE0C7958CE2F3BA.quest_desc: [
		"Naftový motor jde vylepšit. Vylepšení nasadíš tak, že s ním klikneš pravým tlačítkem na motor."
		""
		"Turbodmychadlo (&eEngine Turbocharger&r) motor zrychlí. Ve výchozím nastavení se točí dvakrát rychleji."
		""
		"Tlumič (&eEngine Silencer&r) motor ztiší. Hodí se, když motor stojí u domu."
	]
	quest.2BE0C7958CE2F3BA.title: "Vylepšení motoru"
	quest.2BE741FAC9DE31D8.quest_desc: [
		"Z 9 sušených zelených čajů vyrob blok (&eDried Green Tea Leaf Block&r) a nech ho znovu uschnout. Vznikne černý čaj (&eDried Black Tea&r)."
		"Černý čaj (&eBlack Tea&r) uvaříš s cukrem. Efekt &eTough&r: při málo životech dostaneš odolnost a regeneraci."
	]
	quest.2BE741FAC9DE31D8.title: "Černý čaj"
	quest.2BF0C9C9375B44EE.quest_desc: [
		"&bFruits Delight&r přidává ovocné stromy a keře: hrušky, broskve, mango, kiwi, fíky, borůvky a další."
		"Ananas roste divoce na plážích. Citrony rostou v pláních."
		"&aTip:&r Džemy a želé z tohoto modu dávají zvláštní efekty. Popis efektu najdeš v popisku jídla."
	]
	quest.2BF0C9C9375B44EE.title: "Fruits Delight"
	quest.2BF735803A0CB25E.quest_desc: [
		"Barevné svíčky na knihovnách u očarovacího stolu zvýší šanci na určitá očarování. Každá barva patří k jinému."
		"Když pod svíčkou (nebo pod její knihovnou) je písek duší, šanci naopak sníží."
		"Úkol: ovlivni očarování svíčkou."
	]
	quest.2BF735803A0CB25E.title: "Svíčky a očarování"
	quest.2C01CB0FA140EADE.quest_desc: ["Kasárny na plné úrovni se všemi věžemi. To je až 20 strážných na jednom místě."]
	quest.2C01CB0FA140EADE.title: "Velká posádka"
	quest.2C099E3F85EBCCFF.quest_desc: [
		"Kolonie má 25 občanů! Teď už nejde o přežití, ale o to, aby byli všichni spokojení."
		"Hlídej jídlo, nemoci a bydlení. Nešťastný soused kazí náladu i ostatním."
	]
	quest.2C099E3F85EBCCFF.quest_subtitle: "Pokročilý"
	quest.2C099E3F85EBCCFF.title: "Vesnička"
	quest.2C31C8ED05148930.quest_desc: [
		"Spací vak (&eBedroll&r) vyrobíš z 5 kůží a 1 bílé vlny."
		"Na rozdíl od postele v něm můžeš spát i pod vodou. Vyspi se v něm pod hladinou."
	]
	quest.2C31C8ED05148930.title: "Spaní pod vodou"
	quest.2C52B19B59B89346.quest_desc: [
		"Široká kolej (&eWide Andesite Train Track&r) má větší rozchod. Hodí se pro mohutné vlaky."
		"Vyrábí se z běžné koleje: mechanická pila ji rozřízne, pokladač přidá desku a lis ji stiskne."
		"&cNa širokou kolej potřebuješ široký podvozek.&r S vlakovým pouzdrem v ruce zmáčkni Alt – otevře se nabídka podvozků. Vyber v ní podvozek pro širokou kolej."
	]
	quest.2C52B19B59B89346.title: "Široký rozchod"
	quest.2C56F56BB9D08CC8.quest_desc: [
		"Ve světě je spousta staveb. Přidávají je mody &bTowns and Towers&r, &bExplorify&r, &bIntegrated Dungeons and Structures&r, &bRepurposed Structures&r, &bMoog's Voyager Structures&r a stavby pro &bCreate&r."
		"Každý biom má jiné stavby. Čím vzácnější stavba, tím lepší poklad a silnější nepřátelé."
		""
		"&aTip:&r Stavby hledej z výšky – z hory nebo z vrcholu stromu je vidíš z dálky."
	]
	quest.2C56F56BB9D08CC8.quest_subtitle: "Začátečník"
	quest.2C56F56BB9D08CC8.title: "Stavby ve světě"
	quest.2C56F980713D3F51.quest_desc: [
		"Teď už vyrábíš sladkosti v celých linkách. Marshmallow (&eMarshmallow&r) namícháš s ohřevem: 2 cukry, sliz a voda. Z jednoho míchání je jich 8."
		"Tekutý karamel je ze 2 cukrů a vody (taky s ohřevem). Lis nad tyglíkem z něj udělá tabulku (&eBar of Caramel&r)."
	]
	quest.2C56F980713D3F51.quest_subtitle: "Pokročilý"
	quest.2C56F980713D3F51.title: "Marshmallow a karamel"
	quest.2C598B9EC0357553.quest_desc: ["Měděné oplechování (&eCopper Plating&r) zlepší ovladatelnost lodi. Instaluje se v loděnici."]
	quest.2C598B9EC0357553.title: "Měděné oplechování"
	quest.2C6246BC13E91518.quest_desc: [
		"Na hladině oceánů, řek a bažin se občas objeví hejno ryb (&eShoal&r)."
		"Nahoď do něj prut a lov tak dlouho, dokud hejno nezmizí."
	]
	quest.2C6246BC13E91518.title: "Hejno"
	quest.2C871A47F93B1186.quest_desc: [
		"Logický adaptér (&eFission Reactor Logic Adapter&r) hlídá reaktor redstonem. Postav ho do stěny reaktoru."
		"Jednoduchá pojistka: první adaptér nastav na &eHigh Temperature&r. Jeho signál přiveď do redstonové pochodně a pochodeň napoj na druhý adaptér v režimu &eActivation&r."
		"Když se reaktor přehřeje, první adaptér vyšle signál, pochodeň zhasne a druhý adaptér reaktor vypne."
		"&aTip:&r Stejně můžeš hlídat i poškození (&eDamage Critical&r) nebo plnou nádrž odpadu (&eCritical Waste Level&r)."
	]
	quest.2C871A47F93B1186.title: "Pojistka reaktoru"
	quest.2C894BE6E98E80CF.quest_desc: [
		"Fúzní palivo D-T vznikne v chemickém infuzéru z deuteria a tritia. Tritium vyrobí solární neutronový aktivátor z plynného lithia."
		"Hohlraum (&eHohlraum&r) vyrobíš v infuzéru ze 4 zlatých prachů a uhlíku. Naplň ho palivem D-T – vlož ho do slotu chemické nádrže s palivem."
		"&aTip:&r Hohlraum se při zapálení reaktoru spotřebuje."
	]
	quest.2C894BE6E98E80CF.title: "Fúzní palivo"
	quest.2CBC7475AE21C488.quest_desc: [
		"Toxické jeskyně jsou radioaktivní pustina z kamene &eRadrock&r."
		"&cJezírka kyseliny ničí brnění a pak i tebe. Radioaktivní věci ti dají efekt ozáření (&eIrradiated&c): zastaví léčení a silnější ozáření tě zraňuje.&r"
		"&aJídlo ze sirného prachu (&eSulfur Dust&r) tě léčí i při ozáření.&r"
	]
	quest.2CBC7475AE21C488.title: "Toxické jeskyně"
	quest.2CBF7FF3B2F783CD.quest_desc: [
		"&bEnder Storage&r: truhly propojené kódem ze 3 barev. Stejné barvy = stejný obsah, i přes dimenze."
		"Barvu změníš tak, že klikneš barvivem na jeden z barevných proužků na víku truhly."
		"Endová kapsa (&eEnder Pouch&r) otevře truhlu se stejným kódem odkudkoli. Kód můžeš sdílet s kamarády."
	]
	quest.2CBF7FF3B2F783CD.title: "Ender Storage"
	quest.2CC5781813EF7459.quest_desc: [
		"Sada na vylepšení (&eBasic Tier Installer&r) promění jednoduchý stroj na továrnu přímo na místě – nemusíš ho bourat."
		"Klikni s ní pravým tlačítkem na stroj, třeba na energetickou tavicí pec. Továrnu pak sadami vyšší úrovně (&eAdvanced Tier Installer&r a další) vylepšíš ještě víc."
		"&aTip:&r Továrnu jde vyrobit i rovnou v pracovním stole – recept ukáže JEI."
	]
	quest.2CC5781813EF7459.title: "Sada na továrnu"
	quest.2CC9432A1DACBAA8.quest_desc: [
		"Hydra je obří vícehlavý drak. Plive oheň, hlavami kouše a zničené hlavy jí po chvíli dorostou."
		"Drž se v pohybu a nestůj v plamenech."
		"Upustí ohnivou krev (&eFiery Blood&r), kotletu hydry a trofej."
	]
	quest.2CC9432A1DACBAA8.title: "Hydra"
	quest.2CCEFDD346DB7DEA.quest_desc: [
		"&eKarton&r (&eCardboard&r) je materiál na balíčky. Míchačka smíchá 4 kusy bambusu, cukrové třtiny nebo sazenic s 250 mB vody na &ebuničinu&r (&ePulp&r)."
		"Lis z buničiny udělá karton. 4 kartony dají &eblok kartonu&r, ten je v receptu balíkovače."
	]
	quest.2CCEFDD346DB7DEA.title: "Karton"
	quest.2CE8408DA5D42876.quest_desc: [
		"Spokojení občané pracují lépe. Spokojenost (&eHappiness&r) najdeš v radnici."
		"Zvyšuje ji: bydlení (lepší dům = víc), práce, jídlo, spánek, strážní a přežitý nájezd bez mrtvých."
		"Snižuje ji: nemoc, zranění, smrt občana, dělník bez nástrojů a nešťastní sousedé."
		"{@pagebreak}"
		"V této kapitole postavíš lepší domy, kuchyni a zvířata a nakonec zvětšíš kolonii na desítky občanů."
		"&aTip:&r úroveň dělníka nepřeroste úroveň jeho domu. Kdo bydlí špatně, přestane se zlepšovat."
	]
	quest.2CE8408DA5D42876.title: "Spokojení občané"
	quest.2CF5F343FEB15B83.quest_desc: [
		"Teď už vlk jen nekouše – dostane výbavu. Vlk má 1 slot na obranu, 3 na útok, 2 na pohyb a 3 na užitečné věci."
		""
		"Obrana: zesílené pláty (&eReinforced Plates&r) z mosazi a štítu. Útok: namontovaná kuše (&eMounted Crossbow&r) z precizního strojku, obyčejné kuše a mosazi. Střílí jen na cíl vlka."
		""
		"&aDalší útočné moduly: teslův ocas (&eTesla Tail&r) zraní, kdo vlka napadne. Ohnivé tesáky (&eSmelting Fangs&r) zapalují a chrání vlka před ohněm.&r"
	]
	quest.2CF5F343FEB15B83.quest_subtitle: "Pokročilý"
	quest.2CF5F343FEB15B83.title: "První moduly"
	quest.2CF92FE6E201E0A2.quest_desc: [
		"Kopírovací nástroj (&eCopy Paste Gadget&r) zkopíruje celou stavbu a postaví ji jinde."
		"V režimu kopírování označ dva rohy oblasti, pak přepni na vkládání a stavbu polož. Bloky se berou z tvého inventáře."
		"&aTip:&r Hodí se na opakující se stavby – domy, farmy nebo stroje z Create."
	]
	quest.2CF92FE6E201E0A2.title: "Kopírování staveb"
	quest.2CFBBD46E56319D6.quest_desc: [
		"Generátor krystalové rezonance (&eCrystal Resonance Generator&r) vyrábí energii pro síť bez paliva."
		"V jedné síti ale funguje jen jeden."
		"&aTip:&r Na malou síť to stačí. Velká síť s automatickou výrobou potřebuje víc – připoj akceptor energie."
	]
	quest.2CFBBD46E56319D6.title: "Energie bez paliva"
	quest.2D525CB474749D76.quest_desc: [
		"Detektor vlaku (&eTrain Observer&r) dá redstonový signál, když přes jeho značku projede vlak."
		"Pokládá se jako stanice: klikni na kolej a polož ho vedle. Filtrem nastavíš, aby reagoval jen na vlak s určitým nákladem."
		"&aPoužij ho na závory, světla, zvonek nebo počítání vlaků.&r"
	]
	quest.2D525CB474749D76.title: "Detektor vlaku"
	quest.2D87980A8468C48F.quest_desc: [
		"Motor z Netheru (&eNether Engine&r): výkon motoru +30 %, spotřeba paliva +30 %."
		"Výroba: motor, netheritový ingot, ohnivé tyče, magmový krém a netherové cihly."
	]
	quest.2D87980A8468C48F.title: "Motor z Netheru"
	quest.2DB6FF5D23B03EFB.quest_desc: [
		"Nech se trefit střelou shulkera a vyleť do výšky 50 bloků."
		"&cAž levitace skončí, spadneš. Měj u sebe vodu nebo krovky!&r"
	]
	quest.2DB6FF5D23B03EFB.title: "Vzhůru!"
	quest.2DBEAD3058872A11.quest_desc: [
		"&bBells \\& Whistles&r přidává drobnosti pro vlaky a nádraží. Začni světlometem (&eHeadlight&r) na předek lokomotivy."
		"Výroba: pochodeň a železné nugety dají 2 světlomety."
	]
	quest.2DBEAD3058872A11.title: "Světlomet"
	quest.2DDA09607F9DF746.quest_desc: [
		"Portál do Aetheru postavíš jako portál do Netheru, jen místo obsidiánu použiješ bloky světlitu (&eGlowstone&r)."
		"Rám je nejmenší 4 bloky široký a 5 vysoký. Na zapálení nalij dovnitř vodu z kbelíku."
		"Světlit získáš v Netheru – visí ze stropu. Potřebuješ 10 bloků (rohy rámu nejsou nutné)."
	]
	quest.2DDA09607F9DF746.title: "Portál do nebe"
	quest.2E0499457314AAEF.quest_desc: [
		"&ePrahový spínač&r (&eThreshold Switch&r) hlídá, jak plná je truhla, trezor nebo nádrž."
		"Když obsah přeroste horní hranici, změní redstone signál. Vrátí ho, až obsah klesne pod dolní hranici. Hranice nastavíš v okně."
		"&aTip:&r Spínač u skladu může spojkou vypnout výrobu, když je sklad plný."
	]
	quest.2E0499457314AAEF.title: "Prahový spínač"
	quest.2E1183E126BBEE2D.quest_desc: [
		"Teď už nejsi omezený běžnými limity. V super režimu jdou úrovně očarování nad maximum, kovář spojí i očarování, která se navzájem vylučují, a očarovávač umí pokladová očarování."
		""
		"V super režimu ale stroje přijímají jen super šablony (&eSuper Enchanting Template&r)."
		"{@pagebreak}"
		"Polož hromosvod přímo na blok zkušeností. Když do hromosvodu udeří blesk, blok se může změnit na blok super zkušeností (&eBlock of Super Experience&r). Blesk ze super režimu ho promění vždy."
		""
		"Blok super zkušeností rozmáčkni lisem a máš super šablonu."
		""
		"&cSuper režim přivolává blesky. Dej poblíž stroje hromosvod. Když stroj zakryješ blokem, blesk do něj neudeří, ale výsledek může být horší (třeba s kletbou).&r"
	]
	quest.2E1183E126BBEE2D.quest_subtitle: "Expert"
	quest.2E1183E126BBEE2D.title: "Super očarování"
	quest.2E26A11D9E252E54.quest_desc: [
		"Pod zemí rostou kořeny. Světlejší živé kořeny (&eLiveroots&r) dávají živý kořen (&eLiveroot&r)."
		"Je to základ železodřeva – první dobré výbavy v lese."
	]
	quest.2E26A11D9E252E54.quest_subtitle: "Začátečník"
	quest.2E26A11D9E252E54.title: "Živý kořen"
	quest.2E357941BEE9D977.quest_desc: [
		"Duševní korálek (&eSoul Bead&r) padá z přízraků (&eWraith&r) v údolí duší v Netheru."
		"Když ho použiješ, poletí směrem k nejbližší netherové pevnosti."
	]
	quest.2E357941BEE9D977.title: "Duševní korálek"
	quest.2E4CEF52C54BAAEF.quest_desc: [
		"Bronzové dělo vydrží 4 nálože a svařováním nezeslábne."
		""
		"Bronz (&eBronze Ingot&r) uděláš v míchačce s ohřevem z mědi, zinku a uškvařené mouky (&eCinder Flour&r). Jde to i ze 2 mosazí a uškvařené mouky. Vzniknou vždy 2 ingoty."
		""
		"Roztav ho, odlij a vyvrtej stejně jako litinu. Bronz potřebuje 2 nálože na každé 3 kusy hlavně."
		""
		"Posuvný závěr z bronzu dokončíš klínem &eBronze Sliding Breechblock&r."
	]
	quest.2E4CEF52C54BAAEF.title: "Bronzové dělo"
	quest.2E72FB52740BFE07.quest_desc: [
		"Asfaltová jezírka najdeš na pláních a v savanách, některá i v zasněžené krajině."
		"Kbelíkem naber asfalt. V pracovním stole z kbelíku asfaltu vzniknou 4 kapky (&eTar Drop&r)."
		"Kapky analyzuj. Dostaneš asfaltovou fosilii (&eTar Fossil&r) s DNA zvířat doby ledové."
	]
	quest.2E72FB52740BFE07.title: "Asfaltová jezírka"
	quest.2E824C8431A61702.quest_desc: [
		"Bio-generátor (&eBio-Generator&r) pálí bio palivo z drtiče. Je to jednoduchý zdroj energie, který jde snadno automatizovat."
		"Bio palivo vlož do slotu. Generátor z něj udělá tekuté palivo a spaluje ho."
		"&aTip:&r Napoj farmu na drtič a drtič na generátor – energie poteče sama."
	]
	quest.2E824C8431A61702.title: "Bio-generátor"
	quest.2E82E1E9C5E6B5A0.quest_desc: [
		"&bCritters and Companions&r přidává vydry, fretky, pandy červené, kapry koi, vážky a další."
		"Vážčí křídlo (&eDragonfly Wing&r) padá z vážky. Vážky létají hlavně u vody."
		"&aTip:&r Křídlem ochočíš skákavého pavouka (&eJumping Spider&r). Víc v kapitole &eMazlíčci a chov&r."
	]
	quest.2E82E1E9C5E6B5A0.title: "Vážčí křídlo"
	quest.2E962DB53F5177FE.quest_desc: [
		"Měřítko (&eCalipers&r) změří vzdálenost. Hodí se, když plánuješ, kam se vejde budova."
		"Levým tlačítkem klikni na první blok, pravým na druhý. Pak klikni pravým tlačítkem do vzduchu a měřítko ukáže rozměry."
	]
	quest.2E962DB53F5177FE.title: "Posuvné měřítko"
	quest.2E96CA9B08CF96A4.quest_desc: [
		"Aerolitový amulet (&eAerolite Charm&r) tě vytáhne na povrch. Použij ho, když stojíš pod bloky, třeba v jeskyni."
		"Výroba: provázek, 2 aerolitové větvičky, perla Enderu a křemen. Dobiješ ho v pracovním stole perlou Enderu."
	]
	quest.2E96CA9B08CF96A4.title: "Aerolitový amulet"
	quest.2EAE49CCD83FB7CF.quest_desc: [
		"V pekelných dunách (&eInfernal Dunes&r) stojí pekelný oltář (&eInfernal Altar&r)."
		"Až budeš mít hvězdu Netheru, vyvoláš tu bosse."
	]
	quest.2EAE49CCD83FB7CF.title: "Pekelný oltář"
	quest.2EB9E28995E4A151.quest_desc: [
		"&bFish of Thieves&r přidává 10 druhů ryb ze hry Sea of Thieves. Každý má několik barevných variant podle biomu, času a počasí."
		"Ryby plavou ve vodě. Chytíš je do kbelíku s vodou nebo ulovíš. Splashtail (&eRaw Splashtail&r) žije v oceánech."
	]
	quest.2EB9E28995E4A151.title: "Fish of Thieves"
	quest.2EBEF3B33E07DAF2.quest_desc: [
		"&eSeznam filtrů&r (&eList Filter&r): vlna mezi 2 železnými nugety. Pravým klikem do něj nastavíš předměty."
		"Filtr vlož do &efiltrového slotu&r stroje (malé okénko na bloku). Stroj pak pracuje jen s vybranými věcmi."
		"&eFiltr atributů&r (&eAttribute Filter&r, s mosaznými nugety) třídí podle vlastností, třeba „lze rozdrtit“ (&ecan be Crushed&r) nebo „lze sníst“ (&ecan be eaten&r)."
	]
	quest.2EBEF3B33E07DAF2.title: "Filtry"
	quest.2EC104BAFD748A80.quest_desc: [
		"Otevři 100 truhel z Lootru. To se povede jen opravdovému průzkumníkovi."
		"&aTip:&r Nejvíc truhel mají velké stavby: hrady, pevnosti a chrámy."
	]
	quest.2EC104BAFD748A80.title: "Sto pokladů"
	quest.2EC2B936B99A6DDA.quest_desc: [
		"Teď už jednotlivé věže nestačí. Postav kasárny na úrovni 1."
		"Za každou úroveň kasáren můžeš postavit jednu kasárenskou věž. Věž nemůže mít vyšší úroveň než kasárny."
		"&aTip:&r v kasárnách můžeš během nájezdu najmout špehy. Za zlato ti prozradí, kde jsou nepřátelé."
	]
	quest.2EC2B936B99A6DDA.quest_subtitle: "Pokročilý"
	quest.2EC2B936B99A6DDA.title: "Kasárny stojí"
	quest.2ED6CA635F4ADC2C.quest_desc: [
		"Bombu (&eBomb&r) hodíš a ona po chvíli vybuchne."
		"Z jednoho TNT, železa a provázku vyrobíš 4 bomby."
		"&cPozor:&r bomby ničí bloky – nehaž je u domu."
	]
	quest.2ED6CA635F4ADC2C.title: "Bomby"
	quest.2EFA4DB7C88AFD2C.quest_desc: [
		"Dvě zvířata stejného druhu nakrm jejich oblíbeným jídlem. Pak se jim narodí mládě."
		"Krávy a ovce chtějí pšenici, prasata mrkev, slepice semínka."
		"Vlastní chov znamená stálý přísun masa, kůže a vlny. Kůži budeš potřebovat na batoh."
	]
	quest.2EFA4DB7C88AFD2C.title: "Chov zvířat"
	quest.2F010B6348E6265D.quest_desc: [
		"Nádvoří nagy (&eNaga Courtyard&r) je ohrazená zahrada z kamene nagy (&eNagastone&r). Najdeš ho v běžném lese."
		"Uvnitř čeká první boss. Kouzelná mapa ti nádvoří pomůže najít."
	]
	quest.2F010B6348E6265D.title: "Nádvoří nagy"
	quest.2F19BEBF9BECB07F.quest_desc: [
		"Ruční přenášení věcí z vlaku zdržuje. Přenosné úložné rozhraní (&ePortable Storage Interface&r) vlak naloží a vyloží samo."
		"Výroba: andezitové pouzdro a šachta. Jedno rozhraní dej na vlak, druhé na nástupiště. Mezi nimi musí být mezera 1 nebo 2 bloky. Když se potkají, spojí se."
		"Rozhraní na nástupišti pak funguje jako všechny truhly vlaku dohromady. Věci do něj posílej trychtýřem nebo šachtou, nebo je z něj vytahuj."
		"&aV jízdním řádu použij podmínku &eCargo Inactivity&a – vlak odjede, až se nakládka zastaví.&r"
		"Vlakem můžeš posílat i balíky z Create. Klikni poštovní schránkou (&ePostbox&r) na stanici, polož ji poblíž a dej jí adresu. Vlak tu naloží balíky s cizí adresou a vyloží ty s její adresou."
	]
	quest.2F19BEBF9BECB07F.title: "Nakládka bez rukou"
	quest.2F23EA8BB242092C.quest_desc: [
		"Křečky přidává &bAdorable Hamster Pets&r. Křečci žijí v mnoha biomech a v každém mají jinou barvu srsti."
		"V teplejších biomech (nížiny, savany, okraje džungle) rostou divoké okurkové keře. Klikni na ně pravým tlačítkem a dostaneš okurková semínka (&eCucumber Seeds&r). Zasaď je na pole."
	]
	quest.2F23EA8BB242092C.title: "Okurková semínka"
	quest.2F3C7FB3AFECCECA.quest_desc: [
		"Padá z fičáka, větrné příšery z komnat klání."
		"Vyrobíš z ní &eVětrné náboje&r. Hodíš je pod sebe a vyskočíš vysoko. Hůl je také potřeba na &ePalcát&r."
	]
	quest.2F3C7FB3AFECCECA.title: "Fičákova hůl"
	quest.2F57F1A41EEE1AD3.quest_desc: [
		"Pult (&eOak Counter&r) a skříňka (&eOak Cupboard&r) se vyrábí s truhlou – můžeš do nich ukládat věci."
		"Kladivem z &bHandcrafted&r změníš jejich tvar. Na pult klikni blokem dřeva nebo kamene a změníš desku."
	]
	quest.2F57F1A41EEE1AD3.title: "Kuchyňská linka"
	quest.2F7E05AA0E43016B.quest_desc: [
		"Přízračný šrot (&eSpectral Scrap&r) padá z nemrtvých enderlingů (&eUndead Enderling&r). Najdeš ho i v truhlách v domech a lodích."
		"Je to poslední surovina, kterou potřebuješ na perleťový ingot."
	]
	quest.2F7E05AA0E43016B.title: "Přízračný šrot"
	quest.2FA2BDF96208DF0E.quest_desc: [
		"Talíř rolek (&eRice Roll Medley&r) je hostina z plátků rolky z řasy, lososových rolek, treskových rolek a misky."
		"Rolku z řasy nakrájíš nožem na prkénku na plátky."
	]
	quest.2FA2BDF96208DF0E.title: "Talíř rolek"
	quest.2FAA295E3540F2CE.quest_desc: ["Mlýnek (&eGrinder&r) s pšenicí nebo bramborou na pracovním stole dá mouku (&eFlour&r)."]
	quest.2FAA295E3540F2CE.title: "Mouka"
	quest.2FB005B949EA6CE7.quest_desc: [
		"Drtící kola (&eCrushing Wheel&r) rozemelou drcené kakao na kakaový prášek (&eCocoa Powder&r) a se šancí 75 % i kakaové máslo (&eCocoa Butter&r)."
		"Kakaové máslo je základ hořké a bílé čokolády."
	]
	quest.2FB005B949EA6CE7.title: "Kakaový prášek a máslo"
	quest.2FC01348B9B2FEAF.quest_desc: [
		"Vlaky z &bCreate&r vozí hráče i náklad po vlastních kolejích. Jezdí daleko, rychle a umí jezdit samy podle jízdního řádu."
		"Postup: vyrobíš robustní plát a vlakové pouzdro, položíš koleje a stanici, sestavíš vlak a naučíš ho jezdit samotného. Nakonec postavíš celou železniční síť."
		"&aVlaky jsou pokročilá část Create. Nejdřív zvládni mosaz, pokladač a precizní strojek z kapitoly Create.&r"
		"&bSteam 'n' Rails&r přidává další koleje, výhybky a průvodčí. &bBells \\& Whistles&r přidává ozdoby pro vlaky a nádraží."
	]
	quest.2FC01348B9B2FEAF.quest_subtitle: "Začátečník"
	quest.2FC01348B9B2FEAF.title: "Vlaky v Create"
	quest.2FE678C449C86B15.quest_desc: [
		"&bExtraDelight&r napodobuje skutečnou kuchyni. Místo pracovního stolu vaříš na strojích: mícháš v míse, drtíš v hmoždíři a pečeš v troubě."
		"Začni mísou a hmoždířem. Pak přijde trouba, odpařovač soli a nakonec kvašení a čokoláda."
		"&aTip:&r Postup každého receptu (i počet zamíchání) ukáže JEI."
	]
	quest.2FE678C449C86B15.quest_subtitle: "Začátečník"
	quest.2FE678C449C86B15.title: "Kuchyně ExtraDelight"
	quest.2FF0B80BC844AEF4.quest_desc: [
		"&bMacaw's Doors&r: stodolové, moderní, japonské, westernové a mnoho dalších dveří."
		"Stodolové dveře (&eOak Barn Door&r) jsou z prken a tyček, moderní (&eOak Modern Door&r) z prken a tabulek skla."
		"&cKovové dveře se otevírají jen redstonem.&r"
	]
	quest.2FF0B80BC844AEF4.title: "Dveře"
	quest.2FFF72D75547DA55.quest_desc: [
		"Sýrový sud (&eCask&r) vyrobíš ze sudů, kbelíku, železa a prken. Klikni na něj kbelíkem mléka."
		"Mléko v sudu pomalu zraje na sýr. Rychleji to jde ve tmě a u vody. Hotový sýr vyndáš pravým tlačítkem."
	]
	quest.2FFF72D75547DA55.title: "Sýr ze sudu"
	quest.3002526E88C933DB.quest_desc: [
		"Naga je obří had. Rychle se plazí a vrhá se na tebe."
		"Po smrti upustí šupiny nagy (&eNaga Scale&r) a trofej. Šupina zlomí kletbu na věži Licha."
	]
	quest.3002526E88C933DB.title: "Naga"
	quest.300293F855AB765B.quest_desc: [
		"Na zemi jezdí stroje na kolech z &bOffroad&r. Uložení kola (&eWheel Mount&r) drží kolo a roztáčí ho rotací."
		"Pneumatiku (&eTire&r) nasadíš kliknutím na přední stranu uložení. Signál shora kolo brzdí, signál z boku ho natočí na tu stranu."
		"Tuhost odpružení nastavíš na panelu uložení."
		"&aPřidej přenosný motor a zatáčení redstonem – a máš auto.&r"
	]
	quest.300293F855AB765B.title: "Vozidla na kolech"
	quest.30098F74EC95DF66.quest_desc: [
		"&ePoštovní schránka&r (&ePostbox&r): barvivo, sud a slitina. S ní v ruce klikni na vlakovou stanici a polož ji poblíž."
		"Balíčky s cizí adresou naloží vlak, který ve stanici zastaví. Balíčky s její adresou tu vlak vyloží. Funguje, i když u ní nikdo není a okolí není načtené."
		"Jak postavit vlak, najdeš v kapitole Vlaky."
	]
	quest.30098F74EC95DF66.title: "Poštovní schránka"
	quest.3028D2E3A9DD5FE4.quest_desc: [
		"Neptuniové brnění má podvodní schopnosti: helma lepší vidění, hrudní plát dýchání pod vodou, kalhoty tě pod vodou nadnášejí a boty zrychlí plavání."
		"Neptuniové nástroje se pod vodou nezpomalují a meč i sekera tam dávají víc zranění."
	]
	quest.3028D2E3A9DD5FE4.title: "Neptunova zbroj"
	quest.303271A683408829.quest_desc: [
		"Tuto kovářskou šablonu (&eSmithing Template&r) potřebuješ, když chceš z ohňohořáku (&eBlaze Burner&r) udělat plamenný stroj."
		""
		"První kus najdeš v truhlách v Netheru – v pevnostech a v baštách."
		""
		"Další si vyrobíš: šablona, 7 ohnivých tyčí a netherrack dají 2 šablony. &cVždy si nech aspoň jednu šablonu na další kopírování.&r"
	]
	quest.303271A683408829.title: "Kovářská šablona plamene"
	quest.3033A04DC0D32348.quest_desc: [
		"Meka-Tool (&eMeka-Tool&r) je vylepšený atomový rozkladač. Těží, kope i seká a dávají se do něj moduly."
		"Užitečné moduly: rychlejší těžba (&eExcavation Escalation Unit&r), těžba celé žíly (&eVein Mining Unit&r), Něžný dotek nebo Štěstí."
		"&aTip:&r Meka-Tool spotřebuje hodně energie – dej mu modul energie."
	]
	quest.3033A04DC0D32348.title: "Meka-Tool"
	quest.30481BA3B8AB6DF5.quest_desc: [
		"Boloňská omáčka (&eBolognese&r) se dělá na pekáči nebo pánvi. Potřebuješ rajskou polévku, mleté hovězí, slaninu, cibuli, mrkev, lahev s vodou a misku."
		"Rajskou polévku uvaříš v hrnci. Přesný recept ukáže JEI."
	]
	quest.30481BA3B8AB6DF5.title: "Boloňská omáčka"
	quest.304C7241ABFFB923.quest_desc: [
		"Teď už nemusíš klikat u očarovacího stolu a platit vlastními úrovněmi. Plamenný očarovávač bere tekuté zkušenosti z trubky."
		""
		"Nastav na panelu úroveň, vlož neočarovaný předmět a počkej. Očarovaný předmět vybereš pravým tlačítkem s prázdnou rukou."
		""
		"&aPrvní automatizace:&r Mechanická paže (&eMechanical Arm&r) umí očarovávači předměty vkládat i je vybírat. Stačí k němu přivést zkušenosti trubkou."
	]
	quest.304C7241ABFFB923.quest_subtitle: "Pokročilý"
	quest.304C7241ABFFB923.title: "Očarování bez stolu"
	quest.304FF124F30EFE2D.quest_desc: [
		"Deuterium je první složka fúzního paliva. Vzniká z těžké vody (&eHeavy Water&r)."
		"Elektrickou pumpu vylepši filtrem (&eFilter Upgrade&r) – místo vody bude čerpat těžkou vodu. Elektrolytický separátor ji rozloží na deuterium a kyslík."
		"&aTip:&r Pumpa potřebuje hodně vody. Polož ji nad velký zdroj, třeba moře."
	]
	quest.304FF124F30EFE2D.title: "Deuterium"
	quest.3058171C0B692A5F.quest_desc: [
		"Prismalitové střepy (&ePrismalite Shard&r) najdeš v hlubinách &eGloopstone Highlands&r, v urnách a truhlách."
		"9 střepů dá prismalitový drahokam (&ePrismalite Gem&r)."
	]
	quest.3058171C0B692A5F.title: "Prismalit"
	quest.307BBCE6E338273B.quest_desc: [
		"Univerzita (&eUniversity&r) je brána k pokročilé kolonii. Výzkumníci v ní odemykají nové budovy a vylepšení."
		"Vyrobíš ji z prken, 2 knih a nástroje stavby."
		"Každý výzkum stojí předměty a čas. Vyšší úroveň univerzity odemkne další stupně výzkumu a víc výzkumníků."
		"&cZrušený výzkum ti předměty nevrátí.&r Víc v kapitole &eVýzkum a obrana&r."
	]
	quest.307BBCE6E338273B.quest_subtitle: "Expert"
	quest.307BBCE6E338273B.title: "Univerzita"
	quest.3094DA8711BD1EF4.quest_desc: [
		"&bDomum Ornamentum&r skládá dva bloky do jednoho: třeba hrázděnou zeď z prken a kamene. Používá ho mnoho stylů MineColonies."
		"Řezačku (&eArchitect's Cutter&r) vyrobíš ze železného ingotu, kamenných půlbloků a kmenů."
		"Vlož materiály a vyber tvar: hrázdění, šindele, dveře, poklopy, panely, sloupy, papírové stěny, světla, cihly nebo sloupky."
	]
	quest.3094DA8711BD1EF4.title: "Architektova řezačka"
	quest.30AC080826CD4D00.quest_desc: [
		"Úkol pro experty: použij na kovářském stole každou ze vzácných šablon: Spire, Snout, Rib, Ward, Silence, Vex, Tide a Wayfinder."
		"Většinou jsou v truhlách v End City, v bastionech, v pevnostech v Netheru, v prastarých městech a v lesních sídlech. Tide padá z Elder Guardiana a Wayfinder najdeš v ruinách (Trail Ruins)."
	]
	quest.30AC080826CD4D00.title: "Sběratel vzorů"
	quest.30E7163CA35D51CE.quest_desc: [
		"Všechny stroje Ad Astra potřebují energii. Uhelný generátor (&eCoal Generator&r) ji vyrábí z uhlí nebo dřeva."
		"Stroj polož přímo vedle generátoru. Energie do něj poteče sama."
		"&aNa delší vzdálenost později použiješ kabely (&eSteel Cable&r).&r"
	]
	quest.30E7163CA35D51CE.title: "Uhelný generátor"
	quest.31086DF1C8B10AE6.quest_desc: ["Zesílení trupu (&eHull Reinforcement&r): odolnost letadla +100 %. Výroba: 3 trupy a železné ingoty."]
	quest.31086DF1C8B10AE6.title: "Zesílení trupu"
	quest.311D1BF1D8078723.quest_desc: [
		"Vylepšení se vkládají do slotů pro vylepšení na boku okna truhly. Většina se vyrábí ze základu (&eUpgrade Base&r) z prken a železa."
		"Násypkové vylepšení (&eHopper Upgrade&r) samo bere věci z bloku nad truhlou a posílá je do bloku pod ní."
		"&aTip:&r Další užitečná: sběrné (&ePickup Upgrade&r), filtr (&eFilter Upgrade&r) nebo tavení (&eSmelting Upgrade&r)."
	]
	quest.311D1BF1D8078723.title: "Vylepšení truhel"
	quest.312549E37E66FDF5.quest_desc: [
		"&eAndezitová slitina&r (&eAndesite Alloy&r) je základ skoro všech strojů z Create."
		"Vyrob ji v pracovním stole: 2 andezity a 2 železné nugety střídavě do čtverce 2×2. Místo železných nugetů jdou i zinkové."
		"Andezit najdeš v jeskyních a v horách. Později bude slitinu vyrábět míchačka sama (kapitola Stroje a automatizace)."
	]
	quest.312549E37E66FDF5.title: "Andezitová slitina"
	quest.31551F3777F08E22.quest_desc: [
		"&eTachometr&r (&eSpeedometer&r): kompas na andezitovém pouzdře. Ukazuje rychlost hřídele."
		"Komparátor u tachometru vyšle redstone signál podle rychlosti."
	]
	quest.31551F3777F08E22.title: "Tachometr"
	quest.315F7E3269F1CDF3.quest_desc: [
		"Gravititová ruda (&eGravitite Ore&r) je nejvzácnější ruda. Vytěžíš ji zanitovým krumpáčem. Když nad ní nic není, vyletí nahoru – padá vzhůru!"
		"Rudu dej do oltáře. Vznikne očarovaný gravitit (&eEnchanted Gravitite&r) a z něj vyrobíš výbavu."
		"&aTip:&r rudu těž zespodu nebo nad ni dej blok, ať ti neuletí."
	]
	quest.315F7E3269F1CDF3.title: "Gravitit"
	quest.31A8FB77C4AAFE9B.quest_desc: [
		"Vylepšení se vkládají do stroje: v okně stroje otevři kartu vylepšení a vlož je dovnitř."
		"Rychlost (&eSpeed Upgrade&r) zrychlí práci, ale stroj bere víc energie. Energie (&eEnergy Upgrade&r) sníží spotřebu a zvětší zásobník energie."
		"&aTip:&r Kolik kusů jde do stroje vložit, ukáže tooltip vylepšení."
	]
	quest.31A8FB77C4AAFE9B.title: "Vylepšení strojů"
	quest.31B81460433A0B70.quest_desc: [
		"Kamenický stůl a železný ingot dají dláto (&eChisel&r) – kamenický stůl, který nosíš v inventáři. Klikni s ním pravým tlačítkem a otevře se stejné okno."
		"Podobně vznikne pila (&eSaw&r) z truhlářského stolu a jehly (&eNeedles&r) z tkalcovského stolu."
	]
	quest.31B81460433A0B70.title: "Stůl do kapsy"
	quest.31FA0F97546D359E.quest_desc: [
		"Mapa bludiště + blok diamantů + blok zlata + blok železa = mapa rud (&eBlank Maze/Ore Map&r)."
		"Kromě chodeb ukazuje i rudy ve tvé výšce. Je ale hodně drahá."
	]
	quest.31FA0F97546D359E.title: "Mapa rud"
	quest.320B98A84E0B62FB.quest_desc: [
		"Nejtěžší stavby ve světě. Jdi jen v dobré zbroji, s jídlem a lektvary."
		"Pevnost nájezdníků stojí na nížinách, v tajze, v džungli, v květinovém lese a v dalších biomech. Žijí v ní mstitelé, mágové i ničitelé a jsou tu líhně."
		"Ve vězení najdeš zajaté vesničany."
	]
	quest.320B98A84E0B62FB.quest_subtitle: "Expert"
	quest.320B98A84E0B62FB.title: "Pevnost nájezdníků"
	quest.321226F7DE3C3D0E.quest_desc: [
		"Postav udělátko s vrtákem, pilou nebo sklízečem. Tyto díly pracují, když se udělátko hýbe."
		"Přilep k udělátku truhlu nebo sud, vytěžené věci padají rovnou do ní."
		"Teď už netěžíš ty, ale stroj. Pokladač na udělátku bere věci z jeho truhel – tak může zasít nebo položit bloky."
	]
	quest.321226F7DE3C3D0E.quest_subtitle: "Pokročilý"
	quest.321226F7DE3C3D0E.title: "Pracující udělátko"
	quest.32338933224950A5.quest_desc: [
		"Kalhoty ze stonožky (&eCave Centipede Leggings&r) ti dovolí lézt po stěnách."
		"Vyrob je ze 7 nožiček stonožky (&eCave Centipede Leg&r)."
	]
	quest.32338933224950A5.title: "Lezecké kalhoty"
	quest.323457D77D522225.quest_desc: [
		"Strážci v oceánských monumentech pouštějí maso strážce (&eGuardian&r)."
		"Polévku (&eGuardian Soup&r) uvaříš v hrnci ze strážce, cibule, 2 vajec a 2 rajčat."
	]
	quest.323457D77D522225.title: "Polévka ze strážce"
	quest.32411D3FA8AF1902.quest_desc: [
		"Krystaltin (&eCrystaltine Ingot&r) je vzácný materiál z elitního stolu (&eElite Crafting Table&r) 7×7."
		"Recept: diamanty, lazurit, železo, zlato a dvě netherové hvězdy. Vyjdou 4 ingoty."
		"&aTip:&r Na elitní stůl potřebuješ nejdřív pokročilý stůl (&eAdvanced Crafting Table&r)."
	]
	quest.32411D3FA8AF1902.quest_subtitle: "Expert"
	quest.32411D3FA8AF1902.title: "Krystaltin"
	quest.327637EA9EB24D7C.quest_desc: [
		"Odlitá hlaveň a komora jsou uvnitř plné. Vyvrtáš je vrtačkou (&eCannon Drill&r)."
		""
		"Dělo připevni na mechanické ložisko (&eMechanical Bearing&r). To je soustruh, který dělem točí. Proti ústí postav vrtačku a prodluž ji prodlužovacími ojnicemi (&ePiston Extension Pole&r)."
		""
		"Vrtačka potřebuje rotaci a vodu. Musí se točit stejně rychle nebo rychleji než soustruh. Při vrtání padají nugety. Uzávěr se nevrtá."
		"{@pagebreak}"
		"Hotové litinové dělo: uzávěr, 2 komory a 2 kusy hlavně. Do komor dej 2 nálože, střelu před ně."
		""
		"&aTip:&r S brýlemi uvidíš v popisku bloku děla, kolik náloží vydrží."
	]
	quest.327637EA9EB24D7C.quest_subtitle: "Pokročilý"
	quest.327637EA9EB24D7C.title: "Vyvrtej dělo"
	quest.32D4803F81262D20.quest_desc: [
		"Vosí krovky (&eTarantula Hawk Elytra&r) fungují jako Krovky, ale dávají navíc 3 body brnění."
		"Vyrob je ze 2 křídel a obyčejných &eKrovek&r z Endu."
	]
	quest.32D4803F81262D20.title: "Vosí krovky"
	quest.32D7711CE16D2166.quest_desc: [
		"&eWarped Mosco&r je obří zmutovaný komár a jeden z bossů modu &bAlex's Mobs&r."
		"Vznikne, když krvavý komár (&eCrimson Mosquito&r) vysaje krev z houbového tvora &eMungus&r, který nese zkřivenou houbu."
		"Je to silný boss. Z jeho svalu (&eWarped Muscle&r) a vaků (&eHemolymph Sac&r) vyrobíš zbraň &eHemolymph Blaster&r."
	]
	quest.32D7711CE16D2166.title: "Zkřivený mosco"
	quest.33062F97068D2DF3.quest_desc: [
		"Vysoké hory. Ve skále jsou dutiny z kalcitu a hladkého čediče. V nich je &eHlubinné smaragdové ložisko&r."
		"&aTip:&r Na smaragdy použij krumpáč s očarováním &eŠtěstí&r. Smaragdy se hodí na obchod s vesničany."
	]
	quest.33062F97068D2DF3.title: "Smaragdové vrcholky"
	quest.333037DE34082CA8.quest_desc: [
		"Na 5× zpracování rud potřebuješ kyselinu sírovou (&eSulfuric Acid&r). Výroba má tři kroky."
		"1) Chemický oxidátor (&eChemical Oxidizer&r) udělá ze sirného prachu oxid siřičitý. 2) Chemický infuzér: oxid siřičitý + kyslík = oxid sírový. 3) Chemický infuzér: oxid sírový + vodní pára = kyselina sírová."
		"Vodní páru vyrobí z vody rotační kondenzátor (&eRotary Condensentrator&r). Ten převádí kapaliny na plyny a zpět."
		"&aTip:&r Sirný prach dostaneš ze střelného prachu ve vstřikovací komoře, nebo z uhlí v tlakové reakční komoře."
	]
	quest.333037DE34082CA8.title: "Kyselina sírová"
	quest.3334E1BF315C1F0D.quest_desc: [
		"Bludištní sporák (&eMaze Stove&r) vyrobíš z rytířského kovu, cihel z bludiště, pochodňových bobulí a táboráku."
		"Hřeje hrnec a jídla z Twilight Forestu na něm vaříš rychleji."
		"&aTip:&r Ohnivý hrnec (&eFiery Cooking Pot&r) z ohnivých ingotů hřeje sám a nepotřebuje sporák."
	]
	quest.3334E1BF315C1F0D.title: "Bludištní sporák"
	quest.335442170EA2BD97.quest_desc: [
		"Čarodějnice Licowitch žijí ve věžích na velkých lékořicových stromech. Hází lektvary a vyvolávají sladké tvory."
		"Po zabití můžou upustit zářivou esenci (&eRadiant Essence&r). Najdeš ji i v truhlách jejich věží."
		"&aZ esence, želatiny a karamelu jsou gumová sluníčka (&eSundrop&r) a z nich duhové boty (&eRainbounce Boots&r), které ruší pád.&r"
	]
	quest.335442170EA2BD97.title: "Zářivá esence"
	quest.335737785A09E59F.quest_desc: [
		"Věž Licha (&eLich Tower&r) je vysoká věž se špičatou střechou. Dokud neporazíš nagu, chrání ji kletba."
		"Ve věži jsou knihovny a nepřátelé. Lich čeká v nejvyšším patře."
	]
	quest.335737785A09E59F.title: "Věž Licha"
	quest.3362A9FB7CFC6AA9.quest_desc: [
		"Odpařovač (&eEvaporator&r) vyrobíš z těžkých nášlapných desek a železných nugetů."
		"Postav ho tak, aby nad ním bylo vidět nebe, a nalij do něj kbelík vody. Voda se pomalu odpaří a zůstane sůl (&eSalt&r)."
	]
	quest.3362A9FB7CFC6AA9.title: "Sůl z vody"
	quest.337F30C7F7D63317.quest_desc: [
		"Mlátička (&eThrasher&r) je mořská příšera v chladných a ledových oceánech."
		"&cUmí tě chytit do tlamy a vidí tě přes zvukové vlny.&r Padá z ní zub (&eThrasher Tooth&r)."
	]
	quest.337F30C7F7D63317.title: "Zub mlátičky"
	quest.339C0897F750F0DA.quest_desc: [
		"&bSupplementaries&r: spousta malých užitečných bloků – lana, pytle, sklenice, glóby, rozcestníky, podstavce…"
		"Lano (&eRope&r) je z vláken, pytel (&eSack&r) z pšenice a vlákna, sklenice (&eJar&r) ze skla a dřevěného půlbloku."
		"Do pytle a sklenice se dají ukládat věci a vezmeš je s sebou i s obsahem."
	]
	quest.339C0897F750F0DA.title: "Supplementaries"
	quest.33CEF45BCB79EC5F.quest_desc: [
		"Nejvyšší stupeň: 5× zpracování rud. Z bloku rudy dostaneš 5 ingotů, ze 3 vytěžených rud 10 krystalů."
		"1) Rozpouštěcí komora (&eChemical Dissolution Chamber&r): ruda + kyselina sírová = špinavá kaše. 2) Pračka (&eChemical Washer&r): kaše + voda = čistá kaše. 3) Krystalizátor (&eChemical Crystallizer&r): kaše → krystaly (např. &eIron Crystal&r)."
		"Krystaly dej do vstřikovací komory a pokračuj linkou: střepy → hrudky → špinavý prach → prach → ingot."
		"&aTip:&r Na krystalizátor potřebuješ fluorit (&eFluorite&r). Jeho rudu zpracuj v obohacovací komoře – z bloku rudy dá 6 kusů."
	]
	quest.33CEF45BCB79EC5F.quest_subtitle: "Expert"
	quest.33CEF45BCB79EC5F.title: "5× rudy: celá linka"
	quest.33F328FA6A61DC1D.quest_desc: [
		"Svitek návratu (&eReturn Scroll&r) tě přenese k nejbližšímu waystonu, který jsi aktivoval. Po použití zmizí."
		"Teleport svitkem je zdarma – nestojí žádné zkušenosti."
		"Vyrábí se na mechanických craftovačích ze zlatých nuggetů, papíru a fialového barviva. Jeden recept dá 3 svitky."
	]
	quest.33F328FA6A61DC1D.title: "Svitek návratu"
	quest.33FA89533CAF9270.quest_desc: [
		"Nastav mechanické paži jako vstup truhlu s uhlím a jako výstup ohňohořák. Paže pak hořák krmí sama."
		"Paže nevezme víc, než může někam dát. S mosazným trychtýřem jako cílem bere jen to, co projde jeho filtrem."
	]
	quest.33FA89533CAF9270.title: "Paže krmí hořák"
	quest.33FC7CF39965C41D.quest_desc: [
		"Ent je živý strom. Objevuje se v noci v lesích."
		"Prolézá listím. Může z něj padnout &eTree Ent Root&r. Když ho držíš v druhé ruce, občas zpomalí nepřítele, kterého zasáhneš."
	]
	quest.33FC7CF39965C41D.title: "Stromový ent"
	quest.342BEB57BAE7A8B4.quest_desc: [
		"Jeskyně plná pavučin a pavouků."
		"&aTip:&r Pavučiny rychle přeseká meč nebo nůžky. Bez nich v pavučině uvízneš."
	]
	quest.342BEB57BAE7A8B4.title: "Pavoučí jeskyně"
	quest.343C30DCEAFBA9E7.quest_desc: [
		"Drtící kola rozdrtí surové železo na &erozdrcené surové železo&r (&eCrushed Raw Iron&r). K tomu s 75% šancí padne nuget zkušeností."
		"Celý blok rudy (vytěžený Jemným dotykem) dá víc: železná, zlatá a zinková ruda 1 drť + 75 % na druhou, hlubinné verze 2 + 25 %. Měděná ruda dá 5, hlubinná 7."
		"Teď už rudu nedávej rovnou do pece. Drť ještě vyper (bonus) nebo roztav. Z 1 drti je vždy 1 ingot nebo 9 nugetů."
	]
	quest.343C30DCEAFBA9E7.quest_subtitle: "Pokročilý"
	quest.343C30DCEAFBA9E7.title: "Drcení rud"
	quest.347E015883BF468C.quest_desc: [
		"Barvíř (&eDyer's Hut&r) vyrábí barviva a barví vlnu, sklo a další bloky."
		"Výzkum &eRainbow Heaven&r stojí 64 vlčích máků a kompostárny musí mít dohromady úroveň 3. Blok budovy: prkna, červené barvivo a nástroj stavby."
	]
	quest.347E015883BF468C.title: "Barvířství"
	quest.34C580629BB07E51.quest_desc: [
		"Ohniváci se objevují u líhní (&eMonster Spawner&r) v pevnosti. Po zabití z nich padá ohnivá tyč (&eBlaze Rod&r)."
		"Z tyče vyrobíš varný stojan a ohnivý prach. Ohnivý prach je potřeba na oči Enderu."
		"&aTip:&r ohniváci střílí ohnivé koule. Sněhové koule je zraňují a lektvar ohnivzdornosti tě ochrání."
	]
	quest.34C580629BB07E51.title: "Ohnivé tyče"
	quest.34DBBB9B7C4D7D98.quest_desc: [
		"Svět v tomto packu je větší a divočejší než obyčejný Minecraft."
		"&bTectonic&r dělá vysoké hory a hluboké oceány. &bTerralith&r přidává spoustu nových biomů. Mody &bYUNG's&r vylepšují dungeony, doly a chrámy."
		""
		"&aTip:&r Na výpravu si vezmi jídlo, pochodně, postel a náhradní nástroje. Biom, ve kterém stojíš, uvidíš po stisku F3."
		"Pokračuj kapitolami &eBiomy a krajina&r a &eStavby a města&r."
	]
	quest.34DBBB9B7C4D7D98.quest_subtitle: "Začátečník"
	quest.34DBBB9B7C4D7D98.title: "Velký svět"
	quest.34DD6FCEE793D686.quest_desc: [
		"Rostlinný olej (&ePlant Oil&r) je nejjednodušší palivo. Vyrobíš ho z obyčejných semínek."
		""
		"Polož tyglík (&eBasin&r) pod mechanický lis (&eMechanical Press&r) a vhoď do něj semínka. Lis z každého semínka vymačká 100 mB oleje."
		""
		"Olej odčerpej z tyglíku čerpadlem do nádrže a z ní potrubím do motoru. Kbelíkem motor nenaplníš."
		""
		"Kbelík na úkol naplníš tak, že klikneš prázdným kbelíkem na tyglík nebo nádrž. Musí v nich být aspoň 1 000 mB oleje."
		""
		"&aTip: Olej je slabé palivo, ale na první motor stačí. Až budeš chtít víc síly, pokračuj k etanolu a bionaftě.&r"
	]
	quest.34DD6FCEE793D686.quest_subtitle: "Začátečník"
	quest.34DD6FCEE793D686.title: "Rostlinný olej"
	quest.34E2F932B08C047C.quest_desc: [
		"Teď už nemusíš všechno vyrábět sám. More Features přidává vesničanům nová povolání a každé má svůj pracovní blok."
		""
		"Dílna (&eWorkshop&r) udělá z vesničana bez práce konstruktéra (&eConstructor&r). Potřebuješ na ni sadu základních strojů (&eSet Of Basic Mechanisms&r)."
		""
		"Sada se skládá z lisu, větráku, míchačky, vrtáku, pokladače, pily, sklízeče, pluhu a mlýnského kamene."
		""
		"Další pracovní bloky jsou třeba &ePlumber Table&r, &eLineman Table&r nebo &ePostman worktable&r. Noví řemeslníci prodávají za smaragdy věci z Create."
	]
	quest.34E2F932B08C047C.quest_subtitle: "Pokročilý"
	quest.34E2F932B08C047C.title: "Řemeslníci z Create"
	quest.34F4915BEA30683F.quest_desc: [
		"Postav první kasárenskou věž (&eBarracks Tower&r). Každá úroveň věže přidá jednoho strážného, až 5 na věž."
		"Strážní bydlí přímo ve věži, takže nezabírají postele v domech."
	]
	quest.34F4915BEA30683F.title: "Kasárenská věž"
	quest.34F59209DC3C1624.quest_desc: [
		"Základní materiál je křemenné železo (&eQuartz Enriched Iron&r): 3 železné ingoty + 1 netherový křemen = 4 kusy."
		"Na kabely potřebuješ křemennou měď (&eQuartz Enriched Copper&r) – stejný recept, jen s mědí."
		"&aTip:&r Netherový křemen najdeš v Netheru."
	]
	quest.34F59209DC3C1624.title: "Křemenné železo"
	quest.34FB2E5CBA0F0BB9.quest_desc: [
		"Sněhová královna (&eSnow Queen&r) čeká na vrcholu polárního paláce."
		"Upustí trojitý luk (&eTri-Bow&r) nebo luk naváděných šípů (&eSeeker Bow&r) a trofej."
	]
	quest.34FB2E5CBA0F0BB9.title: "Sněhová královna"
	quest.35089B47ED779ED7.quest_desc: [
		"V mracích stojí dům obrů. Obří horník (&eGiant Miner&r) po smrti upustí obrův krumpáč (&eGiant's Pickaxe&r)."
		"Jen obrův krumpáč rozbije obří bloky, třeba obrovský obsidián (&eGiant Obsidian&r)."
	]
	quest.35089B47ED779ED7.title: "Obři v oblacích"
	quest.351131BFC29EA916.quest_desc: [
		"Mrak v lahvi (&eCloud in a Bottle&r) postaví dočasný blok ve vzduchu. Na něj pak můžeš stavět dál."
		"Naber ho prázdnou lahví ve výšce mraků (Y 191 až 196)."
	]
	quest.351131BFC29EA916.title: "Mrak v lahvi"
	quest.35318D85DBDBF88B.quest_desc: [
		"&eMontážní klíč&r (&eWrench&r): 3 zlaté pláty, ozubené kolečko a klacek."
		"Pravým tlačítkem otáčíš bloky. Shift + pravé tlačítko blok rychle sebere do inventáře."
		"Klíčem také přepínáš režimy: obrátíš čerpadlo, nastavíš šipky mechanického výrobníku nebo uděláš okénko v potrubí."
	]
	quest.35318D85DBDBF88B.title: "Montážní klíč"
	quest.3537E60BAC85BC48.quest_desc: [
		"Kolonie má 10 občanů. Víc občanů znamená víc dělníků a víc surovin."
		"Každý nový občan potřebuje postel a jídlo. Stav domy dřív, než dojdou místa."
	]
	quest.3537E60BAC85BC48.title: "Osada"
	quest.354F890F64451933.quest_desc: [
		"&bCreate: Let The Adventure Begin&r přidává do světa stavby z bloků Create: domy, větrné mlýny, lomy, jeskyně a hrady. V jejich truhlách najdeš kořist."
		"Královský hrad je vzácný. Hledej ho na pláních a v březových lesích, spíš dál od spawnu. Stačí, když do něj vejdeš."
		""
		"&cUvnitř je truhla, která přivolá bosse. Než ji otevřeš, připrav se na boj.&r"
	]
	quest.354F890F64451933.quest_subtitle: "Let The Adventure Begin"
	quest.354F890F64451933.title: "Královský hrad"
	quest.355418A2E2912B0A.quest_desc: [
		"Žíla je obrovské ložisko rudy hluboko pod zemí. Nevidíš ji a krumpáčem ji nevytěžíš – patří vždy k jednomu chunku."
		""
		"Vrtná souprava (&eDrilling Machine&r) z ní těží bez kopání, ale bez vrtáku nefunguje. Nejjednodušší je železný vrták (&eIron Drill&r) z 5 železných ingotů a 2 železných bloků."
		""
		"Vlož vrták do soupravy a roztoč ji. Souprava musí stát na pevné zemi v chunku se žílou. Brýle ti ukážou, co se těží a kolik žíly zbývá."
	]
	quest.355418A2E2912B0A.quest_subtitle: "Začátečník"
	quest.355418A2E2912B0A.title: "Železný vrták"
	quest.357EC8D220BAB085.quest_desc: [
		"Mody &bLet's Do&r přidávají nové plodiny, farmářské stroje a kuchyni, kde se vaří ručně krok za krokem."
		"Základ je &bFarm \\& Charm&r: plodiny, mlýnek, kamna, hrnec a sila. Na něj navazují &bBakery&r (dorty), &bCandlelight&r (večeře), &bMeadow&r (sýry), &bVinery&r (víno), &bBrewery&r (pivo), &bHerbalBrews&r (čaj) a &bBeachparty&r (pláž)."
		"&aTip:&r Když se na stroj z těchto modů podíváš, ukáže se nápověda, co máš udělat (třeba „Right-Click: Stir“ = pravým tlačítkem míchej). Přesné recepty vždy najdeš v JEI."
	]
	quest.357EC8D220BAB085.quest_subtitle: "Začátečník"
	quest.357EC8D220BAB085.title: "Vítej na farmě"
	quest.3588D3848B7F52F3.quest_desc: [
		"Tato kapitola ukazuje doplňky &bCreate&r pro velkou továrnu."
		""
		"Najdeš tu očarování s tekutými zkušenostmi, nekonečnou těžbu rud, načítání chunků, nové převodovky, práci s kapalinami a pár užitečných drobností."
		""
		"Každý mod začíná questem v kapitole &eCreate: doplňky&r. Pak pokračuješ tady od začátečníka až po experta."
		""
		"Šestiúhelníky jsou milníky. Jejich podnázev říká, na jakou úroveň se jimi dostaneš."
	]
	quest.3588D3848B7F52F3.quest_subtitle: "Doplňky pro velkou továrnu"
	quest.3588D3848B7F52F3.title: "Průmysl"
	quest.358EE95E5EF85F32.quest_desc: [
		"&eOhňohořák&r (&eBlaze Burner&r) je zdroj tepla. Nejdřív vyrob &eprázdný ohňohořák&r (&eEmpty Blaze Burner&r): 4 železné pláty a netherrack."
		"V Netheru klikni prázdným hořákem na ohniváka (Blaze) a chytíš ho dovnitř. Jde to i přímo u spawneru ohniváků."
		"Krm ho palivem (uhlí, dřevo), pak je &eohřátý&r. Ohňodort ho udělá &epřehřátý&r. Krmení zvládne pokladač nebo mechanická paže."
	]
	quest.358EE95E5EF85F32.title: "Ohňohořák"
	quest.35A3763D6EA7B449.quest_desc: [
		"Boty kukačky (&eRoadrunner Boots&r) tě zrychlí, když jdeš po písku."
		"Vyrob je ze 4 pírek kukačky, &eKožených bot&r a 2 bloků &eOpracovaného pískovce&r."
	]
	quest.35A3763D6EA7B449.title: "Běžecké boty"
	quest.35A82C1F89E8B260.quest_desc: [
		"&bMacaw's Fences and Walls&r: laťkové ploty, palisády, živé ploty, brány a zdi."
		"Laťkový plot (&eOak Picket Fence&r) je z kmenů, prken a tyčky, živý plot (&eOak Hedge&r) ze 4 bloků listí."
		"Některé ploty jdou stavět do výšky. &cDrátěný plot (&eWired Fence&c) zraňuje.&r"
	]
	quest.35A82C1F89E8B260.title: "Ploty a živé ploty"
	quest.35C85C4E476C056F.quest_desc: [
		"Každý druh ryby dá jiný počet filetů (&eRaw Fish Fillet&r). Upečené filety dobře zasytí."
		"Ryby z Aquaculture mají i váhu. Opravdu velký úlovek si můžeš vystavit na stěnu (&eOak Fish Mount&r)."
	]
	quest.35C85C4E476C056F.title: "Rybí filety"
	quest.35D7F1430209F1F8.quest_desc: [
		"Meteority jsou začátek AE2. Najdeš je podle velkého kráteru v krajině, nebo pomocí meteoritového kompasu (&eMeteorite Compass&r)."
		"Kompas vyrobíš v nabíječce (&eCharger&r). Nabíječku vyrobíš ze železa a mědi. Polož ji, vlož do ní obyčejný kompas a dodej energii."
		"Bez jiného zdroje energie použij kliku (&eWooden Crank&r): polož ji na nabíječku shora nebo zespodu a klikej na ni pravým tlačítkem."
	]
	quest.35D7F1430209F1F8.title: "Meteoritový kompas"
	quest.35E7FB9BFAB4A8C0.quest_desc: [
		"&eMechanická míchačka&r (&eMechanical Mixer&r) míchá suroviny v &etyglíku&r (&eBasin&r) pod sebou. Do tyglíku dej suroviny a míchačku roztoč."
		"Zvládne všechny recepty bez pevného tvaru a speciální recepty Create: slitiny, těsto, čokoládu. Některé potřebují teplo z ohňohořáku."
		"Výrobek vypadne bokem do desky nebo truhly pod tyglíkem. &aTip:&r Lis nad tyglíkem místo míchačky věci slisuje, např. 9 nugetů na ingot."
	]
	quest.35E7FB9BFAB4A8C0.title: "Míchačka a tyglík"
	quest.35F80454C09F4A61.quest_desc: [
		"Vyrob všech 7 druhů sýra: obyčejný, ovčí, kozí, buvolí, obilný, ametystový a warpový."
		"Odměnou je prapor (&eCompletionist Banner: Meadow&r). Postavený zrychluje těžení hráčům v okolí."
	]
	quest.35F80454C09F4A61.quest_subtitle: "Expert"
	quest.35F80454C09F4A61.title: "Znalec sýrů"
	quest.362EE3BF2863C0EF.quest_desc: [
		"&bBits 'n' Bobs&r přidává světla, která můžeš ovládat redstonem."
		""
		"Žárovka (&eLightbulb&r) se vyrobí z redstonu, světlitého prachu a skla. Jeden recept dá 3 žárovky."
		""
		"Žárovka svítí, když dostane redstonový signál. Pravým tlačítkem prázdnou rukou ji přepneš, aby svítila pořád. Montážním klíčem jí přidáš nebo sundáš klec."
		"{@pagebreak}"
		"Z jedné žárovky vyrobíš dva světlomety (&eHeadlamp&r). Dají se obarvit barvivem a do jednoho bloku jich položíš víc."
		""
		"&aTip: Světlomety se hodí na vlaky a na ozdobné cedule.&r"
	]
	quest.362EE3BF2863C0EF.title: "Žárovky a světlomety"
	quest.36354498EC737013.quest_desc: [
		"Dávkovač naleje na karamelovou tabulku čokoládu – vznikne čokoládový bonbon (&eChocolate Candy&r)."
		"Stejně poleješ čokoládou marshmallow nebo bobule. Vyzkoušej i hořkou, bílou a rubínovou čokoládu."
	]
	quest.36354498EC737013.title: "Bonbony"
	quest.3646048B16BCED73.quest_desc: [
		"&eMinoshroom&r je houbový minotaur v nejhlubší části labyrintu. Útočí obří sekerou."
		"Upustí stroganov (&eMeef Stroganoff&r), trofej a diamantovou minotauří sekeru."
	]
	quest.3646048B16BCED73.title: "Minoshroom"
	quest.364C776C66B0B097.quest_desc: [
		"Teleportér (&eEntity Teleporter&r) z &bCreate: Teleporters&r přenese hráče a moby na uložené místo. Cílový teleportér nepotřebuješ."
		""
		"Vyrobíš ho z mosazných pouzder, redstonových perel, elektronek a kvantového mechanismu. Na kameníku z něj uděláš i nižší verzi."
		""
		"&aJak vyrobit mechanismus a jak teleportér nastavit, najdeš v kapitole Pohyb a výbava.&r"
	]
	quest.364C776C66B0B097.quest_subtitle: "Teleport pro hráče a moby"
	quest.364C776C66B0B097.title: "Teleportér"
	quest.364D5A55055E6CC0.quest_desc: [
		"Kompresor (&eCompressor&r) lisuje ingoty na pláty. Teď v něm z oceli vylisuj ocelové pláty (&eSteel Plate&r)."
		"Skoro všechno dál je z ocelových plátů. &aUmí je i mechanický lis z Create.&r"
	]
	quest.364D5A55055E6CC0.title: "Ocelové pláty"
	quest.367BAA9CAEEA5812.quest_desc: [
		"&bCreate: Enchantment Industry&r mění zkušenosti na kapalinu. Tu můžeš čerpat, skladovat a očarovávat s ní."
		""
		"Nejdřív potřebuješ blok zkušeností (&eBlock of Experience&r) z 9 nugetů zkušeností. Nugety občas padají, když drtícími koly drtíš rudy."
		""
		"Klikni blokem zkušeností na položený kapalinový poklop a vznikne poklop zkušeností (&eExperience Hatch&r). Mechanickou brusku (&eMechanical Grindstone&r) vyrobíš z andezitové slitiny a hřídele."
		"{@pagebreak}"
		"Klikni bruskou na cedník (&eItem Drain&r) a vznikne brusný odtok. Na něj polož druhou brusku a roztoč ji."
		""
		"Bruska rozemele nugety zkušeností na tekuté zkušenosti. Umí taky sundat očarování z předmětu."
		""
		"Víc najdeš v kapitole Průmysl."
	]
	quest.367BAA9CAEEA5812.title: "Tekuté zkušenosti"
	quest.36808E4B80C67FD6.quest_desc: [
		"Nejlepší chunk loader (&eUltimate Chunk Loader&r) drží oblast 7 × 7 chunků."
		"Pokročilý chunk loader obklop diamanty, ender očima a redstonem."
		"&cZapínej jen chunky, které opravdu potřebuješ.&r Server ti poděkuje."
	]
	quest.36808E4B80C67FD6.quest_subtitle: "Expert"
	quest.36808E4B80C67FD6.title: "Chunk loader 7 × 7"
	quest.36A987BEA521B72A.quest_desc: [
		"Zlatolisté bobule (&eGoldenleaf Berries&r) rostou na zlatých šlahounech (&eGolden Vines&r), které vyrůstají z rychlopísku (&eQuicksoil&r)."
		"Zmražené v mrazáku (&eFrozen Goldenleaf Berries&r) jsou surovina do kombinátoru."
	]
	quest.36A987BEA521B72A.title: "Zlatolisté bobule"
	quest.36B9D96272538198.quest_desc: [
		"Teď už odlití nestačí – ocelová hlaveň a komora se skládají z vrstev. Každou vrstvu odlij z oceli a vyvrtej."
		""
		"Ocelová hlaveň je 1 vrstva (velmi malá). Ocelová komora má 3 vrstvy: velmi malou, malou a střední."
		""
		"Stavěč (&eCannon Builder&r) zasouvá vrstvy do sebe. Funguje jako píst s prodlužovacími ojnicemi. Redstonovým pulzem přepneš, jestli vrstvu drží."
		"{@pagebreak}"
		"Složené vrstvy zahřej: větrák (&eEncased Fan&r) fouká přes lávu na vrstvy. Za chvíli se změní v hotový díl děla."
		""
		"Ocel potřebuje jen 1 nálož na 2 kusy hlavně. Se šroubovým závěrem vydrží 8 náloží."
		""
		"JEI v kategorii &eCannon Building&r ukáže vrstvy i pro silnější díly."
	]
	quest.36B9D96272538198.quest_subtitle: "Expert"
	quest.36B9D96272538198.title: "Ocelové dělo"
	quest.36C5E8EE512AD835.quest_desc: [
		"Hornický strom (&eMiner's Tree&r) má hornické jádro (&eMinewood Core&r)."
		"Jádro jako magnet přitahuje rudy z okolí k sobě. Rudy pak snadno vytěžíš u kmene."
	]
	quest.36C5E8EE512AD835.title: "Hornický strom"
	quest.36FE3B9C3FF8FED3.quest_desc: [
		"Pšenice semletá v mlýnku dá mouku (&eFlour&r) – z jedné pšenice jsou 4 mouky."
		"Mouka je základ těsta, dortů i pekařského stolu z modu Bakery."
	]
	quest.36FE3B9C3FF8FED3.title: "Mouka"
	quest.370357136636F139.quest_desc: ["Ingot &eNetherite-Diamond Ingot&r je nejlepší stupeň. Vyrobíš ho z ingotu &eNetherite-Emerald Ingot&r a 4 diamantů."]
	quest.370357136636F139.quest_subtitle: "Expert"
	quest.370357136636F139.title: "Netherit-diamant"
	quest.371AE69B18B23F12.quest_desc: [
		"Vlaková stanice (&eTrain Station&r) je zastávka a zároveň místo, kde se vlak staví a rozebírá."
		"Výroba: vlakové pouzdro a kompas dají 2 stanice."
		"Pokládání: se stanicí v ruce klikni na kolej (tím ji vybereš) a pak stanici polož kousek vedle koleje."
		"&cKe stanici umí vlak přijet jen ze směru, který stanice ukazuje.&r"
	]
	quest.371AE69B18B23F12.title: "Vlaková stanice"
	quest.371F7346F3C86401.quest_desc: [
		"Deep Aether přidává biomy jako zlaté výšiny (&eGolden Heights&r), zářící lesy (&eAerglow Forest&r) nebo jedovatou bažinu (&eYagroot Swamp&r)."
		"Najdi zlaté výšiny – ostrovy se zlatou trávou a zlatými květinami."
	]
	quest.371F7346F3C86401.quest_subtitle: "Začátečník"
	quest.371F7346F3C86401.title: "Nové biomy"
	quest.3722988AC8CF4FD4.quest_desc: [
		"Počítadlo (&eAbacus&r) změří vzdálenost mezi dvěma bloky (až 48 bloků)."
		"Klikni s ním na první blok a pak se podívej na druhý."
	]
	quest.3722988AC8CF4FD4.title: "Počítadlo"
	quest.37586B9072C4F62C.quest_desc: [
		"Pracovní stůl vyrobíš ze 4 prken. Polož ho a klikni na něj – dostaneš větší mřížku 3 × 3 na složitější recepty."
		"Když jeden recept dává víc různých výsledků, mod &bPolymorph&r ukáže tlačítko, kterým si vybereš ten správný."
	]
	quest.37586B9072C4F62C.title: "Pracovní stůl"
	quest.3761F987E519B948.quest_desc: [
		"Pod vysočinou jsou trollí jeskyně (&eTroll Cave&r). Najdi trolla a zabij ho."
		"Z trollů padají kouzelné fazole (&eMagic Beans&r)."
	]
	quest.3761F987E519B948.title: "Trollí jeskyně"
	quest.3774E97440BA7A66.quest_desc: [
		"Konfigurační karta (&eConfiguration Card&r) přenese nastavení stran z jednoho stroje na druhý."
		"Shift + pravým tlačítkem na stroj nastavení zkopíruješ, pravým tlačítkem na jiný stroj ho vložíš."
		"&aTip:&r Hodí se, když stavíš řadu stejných strojů."
	]
	quest.3774E97440BA7A66.title: "Konfigurační karta"
	quest.37834C3C9F52793A.quest_desc: [
		"Měděný batoh (&eCopper Backpack&r) má víc místa než obyčejný."
		"Dej obyčejný batoh doprostřed pracovního stolu a kolem něj 8 měděných ingotů."
	]
	quest.37834C3C9F52793A.title: "Měděný batoh"
	quest.37B0C8E79CDA85B3.quest_desc: [
		"Andezitová bedna (&eAndesite Box&r) je velké úložiště. Pojme 1000 předmětů."
		""
		"Vyrobíš ji ze 6 andezitových pouzder, 2 trezorů (&eItem Vault&r) a truhly. Recept dá 2 bedny."
		""
		"&aTip:&r Mosazná bedna (&eBrass Box&r) pojme 3000 předmětů a spolupracuje s násypkami. Měděná bedna (&eCopper Box&r) je nádrž na 1500 mB kapaliny."
	]
	quest.37B0C8E79CDA85B3.title: "Andezitová bedna"
	quest.37BE1970E7DE09C2.quest_desc: [
		"Hamburger (&eHamburger&r) slož na pracovním stole ze dvou housek (&eBun&r), pečeného masa (karbanátek nebo steak), cibule, zelí a rajčete."
		"Housku upečeš v peci z těsta se solí (&eSalt Dough&r). To slož na pracovním stole ze 3 pšenic, soli a kbelíku vody."
		"Sůl (&eSalt&r) uvaříš v hrnci z kbelíku vody."
	]
	quest.37BE1970E7DE09C2.title: "Hamburger"
	quest.37C9342C423630BE.quest_desc: [
		"Upgrade stohu (&eStack Upgrade&r) zvětší sloty batohu. Do jednoho slotu se vejde víc věcí."
		"Startovní stupeň (&eStack Upgrade Starter Tier&r) dá 1,5× víc. Vyrobíš ho z 8 měděných bloků a základu upgradu."
	]
	quest.37C9342C423630BE.title: "Víc věcí do slotu"
	quest.37D0A33209655485.quest_desc: [
		"Karty se vkládají do sběrnic a dalších zařízení. Zrychlovací karta (&eAcceleration Card&r) zrychlí přesun, kapacitní karta (&eCapacity Card&r) přidá sloty filtru."
		"Výrobní karta (&eCrafting Card&r) dovolí exportní sběrnici chybějící věc nechat vyrobit."
		"&aTip:&r Které karty zařízení přijme, ukáže jeho okno a průvodce AE2 (klávesa G)."
	]
	quest.37D0A33209655485.title: "Karty vylepšení"
	quest.37F54E989E00FA25.quest_desc: [
		"Kostěný lovec (&eBone Stalker&r) žije v &eTemném hvozdu&r."
		"&cUmí se zneviditelnit a oslepit tě.&r Může z něj padnout &eBone Rattle&r: když zemřeš, přivolá ti spojence."
	]
	quest.37F54E989E00FA25.title: "Kostěný lovec"
	quest.380CEDA0DCA34A90.quest_desc: [
		"Úkol: získej celou sadu netheritového brnění (všechny 4 kusy)."
		"Na kovářském stole dej šablonu netheritového vylepšení, diamantový kus brnění a netheritový ingot. Očarování zůstanou."
		"Šablonu najdeš v truhlách bastionů v Netheru. Nevyhazuj ji – z ní, 7 diamantů a 1 netherracku (&eNetherrack&r) vyrobíš 2 šablony."
		"Netheritové věci neshoří v lávě."
	]
	quest.380CEDA0DCA34A90.quest_subtitle: "Expert"
	quest.380CEDA0DCA34A90.title: "Netheritové brnění"
	quest.3811E32C4D5AED8C.quest_desc: [
		"&bApplied Energistics 2&r (AE2) ukládá věci jako data do paměťových buněk. Všechno pak najdeš na jedné obrazovce a stroje ti mohou věci samy vyrábět."
		"Postup: meteorit → certus a fluix → lisy a procesory → první síť → kanály → automatická výroba. Některé kroky jsou v kapitole &bÚložiště&r (mají v názvu „AE2:“)."
		"&aTip:&r AE2 má v sobě výborného průvodce: v inventáři najeď na předmět z AE2 a podrž klávesu G."
	]
	quest.3811E32C4D5AED8C.quest_subtitle: "Začátečník"
	quest.3811E32C4D5AED8C.title: "Co je AE2"
	quest.382B09DF448058D5.quest_desc: [
		"Obyčejné větrné plachty (&eWindmill Sail&r) na letícím stroji fungují jako křídla. Čím rychleji letíš, tím víc nadnášejí. Tak postavíš letadlo."
		"Souměrná plachta (&eSymmetric Sail&r) nenadnáší, jen brzdí vzduch. Natočená šikmo ke směru letu poslouží jako kormidlo nebo stabilizátor."
		"Výroba: 2 plachty z Create dají 2 souměrné plachty. K blokům se přichytí samy, bez lepidla."
	]
	quest.382B09DF448058D5.title: "Křídla a kormidla"
	quest.3843955DA8354ACC.quest_desc: [
		"Vylepšený podvozek (&eImproved Landing Gear&r): rychlost rozjezdu +75 %. Dvouplošník se rychleji odlepí od země."
		"Výroba: železné ingoty a uhlí."
	]
	quest.3843955DA8354ACC.title: "Vylepšený podvozek"
	quest.386BB6AD5D919FBE.quest_desc: ["Stinná zahrádka (&eShaded Garden&r) roste v lesích. Dává třeba česnek, pórek, ředkvičky nebo lanýže."]
	quest.386BB6AD5D919FBE.title: "Stinná zahrádka"
	quest.38744765149F1869.quest_desc: [
		"Do truhlíku (&eOak Flower Box&r) z prken, půlbloků a hlíny zasadíš květiny."
		"Zvonek (&eService Bell&r) ze železa cinkne, když na něj klikneš. Ideální pro obchod nebo krčmu."
	]
	quest.38744765149F1869.title: "Truhlíky a zvonek"
	quest.387545CBB8718513.quest_desc: [
		"Hák (&eGrappling Hook&r) vystřelíš do bloku. Zachytí se a přitáhne tě k sobě. Hodí se na skály a hory."
		"Vyrob ho ze 4 hedvábí a železného ingotu."
	]
	quest.387545CBB8718513.title: "Hák s lanem"
	quest.3876F1AC2549FBEC.quest_desc: [
		"MineColonies přidává plodiny jako cibule (&eOnion&r), česnek (&eGarlic&r), rajče, rýže nebo kukuřice. Potřebuješ je na lepší jídla."
		"Semena získáš, když motykou rozbíjíš trávu, kapradí a keře."
		"Dej je farmáři: na poli vyber novou plodinu a on ji bude pěstovat."
		"&aTip:&r cibule, česnek a tvrdá pšenice padají v každé krajině. Jiné plodiny jen v určitém podnebí – třeba rýže ve vlhkém, zelí ve studeném."
	]
	quest.3876F1AC2549FBEC.title: "Nové plodiny"
	quest.38842F59B8DAC18F.quest_desc: [
		"Teď už nemusíš po každém výstřelu nabíjet. Autokanón střílí rychle malými náboji. Formy na jeho díly vyřežeš z kmenů na pile."
		""
		"Do malých forem stačí kliknout licím pískem, čtverec písku kolem není potřeba. Odlitou hlaveň a závěr vyvrtej."
		""
		"Do závěru pak klikni vyhazovačem (&eCast Iron Autocannon Breech Extractor&r). Ten vznikne na pile z litinového ingotu (sekvenční montáž)."
		"{@pagebreak}"
		"Autokanón postav na lafetu. Může být dlouhý nejvýš 3 bloky včetně závěru (bronzový 5, ocelový 7)."
		""
		"Střílí, dokud má signál v plošce s hořícím dělem. Silnější signál = rychlejší střelba."
	]
	quest.38842F59B8DAC18F.title: "Autokanón"
	quest.388D09DBFBF5C8CF.quest_desc: [
		"Zanitová zbroj chrání stejně jako železná. Než půjdeš do dungeonu, vyrob si celou sadu."
		"Do sady patří i zanitové rukavice (&eZanite Gloves&r). Nosí se ve slotu na doplňky."
	]
	quest.388D09DBFBF5C8CF.title: "Zanitová zbroj"
	quest.388EB04250DC5886.quest_desc: ["Zasáhni šípem letícího ptáka. Je to těžké – ptáci létají rychle a mění směr."]
	quest.388EB04250DC5886.title: "Sokolí oko"
	quest.3898F67D5EF83943.quest_desc: [
		"Těsto na dort (&eCake Dough&r) zamícháš v misce z mouky, cukru, vejce a mléka."
		"Sladké těsto (&eSweet Dough&r) má místo mléka vodu. Z něj se dělají koláčky a croissanty."
	]
	quest.3898F67D5EF83943.title: "Těsto na dort"
	quest.38A52802BB128310.quest_desc: [
		"HDPE je odolný plast. Substrát + kapalný etylen + kyslík v reakční komoře = HDPE peleta (&eHDPE Pellet&r)."
		"Komora dává etylen jako plyn. Na kapalinu ho převede rotační kondenzátor (&eRotary Condensentrator&r)."
		"3 pelety v obohacovací komoře = HDPE deska (&eHDPE Sheet&r)."
		"&aTip:&r HDPE desky potřebuješ na MekaSuit, solární neutronový aktivátor a plastové bloky."
	]
	quest.38A52802BB128310.title: "HDPE plast"
	quest.38AD3C812DC54AF2.quest_desc: [
		"&eAlpha Yeti&r je vůdce yetiů. Je silný a hází po tobě led."
		"Upustí srst alfa yetiho (&eAlpha Yeti Fur&r), ledové bomby a trofej. Se srstí v inventáři tě už nezmrazí ledovec."
	]
	quest.38AD3C812DC54AF2.title: "Alfa Yeti"
	quest.38B8441FBEFE8EB6.quest_desc: [
		"Dílna illagerů (&eIllager Workshop&r) je stavba plná strojů z Create. V jejích truhlách najdeš díly pro vlka."
		""
		"Objevuje se ve stejných biomech jako základny pillagerů. Mapu k ní ti prodá kartograf (za 10 smaragdů a kompas) nebo potulný obchodník."
		""
		"&cHlídají ji illagerští inženýři (&eIllager Engineer&c) a dozorci s bramborovým dělem (&eIllager Supervisor&c). Vezmi si dobrou zbroj.&r"
	]
	quest.38B8441FBEFE8EB6.title: "Dílna illagerů"
	quest.38C281F90BD44AA3.quest_desc: [
		"Zničené figurky dostaneš z analýzy střepů relikvie. Na archeologově stole je s úlomkem keramiky opravíš."
		"Na otevření portálu k Anu budeš potřebovat 4 figurky (jakékoli)."
	]
	quest.38C281F90BD44AA3.title: "Figurky"
	quest.38C754449DA1D832.quest_desc: [
		"&eRevenant&r je kostlivec z &bLuminous Nether&r. Žije v &eÚdolí duší&r."
		"Když ho porazíš, může z něj padnout kost duší (&eSoul Bone&r). Očarování &eKořist&r přidá víc kostí."
		""
		"&aTip:&r Z jedné kosti duší vyrobíš 6 kostních mouček. Ze 4 kostí složíš blok (&eSoul Bone Block&r)."
	]
	quest.38C754449DA1D832.title: "Kost duší"
	quest.38D1015B151B40AB.quest_desc: [
		"Teď už železný vrták nestačí. Nejtěžší žíly vyžadují netheritový vrták (&eNetherite Drill&r)."
		""
		"Nejdřív vyrob diamantový vrták (&eDiamond Drill&r) ze železného vrtáku, diamantů a diamantového bloku. Pak ho na kovářském stole vylepši netheritovým ingotem a netheritovou šablonou."
		""
		"S ním těžíš žílu tvrzených diamantů v Overworldu a žílu prastarých trosek v Netheru. Obě potřebují při vrtání lávu – přiveď ji do soupravy trubkou."
	]
	quest.38D1015B151B40AB.quest_subtitle: "Expert"
	quest.38D1015B151B40AB.title: "Netheritový vrták"
	quest.38DE1467C9121C43.quest_desc: [
		"&bExpanded Delight&r přidává odšťavňovač, sýrový sud, skořici, burské oříšky, chilli, chřest, batáty a brusinky."
		"Odšťavňovač (&eJuicer&r) ze sudu a železa dělá džusy do lahví. Skořicovníky rostou v džunglích."
		"Skořici získáš takhle: kmen skořicovníku nakrájej sekerou na prkénku na tyčinky. Tyčinku pak rozdrť na prkénku paličkou (&eCrushing Mallet&r)."
	]
	quest.38DE1467C9121C43.title: "Expanded Delight"
	quest.38DE4FC22133C212.quest_desc: [
		"Na sedátko (&eOak Seat&r) se dá posadit. Vyrobíš ho z půlbloku a plotu."
		"Shift + pravé tlačítko do vzduchu přepne, jak bude vypadat."
	]
	quest.38DE4FC22133C212.title: "Sedátko"
	quest.38E40DCADC9C6914.quest_desc: [
		"Velký kamenný chrám zarostlý džunglí od &bYUNG's Better Jungle Temples&r."
		"Uvnitř jsou pasti a truhly. V &ezvláštním štěrku&r najdeš &eštětečkem&r smaragdy."
		""
		"&cPozor:&r některé truhly jsou s nástrahou."
	]
	quest.38E40DCADC9C6914.title: "Chrám v džungli"
	quest.3915D5BC3C54352F.quest_desc: [
		"Chemický rozprašovač (&eChemical Sprayer&r) stříká kapalinu ze své nádržky."
		""
		"Vyrobíš ho v mechanickém výrobníku (&eMechanical Crafter&r) z precizního strojku, měděného bloku, potrubí, sušené chaluhy a 2 chaluhových rukojetí (&eKelp Handle&r)."
		""
		"Naplníš ho dávkovačem jakoukoli kapalinou. Nádržka pojme 200 mB."
		""
		"Podrž pravé tlačítko a rozprašovač začne stříkat."
	]
	quest.3915D5BC3C54352F.title: "Chemický rozprašovač"
	quest.392705C4BFDED016.quest_desc: [
		"Tvarovací stůl (&eDough Shaping Station&r) slož z mouky, prkna a klacku."
		"Tvaruje těsto na různé druhy těstovin a sušenek. Možnosti ukáže JEI."
	]
	quest.392705C4BFDED016.title: "Tvarovací stůl"
	quest.3934B84F459A011A.quest_desc: [
		"Šunku v medu (&eHoney Glazed Ham&r) slož z uzené šunky, lahve medu, sladkých bobulí, vařené rýže a misky."
		"Uzenou šunku získáš, když šunku vyudíš v udírně."
	]
	quest.3934B84F459A011A.title: "Šunka v medu"
	quest.3940988AD938A2FF.quest_desc: [
		"&bCreate: Wrapped&r přidává balení dárků a pár vánočních sladkostí."
		""
		"Balicí stůl (&eWrapping Station&r) vyrobíš z prken, papíru a železného ingotu."
		""
		"&aZ těsta, cukru a lahvičky medu vyrobíš na pracovním stole perník (&eGingerbread&r).&r"
	]
	quest.3940988AD938A2FF.quest_subtitle: "Create: Wrapped"
	quest.3940988AD938A2FF.title: "Balení dárků"
	quest.3957C754C1C17043.quest_desc: [
		"Uvař každé jídlo z &bCandlelight&r."
		"Odměnou je prapor (&eCompletionist Banner: Candlelight&r). Postavený dává hráčům v okolí odolnost vůči ohni."
		"&aTip:&r Kuchařský oblek (čepice, kabát, kalhoty, boty) dává šanci na porci navíc z pánve a hrnce."
	]
	quest.3957C754C1C17043.quest_subtitle: "Expert"
	quest.3957C754C1C17043.title: "Šéfkuchař"
	quest.3976A15C80404CE2.quest_desc: [
		"Nebeský kořen (&eSkyroot Log&r) je zdejší dřevo. Svatý kámen (&eHolystone&r) je zdejší kámen."
		"Z prken vyrobíš nebeské klacky (&eSkyroot Stick&r). Ty potřebuješ na všechny nástroje z Aetheru."
	]
	quest.3976A15C80404CE2.title: "Nebeské dřevo a kámen"
	quest.398876E1DCE7F037.quest_desc: [
		"&eMěděná tlaková láhev&r (&eCopper Backtank&r) se nosí na zádech a drží stlačený vzduch."
		"Nabiješ ji tak, že ji položíš na zem a roztočíš hřídelí. Čím rychlejší rotace, tím rychleji se plní."
		"Vzduch spotřebuje potápěcí helma, prodlužo rameno, bramborové dělo i jetpack. Víc v kapitole Nástroje a schémata."
	]
	quest.398876E1DCE7F037.title: "Tlaková láhev"
	quest.39AFCCAAADC32A94.quest_desc: [
		"Očarovací stůl vyrobíš z knihy, 2 diamantů a 4 obsidiánů."
		"V tomhle packu funguje očarování jinak (Quark &eMatrix Enchanting&r). Vlož předmět a lapis lazuli. Za lapis a zkušenosti vygeneruješ dílky očarování."
		"Dílky přetáhni do mřížky. Dva stejné dílky spojíš do silnějšího."
		"{@pagebreak}"
		"Knihovny kolem stolu (nejvíc 15) ti dají víc dílků a lepší očarování."
		"Barevné svíčky na knihovnách mění, jaká očarování se objevují. Každá barva patří k jinému očarování."
	]
	quest.39AFCCAAADC32A94.title: "Očarovací stůl"
	quest.39B357B4E049960F.quest_desc: [
		"Postřikovač (&eSprinkler&r) dej pod potrubí a pusť do něj tekutinu."
		"S vodou zalévá okolí, jako by pršelo. Jiné tekutiny působí jinak – třeba lektvar zasáhne tvory pod ním."
	]
	quest.39B357B4E049960F.title: "Postřikovač"
	quest.39B8F8A441598265.quest_desc: [
		"Kormidelní kolo (&eSteering Wheel&r) dává přesnou rotaci. Drž na něm pravé tlačítko a otáčej myší. Se Shiftem skáče po 45°."
		"Napoj ho hřídelí na ložisko, které otáčí směrovkou nebo vrtulí, a budeš zatáčet. &cLožisku musíš nastavit, že se nemá rozebírat.&r"
		"Plynová páka (&eThrottle Lever&r) dává plynule nastavitelný redstonový signál – klikni a táhni. Napoj ji na hořák a ovládáš výšku letu."
	]
	quest.39B8F8A441598265.title: "Kormidelní kolo a plyn"
	quest.39D5F94D2C4832BE.quest_desc: [
		"Perlu Endu a plod chorusu nakrájíš nožem na prkénku na zrníčka (&eEnder Pearl Grain&r, &eChorus Fruit Grain&r)."
		"Bublinkový čaj (&eBubble Tea&r) uvaříš v hrnci z mléka, plodu chorusu a obou druhů zrníček."
	]
	quest.39D5F94D2C4832BE.title: "Bublinkový čaj"
	quest.39FF52BAF0889EFF.quest_desc: [
		"Plněnou dýni (&eStuffed Pumpkin&r) uvaříš v hrnci. Místo misky dej do políčka pro nádobu celou dýni."
		"Dovnitř přijde rýže, cibule, hnědá houba, brambora, bobule a zelenina. Vaří se dvakrát déle než běžné jídlo."
	]
	quest.39FF52BAF0889EFF.title: "Plněná dýně"
	quest.3A0B8FAD55C1B472.quest_desc: [
		"Trofeje se věší na zeď. Pavoučí trofej (&eSpider Trophy&r) vyrobíš z prken a pavoučího oka."
		"Na vzácnější trofeje potřebuješ hlavy mobů, třeba lebku wither skeletona."
	]
	quest.3A0B8FAD55C1B472.title: "Trofej"
	quest.3A0BA8532C3E3E31.quest_desc: [
		"Chemický infuzér (&eChemical Infuser&r) spojí dva plyny v nový."
		"Nejdůležitější recept: vodík + chlor = chlorovodík (&eHydrogen Chloride&r). Ten potřebuješ na 4× zpracování rud."
		"&aTip:&r Chlor vyrobí elektrolytický separátor ze solanky z odpařovací věže."
	]
	quest.3A0BA8532C3E3E31.title: "Chemický infuzér"
	quest.3A0F97042370EA0C.quest_desc: [
		"Rotace se šíří přes &ehřídele&r (&eShaft&r) rovně a přes &eozubená kolečka&r (&eCogwheel&r) do stran."
		"2 slitiny nad sebou = 8 hřídelí. Kolečko = hřídel + prkno. Velké kolečko (&eLarge Cogwheel&r) = kolečko + prkno."
		"Dvě kolečka vedle sebe se točí opačně. Malé a velké kolečko spojené našikmo mění rychlost: z velkého na malé 2× rychleji, z malého na velké 2× pomaleji."
	]
	quest.3A0F97042370EA0C.title: "Hřídele a kolečka"
	quest.3A4D264B38434C38.quest_desc: ["Raketa 4. stupně (&eTier 4 Rocket&r) je z kaloritu a doletí do jiné sluneční soustavy, k hvězdě Proxima Centauri."]
	quest.3A4D264B38434C38.title: "Raketa 4. stupně"
	quest.3A66256F6C6A294B.quest_desc: [
		"Plánek stroje (&eContraption Diagram&r) ukáže síly, které působí na tvůj stroj. Výroba: papír a fyzikální sestavovač. Klikni s ním na stroj."
		"Každý blok má jinou váhu a vlastnosti. S nasazenými brýlemi je uvidíš v popisku bloku."
		"&aTěžké bloky dávej doprostřed a dolů. Stroj se pak tolik nepřevrací.&r"
	]
	quest.3A66256F6C6A294B.title: "Plánek stroje"
	quest.3A66462861B4969E.quest_desc: [
		"&eMechanický výrobník&r (&eMechanical Crafter&r): elektronka, mosazné pouzdro a pracovní stůl dají 3 kusy."
		"Postav je vedle sebe do mřížky jako políčka pracovního stolu. Klíčem nastav šipky tak, aby všechny vedly k jednomu výstupu."
		"Každý výrobník dostane jeden předmět. Když jsou všechny plné, výroba začne. U menšího receptu ji spustíš redstone pulsem."
		"Velké recepty, třeba drtící kolo (mřížka 5×5), jdou vyrobit jen tady. V JEI mají název „Mechanická výroba“ (&eMechanical Crafting&r)."
	]
	quest.3A66462861B4969E.title: "Mechanický výrobník"
	quest.3A769E66A3EE3397.quest_desc: [
		"Klobouk (&eForgotten Hat&r) padá ze Zapomenutého (&eForgotten&r). Ten žije hluboko pod zemí."
		"&cPozor:&r má silnou výbavu a umí bojovat zblízka i na dálku."
	]
	quest.3A769E66A3EE3397.title: "Klobouk Zapomenutého"
	quest.3A76ED1082CA7966.quest_desc: [
		"Makaróny se sýrem (&eMac and Cheese&r) uvaříš v hrnci z mléka, sýra, těstovin a soli."
		"Pod dnem oceánů najdeš rudu soli (&eSalt Ore&r). Padá z ní kamenná sůl (&eSalt Rock&r), kterou rozdrtíš na prkénku paličkou na sůl."
	]
	quest.3A76ED1082CA7966.title: "Makaróny se sýrem"
	quest.3A7BC108F8B9C5B9.quest_desc: [
		"Kvasnice (&eYeast&r) se uvaří v hrnci z cukru, pšenice a kbelíku vody. Do hrnce přidej i misku."
		"Z jednoho vaření je jich 12. Budeš je potřebovat na těsto, pivo i whisky."
	]
	quest.3A7BC108F8B9C5B9.title: "Kvasnice"
	quest.3A7CFEC949172A61.quest_desc: [
		"Skleněný rámeček (&eGlass Item Frame&r) je skoro neviditelný. Uvidíš jen předmět, který do něj dáš."
		"Z 8 skleněných tabulí a rámečku vyrobíš 2 kusy."
	]
	quest.3A7CFEC949172A61.title: "Skleněný rámeček"
	quest.3AACFE7BEA518A4E.quest_desc: ["Tropická zahrádka (&eTropical Garden&r) roste v džunglích a u oceánů. Dává třeba ananas, kávu, kiwi nebo zázvor."]
	quest.3AACFE7BEA518A4E.title: "Tropická zahrádka"
	quest.3AAEB9F6BE6894AA.quest_desc: [
		"Diamanty jsou hluboko pod zemí, v tmavém kameni (deepslate). Nejvíc jich je kolem výšky Y −59."
		"Výšku ukáže výškoměr (&eAltimeter&r) ze &bSupplementaries&r nebo obrazovka F3."
		"&cPozor:&r v hloubce je hodně lávy. Měj u sebe kbelík vody."
	]
	quest.3AAEB9F6BE6894AA.quest_subtitle: "Expert"
	quest.3AAEB9F6BE6894AA.title: "Diamanty!"
	quest.3AC74DFF7F405AB6.quest_desc: [
		"Boss je duch slunce (&eSun Spirit&r). Střílí ohnivé a ledové krystaly a vyvolává ohnivé pomocníky."
		"Udeř do ledového krystalu – odletí směrem, kam se díváš. Když ducha zasáhne, zmrazí ho. Útoč na něj, dokud je zmrazený."
		"&cVezmi si lektvary ohnivzdornosti!&r Po smrti dá zlatý klíč (&eGold Key&r) a sluneční oltář, kterým ovládáš denní dobu."
	]
	quest.3AC74DFF7F405AB6.title: "Duch slunce"
	quest.3AD43811C8DC0EF1.quest_desc: [
		"Andezitová výhybka (&eAndesite Track Switch&r) určuje, kam vlak na rozdvojení pojede."
		"Pokládá se jako stanice: klikni na kolej u rozdvojení a polož výhybku vedle. Kliknutím ji přepneš doprava, se Shiftem doleva."
		"Směr nastavíš i redstonem. Signálem do spodní části výhybku zamkneš. Komparátor z ní přečte směr: 0 rovně, 1 vlevo, 2 vpravo."
		"&aVlaky s jízdním řádem si cestu přes rozdvojení najdou samy. Výhybka se hodí tam, kde chceš směr určit ty.&r"
	]
	quest.3AD43811C8DC0EF1.title: "Výhybka"
	quest.3AD53B47A7D7ABD4.quest_desc: [
		"Zapalovač (&eLighter&r) je křesadlo na palivo. Naplň ho dávkovačem jakýmkoli palivem z této kapitoly."
		""
		"Pravým tlačítkem ho otevřeš nebo zavřeš a zkusíš zapálit oheň. Shift + pravé tlačítko ho jen otevře nebo zavře."
		""
		"&aTip: Přejmenuj ho na kovadlině. Některá jména mu změní vzhled.&r"
	]
	quest.3AD53B47A7D7ABD4.title: "Zapalovač"
	quest.3AE790A25E7A6C23.quest_desc: [
		"Hustá polévka (&ePottage&r) je jedno ze speciálních jídel MineColonies. Můžeš si ji vyrobit i sám na pracovním stole."
		"Recept: tvrdá pšenice (&eDurum Wheat&r), cibule, česnek, miska, brambora a mrkev."
		"Když na jídlo najedeš myší, popisek ukáže jeho úroveň a kdo ho umí uvařit."
	]
	quest.3AE790A25E7A6C23.title: "Hustá polévka"
	quest.3B04A98055576736.quest_desc: [
		"Z biofosilie dostaneš většinou kostní moučku nebo písek. DNA jen asi jednou ze sedmi pokusů."
		"Druh je náhodný. Z biofosilií jsou hlavně dinosauři, z břidlicových fosilií prvohorní tvorové, ze zmrzlého masa hlavně savci a ptáci doby ledové."
		"&aAnalyzuj hodně fosilií, ať máš z čeho vybírat.&r"
	]
	quest.3B04A98055576736.title: "DNA"
	quest.3B26BD3D8B5B5C9A.quest_desc: [
		"Doteď musela ozubená kola stát těsně u sebe. Řetěz přenese rotaci i mezi koly, která jsou od sebe daleko."
		""
		"Ozubené kolo s přírubou (&eFlanged Cogwheel&r) vyrobíš z ozubeného kolečka a železného nugetu. Velké (&eLarge Flanged Cogwheel&r) z velkého ozubeného kolečka a nugetu."
		"{@pagebreak}"
		"Vezmi do ruky řetězy a klikej postupně na kola, která chceš spojit. Řetěz jde i přes obyčejná ozubená kola. Musí vytvořit uzavřenou smyčku a kola se nesmí dotýkat."
		""
		"Pohon spotřebuje řetězy podle délky. Převod zůstane stejný jako u kol, která se dotýkají: malé kolo se točí 2× rychleji než velké."
		"{@pagebreak}"
		"Místo řetězu můžeš použít i mechanický pás (&eMechanical Belt&r) nebo lano. Ty jdou natáhnout jen přes kola s přírubou."
		""
		"&aTip: Mezi dvěma velkými koly může řetěz změnit směr. Kola musí mít společnou tečnu, po které řetěz povede. Podívej se do ponderu.&r"
	]
	quest.3B26BD3D8B5B5C9A.quest_subtitle: "Pokročilý"
	quest.3B26BD3D8B5B5C9A.title: "Řetězový pohon"
	quest.3B2F7744E896132B.quest_desc: [
		"&bFarmer's Respite&r přidává čaj, kávu a konvici. Divoké čajovníky (&eWild Tea Bush&r) rostou v bažinách a džunglích."
		"Zasaď semínka čaje (&eTea Seeds&r). Mladý keř dává zelené lístky, starší žluté a nejstarší černé."
	]
	quest.3B2F7744E896132B.title: "Čajovník"
	quest.3B575F13BC6FC77B.quest_desc: [
		"Teď už nejedeš jen po rovině, ale i nahoru. Eskalátor postavíš stejně jako chodník, jen hřídele jsou v různé výšce."
		""
		"Vodorovná vzdálenost hřídelí musí být o 3 bloky větší než výšková. Příklad: 4 bloky nahoru znamená 7 bloků dopředu."
		""
		"Zábradlí přidáš pravým kliknutím mechanickým pásem (&eMechanical Belt&r) na chodník nebo eskalátor. Nad ním musí být volné místo. Quest se splní, až zábradlí přidáš."
		""
		"&aSchody i zábradlí obarvíš barvivem a vodou barvu smyješ. Kliknutím blokem skla uděláš skleněné zábradlí.&r"
	]
	quest.3B575F13BC6FC77B.quest_subtitle: "Pokročilý"
	quest.3B575F13BC6FC77B.title: "Eskalátor se zábradlím"
	quest.3B5993BF64467C8A.quest_desc: [
		"Lisy (&eInscriber Silicon Press&r, &eInscriber Logic Press&r, &eInscriber Calculation Press&r, &eInscriber Engineering Press&r) jsou potřeba na výrobu procesorů."
		"Když lis ztratíš, nic se neděje: razítkovač umí každý lis zkopírovat z bloku železa."
		"&aTip:&r Lisy si přesto dobře schovej, třeba hned do truhly u razítkovače."
	]
	quest.3B5993BF64467C8A.title: "Lisy"
	quest.3B7A6ED0159FE495.quest_desc: [
		"&eBalíkovač&r (&ePackager&r) zabalí obsah truhly do &ebalíčku&r. Přilož ho k truhle a dej mu redstone signál."
		"Balíček je obyčejný předmět, vozí se pásem, šachtou nebo katapultem. Balíček vložený do balíkovače se rozbalí do jeho truhly."
		"Teď už nevozíš jednotlivé věci, ale celé zásilky. &cBalíkovač nepřijme balíček, který se do truhly celý nevejde.&r"
	]
	quest.3B7A6ED0159FE495.quest_subtitle: "Pokročilý"
	quest.3B7A6ED0159FE495.title: "Balíkovač"
	quest.3B8047DA733742CB.quest_desc: [
		"Měděný obvod (&eCopper Circuit&r) potřebuješ na rozšíření motorů."
		""
		"Nejdřív vylisuj prázdné obvody (&eBlank Circuit&r): mechanický lis nad tyglíkem slisuje kámen, redstone, železný ingot a křemen na 4 obvody. Ohňohořák pod tyglíkem musí být rozpálený doběla."
		""
		"Pak pokladačem (&eDeployer&r) přidej na prázdný obvod měděný drát z New Age."
	]
	quest.3B8047DA733742CB.title: "Obvody"
	quest.3B8A5E7E3A66B7C8.quest_desc: [
		"Divoké moa občas snesou vejce na zem. Vejce najdeš i v truhlách stříbrného dungeonu."
		"Modrá moa (&eBlue Moa Egg&r) je nejběžnější a ve vzduchu skočí 3×. Bílá skočí 4×, černá dokonce 8×."
		"Mládě krm okvětními lístky (&eAechor Petal&r) z nepřátelské rostliny &eAechor Plant&r. Moa, kterou vychováš z vejce, můžeš po dospění osedlat a létat na ní."
	]
	quest.3B8A5E7E3A66B7C8.title: "Vejce moa"
	quest.3B8CEDE612DE5D82.quest_desc: ["Pečeni (&ePot Roast&r) slož na pracovním stole z hrnce, syrového hovězího, brambory a mrkve. Dobře zasytí."]
	quest.3B8CEDE612DE5D82.title: "Pečeně v hrnci"
	quest.3B9268E33ABC8B62.quest_desc: [
		"Tahle kapitola ti ukáže, jak udělat z továrny hezké místo. Je tu pět modů."
		""
		"&bCreate: Copycats+&r – imitace: bloky, které převezmou vzhled jiného bloku."
		"&bCreate: Bits 'n' Bobs&r – žárovky, nixie displeje, řetězové pohony a barevné potrubí."
		"&bCreate Deco&r – kovové lávky, lampy, dveře, kontejnery a barevné cihly."
		"{@pagebreak}"
		"&bCreate: Interiors&r – židle, křesla a polštáře."
		"&bRechiseled: Create&r – dláto, které z kamenů a oken Create udělá nové vzory."
		""
		"Cesta kapitolou: &aZačátečník&r (první dekorace z jednoduchých surovin), &aPokročilý&r (víc materiálů v jednom bloku, řetězy, kontejnery) a &aExpert&r (skryté stroje a živé nápisy)."
		""
		"&aTip: Ke strojům Create i k věcem z těchto modů je často animovaný návod. Najeď myší na předmět a podrž W.&r"
	]
	quest.3B9268E33ABC8B62.quest_subtitle: "Začátečník"
	quest.3B9268E33ABC8B62.title: "Krásná továrna"
	quest.3B9455255FD285FE.quest_desc: [
		"Rytířští fantomové občas upustí fantomovu helmu nebo brnění (&ePhantom Helmet&r)."
		"&aFantomova zbroj ti po smrti zůstane – nikdy o ni nepřijdeš.&r"
	]
	quest.3B9455255FD285FE.title: "Fantomova zbroj"
	quest.3BB950357C9221AE.quest_desc: [
		"Nakrm ochočeného křečka krmnou směsí (&eHamster Food Mix&r). Odemkneš mu tím lícní torbu."
		"Shift + pravé tlačítko na křečka otevře torbu se 6 místy. Křeček ti v ní nosí věci."
	]
	quest.3BB950357C9221AE.title: "Lícní torba"
	quest.3BCE54A6BB994F49.quest_desc: [
		"Postav nádrž aspoň ze 4 bloků (např. 2×2), na její bok parní motor s hřídelí, pod ni ohňohořák a přiveď vodu."
		"Ohňohořák s palivem dá kotli 1 úroveň tepla. Bez paliva hřeje jen &epasivně&r, stejně jako magmatický blok, láva nebo oheň pod nádrží."
		"Pasivní kotel dá jen osminu výkonu jednoho motoru (2 048 SU). Pro plný výkon hořáky krm."
	]
	quest.3BCE54A6BB994F49.title: "Kotel běží"
	quest.3BD2805774A2987A.quest_desc: [
		"Řemeslník (pila, kameník, kovář…) vyrábí věci pro ostatní občany. Teď už nemusíš vyrábět každý schod sám."
		"Pozor: řemeslník nic nevyrábí do zásoby. Pracuje, jen když jiný dělník (třeba stavitel) o věc požádá."
		"Recepty mu musíš naučit: v jeho budově otevři „Naučit recept“ (&eTeach Recipe&r) a poskládej recept jako na pracovním stole."
		"{@pagebreak}"
		"&cBez skladiště a kurýra řemeslníci nefungují – kurýr jim nosí suroviny.&r"
		"&aTip:&r šikovný řemeslník občas recept vylepší a spotřebuje méně surovin."
	]
	quest.3BD2805774A2987A.title: "Jak pracují řemeslníci"
	quest.3BD86699630ED67D.quest_desc: [
		"&bEtched&r: vypal si vlastní písničku na hudební desku a pusť ji všem na serveru."
		"Rycí stůl (&eEtching Table&r) vyrobíš z diamantu, železného ingotu a prken."
		"Potřebuješ prázdnou desku (&eBlank Music Disc&r – přetav libovolnou hudební desku) a štítek (&eMusic Label&r) z papíru. Do stolu vložíš odkaz na skladbu."
	]
	quest.3BD86699630ED67D.title: "Vlastní hudba"
	quest.3BF7435C0A468EC0.quest_desc: [
		"Brnění z rafinovaného obsidiánu (&eRefined Obsidian Chestplate&r) je nejsilnější brnění z &bMekanism Tools&r."
		"Vyrobíš ho stejně jako železné brnění, jen z ingotů rafinovaného obsidiánu."
		"&aTip:&r Celou sadu doplní helma, kalhoty a boty ze stejného materiálu."
	]
	quest.3BF7435C0A468EC0.title: "Obsidiánové brnění"
	quest.3C0327F9D8F645A5.quest_desc: [
		"Nejvyšší úroveň imitací: díly strojů, které vypadají jako obyčejné bloky. Ozubená kola a hřídele pak schováš přímo do zdi."
		""
		"Imitační ozubené kolečko (&eCopycat Cogwheel&r) vyrobíš ze 4 ozubených koleček a zinkového ingotu. Dostaneš 4 kusy."
		""
		"Točí se a přenáší rotaci úplně stejně jako normální ozubené kolečko. Jen má vzhled bloku, který do něj dáš."
		"{@pagebreak}"
		"Stejně funguje velké kolečko (&eCopycat Large Cogwheel&r), hřídel (&eCopycat Shaft&r) a potrubí (&eCopycat Fluid Pipe&r)."
		""
		"&aTip: Když postavíš celý pohon z imitací, bude továrna vypadat jako obyčejný dům. Brýlemi i tak uvidíš jejich rychlost a napětí.&r"
	]
	quest.3C0327F9D8F645A5.quest_subtitle: "Expert"
	quest.3C0327F9D8F645A5.title: "Skryté stroje"
	quest.3C08011DC4EE25A2.quest_desc: [
		"Stavitel nic nevyrábí z ničeho. Materiál mu musíš donést ty."
		"Na kartě „Požaduje suroviny“ (&eRequired Resources&r) v jeho budově vidíš, co ještě chybí. Věci vlož přímo tam, nebo do inventáře budovy (Shift + pravé tlačítko na blok)."
		"Když stavitel chce nástroj nebo jídlo, klikni na něj pravým tlačítkem, otevři požadavky a dej mu věc tlačítkem „Doplnit“ (&eFulfill&r)."
		"{@pagebreak}"
		"&cChyba začátečníka:&r stavitel s budovou úrovně 0 smí používat jen dřevěné a zlaté nástroje. Kamenné umí až s úrovní 1, železné s úrovní 2, diamantové s úrovní 3."
		"&aTip:&r V seznamu surovin se občas objeví i vzduch nebo pěšina. Ty neřeš. Sleduj hlavně požadavky samotného stavitele."
	]
	quest.3C08011DC4EE25A2.title: "Dodej materiál"
	quest.3C1C8FC6DE2BB59E.quest_desc: [
		"Rozprašovač se zapalovačem (&eChemical Sprayer With Lighter&r) se pokusí stříkanou kapalinu zapálit. Je to plamenomet."
		""
		"Vyrobíš ho pokladačem (&eDeployer&r): polož rozprašovač pod pokladač a dej mu do ruky zapalovač."
		""
		"Naplň ho hořlavým palivem, třeba benzínem."
		""
		"&cPozor, oheň zapálí i dřevěné stavby kolem tebe!&r"
	]
	quest.3C1C8FC6DE2BB59E.title: "Plamenomet"
	quest.3C317427956C4A7A.quest_desc: [
		"&eRůženín&r (&eRose Quartz&r): křemen a 8 redstonu v pracovním stole."
		"Vyleštíš ho &ešmirglpapírem&r (&eSand Paper&r = papír + písek). Růženín drž v druhé ruce a se šmirglpapírem drž pravé tlačítko."
		"Leštěný růženín je potřeba na elektronky. &aTip:&r Leštění zvládne i pokladač se šmirglpapírem."
	]
	quest.3C317427956C4A7A.title: "Leštěný růženín"
	quest.3C66A48BA7B0B046.quest_desc: [
		"Palačinky (&ePancakes&r) potřebují těstíčko, sirup a cukr. Sirup uvaříš v hrnci z jablek nebo řepy s cukrem."
		"Talíř palačinek se dá položit jako blok."
	]
	quest.3C66A48BA7B0B046.title: "Palačinky"
	quest.3C6B28CEBE6B307D.quest_desc: [
		"&cNež odletíš: do inventáře rakety dej odpalovací rampu a 3 kbelíky paliva na cestu zpět. Jinak na Měsíci uvízneš!&r"
		"Na Měsíci je −173 °C a není vzduch. Voda zamrzne a pochodně se rozbijí. Vezmi si náhradní kyslík, jídlo a jako světlo pochodně duší nebo světlit."
		"Po přistání dej Shift + pravé tlačítko na přistávací modul (&eLander&r) a vezmi si z něj raketu, palivo a rampu. Modul pak rozbij."
		"Na Měsíci najdeš rudu desh."
	]
	quest.3C6B28CEBE6B307D.title: "Měsíc"
	quest.3CAB98B098F938DF.quest_desc: [
		"Přenosné rozhraní paliva (&ePortable Fuel Interface&r) doplní palivové nádrže vlaku přímo na nástupišti."
		"Výroba: vlakové pouzdro a šachta. Staví se stejně jako přenosné úložné rozhraní: jedno na vlak, druhé na nástupiště."
	]
	quest.3CAB98B098F938DF.title: "Tankovací stanice"
	quest.3CBAB1EE3B70E4BA.quest_desc: [
		"V noci chodí monstra a občas přijdou nájezdníci. Strážní věž (&eGuard Tower&r) má jednoho strážného, který v ní i bydlí."
		"Z prken, luku a nástroje stavby vyrobíš rovnou 2 věže. Strážný je rytíř (meč) nebo lučištník (luk) a potřebuje zbraň a zbroj."
		"&aTip:&r strážní věže zvětšují území kolonie. Mimo území nové budovy nepostavíš."
	]
	quest.3CBAB1EE3B70E4BA.title: "Strážní věž"
	quest.3CC07109F07C89E3.quest_desc: [
		"Teď z dekorace uděláš užitečný sklad. Lodní kontejner (&eBlue Shipping Container&r) funguje stejně jako trezor (&eItem Vault&r) z Create, jen vypadá jako barevný kontejner."
		""
		"Vyrobíš ho z barviva, 2 železných plátů a sudu. Nebo obarvíš hotový trezor barvivem ve výrobní mřížce."
		"{@pagebreak}"
		"Kontejnery položené k sobě se spojí do jednoho velkého skladu, stejně jako trezory."
		""
		"Plní se a vybírají trychtýřem, mechanickou paží nebo jiným strojem, ne rukou."
		""
		"&aTip: Každá barva může znamenat jiný druh zboží. Ve skladu se pak hned vyznáš.&r"
	]
	quest.3CC07109F07C89E3.quest_subtitle: "Pokročilý"
	quest.3CC07109F07C89E3.title: "Lodní kontejnery"
	quest.3CC1003E9B6F8329.quest_desc: [
		"Upgrade na doplňování (&eRefill Upgrade&r) ti doplňuje vybrané věci v inventáři z batohu."
		"Nastav do filtru třeba pochodně nebo bloky na stavění. Už ti nedojdou."
	]
	quest.3CC1003E9B6F8329.title: "Doplňování"
	quest.3CC6C5AC9BF6A6A5.quest_desc: [
		"V klenotnici otevři starodávnou truhlu klíčem."
		"Uvnitř jsou starodávné hodiny (&eAncient Clock&r), poslední poklad modu. Gratulujeme!"
	]
	quest.3CC6C5AC9BF6A6A5.title: "Starodávné hodiny"
	quest.3CCF542EE34A2AA8.quest_desc: [
		"Mod &bEtched&r umí nahrát vlastní písničku na hudební desku."
		"Prázdnou desku (&eBlank Music Disc&r) získáš tak, že v peci roztavíš hudební desku (kromě desky Stal)."
		"Hudební desky najdeš v truhlách. Padají i z creepera, kterého zabije kostlivec."
	]
	quest.3CCF542EE34A2AA8.title: "Prázdná deska"
	quest.3CD80219E2F1CFD4.quest_desc: [
		"Věže a sídla mágů od &bTerralithu&r. Stojí jen v kouzelných biomech: v ametystovém pralese, levandulových a měsíčních biomech a na létajících ostrovech."
		"&cHlídají je nájezdníci, mstitelé, čarodějnice i mágové.&r V truhlách je cenný poklad."
	]
	quest.3CD80219E2F1CFD4.title: "Věž mágů"
	quest.3CE14D97441773CB.quest_desc: [
		"Trosky přetav v peci na netheritový šrot (&eNetherite Scrap&r). 4 šroty + 4 zlaté ingoty = 1 netheritový ingot."
		"Ještě silnější verze netheritu nabízí mod &bAdvanced Netherite&r. Najdeš ho v kapitole &bVýbava a boj&r."
	]
	quest.3CE14D97441773CB.title: "Netherit"
	quest.3CEE744AA57E29F5.quest_desc: [
		"Mod &bNether Exotics&r přidává brnění a nástroje z ovoce z Netheru."
		"Kyrys (&eKiwano Chestplate&r) vyrobíš z 8 slupek kiwana (&eKiwano Peel&r). Slupka ti zůstane, když kiwano sníš."
		"Kiwano brnění zmírňuje popáleniny. Kiwano nástroje vykopané věci rovnou přetaví."
	]
	quest.3CEE744AA57E29F5.title: "Kiwano brnění"
	quest.3CFD936F658EFFBC.quest_desc: [
		"Alternátor (&eAlternator&r) mění otáčení na elektřinu (⚡). Potřebuje aspoň 32 RPM. Čím rychleji se točí, tím víc elektřiny vyrobí."
		""
		"Vyrobíš ho v mechanickém výrobníku ze 4 měděných cívek, železných plátů, železné tyče a andezitové slitiny."
		""
		"&aVíc najdeš v kapitole Elektřina.&r"
	]
	quest.3CFD936F658EFFBC.quest_subtitle: "Začátečník"
	quest.3CFD936F658EFFBC.title: "Z otáčení elektřina"
	quest.3D0ACE59BA4B9DDD.quest_desc: [
		"Wreckery (&eRaw Wrecker&r) žijí u vraků lodí a zatopených zničených portálů."
		"Najdi vrak a pátrej ve vodě kolem něj."
	]
	quest.3D0ACE59BA4B9DDD.title: "Wrecker"
	quest.3D156018471C076F.quest_desc: [
		"Nech horníka vykopat šachtu až na podloží."
		"Důl úrovně 1 začne kopat chodby pod výškou 50, úrovně 2 pod výškou 30 a úrovně 3 pod výškou 5."
	]
	quest.3D156018471C076F.title: "Až na dno"
	quest.3D1C356BDD7B05DB.quest_desc: [
		"Výzkum se dělá na univerzitě. Má tři větve: &eCivilian&r (občané), &eCombat&r (boj) a &eTechnology&r (výroba)."
		"Každý výzkum stojí předměty a čas a má podmínky, třeba úroveň budovy. Výzkum dělají výzkumníci na univerzitě – bez nich se nepohne."
		"Hodně výzkumů stojí knihy, proto si připrav aspoň 3 do zásoby."
		"{@pagebreak}"
		"&cZrušený výzkum ti předměty nevrátí. Na nejvyšší úrovni (6) si v každé větvi vybereš jen jeden výzkum.&r"
	]
	quest.3D1C356BDD7B05DB.title: "Jak funguje výzkum"
	quest.3D2E3D7FA4834FFE.quest_desc: ["Mrazivá zahrádka (&eFrost Garden&r) roste v jehličnatých lesích. Dává třeba brokolici, zelí, oves nebo maliny."]
	quest.3D2E3D7FA4834FFE.title: "Mrazivá zahrádka"
	quest.3D34BA6051ED0CB1.quest_desc: [
		"Duší sklo (&eSoul Glass&r) vyrobíš z 1 skla a 4 fantomových střepů. Dostaneš 2 kusy."
		"Přes duší sklo můžeš projít, jako by tam nebylo. Hodí se na tajné dveře."
	]
	quest.3D34BA6051ED0CB1.title: "Duší sklo"
	quest.3D39D58490ECDCDF.quest_desc: [
		"Drtič (&eCrusher&r) rozdrtí ingoty na prach. Umí i dlažební kámen na štěrk, štěrk na písek a rostliny na bio palivo."
		"Prach potřebuješ do receptů (elektrolytické jádro, vylepšení) a drtič je i součástí linky na 3× zpracování rud."
		"&aTip:&r Co všechno drtič umí, zjistíš v JEI: najeď na drtič a stiskni U."
	]
	quest.3D39D58490ECDCDF.title: "Drtič"
	quest.3D51399C97F3C37F.quest_desc: [
		"Raketa 2. stupně (&eTier 2 Rocket&r) se staví stejně jako první, ale z deshe: 6 bloků deshe, deshové nádrže (&eDesh Tank&r) a deshový motor (&eDesh Engine&r)."
		"Doletí na Mars."
	]
	quest.3D51399C97F3C37F.title: "Raketa 2. stupně"
	quest.3D7FBA1AF75A0BA4.quest_desc: [
		"&bAquaculture 2&r přidává desítky ryb, lepší pruty, háčky, návnady a poklady. Každý biom (řeka, oceán, bažina, džungle…) má jiné ryby."
		"&bFish of Thieves&r přidává ryby ze hry Sea of Thieves a &bUnusual Fish&r podivné mořské tvory."
		"Začni obyčejným prutem a pak si vyrob železný."
	]
	quest.3D7FBA1AF75A0BA4.quest_subtitle: "Začátečník"
	quest.3D7FBA1AF75A0BA4.title: "Na ryby!"
	quest.3D83EF99695CF6C0.quest_desc: [
		"Teletor je nepřítel, který se vznáší a ovládá železnou zbraň nad hlavou. Útočí s ní i z dálky."
		"Po zabití z něj padá &eTelecore&r a někdy i surový neodym."
	]
	quest.3D83EF99695CF6C0.title: "Telecore"
	quest.3D8A84366753A8E9.quest_desc: [
		"&bBits 'n' Bobs&r přidává světla, displeje, řetězové pohony a dekorace pro továrny."
		""
		"Velká nixie trubice (&eLarge Nixie Tube&r) je svítící displej na znaky. Vyrobíš ji ze 4 leštěných růženínů a 2 železných plátů, dostaneš 4 kusy. Text nastavíš jmenovkou nebo psací podložkou (&eClipboard&r)."
		"{@pagebreak}"
		"Ložisko setrvačníku (&eFlywheel Bearing&r) je z mosazného pouzdra, andezitové slitiny, velkého ozubeného kolečka a dřevěného půlbloku. Když se točí, roztočí bloky přilepené před ním jako velký setrvačník."
		""
		"Pravým tlačítkem prázdnou rukou setrvačník z přilepených bloků sestavíš, dalším kliknutím ho zase rozebereš."
		""
		"Víc najdeš v kapitole Dekorace."
	]
	quest.3D8A84366753A8E9.quest_subtitle: "Create: Bits 'n' Bobs"
	quest.3D8A84366753A8E9.title: "Bits 'n' Bobs"
	quest.3DA45EB6B80015CC.quest_desc: [
		"Procesor má tři vrstvy. Nejdřív v razítkovači vyraž plošné spoje: lis nahoru, materiál doprostřed."
		"Logický lis + zlatý ingot, výpočetní lis + certusový krystal, inženýrský lis + diamant, křemíkový lis + křemík (&eSilicon&r)."
		"Křemík vyrobíš tavením certusového prachu. Prach dostaneš rozdrcením certusu v razítkovači nebo v drtiči Mekanismu."
		"&aTip:&r Hotový procesor: vytištěný obvod nahoru, redstone doprostřed, vytištěný křemík dolů."
	]
	quest.3DA45EB6B80015CC.title: "Plošné spoje"
	quest.3DCF880F9026407A.quest_desc: [
		"Základní stůl (&eBasic Crafting Table&r) je 3×3 stůl, který si pamatuje obsah, i když ho zavřeš."
		"Potřebuješ na něj součástky (&eBasic Component&r) a katalyzátor (&eBasic Catalyst&r) z černého železa a luminescence (&eLuminessence&r)."
		"&aTip:&r Další stoly: pokročilý 5×5, elitní 7×7 a ultimátní 9×9. Každý se vyrábí z předchozího."
	]
	quest.3DCF880F9026407A.title: "Velký pracovní stůl"
	quest.3DD6B055279442CD.quest_desc: [
		"Základní chunk loader (&eBasic Chunk Loader&r) udrží zapnutou oblast 3 × 3 chunky."
		"Vyrobíš ho ze železných ingotů, obsidiánu a ender perly. Z 9 malých chunk loaderů ho taky složíš zpátky."
	]
	quest.3DD6B055279442CD.title: "Chunk loader 3 × 3"
	quest.3DE2CC05B558207D.quest_desc: [
		"Nástroj stavby (&eBuild Tool&r) staví všechny budovy kolonie. Je v truhle tábora, další si vyrobíš ze 2 tyček a 1 kamení (šikmo jako hůl)."
		"Každá budova má svůj blok (&eHut Block&r). Dej ho do inventáře, klikni nástrojem pravým tlačítkem na zem a vyber budovu. Šipkami ji posuň a otoč, fajfkou potvrď."
		"&aTip:&r nástroj stavby je v receptu skoro každé budovy. Měj jich vždycky pár v zásobě."
	]
	quest.3DE2CC05B558207D.title: "Nástroj stavby"
	quest.3DE5A1656C5F3C3B.quest_desc: [
		"Hnojenou půdu (&eFertilized Soil&r) vyrobíš z 9 hnojiv. Polož ji na pole."
		"Použij na ni vidle (&ePitchfork&r). Rostliny v okolí pak porostou rychleji."
		"Když je půda plná, motykou z ní uděláš hnojenou ornici. Plodiny na ní občas povyrostou samy, jako by dostaly kostní moučku."
	]
	quest.3DE5A1656C5F3C3B.title: "Hnojená půda"
	quest.3DED586198EEB811.quest_desc: [
		"&eBalíčkový žaboport&r (&ePackage Frogport&r): slizová koule, trezor a slitina. S ním v ruce klikni na řetězový dopravník a polož ho poblíž."
		"V jeho okně nastav adresu. Balíček s cizí adresou žába pošle po řetězu, balíček se svou adresou chytí."
		"Žaboport bere z inventáře pod sebou i do něj dává, třeba z balíkovače. Tak vznikne pošta mezi budovami."
	]
	quest.3DED586198EEB811.title: "Balíčkový žaboport"
	quest.3DFEAA3F9BC7B282.quest_desc: [
		"Tryskací pistole (&eZip Gun&r) spaluje kyslík a tlačí tě dopředu. V nulové gravitaci je to nejlepší způsob pohybu."
		"&cVe vesmíru tě nic nezastaví. Neleť moc rychle, nebo se ztratíš.&r"
	]
	quest.3DFEAA3F9BC7B282.title: "Tryskací pistole"
	quest.3DFF40290DEF19EB.quest_desc: [
		"Atomový rozkladač (&eAtomic Disassembler&r) je krumpáč, sekera i lopata v jednom. Běží na energii."
		"Rychlost a režim těžby (třeba těžba celé žíly) přepneš Shift + kolečkem myši."
		"&aTip:&r Nabiješ ho ve slotu energetické kostky nebo na nabíjecí podložce (&eChargepad&r)."
	]
	quest.3DFF40290DEF19EB.title: "Atomový rozkladač"
	quest.3E13CE882E876E3A.quest_desc: [
		"&eMechanický sklízeč&r (&eMechanical Harvester&r) na pohyblivém udělátku sklízí zralé plodiny a nechá je znovu růst."
		"Dej ho na píst, ložisko nebo vozík a veď ho nad polem. Úrodu sebere truhla přilepená k udělátku."
	]
	quest.3E13CE882E876E3A.title: "Automatická sklizeň"
	quest.3E36F63D918A1B72.quest_desc: [
		"Labyrint (&eMinotaur Labyrinth&r) je bludiště z bludištního kamene pod bažinou."
		"Minotauři v něm pouštějí zaměřovač bludiště. Z něj vyrobíš mapu bludiště, rozebírací stůl a později mapu rud."
	]
	quest.3E36F63D918A1B72.title: "Labyrint"
	quest.3E5844F576D286E5.quest_desc: [
		"Do mísy dej 3 mouky a kbelík vody. Zamíchej vařečkou a dostaneš 3 těsta (&eWheat Dough&r)."
		"Z těsta jsou chleby, těstoviny a koláče."
	]
	quest.3E5844F576D286E5.title: "Těsto z mísy"
	quest.3E5C6167A3E2DE2D.quest_desc: [
		"Hovězí guláš (&eBeef Stew&r) uvaříš v hrnci ze syrového hovězího, mrkve a brambory."
		"Jídla z hrnce dávají efekt &eNourishment&r (sytost). Dokud trvá, hlad ti neubývá. Výjimka: když tě léčí nasycení."
		"&aTip:&r Lepší jídla dávají delší efekt. Délku vidíš v popisku jídla."
	]
	quest.3E5C6167A3E2DE2D.title: "První guláš"
	quest.3E5D92B7D7E5B967.quest_desc: [
		"Mod &bAppleSkin&r ukazuje, co jídlo umí. V popisku jídla vidíš, kolik doplní hladu a nasycení."
		"Když jídlo držíš v ruce, na liště hladu bliká, kolik ti ho doplní. Žlutý obrys na liště je nasycení: dokud ho máš, hlad neubývá."
		"Špíz (&eBarbecue on a Stick&r) slož z rajčete, cibule, pečeného masa a klacku. Prohlédni si jeho hodnoty."
	]
	quest.3E5D92B7D7E5B967.title: "Co ukazuje AppleSkin"
	quest.3E6F4FEEB9EAC956.quest_desc: [
		"Železné žebrování (&eIron Scantlings&r) zvýší odolnost lodi. Instaluje se v loděnici stejně jako plachty."
		"&aV loděnici loď také opravíš – zvlášť trup a zvlášť plachty.&r"
	]
	quest.3E6F4FEEB9EAC956.title: "Železné žebrování"
	quest.3E93512982141B09.quest_desc: [
		"&eŠachta&r (&eChute&r): 2 železné pláty a železný ingot dají 4 kusy. Vozí předměty dolů mezi inventáři."
		"Větrák na konci šachty ji obrátí, pak vozí nahoru. Šachta položená na bok jiné šachty povede šikmo."
	]
	quest.3E93512982141B09.title: "Šachta"
	quest.3EA87B6B8C8EA5F2.quest_desc: [
		"Rakety se skládají jen v pracovním stole NASA (&eNasa Workbench&r)."
		"Raketa 1. stupně potřebuje: špici, 6 bloků oceli, 4 ploutve, 2 ocelové nádrže a ocelový motor."
	]
	quest.3EA87B6B8C8EA5F2.title: "Pracovní stůl NASA"
	quest.3EA9CCFB4D43E06B.quest_desc: [
		"Nech stavitele postavit radnici na úrovni 1. Bude vypadat podle stylu, který sis vybral."
		"&bStylecolonies&r přidává styly jako &eSteampunk&r, &eFairyTale&r, &eFrontier&r, &eAntique&r, &eTropical&r nebo &eCrimson Keep&r."
		"&bByzantine&r přidává &eByzantine&r, &eNile&r a &eShogun&r, &bChristmasColonies&r zase vánoční &eChristmas Style&r a obří vánoční strom."
		"{@pagebreak}"
		"&cNěkteré styly potřebují zvláštní místo: &eTropical&r mělkou vodu, &eAquatica&r a &eUnderwater Base&r hluboký oceán. Než začneš, přečti si popis stylu.&r"
		"&aTip:&r pokročilé styly (&eSpace Wars&r, &eFortress&r) jsou náročné na suroviny. Na začátek vyber styl označený &e[Beginner]&r."
	]
	quest.3EA9CCFB4D43E06B.quest_subtitle: "Začátečník"
	quest.3EA9CCFB4D43E06B.title: "Radnice ve tvém stylu"
	quest.3EB44E38B1C0DCFF.quest_desc: [
		"Nejlevnější náboj je kulometný (&eMachine Gun Round&r). Hodí se hlavně na tvory."
		""
		"Pila rozřeže plát (železný, měděný nebo mosazný) na &eAutocannon Cartridge Sheet&r. Další řez dá 4 prázdné náboje. Na stole k nim přidej střelný prach a měděný nugget."
		""
		"Zásobník (&eAutocannon Ammo Container&r) vyrobíš z mosazného ingotu a železných plátů. Naplníš ho v jeho menu. Klikni s ním pravým tlačítkem na závěr a vložíš ho do autokanónu."
		""
		"&aTip:&r Silnější náboj: na stole spoj plnou nábojnici (&eFilled Autocannon Cartridge&r) s &eFlak Autocannon Round&r nebo &eArmor Piercing (AP) Autocannon Round&r. Nábojnici uděláš z plechu: lis ho 6× slisuje a pokladač do něj přidá střelný prach."
	]
	quest.3EB44E38B1C0DCFF.title: "Náboje do autokanónu"
	quest.3EDC51BA2B8306E3.quest_desc: [
		"Divoká jeskynní mrkev roste v jeskyních pod výškou Y 48."
		"Jeskynní polévku (&eCave Soup&r) uvaříš z jeskynní mrkve, červené houby a dvou hnědých hub."
	]
	quest.3EDC51BA2B8306E3.title: "Jeskynní polévka"
	quest.3EE3688D7A7B30E1.quest_desc: [
		"Můří kulička (&eMoth Ball&r) drží můry dál od světel."
		"Recept: můří prach (&eMoth Dust&r, padá z můr), guáno (&eGuano&r) a 2 provázky."
		"&aZe 2 guán a kostní moučky je hnojivo (&eFertilizer&r), které funguje líp než kostní moučka.&r"
	]
	quest.3EE3688D7A7B30E1.title: "Můří kulička"
	quest.3EE3B341791567D6.quest_desc: [
		"Hrnec (&ePot&r) a voda na pracovním stole dají sůl (&eSalt&r)."
		"Sůl je potřeba do těsta, sýra a mnoha dalších jídel."
	]
	quest.3EE3B341791567D6.title: "Sůl"
	quest.3EE5D0649401A1FB.quest_desc: [
		"Smetanovou polevu namícháš ze smetany, 2 cukrů a 2 kusů másla."
		"Dávkovač polevou naplní prázdný cukrářský sáček – vznikne sáček s polevou (&ePiping Bag&r)."
	]
	quest.3EE5D0649401A1FB.title: "Poleva"
	quest.3EEBD451E02C56B6.quest_desc: [
		"Ochranný oblek proti radiaci má 4 díly: masku (&eHazmat Mask&r), plášť (&eHazmat Gown&r), kalhoty (&eHazmat Pants&r) a boty (&eHazmat Boots&r)."
		"Vyrobíš je z olověných ingotů a oranžového barviva."
		"&aTip:&r Nos ho vždy, když pracuješ s jaderným palivem nebo odpadem."
	]
	quest.3EEBD451E02C56B6.title: "Ochranný oblek"
	quest.3F06AB4B099762CA.quest_desc: [
		"Tato kapitola navazuje na kapitolu &bLet's Do: farma a kuchyně&r. Tam vyrobíš první víno, první pivo a první čaj."
		"Tady pěstuješ vzácné odrůdy, necháváš víno zrát, vaříš whisky a mícháš čaje se silnými efekty."
		"&aTip:&r Většina nápojů dává efekt. Najetím myši na nápoj ho uvidíš v popisku."
	]
	quest.3F06AB4B099762CA.quest_subtitle: "Začátečník"
	quest.3F06AB4B099762CA.title: "Sklep plný lahví"
	quest.3F0AF89D5FF4173A.quest_desc: [
		"Kouzelná mapa ukáže okolí i stavby bossů. Nejdřív vyrob zaměřovač (&eMagic Map Focus&r): havraní pírko, svítící bobule (&eTorchberries&r) a světlitový prach."
		"Havrani (&eRaven&r) žijí v lesích. Svítící bobule visí z kořenů v jeskyních."
		"Zaměřovač obklop 8 papíry. Prázdnou mapu pak použij pravým tlačítkem."
	]
	quest.3F0AF89D5FF4173A.title: "Kouzelná mapa"
	quest.3F1225CF28038847.quest_desc: [
		"Sláma (&eStraw&r) je suché vlákno. Vyrábí se z ní lano, plátno a kompost."
		"Vezmi nůž do ruky a rozbíjej jím trávu nebo zralou pšenici a rýži. Ze zralého obilí padá sláma vždy, z trávy jen občas."
		"&aTip:&r Devět kusů slámy složíš do balíku slámy (&eStraw Bale&r) a zase zpátky."
	]
	quest.3F1225CF28038847.title: "Sláma"
	quest.3F2130170EC49D68.quest_desc: [
		"Automatická výroba začíná prázdným vzorem (&eBlank Pattern&r). Recept do něj zapíšeš v terminálu pro vzory (&eME Pattern Encoding Terminal&r)."
		"Výrobní vzor obsahuje recept z pracovního stolu. Zpracovací vzor (&eProcessing Pattern&r) říká, co poslat do stroje (třeba pece) a co se má vrátit."
		"&aTip:&r Recept do terminálu přeneseš z JEI tlačítkem + u receptu."
	]
	quest.3F2130170EC49D68.title: "Vzory receptů"
	quest.3F2B9687F2677F09.quest_desc: [
		"Mody &bLuminous&r přidávají motýly, světlušky, nové příšery, dekorace a hlavně &ebestie&r – velké a silné tvory."
		"Bestie v Overworldu se objevují jen v noci, pod širým nebem a ve tmě. Každá žije v jiném biomu. Některé se líhnou z vajec nebo z kokonů."
		""
		"Začni motýly. Až budeš mít diamanty a dobrou zbroj, vyrob si &eBestiář&r a jdi na bestie."
	]
	quest.3F2B9687F2677F09.quest_subtitle: "Začátečník"
	quest.3F2B9687F2677F09.title: "Svět Luminous"
	quest.3F452D140A574530.quest_desc: [
		"&eMechanický vrták&r (&eMechanical Drill&r) těží blok před sebou. Čím rychlejší rotace, tím rychleji těží."
		"&eMechanická pila&r (&eMechanical Saw&r) pokácí celý strom, když přeřízne jeho spodní kmen. Otočená nahoru zpracovává předměty."
		"Nejvíc se hodí na pohyblivých strojích, víc v kapitole Stroje a automatizace."
	]
	quest.3F452D140A574530.title: "Vrták a pila"
	quest.3F5F89B8D129FFBE.quest_desc: [
		"Železná tyč (&eIron Rod&r) rozbije blok před sebou, když ji posune píst. Tak postavíš automatický důl nebo farmu."
		"Vyrobíš ji ze železných ingotů a tyče z Endu (&eEnd Rod&r). Tu vyrobíš z ohnivé tyče a prasklého chorusového ovoce, nebo ji najdeš v Endu."
	]
	quest.3F5F89B8D129FFBE.title: "Železná tyč"
	quest.3F852D0F0D775A1D.quest_desc: [
		"&bCultural Delights&r přidává jídla z celého světa: tacos, kari, sushi, nakládané okurky i nápoje."
		"Avokáda rostou na stromech v džunglích. Divoké okurky najdeš v bažinách, lilek v džunglích a kukuřici v pláních."
		"&aTip:&r Z divokých rostlin dostaneš i semínka, takže si je můžeš pěstovat doma."
	]
	quest.3F852D0F0D775A1D.title: "Cultural Delights"
	quest.3F879A97FB867D87.quest_desc: [
		"Betonář (&eConcrete Mixer's Hut&r) vyrábí betonový prášek i hotový beton."
		"Výzkum &ePave the Road&r stojí 32 betonu a potřebuje drtič úrovně 1. Blok budovy: prkna, bílý betonový prášek a nástroj stavby."
	]
	quest.3F879A97FB867D87.title: "Betonárna"
	quest.3FB08EF4D9BA4CED.quest_desc: [
		"Lafeta míří pomocí rotace. Rotace zespodu otáčí dělem do stran. Rotace z boku ho zvedá a sklápí."
		""
		"S brýlemi (&eEngineer's Goggles&r) uvidíš na lafetě úhly děla i jeho sílu."
		""
		"Rozšíření lafety (&eCannon Mount Extension&r) přidá další místa pro připojení. Šipka na jeho boku ukazuje, ke které lafetě patří."
		""
		"&aTip:&r Pevná lafeta (&eFixed Cannon Mount&r) nepotřebuje rotaci. Úhel se jí nastaví na bocích a míří pořád na stejné místo."
	]
	quest.3FB08EF4D9BA4CED.title: "Míření"
	quest.3FB7FFBF2721E31A.quest_desc: [
		"Zkušenosti (zelené kuličky) teď nemusíš nosit v sobě. Poklop zkušeností (&eExperience Hatch&r) je převede na tekuté zkušenosti (&eLiquid Experience&r) a uloží do nádrže."
		""
		"Polož ho na nádrž (&eFluid Tank&r). Pravým tlačítkem do něj zkušenosti uložíš. Shift + pravé tlačítko je zase vybereš."
		""
		"Tekuté zkušenosti se měří v mB jako jiné kapaliny. Můžeš je čerpat trubkami a plnit jimi stroje."
		""
		"&aTip:&r Na panelu poklopu nastavíš, kolik zkušeností se přesune jedním kliknutím."
	]
	quest.3FB7FFBF2721E31A.quest_subtitle: "Začátečník"
	quest.3FB7FFBF2721E31A.title: "Ulož si zkušenosti"
	quest.3FBD82008C8C1D22.quest_desc: [
		"&bBeachparty&r přidává palmy, kokosy, mušle, koktejly a plážové vybavení."
		"Najdi pláž. Rostou tam palmy s kokosy a v písku najdeš mušle."
	]
	quest.3FBD82008C8C1D22.title: "Na pláž!"
	quest.3FC469B7844B825A.quest_desc: [
		"Prkénko (&eOak Cutting Board&r) vyrobíš na dílenském stole, nůž (&eKnife&r) na pracovním stole."
		"Polož chleba na prkénko a klikni na něj nožem. Dostaneš 6 krajíců (&eBread Slice&r)."
	]
	quest.3FC469B7844B825A.title: "Krájení chleba"
	quest.3FCDC9565C1FCFA7.quest_desc: [
		"V Incendiu žijí piglini i ve vesnicích s kovárnou, řeznictvím a farmami. Vesnice stojí v karmínovém a zkřiveném lese."
		"Vykraď truhlu v piglinské vesnici. &cStráže se budou bránit.&r"
	]
	quest.3FCDC9565C1FCFA7.title: "Piglinská vesnice"
	quest.3FD1E196C8480A68.quest_desc: [
		"&eMlýnské kolo&r (&eWater Wheel&r) je první stálý zdroj energie. Recept: hřídel uprostřed a kolem ní 8 prken."
		"Polož ho tak, aby kolem něj &etekla&r voda – stojatá voda kolo neroztočí. Stačí proud na jedné straně, další strany už výkon nezvýší."
		"Kolo se točí 8 RPM a dá 256 SU. &aTip:&r Víc kol na jedné hřídeli dá víc SU, jen se musí točit stejným směrem. Víc zdrojů je v kapitole Energie a stres."
	]
	quest.3FD1E196C8480A68.title: "Mlýnské kolo"
	quest.3FD937410BC77B93.quest_desc: [
		"Na křemenných pláních (&eQuartz Flats&r) stojí svatyně illagerů (&eSanctum&r)."
		"Uvnitř je trezor s pokladem. Hlídají ho stráže, které ti dávají únavu z těžby. Když je porazíš, únava zmizí."
	]
	quest.3FD937410BC77B93.title: "Svatyně illagerů"
	quest.3FEC4FBAA9352721.quest_desc: [
		"Postav vlak, který má aspoň 6 vagonů."
		"Každý vagon stojí na vlastním podvozku (nebo na dvou) a je slepený zvlášť. Všechny vagony postav za sebou u stanice a sestav je najednou."
		"&aDelší vlak uveze víc, ale potřebuje delší nástupiště.&r"
	]
	quest.3FEC4FBAA9352721.title: "Dlouhý vlak"
	quest.3FFB90425DE23E6A.quest_desc: [
		"Sporák (&eStove&r) je zdroj tepla pro hrnec a pánev. Vyrobíš ho z cihel, železa a táboráku."
		"Na sporák můžeš rovnou položit až 6 kusů syrového jídla a opéct je jako na táboráku."
		"&cPozor:&r Hořící sporák pálí, když na něj šlápneš. Uhasíš ho lopatou nebo kbelíkem vody, zapálíš ho křesadlem."
	]
	quest.3FFB90425DE23E6A.title: "Sporák"
	quest.400A3C288712DE60.quest_desc: [
		"Bloky soli (&eSalt Block&r) najdeš pod zemí v krápníkových jeskyních (&eDripstone Caves&r). Z jednoho bloku slož na pracovním stole 4 soli (&eSalt&r)."
		"&aTip:&r Sůl jde i pěstovat. Z bloku soli, vody a krápníku (&ePointed Dripstone&r) postavíš farmu na solné krápníky (&eSalt Spike&r)."
	]
	quest.400A3C288712DE60.title: "Sůl"
	quest.4012856180BD06C4.quest_desc: [
		"Certusový krystal vlož do nabíječky – vznikne nabitý certus (&eCharged Certus Quartz Crystal&r)."
		"Nabitý certus hozený do vody spolu s redstonem a netherovým křemenem se změní na 2 fluixové krystaly (&eFluix Crystal&r)."
		"&aTip:&r Nabitý certus + certusový prach ve vodě = 2 nové certusové krystaly. Nabíjet jde i Teslovou cívkou (&eTesla Coil&r) z &bCreate Crafts \\& Additions&r."
	]
	quest.4012856180BD06C4.title: "Nabitý certus"
	quest.4016DC04770BC921.quest_desc: [
		"Chytrá vrtule (&eSmart Propeller&r) je malá vrtule, která se sama naklání tak, aby mířila nahoru."
		"Hodí se na malé létající stroje. Montážním klíčem otočíš směr tahu."
		"Výroba: vrtule z Create, gyroskopický mechanismus a mosazné pouzdro dají 2 kusy."
	]
	quest.4016DC04770BC921.title: "Chytrá vrtule"
	quest.4043B5F303D667BA.quest_desc: [
		"Obal balónu (&eHot Air Envelope&r) je látka na stavbu balónu. Z obalů postav uzavřený prostor – to je balón."
		"Výroba: 2 bílé vlny a 2 tyčky dají 4 obaly. Barvivem je obarvíš."
		"&cBalón musí být vzduchotěsný. Těsní jen obaly a vlna, jinudy horký vzduch uteče.&r Hřídel vedoucí skrz balón obal tak, že na ni klikneš obalem."
		"Bloky uvnitř balónu zmenšují jeho objem."
	]
	quest.4043B5F303D667BA.title: "Obal balónu"
	quest.404955A3B5027ACB.quest_desc: [
		"&eHůlka souměrnosti&r (&eWand Of Symmetry&r) zrcadlí stavění. Klikni s ní na zem a objeví se zrcadlo. Se Shiftem otevřeš nastavení."
		"Dokud je hůlka v hotbaru, každý blok se položí i zrcadlově na druhou stranu."
	]
	quest.404955A3B5027ACB.title: "Hůlka souměrnosti"
	quest.40557267D1201D19.quest_desc: [
		"&bMacaw's Holidays&r: vánoční stromky, girlandy a podzimní dekorace."
		"Spodek vánočního stromku (&eChristmas Tree Base&r) je ze smrkového jehličí a smrkového kmenu. Cukrová hůlka (&eCandy Cane&r) z cukru."
	]
	quest.40557267D1201D19.title: "Sváteční dekorace"
	quest.405F4B1F57D56107.quest_desc: [
		"Monitor výroby (&eAutocrafting Monitor&r) ukáže běžící zakázky a dovolí je zrušit."
		"Správce výrobníků (&eAutocrafter Manager&r) ukáže všechny výrobníky a jejich vzory na jednom místě."
		"&aTip:&r Hodí se, když máš výrobníků hodně."
	]
	quest.405F4B1F57D56107.title: "Přehled výroby"
	quest.407BED3177E66905.quest_desc: [
		"Karminit (&eCarminite&r) padá z Ur-Ghasta. Vyrobíš ho i z esence vrtáků (&eBorer Essence&r), rudého prachu a slzy ghasta."
		"Z karminitu jsou zvláštní bloky: mizející a znovu se objevující bloky, stavitel a reaktor."
	]
	quest.407BED3177E66905.title: "Karminit"
	quest.408F6D732F71A680.quest_desc: [
		"Mod &bMoog's Nether Structures&r přidává do Netheru desítky menších i velkých staveb."
		"Najdi karmínovou kovárnu (&eCrimson Forge&r). Stojí v karmínovém lese."
	]
	quest.408F6D732F71A680.title: "Netherové stavby"
	quest.40AB0739CF0F511D.quest_desc: [
		"Semínka pšenice rozdrcená v hmoždíři dají mouku (&eFlour&r) a trochu oleje."
		"Mouka je základ těsta, sušenek a dortů."
	]
	quest.40AB0739CF0F511D.title: "Mouka"
	quest.40B2312141C15A22.quest_desc: [
		"Zednická lžíce (&eTrowel&r) pokládá náhodný blok z tvé lišty rychlého přístupu. Skvělé na přirozeně vypadající zdi a cesty."
		"Když dáš stejný blok do víc slotů, bude se objevovat častěji. Lžíce se nikdy nerozbije."
	]
	quest.40B2312141C15A22.title: "Zednická lžíce"
	quest.40B73277F0D1A7FC.quest_desc: [
		"Oltář (&eAltar&r) = 8 svatých kamenů a zanit. Funguje jako pec, ale místo pálení věci očaruje. Palivo je ambrosium."
		"Mrazák (&eFreezer&r) = svaté kameny, ledový kámen (&eIcestone&r) a prkna. Věci zmrazí. Palivo je ledový kámen."
		"Oltářem také opravíš poškozené nástroje a zbroj."
	]
	quest.40B73277F0D1A7FC.title: "Oltář a mrazák"
	quest.40C24C5EB6B00087.quest_desc: ["Bažinná zahrádka (&eSoggy Garden&r) roste v bažinách. Dává třeba borůvky, rýži, bavlnu nebo chřest."]
	quest.40C24C5EB6B00087.title: "Bažinná zahrádka"
	quest.40D228147AE39E3C.quest_desc: [
		"Rozebírací stůl (&eUncrafting Table&r) rozloží vyrobený předmět zpátky na suroviny. Stojí to zkušenosti."
		"Recept: 8 pracovních stolů a zaměřovač bludiště (&eMaze Map Focus&r). Ten padá z minotaurů v labyrintu."
	]
	quest.40D228147AE39E3C.title: "Rozebírací stůl"
	quest.40D3D1E53C2BE89C.quest_desc: [
		"Kmínky révy (&eGrapevine Stem&r) vyrobíš z polen."
		"Postav kmínek a pravým tlačítkem na něj zasaď semínka hroznů. Réva na něm vyroste a dává hrozny."
	]
	quest.40D3D1E53C2BE89C.title: "Vinná réva"
	quest.40ECA47E46E32C70.quest_desc: [
		"Teď už nejen vaříš, ale i kvasíš. Kvašení chce čas a správnou teplotu."
		"&bBrewin' and Chewin'&r přidává soudek (&eKeg&r) na kvašení nápojů a sýrů. Vyrobíš ho ze železa, prken a plástve."
		"Do soudku dej suroviny a tekutinu (vodu, mléko nebo med). Za chvíli vznikne nápoj, který naliješ do korbelů (&eTankard&r)."
		"Každý recept chce jinou teplotu. Potřebnou teplotu ukáže JEI, aktuální vidíš v okně soudku."
	]
	quest.40ECA47E46E32C70.quest_subtitle: "Pokročilý"
	quest.40ECA47E46E32C70.title: "Brewin' and Chewin'"
	quest.40EE25F3ED960809.quest_desc: ["Ancientscale (&eRaw Ancientscale&r) žije u podmořských ruin, ve vlažných oceánech a v jeskyních."]
	quest.40EE25F3ED960809.title: "Ancientscale"
	quest.411F0CC31EA92442.quest_desc: [
		"&ePsací podložka&r (&eClipboard&r): slitina, papír a prkno. Pravým klikem si do ní píšeš poznámky a seznamy."
		"Kopíruje nastavení: pravým klikem na blok (třeba filtr) ho zkopíruješ, levým klikem na jiný blok ho vložíš. Shift + pravým klikem ji připevníš na blok."
	]
	quest.411F0CC31EA92442.title: "Psací podložka"
	quest.4120D0A89BE42DA6.quest_desc: [
		"Rozšíření (&eBasic Motor Extension&r) dej za motor. Zvýší jeho sílu (SU) až na dvojnásobek."
		""
		"Násobek nastavíš na rozšíření. &cMotor pak spotřebuje úměrně víc elektřiny.&r"
	]
	quest.4120D0A89BE42DA6.title: "Rozšíření motoru"
	quest.4137E178A528DA59.quest_desc: [
		"Plyny se nedají nabrat do kbelíku. Vedou se tlakovou trubkou (&eBasic Pressurized Tube&r) z oceli a skla."
		"Chemická nádrž (&eBasic Chemical Tank&r) plyn uloží. Když ji vykopeš, plyn v ní zůstane, takže ho můžeš přenést."
		"&aTip:&r Jedna síť trubek vede vždy jen jeden plyn. Pro každý plyn postav vlastní trasu."
	]
	quest.4137E178A528DA59.title: "Plyny a nádrže"
	quest.414249F9D2C1FA03.quest_desc: ["Přiřaď jednomu farmáři největší možný počet polí. Farmář zvládne jedno pole za každou úroveň farmy, tedy až 5 polí."]
	quest.414249F9D2C1FA03.title: "Zelené prsty"
	quest.414D0486CFEF4692.quest_desc: [
		"Stirlingův motor je slabý. Víc z tepla dostaneš, když jím ohřeješ parní kotel. Ohřívač (&eHeater&r) funguje jako ohňohořák pod kotlem, jen místo paliva bere teplo z trubek."
		""
		"Čím víc tepla do něj přivedeš, tím víc tepla dává kotli. Vyrobíš ho z prázdného ohňohořáku, nabitého železa, tepelných trubek a železných nugetů."
		""
		"&aTeplo z jaderného reaktoru využiješ právě takhle: tepelné trubky dovedou teplo k ohřívačům pod parními kotli.&r"
	]
	quest.414D0486CFEF4692.quest_subtitle: "Pokročilý"
	quest.414D0486CFEF4692.title: "Ohřívač kotle"
	quest.414F831CEEE4E36F.quest_desc: [
		"Úzká kolej (&eNarrow Andesite Train Track&r) má menší rozchod. Je skvělá na malé vláčky."
		"Vyrábí se z kamenné desky: pila ji ořízne, pokladač přidá nuget a lis ji stiskne."
		"Na úzkou kolej patří úzký podvozek. Vybereš ho v nabídce podvozků (Alt s vlakovým pouzdrem v ruce)."
	]
	quest.414F831CEEE4E36F.title: "Úzký rozchod"
	quest.415BA16357CD55B4.quest_desc: [
		"Ve světě rostou divoké plodiny. Rozbij je a dostaneš plody a semínka."
		"Divoké zelí (&eWild Cabbage&r) a řepa rostou na plážích. Cibule a mrkev v pláních a lesích. Rajčata (&eTomato Shrub&r) v savanách a pouštích. Brambory v chladných horách a tajgách."
		"&aTip:&r Plodiny a semínka najdeš občas i v truhlách."
	]
	quest.415BA16357CD55B4.title: "Divoké plodiny"
	quest.41746D6589903269.quest_desc: [
		"Vystřihovací nástroj (&eCut Paste Gadget&r) stavbu nekopíruje, ale přesune: na původním místě zmizí a objeví se jinde."
		"Spotřebuje hodně energie, tak ho před použitím nabij."
		"&aTip:&r Ideální, když chceš celou základnu posunout o kus dál."
	]
	quest.41746D6589903269.title: "Přesun staveb"
	quest.417A0B58BAD06B21.quest_desc: [
		"&bExtraDelight&r je obří doplněk s desítkami kuchyňských strojů: mísa, hmoždíř, trouba, odpařovač, kvasná káď a další."
		"Míchací mísu (&eMixing Bowl&r) vyrobíš z prken. Troubu (&eOven&r) z cihel, pece a terakoty."
		"Všechno o ExtraDelight najdeš ve vlastní kapitole &eExtraDelight&r."
	]
	quest.417A0B58BAD06B21.title: "ExtraDelight"
	quest.418E82088BE6A190.quest_desc: [
		"Tvůj první elektrický obvod: alternátor vyrobí elektřinu, dráty ji odvedou a elektromotor z ní udělá otáčení třeba na druhém konci základny."
		""
		"Konektor (&eSmall Connector&r) vyrobíš z měděné tyče, andezitové slitiny a slizové koule (3 kusy). Polož ho přímo na stroj. Měděnou cívkou klikni pravým tlačítkem na první a pak na druhý konektor. Spojení spotřebuje jednu cívku a vrátí ti prázdnou."
		"{@pagebreak}"
		"Drát může být dlouhý až 16 bloků, konektor unese 4 dráty. Montážním klíčem přepínáš režim konektoru:"
		"&ePull&r bere energii ze stroje (dej ho na alternátor). &ePush&r energii do stroje posílá (dej ho na motor). &eNone&r jen předává energii dál – hodí se jako sloup vedení."
		""
		"&aDrát odstraníš tak, že prázdnou cívkou klikneš na oba konce. Drát se ti vrátí jako plná cívka.&r"
	]
	quest.418E82088BE6A190.quest_subtitle: "Začátečník"
	quest.418E82088BE6A190.title: "Konektory a vedení"
	quest.41B89DC3CE373DEA.quest_desc: [
		"&eMechanický lis&r (&eMechanical Press&r) lisuje ingoty na &epláty&r. Recept: hřídel, andezitové pouzdro a blok železa pod sebou."
		"Roztoč ho a pod něj dej odkládací desku nebo pás. Předmět můžeš pod lis i jen hodit na zem."
		"Lis bere 8 SU za každé RPM. Na 8 RPM z mlýnského kola je to 64 SU, takže jedno kolo (256 SU) ho utáhne."
	]
	quest.41B89DC3CE373DEA.title: "Mechanický lis"
	quest.41F4CED743ECA254.quest_desc: [
		"Pokročilý chunk loader (&eAdvanced Chunk Loader&r) drží oblast 5 × 5 chunků. Stačí na velkou farmu nebo továrnu."
		"Základní chunk loader obklop zlatými ingoty a ohnivým práškem."
	]
	quest.41F4CED743ECA254.quest_subtitle: "Pokročilý"
	quest.41F4CED743ECA254.title: "Chunk loader 5 × 5"
	quest.41FB5A92DE21933D.quest_desc: ["Druhý stupeň (&eStack Upgrade Tier 2&r) dá 4× víc. Vyrobíš ho z prvního stupně a 8 zlatých bloků."]
	quest.41FB5A92DE21933D.title: "Stoh II"
	quest.422F25920638EE28.quest_desc: [
		"Magnet (&eMagnet&r) zapnutý redstonem tlačí nebo přitahuje bloky ze železa nebo mědi."
		"Je to nový druh redstonových strojů. Víc magnetů na jeden blok? Vyhraje ten nejsilnější."
		"Vyrobíš ho z dlažebního kamene, železa, modrého barviva, chorusového ovoce a redstonu. Chorusové ovoce roste v Endu."
	]
	quest.422F25920638EE28.quest_subtitle: "Pokročilý"
	quest.422F25920638EE28.title: "Magnet"
	quest.42313C7F139CF77B.quest_desc: [
		"Motor (&eEngine&r) vyrobíš z kotle, vysoké pece, dvou pístů a dlažebních kamenů. Vrtule (&ePropeller&r) je ze železných ingotů."
		"&aMotor potřebuje skoro každé letadlo.&r"
	]
	quest.42313C7F139CF77B.title: "Motor a vrtule"
	quest.4233AD5385C33849.quest_desc: [
		"&bCreate Jetpack&r: jetpack je tlaková láhev s tryskami. Vyrábí se v mechanickém výrobníku z měděné láhve, krovek (Elytra), 2 precizních strojků, mosazných plátů, šacht a hřídele."
		"Plní se jako láhev: polož ho a roztoč. Mezerník = nahoru, Shift = dolů, G = motor zapnout a vypnout, H = režim vznášení."
	]
	quest.4233AD5385C33849.title: "Jetpack"
	quest.425EA208F76FCF87.quest_desc: [
		"Výbava ze železodřeva má očarování hned po výrobě. Třeba hrudní plát (&eIronwood Chestplate&r) má Ochranu."
		"Každý kus má jiné očarování. Které, ukáže popis předmětu."
	]
	quest.425EA208F76FCF87.title: "Železodřevěná zbroj"
	quest.427CC13C184E98DB.quest_desc: [
		"Do žlabu (&eFeeding Trough&r) nasyp semínka. Zvířata v okolí z něj sama žerou."
		"Kurník (&eChicken Coop&r) pojme slepice a sbírá jejich vejce. Vejce si pak jen vybereš."
		"&aTip:&r Napajedlo (&eWater Trough&r) zkracuje dobu, než se zvířata znovu rozmnoží."
	]
	quest.427CC13C184E98DB.title: "Péče o zvířata"
	quest.427F3ECA72492A80.quest_desc: [
		"&bUnusual Fish&r přidává podivné vodní tvory. Každý žije jinde: v teplém oceánu, hlubokém oceánu, bažinách, řekách, džungli i v jeskyních."
		"Když podivnou rybu ulovíš, upeč ji. Dostaneš podivný filet (&eCooked Unusual Fillet&r)."
	]
	quest.427F3ECA72492A80.title: "Podivné ryby"
	quest.4280357689A07C27.quest_desc: [
		"Subterranodona ochočíš několika syrovými ocasy trilokarise (&eRaw Trilocaris Tail&r)."
		"Pravým tlačítkem na něj nasedneš a nese tě. Nahoru letí jen chvíli, pak musí přistát."
		"Shift + pravé tlačítko přepíná: následuj / zůstaň / volně se pohybuj."
	]
	quest.4280357689A07C27.title: "Létající ještěr"
	quest.428063760A28C8BE.quest_desc: [
		"Levitační kolej (&eMagnetic Levitation Rail&r) zvedne vozík do vzduchu. Vozík na ní jede rychleji než na obyčejné koleji."
		"Ze 2 modrých neodymových ingotů, 6 železných ingotů a tyčky vyrobíš 6 kolejí."
	]
	quest.428063760A28C8BE.title: "Levitační kolej"
	quest.4295460EAA28B0E9.quest_desc: [
		"Ve vesnicích žijí vesničané. Za smaragdy prodávají nástroje, knihy s očarováním i jídlo."
		"Úkol: udělej jeden obchod. Klikni na vesničana pravým tlačítkem."
		"&aTip:&r Ve vesnicích často stojí waystone. Aktivuj ho, ať se sem snadno vrátíš."
	]
	quest.4295460EAA28B0E9.title: "Obchod s vesničany"
	quest.42976B48CD9D2649.quest_desc: [
		"Alchymista (&eAlchemist Tower&r) vaří lektvary a pěstuje bradavičník a jmelí."
		"Výzkum &eMagic Potions&r (po &eOpen the Nether&r) stojí 16 bradavičníků. Blok budovy: prkna, varný stojan a nástroj stavby."
	]
	quest.42976B48CD9D2649.title: "Alchymista"
	quest.42A129A821DA9AB1.quest_desc: [
		"&ePropojený ovladač&r (&eLinked Controller&r) má 6 tlačítek, která ovládají redstonové vysílače."
		"Klikni ovladačem na přijímač a stiskni jedno z tlačítek – tím ho na přijímač naladíš. Shift + pravým klikem otevřeš ruční nastavení."
		"Pravým klikem ovladač zapneš, pak pohybové klávesy posílají signály. Dá se položit na řečnický pult."
	]
	quest.42A129A821DA9AB1.title: "Propojený ovladač"
	quest.42A695A19BD76174.quest_desc: [
		"Základní řídicí obvod (&eBasic Control Circuit&r) je skoro v každém stroji Mekanismu."
		"Vyrobíš ho v infuzéru: osmiový ingot doprostřed, redstone do levého slotu jako zdroj infuze."
		"&aTip:&r Lepší obvody vzniknou z horšího obvodu a slitin. Pokročilý obvod přijde za pár kroků."
	]
	quest.42A695A19BD76174.title: "Základní obvod"
	quest.42AB3E9759DD764B.quest_desc: [
		"Teď už malé konektory nestačí. Přenesou jen 1 000 ⚡ za tick. Velký konektor (&eLarge Connector&r) přenese 5 000 ⚡, drát k němu smí být dlouhý 32 bloků a unese 6 drátů."
		""
		"Velký konektor vyrobíš ze zlaté nebo elektrové tyče, 2 andezitových slitin a slizové koule (2 kusy). Spojuješ je elektrovou (&eElectrum Spool&r) nebo zlatou cívkou – měděná na ně nestačí."
		"{@pagebreak}"
		"Efektivní napájení základny: víc alternátorů na rychlém a silném zdroji otáčení (třeba velký parní stroj) → velké konektory → velký akumulátor jako zásobník → silné vedení ke strojům."
		""
		"&aAkumulátor může mít až 3 × 3 bloky na šířku a 5 bloků na výšku. Každý blok pojme 2 000 000 ⚡. Elektřinu tak máš i ve chvíli, kdy zdroj stojí.&r"
	]
	quest.42AB3E9759DD764B.quest_subtitle: "Expert"
	quest.42AB3E9759DD764B.title: "Napájení celé základny"
	quest.42B061EE29CDD872.quest_desc: [
		"Teď z jednotlivých truhel uděláš jeden sklad. Ovladač úložiště (&eStorage Controller&r) spojí sofistikované truhly a sudy, které se ho dotýkají – i přes další truhly."
		"Věci vložené do ovladače se samy uloží tam, kde je pro ně místo. Násypkou nebo trubkou do něj můžeš posílat celé dodávky."
		"&aTip:&r Truhly dál od ovladače připojíš spojkou (&eStorage Link&r)."
	]
	quest.42B061EE29CDD872.quest_subtitle: "Pokročilý"
	quest.42B061EE29CDD872.title: "Ovladač úložiště"
	quest.42E6C9265C238216.quest_desc: [
		"Krystaly na pučícím certusu rostou samy velmi pomalu. Urychlovač růstu (&eGrowth Accelerator&r) položený vedle bloku je hodně zrychlí."
		"Urychlovač potřebuje energii: shora nebo zespodu přiveď FE kabelem, nebo na něj dej kliku (&eWooden Crank&r)."
		"Sklízej jen plně vyrostlé shluky (&eCertus Quartz Cluster&r) – dají 4 krystaly. Nedorostlý krystal dá jen 1 prach."
		"&aTip:&r Pučící blok (kromě bezvadného) se při růstu postupně kazí. Opravíš ho hozením do vody s nabitým certusem."
	]
	quest.42E6C9265C238216.title: "Pěstování certusu"
	quest.42F6A305042CC66C.quest_desc: [
		"&bCreate: Dragons Plus&r přidává hlavně věci pro práci s kapalinami. Potřebují ho i další doplňky."
		""
		"Kapalinový poklop (&eFluid Hatch&r) vyrobíš z měděného ingotu a cedníku (&eItem Drain&r). Polož ho na nádrž."
		""
		"Pravým tlačítkem s kbelíkem vyliješ kapalinu do nádrže. Shift + pravé tlačítko kbelík z nádrže naplní."
		""
		"Víc najdeš v kapitole Průmysl."
	]
	quest.42F6A305042CC66C.title: "Kapalinový poklop"
	quest.431646C710BEEE9A.quest_desc: [
		"Hnědá nebo červená houba zasazená na bohatou půdu se změní na houbovou kolonii (&eBrown Mushroom Colony&r, &eRed Mushroom Colony&r). Ta časem roste."
		"Dospělou kolonii rozbij s nůžkami v ruce a dostaneš ji celou jako předmět. Když na ni nůžkami jen klikneš, sklidíš z ní houbu."
		"&aTip:&r Na prkénku ji nožem nakrájíš na 5 hub. Kolonie se hodí i do některých receptů."
	]
	quest.431646C710BEEE9A.title: "Houbové kolonie"
	quest.432588FA046D6DE9.quest_desc: [
		"Mechanické potrubí (&eBasic Mechanical Pipe&r) vede kapaliny, třeba vodu do separátoru. Vyrobíš ho z oceli a kbelíku."
		"Elektrická pumpa (&eElectric Pump&r) nasává kapalinu pod sebou. Polož ji nad vodu nebo lávu a dej jí energii."
		"&aTip:&r Pumpa s filtračním vylepšením (&eFilter Upgrade&r) čerpá z vody těžkou vodu. Tu budeš potřebovat až u fúzního reaktoru."
	]
	quest.432588FA046D6DE9.title: "Kapaliny a pumpa"
	quest.4328CD94686BFEBA.quest_desc: [
		"&eDávkovač&r (&eSpout&r): měděné pouzdro nad sušenou chaluhou. Plní předměty pod sebou na desce nebo na pásu."
		"Plní lahve a kbelíky. Umí i recepty Create, třeba medové jablko nebo ohňodort. Tekutinu mu dodáš potrubím, ručně do něj nenaliješ."
	]
	quest.4328CD94686BFEBA.title: "Dávkovač"
	quest.4341D2427C7A8094.quest_desc: [
		"Očarování &eCapturing&r (Apothic Spawners) a &eReplication&r (Replication Enchantment) dávají šanci, že příšera upustí svoje spawnovací vajíčko."
		"Vajíčkem pak změníš, jaká příšera ze spawneru leze: klikni s ním na spawner."
		"Úkol: získej vajíčko pomocí očarování Capturing."
	]
	quest.4341D2427C7A8094.title: "Vajíčko z příšery"
	quest.437C5E6E3F652DB5.quest_desc: [
		"Úroveň kotle určuje to nejslabší ze tří: &eteplo&r (1 za ohřátý hořák, 2 za přehřátý), &evelikost&r (4 bloky nádrže na úroveň) a &evoda&r (10 mB za tick na úroveň)."
		"Každá úroveň pohání naplno jeden motor. Úroveň 4: 4 hořáky pod nádrží, aspoň 16 bloků nádrže (např. 2×2×4) a 40 mB vody za tick. 4 motory pak dají 65 536 SU."
		"&cVíc motorů než úrovní nic nepřidá,&r výkon se mezi ně jen rozdělí. Brýle na kotli ukážou, co chybí."
	]
	quest.437C5E6E3F652DB5.quest_subtitle: "Expert"
	quest.437C5E6E3F652DB5.title: "Kotel úrovně 4"
	quest.43D5C71489292DC7.quest_desc: [
		"&bCreate Stuff 'N Additions&r přidává jetpacky, exoskelety, drony a další výbavu. Základem jsou malé motory a začíná se tím nejjednodušším."
		""
		"Tepelný motor (&eHeat Engine&r) vyrobíš sekvenční montáží. Na andezitovou slitinu pokladač nasadí ozubené kolečko, velké ozubené kolečko, zinkový a měděný nuget. Celé se to opakuje třikrát."
		""
		"&aTepelný motor pohání výbavu na palivo: andezitový jetpack, andezitový exoskelet a plamenomet (&eFlamethrower&r), který střílí oheň a slouží i jako přenosná pec.&r"
	]
	quest.43D5C71489292DC7.quest_subtitle: "Začátečník"
	quest.43D5C71489292DC7.title: "Tepelný motor"
	quest.43E6A695B18EE4DD.quest_desc: [
		"Ostnatý humr (&ePorcupine Lobster&r) žije v hlubokém vlažném oceánu. Když ho ulovíš, upustí syrový humří ocas a ostny."
		"Ocas upeč a dej ho na pracovní stůl spolu s chlebem – vznikne humří rohlík (&eLobster Roll&r)."
	]
	quest.43E6A695B18EE4DD.title: "Humří rohlík"
	quest.43F3BBECFB68ACC4.quest_desc: [
		"Zanit (&eZanite Gemstone&r) je zdejší železo. Fialová ruda je ve svatém kameni."
		"Zanitové nástroje jsou tím rychlejší, čím víc jsou opotřebené. Po opravě jsou zase pomalé."
	]
	quest.43F3BBECFB68ACC4.title: "Zanit"
	quest.4406C77EC01195D4.quest_desc: [
		"Fúzní reaktor (&eFusion Reactor&r) je nejsilnější zdroj energie v Mekanismu. Spaluje deuterium a tritium."
		"Stavba má pevný tvar v prostoru 5×5×5 bloků: každá stěna vypadá jako kosočtverec – uprostřed 3×3 bloky a k tomu po jednom bloku uprostřed každé strany."
		"Ovladač (&eFusion Reactor Controller&r) musí být uprostřed horní stěny. Ostatní bloky stěn jsou rámy (&eFusion Reactor Frame&r)."
		"Porty (&eFusion Reactor Port&r), sklo a laserovou matici (&eLaser Focus Matrix&r) smíš dát jen do středního kříže stěny: prostřední blok a 4 bloky kolem něj."
		"{@pagebreak}"
		"Zapálení: do ovladače vlož naplněný hohlraum. Zesilovač laseru nabij energií a vystřel ho do laserové matice. Když je plazma dost horká, reaktor se zapálí."
		"Pak do portů posílej deuterium a tritium a energii odváděj z portu."
		"&aTip:&r V okně reaktoru nastavíš rychlost vstřikování paliva (&eInjection Rate&r)."
	]
	quest.4406C77EC01195D4.title: "Fúzní reaktor"
	quest.440D8BDA2A73D1E1.quest_desc: [
		"&bCreate Deco&r přidává kovové stavební díly v barvách kovů z Create: andezitu, železa, mědi, zinku, mosazi a dalších."
		""
		"Většinu dílů vyrobíš v kameníkovi přímo z ingotu nebo slitiny. Z jedné andezitové slitiny jsou 4 lávky (&eAndesite Catwalk&r) nebo 8 zábradlí (&eAndesite Catwalk Railing&r)."
		""
		"Lávka je mřížka, po které se chodí. Zábradlí dáš na její okraj."
		"{@pagebreak}"
		"Stejně se dělají mřížky, pletivo, schody k lávkám a podpěry. Vlož slitinu do kameníku a prohlédni si všechny tvary."
		""
		"&aTip: Lávky z andezitu jsou nejlevnější. Pozdější kovy jako mosaz mají stejné tvary, jen jinou barvu.&r"
	]
	quest.440D8BDA2A73D1E1.title: "Kovové lávky"
	quest.44503078DF39A051.quest_desc: [
		"Nauč pilu recept na dveře. Pila umí recepty 3 × 3 ze dřeva."
		"Až bude stavitel chtít dveře, pila je sama vyrobí a kurýr je donese."
		"Vylepšená pila má víc míst na recepty."
	]
	quest.44503078DF39A051.quest_subtitle: "Začátečník"
	quest.44503078DF39A051.title: "Pila vyrábí dveře"
	quest.4462D33F7C0BE602.quest_desc: [
		"Netherový horník (&eNether Mine&r) chodí na výpravy do Netheru a nosí odtamtud suroviny. Je to nebezpečná práce."
		"Nejdřív výzkum &eMore Scrolls&r (věž zaklínače úrovně 3, 64 papíru, 1 mytická kniha, 64 lapisu), pak &eOpen the Nether&r (3 pozlacené černé kameny – &eGilded Blackstone&r)."
		"Blok budovy vyrobíš z prken, obsidiánu a nástroje stavby."
	]
	quest.4462D33F7C0BE602.quest_subtitle: "Expert"
	quest.4462D33F7C0BE602.title: "Netherový důl"
	quest.447F921BFB5DCF99.quest_desc: [
		"Řetězová kladka (&eChain Pulley&r) funguje jako lanová kladka (&eRope Pulley&r) z Create. Zvedá a spouští bloky, jen místo lana visí řetěz."
		""
		"Polož lanovou kladku a klikni na ni řetězem. Kladka se změní na řetězovou a řetěz ti zůstane v ruce."
		""
		"&aTip: Hodí se do dolů a na výtahy, kde lano nevypadá dobře.&r"
	]
	quest.447F921BFB5DCF99.title: "Řetězová kladka"
	quest.4482464A0C8654A2.quest_desc: [
		"&eChytrá šachta&r (&eSmart Chute&r) je šachta s filtrem. Na panelu nastavíš, kolik kusů naráz pustí."
		"Redstone signál ji zastaví."
	]
	quest.4482464A0C8654A2.title: "Chytrá šachta"
	quest.44907CA48B23D20B.quest_desc: [
		"Dubová židle (&eOak Chair&r) z &bHandcrafted&r je z prken, půlbloku a tyček. Klikni na ni pravým tlačítkem a sedneš si."
		"Stejně se vyrábí lavice, jídelní lavice, noční stolky a psací stoly ve všech druzích dřeva."
	]
	quest.44907CA48B23D20B.quest_subtitle: "Začátečník"
	quest.44907CA48B23D20B.title: "Židle"
	quest.44C1BBBCE0E6C548.quest_desc: [
		"Studený padák (&eCold Parachute&r) vyrobíš ze 4 studených mraků (&eCold Aercloud&r). Jsou to bílé mraky, které se vznášejí mezi ostrovy."
		"Padák se sám otevře, když spadneš z ostrova. Studený padák vydrží jen jedno použití. Zlatý padák (&eGolden Parachute&r) ze zlatých mraků vydrží 20 použití."
	]
	quest.44C1BBBCE0E6C548.title: "Padák"
	quest.4506AA6C0FC0B6CD.quest_desc: [
		"Včelař (&eApiary&r) se stará o včely a úly a sbírá med."
		"Blok budovy vyrobíš z prken, včelího úlu a nástroje stavby."
		"Úly mu přiřadíš nástrojem na úly (&eHive Tool&r), který dostaneš v jeho budově."
	]
	quest.4506AA6C0FC0B6CD.title: "Včelín"
	quest.45140F34F58E6FF4.quest_desc: [
		"Pružina (&eSpring&r) spojí dva bloky pružným spojem. Je to základ odpružení."
		"Montážním klíčem změníš tuhost. Kliknutím další pružinou ji prodloužíš, se Shiftem zkrátíš."
		"Výroba: 2 železné pláty a železný nuget dají 2 pružiny."
	]
	quest.45140F34F58E6FF4.title: "Pružina"
	quest.4516ADF3AF4CD354.quest_desc: [
		"Dosud jsi kopal a pěstoval. Teď tě čeká boj s bohem Anu."
		"Začíná to v Netheru: na lávovém moři pluje pekelná loď se sochou Anu (&eAnu Statue&r)."
		"&cKdyž sochu rozbiješ, nic z ní nepadne. Rituál proto udělej přímo na lodi.&r"
		"Do 4 rohů kolem sochy (šikmo) dej figurky. Na 4 strany (rovně vedle sochy) dej redstonový prach."
		"Socha vybuchne a objeví se totem, který otevře portál."
	]
	quest.4516ADF3AF4CD354.quest_subtitle: "Expert"
	quest.4516ADF3AF4CD354.title: "Pekelná loď"
	quest.451D168F6F571CC2.quest_desc: [
		"Teď už nemusíš soupravu vybírat ručně. Vytěžené suroviny z ní odebírej trychtýřem nebo mechanickou paží a pošli je pásem do trezoru."
		""
		"Chunk loader (&eAndesite Chunk Loader&r) vedle soupravy udrží chunk načtený, takže těží, i když jsi daleko."
		""
		"Vyplatí se diamantová žíla. Souprava z ní těží surový diamant (&eRaw Diamond&r), který mechanickou pilou rozřežeš na diamant. Smaragdová žíla funguje stejně."
	]
	quest.451D168F6F571CC2.quest_subtitle: "Pokročilý"
	quest.451D168F6F571CC2.title: "Těžba bez dozoru"
	quest.452F63D79355740A.quest_desc: [
		"Poštovní schránka (&ePostbox&r): objednáš si v ní věci ze skladiště a kurýr ti je přinese."
		"Skrýš (&eStash&r): co do ní vložíš, kurýr odnese do skladiště."
		"Obě vyrobíš z prken, truhel a nástroje stavby. Hodí se k tvému domu nebo dolu."
	]
	quest.452F63D79355740A.title: "Pošta a skrýš"
	quest.454174B9AF268664.quest_desc: [
		"Teď se za surovinami vydáš do jiných dimenzí, takže se připrav na boj."
		"&bMy Nether's Delight&r přidává jídla z Netheru: maso hoglinů a striderů, pálivé papriky a jídla z ghastů."
		"Hoglin v Netheru pustí místo kotlet hoglinskou svíčkovou (&eHoglin Loin&r). Když ho zabiješ nožem, může pustit i kůži (&eHoglin Hide&r)."
		"&aTip:&r Upeč svíčkovou v peci nebo na táboráku a máš silné jídlo pro boj v Netheru."
	]
	quest.454174B9AF268664.quest_subtitle: "Expert"
	quest.454174B9AF268664.title: "My Nether's Delight"
	quest.454A3962B1857594.quest_desc: [
		"Výškoměr (&eAltimeter&r) ukáže, v jaké jsi výšce (Y). Hodí se při hledání diamantů."
		"Vyrobíš ho z měděných ingotů a redstonu."
	]
	quest.454A3962B1857594.title: "Výškoměr"
	quest.45541DB3DDD8C072.quest_desc: [
		"Importní sběrnice (&eME Import Bus&r) bere věci z bloku, na který je položená, a ukládá je do sítě. Exportní (&eME Export Bus&r) posílá věci ze sítě do bloku."
		"V exportní sběrnici nastav, které věci má posílat. Příklad: exportní sběrnice nahoře na peci posílá rudu, importní dole bere hotové ingoty."
		"&aTip:&r Sběrnice jsou malé destičky na kabelu. Na jeden kabel jich jde dát víc, každou na jinou stranu."
	]
	quest.45541DB3DDD8C072.title: "Import a export"
	quest.45559542136D7874.quest_desc: [
		"Rozbitý starodávný meč (&eBroken Ancient Sword&r) vzácně padá z bloků fosilií a z analýzy relikvií."
		"Na archeologově stole ho oprav na starodávný meč (&eAncient Sword&r)."
		"&aStejně opravíš i rozbitou starodávnou helmu.&r"
	]
	quest.45559542136D7874.title: "Starodávný meč"
	quest.4556B7E175FE18FA.quest_desc: [
		"Stejně jako barvivo funguje i prachový sníh: větrák, který přes něj fouká, předměty mrazí."
		""
		"Led změní na zhuštěný led a ten na modrý led. Magmový krém změní na sliz a ohnivou tyč (&eBlaze Rod&r) na větrnou tyč (&eBreeze Rod&r)."
		""
		"Prachový sníh nabereš kbelíkem v zasněžených horách. Před větrák ho vylij z kbelíku."
	]
	quest.4556B7E175FE18FA.title: "Hromadné mrazení"
	quest.4573ACD5DB755CB5.quest_desc: [
		"Chemická věž (&eChemical Turret&r) je rozprašovač na podstavci. Potřebuje rotaci z ozubeného kolečka a kapalinu v nádržce."
		""
		"Když dostane redstonový signál, začne stříkat. Pravým kliknutím ji ovládáš sám, se Shiftem ovládání ukončíš."
		""
		"Věž může ovládat i tvor. Posaď ho na sedačku z Create (&eSeat&r) hned vedle věže. Do slotu filtru na věži dej filtr tvorů (&eEntity Filter&r). Tvor pak bude stříkat na ty, kteří filtru odpovídají."
		""
		"&aTip: Věž jde vylepšit zapalovačem, pak stříká oheň.&r"
	]
	quest.4573ACD5DB755CB5.title: "Chemická věž"
	quest.45A348495225D179.quest_desc: [
		"Teď stavíš celou obchodní halu. Cíl: získej 1000 smaragdů z jednoho obchodního stolku."
		""
		"Víc vesničanů vedle sebe, každý se svým stolkem. Jeden pás je zásobuje a druhý odváží zboží do skladu."
		""
		"&aDisplejový vysílač (&eDisplay Link&a) na stolku ukáže na ceduli počet hotových obchodů.&r"
	]
	quest.45A348495225D179.quest_subtitle: "Expert"
	quest.45A348495225D179.title: "Obchodní impérium"
	quest.45C845FA722A7D92.quest_desc: [
		"Mistrovská zkouška Farm \\& Charm: uvař každé jídlo z tohoto modu (polévky, pečeně, saláty, snídaně…)."
		"Když máš všechna jídla, dostaneš za úspěch &bFarm \\& Charm&r odměnu – strašáka (&eScarecrow&r). Ten zrychluje růst rostlin v okolí."
		"&aTip:&r Seznam všech jídel uvidíš v postupu (Advancements) u úspěchu &eFarm to Table&r."
	]
	quest.45C845FA722A7D92.quest_subtitle: "Expert"
	quest.45C845FA722A7D92.title: "Zlatý strašák"
	quest.45EAB78EF35AB0A5.quest_desc: [
		"Mořský had (&eSea Viper&r) se líhne z vajíčka na dně chladných a ledových oceánů."
		"Když vajíčko rozbiješ (bez Něžného doteku), had se vylíhne. &cPod vodou tebou hází.&r Vezmi si lektvar dýchání pod vodou."
	]
	quest.45EAB78EF35AB0A5.title: "Mořský had"
	quest.45EC9A722485424D.quest_desc: [
		"Měděný jetpack (&eCopper Jetpack&r) místo paliva potřebuje vodu. Vyrobíš ho na obyčejném pracovním stole."
		""
		"Plnicí nádrž (&eSmall Filling Tank&r) vyrobíš z nádrže z Create. Plní se pravým kliknutím na vodu a v inventáři sama doplňuje výbavu na vodu."
		""
		"&aOvládá se stejně jako andezitový jetpack. Nouzově ho doplníš kbelíkem vody: jetpack do druhé ruky a kbelík vyhoď.&r"
	]
	quest.45EC9A722485424D.title: "Měděný jetpack"
	quest.45EEA4B3F17F2BD3.quest_desc: [
		"Selenit roste v geodách v zasněžených a horských biomech."
		"Krystal selenitu (&eSelenite Crystal&r) zabrání líhnutí příšer ve svém malém okolí. Rozbitý krystal dá střepy (&eSelenite Shard&r), s Hedvábným dotekem celý krystal."
	]
	quest.45EEA4B3F17F2BD3.title: "Selenit"
	quest.45EEB80AF3ED8547.quest_desc: [
		"Teď už nemusíš do děla cpát několik pytlů prachu."
		""
		"Velká nábojnice (&eBig Cartridge&r) je rychlá nálož pro rychlopalný závěr. Do jednoho výstřelu se dává jen jedna."
		""
		"Ze 4 mosazných plátů uděláš na pracovním stole 4 plechy (&eBig Cartridge Sheet&r). Plech pak na pásu pod lisem 5× slisuješ (sekvenční montáž)."
		""
		"Nábojnici na stole naplň nitroprachem (&eNitropowder&r). Víc prachu dá silnější výstřel, nejvýš 4 dávky."
		"{@pagebreak}"
		"Nitroprach: v míchačce smíchej ohnivý prach (&eBlaze Powder&r), magmový krém (&eMagma Cream&r) a 2 střelné prachy. Vzniknou 2 kusy &eCongealed Nitro&r."
		""
		"Ten upeč v peci a výsledek umel mlýnským kamenem (&eMillstone&r). Z jednoho kusu jsou 2 nitroprachy."
	]
	quest.45EEB80AF3ED8547.title: "Velká nábojnice"
	quest.45F9F49682DB6170.quest_desc: [
		"S rytířským kovem začíná silná výbava. Vyrob si rytířskou zbroj (&eKnightmetal&r)."
		"Rytířský meč a krumpáč dávají větší poškození obrněným nepřátelům, sekera neobrněným."
	]
	quest.45F9F49682DB6170.quest_subtitle: "Pokročilý"
	quest.45F9F49682DB6170.title: "Rytířská zbroj"
	quest.46002A8289A541E1.quest_desc: [
		"Plamenný kovář (&eBlaze Forger&r) spojuje očarování jako kovadlina, ale cena za opravu se nezvyšuje."
		""
		"Vyrobíš ho na kovářském stole: ohňohořák + kovadlina + kovářská šablona plamene. Pohánějí ho tekuté zkušenosti."
		""
		"Na bočním panelu přepínáš režim: spojení dvou předmětů, nanesení šablony na předmět, nebo vytažení očarování do prázdné šablony."
	]
	quest.46002A8289A541E1.title: "Plamenný kovář"
	quest.460286ABD8798183.quest_desc: [
		"Atomová slitina (&eAtomic Alloy&r) je nejlepší slitina. Vznikne v infuzéru ze zesílené slitiny a rafinovaného obsidiánu."
		"Zdrojem infuze je rafinovaný obsidiánový prach nebo obohacený obsidián (&eEnriched Obsidian&r) z obohacovací komory."
		"&aTip:&r Atomová slitina je v teleportéru, robitovi, digitálním horníkovi a nejlepších obvodech."
	]
	quest.460286ABD8798183.title: "Atomová slitina"
	quest.4606BEBC612CCC40.quest_desc: [
		"&eLineární šasi&r (&eLinear Chassis&r) přilepí řadu bloků před sebou. Klikni slizovou koulí na jeho stěnu, tím ji uděláš lepivou. Klíčem nastavíš dosah."
		"Stejná šasi vedle sebe se táhnou spolu. &eRadiální šasi&r (&eRadial Chassis&r) lepí bloky do kruhu kolem sebe, dobré na velké mlýny."
	]
	quest.4606BEBC612CCC40.title: "Šasi"
	quest.46104BD3123B3DDD.quest_desc: [
		"Ocas (&eRaccoon Tail&r) padá z mývala (&eRaccoon&r). Mýval žije v lesích, na nížinách a v tajze."
		"&aTip:&r Mývala ochočíš vajíčkem, když je blízko vody. Nejdřív si ho opere."
	]
	quest.46104BD3123B3DDD.title: "Mývalí ocas"
	quest.4617021EB2E7E678.quest_desc: [
		"Potrubí s čerpadlem vysaje med přímo z úlu nebo včelího hnízda. Med je v Create tekutina."
		"Dávkovač s ním plní lahve a dělá medová jablka. Lis v tyglíku z něj udělá blok medu."
	]
	quest.4617021EB2E7E678.title: "Med z úlu"
	quest.46175C44D790187C.quest_desc: [
		"Každý boss Soumračného lesa ti dá surovinu na lepší výbavu. Tady najdeš, co z ní vyrobit."
		"Druhá polovina kapitoly jsou kouzelné stromy. Mají jádro, které pracuje za tebe."
	]
	quest.46175C44D790187C.title: "Výbava ze soumraku"
	quest.4618B1C536A3F3CF.quest_desc: [
		"Tekutou čokoládu namícháš v míchačce s ohřevem (pod tyglíkem zapálený ohňohořák): cukr, kakaové boby a mléko."
		"Lis nad tyglíkem s čokoládou z ní vylisuje tabulky (&eBar of Chocolate&r)."
	]
	quest.4618B1C536A3F3CF.title: "Čokoláda"
	quest.462515D91709E86F.quest_desc: [
		"Thorium (&eThorium&r) je surovina na jaderné palivo."
		""
		"Thoriová ruda je v normálním světě ve výšce zhruba od 20 do 120. Padá z ní thorium."
		""
		"&aThorium umíš rozmnožit: v míchačce smíchej thorium, kámen, blok jílu a 1 000 mB vody. Vzniknou 2 kusy thoria.&r"
	]
	quest.462515D91709E86F.title: "Thorium"
	quest.462EE793244F6FE1.quest_desc: [
		"Příšery se objevují jen ve tmě. Pochodně kolem domu je udrží dál."
		"Pochodeň vyrobíš z uhlí a klacku. Uhlí najdeš jako černé tečky v kameni."
		"&aTip:&r Když nemáš uhlí, upeč v peci dřevo. Vznikne dřevěné uhlí, které funguje stejně."
	]
	quest.462EE793244F6FE1.title: "Světlo"
	quest.463007E46BAE9555.quest_desc: [
		"Mosazný jetpack (&eBrass Jetpack&r) z &bCreate Stuff 'N Additions&r létá ve vzduchu i rychle plave pod vodou."
		""
		"Skládá se v mechanickém výrobníku z parního motorku, větráků, ozubených koleček, mosazi a andezitové slitiny. Potřebuje vodu i palivo, z nich dělá páru."
		""
		"&aVíc najdeš v kapitole Pohyb a výbava.&r"
	]
	quest.463007E46BAE9555.quest_subtitle: "Létej na páru"
	quest.463007E46BAE9555.title: "Mosazný jetpack"
	quest.46336BBDBA6CF6B7.quest_desc: [
		"Pučící certus (&eBudding Certus Quartz&r) je blok, na kterém rostou krystaly certusu – podobně jako ametyst."
		"Bez Něžného doteku se při vykopání zhorší o jednu úroveň. Bezvadný (&eFlawless Budding Certus Quartz&r) se zhorší vždy, i s Něžným dotekem. Proto ho nech na místě."
		"&aTip:&r Nový pučící blok vyrobíš tak, že hodíš do vody certusový blok (&eCertus Quartz Block&r) a nabitý certus. Vznikne &eDamaged Budding Certus Quartz&r."
	]
	quest.46336BBDBA6CF6B7.title: "Pučící certus"
	quest.4635DA963EE98D46.quest_desc: [
		"Kombinátor (&eCombiner&r) spojí 3 přísady v jeden předmět. Recept: nebeská prkna, svaté kameny, 3 jadeity a ambrosium."
		"Základ každého receptu je zlatý jantar (&eGolden Amber&r) a zmražené zlatolisté bobule. Třetí přísada určuje výsledek."
		"Zlatý jantar padá ze dřeva zlatých dubů, když ho kácíš zanitovou sekerou."
		"Vyrobíš v něm třeba krmivo pro moa (&eMoa Fodder&r), které jim dá extra skoky nebo ohnivzdornost."
	]
	quest.4635DA963EE98D46.title: "Kombinátor"
	quest.46485DCF7D8233E3.quest_desc: [
		"Čistá temnota (&ePure Darkness&r) padá jen z Forsakena."
		"Z ní, temných cárů (&eDark Tatters&r) a můřího prachu vyrobíš stínové hedvábí (&eShadow Silk&r)."
		"Hedvábí je surovina na nejlepší výbavu dutin."
	]
	quest.46485DCF7D8233E3.title: "Čistá temnota"
	quest.465B3BBDB3340722.quest_desc: [
		"&bNaturalist&r přidává jeleny, medvědy, šneky, motýly, lvy a další zvířata."
		"Síť (&eCapture Net&r) vyrobíš z bambusu a vláken. Klikni s ní pravým tlačítkem na malé zvíře a chytíš ho jako předmět."
		"Chytíš motýla, housenku, mravence, kraba, šneka, krysu, ježka nebo štíra."
	]
	quest.465B3BBDB3340722.title: "Síť na zvířátka"
	quest.465FB280FFC06AFB.quest_desc: [
		"Balicí páska (&ePacking Tape&r) ti dovolí přenést plnou truhlu i s obsahem."
		"Klikni páskou pravým tlačítkem na truhlu nebo sud a pak ho vykopej. Obsah zůstane uvnitř. Páska vydrží jen několik použití."
		"&aTip:&r Díky doplňku pro Create fungují sofistikované truhly a sudy i na pohyblivých strojích z Create (vlaky, vozíky) jako jejich úložiště."
	]
	quest.465FB280FFC06AFB.title: "Stěhování truhly"
	quest.46978C4A76BBF757.quest_desc: [
		"Mechanik (&eMechanic's Hut&r) vyrábí věci z redstonu a to, co ostatní řemeslníci neumí."
		"Výzkum &eWhat ya Need?&r stojí 64 redstonového prachu a kováři musí mít dohromady úroveň 3. Blok budovy: prkna, redstonový blok a nástroj stavby."
		"S mechanikem kolonie vyrobí skoro všechno, co stavby potřebují."
	]
	quest.46978C4A76BBF757.quest_subtitle: "Pokročilý"
	quest.46978C4A76BBF757.title: "Mechanik"
	quest.469E408A753994E2.quest_desc: [
		"Šaman (&eWitch Doctor&r) se objevuje v noci v džungli."
		"&cDvakrát se zneviditelní a nechá za sebou příšery.&r Může z něj padnout &eJungle Pendant&r."
	]
	quest.469E408A753994E2.title: "Šaman z džungle"
	quest.46CBD1B3412E4B74.quest_desc: [
		"Semínka manioku (&eCassava Seeds&r) padají z trávy. Zasaď je a sklízej kořeny (&eCassava Root&r)."
		"Kořeny rozemel na tapiokovou mouku. Lis ze 4 mouk udělá syrové perly a míchačka s ohřevem je uvaří v rozpuštěném cukru (&eBoba&r)."
		"Rozpuštěný cukr získáš, když v míchačce s ohřevem roztavíš cukr."
	]
	quest.46CBD1B3412E4B74.title: "Tapiokové perly"
	quest.46DEA49E467B6702.quest_desc: [
		"Rybářská krabička (&eTackle Box&r) je úložiště i dílna na prut."
		"Polož ji, otevři a vlož do ní prut. Pak mu přidáš háček, návnadu, vlasec a splávek."
	]
	quest.46DEA49E467B6702.title: "Rybářská krabička"
	quest.46E381B395443D38.quest_desc: [
		"Vtrhni do zakázaného hradu a zabij v něm úplně všechny pigliny."
		"Tohle je jedna z nejtěžších výzev v Netheru. Jdi tam s netheritovou výbavou."
	]
	quest.46E381B395443D38.title: "Dobyvatel"
	quest.46E775EB783DBBB6.quest_desc: [
		"Generátor mění otáčení na elektřinu. Generátorové cívky (&eGenerator Coil&r) dej do řady jako hřídel a roztoč je. Kolem cívek postav magnety a na konec řady dej uhlíkové kartáče (&eCarbon Brushes&r)."
		""
		"&aPřesné rozestavění magnetů ukazuje ponder: podrž klávesu W nad cívkou.&r"
		"{@pagebreak}"
		"Kartáče sbírají elektřinu z cívek a posílají ji do sousedních bloků. Na kartáče dej elektrický konektor (&eElectrical Connector&r) a druhý konektor dej na stroj."
		""
		"Měděný drát z New Age (&eCopper Wire&r) nařežeš mechanickou pilou z měděného plátu. Klikni drátem na oba konektory. Každé spojení spotřebuje 1 drát a smí být dlouhé až 16 bloků."
		""
		"&cCívky nic dalšího neroztočí, jen spotřebovávají SU. Dej jim silný zdroj otáčení.&r"
	]
	quest.46E775EB783DBBB6.quest_subtitle: "Začátečník"
	quest.46E775EB783DBBB6.title: "Postav generátor"
	quest.46EC030FC3E01B68.quest_desc: [
		"Každá budova má vlastní nápovědu. Klikni pravým tlačítkem na stavitelovu budovu – otevře se průvodce. Přečti si ho a potvrď."
		"Nápovědu najdeš v okně každé budovy. Stojí za to ji projít u každé nové budovy."
	]
	quest.46EC030FC3E01B68.title: "Nápověda v budově"
	quest.4719FE669758E907.quest_desc: [
		"Gumový červ je obr dlouhý desítky bloků. Je neutrální, dokud ho nenaštveš."
		"Přivoláš ho blokem &eGobthumper&r (želatina, hromádky žvýkaček a nabroušená cukrová hůl)."
		"&aDvěma háky se do něj můžeš zaseknout a jezdit na něm.&r"
		"Po smrti z něj může padnout sladký zub (&eSweet Tooth&r)."
	]
	quest.4719FE669758E907.quest_subtitle: "Expert"
	quest.4719FE669758E907.title: "Gumový červ"
	quest.47286DF80C0049D3.quest_desc: [
		"Pánev s ohněm (&eBrazier&r) je ze železných mříží a uhlí. Lustr (&eChandelier&r) ze 4 pochodní."
		"Skvěle se hodí do hradů a středověkých kolonií."
	]
	quest.47286DF80C0049D3.title: "Oheň a světlo"
	quest.472E8D27CCEB7042.quest_desc: [
		"Drak je poražený, ale End teprve začíná. Daleko od hlavního ostrova leží vnější ostrovy s městy, poklady a novými biomy."
		"Tady je rozšiřují mody &bNullscape&r, &bUnusual End&r, &bEnderman Overhaul&r, &bMoog's End Structures&r a &bMedieval Buildings End Edition&r."
		"&cPod ostrovy je prázdnota. Kdo do ní spadne, zemře a přijde o věci.&r Vždy měj u sebe bloky."
	]
	quest.472E8D27CCEB7042.title: "Za drakem"
	quest.473A7506F0A0E12E.quest_desc: [
		"Elektronický gyroskop (&eElectronic Gyroscope&r) umí totéž co gyroskop a přidá elektronickou palubní desku."
		"Výroba: gyroskop, redstonová lampa, zlato, skleněná tabule, nótový blok a páka."
	]
	quest.473A7506F0A0E12E.title: "Elektronický gyroskop"
	quest.4746328202AEA1D0.quest_desc: [
		"Krmivo pro slepice (&eChicken Feed&r) složíš na krájecím prkénku bez nástroje: pšenice, mrkev a semínka."
		"Slepice po něm snášejí víc vajec a ztrácejí víc peří. Podobně funguje krmivo pro koně (&eHorse Fodder&r) – kůň je pak rychlejší a skáče výš."
	]
	quest.4746328202AEA1D0.title: "Krmivo"
	quest.47800B02FD8B3D86.quest_desc: [
		"Prášek proměny (&eTransformation Powder&r) promění jednoho tvora na jiného. JEI ukáže, koho na koho."
		"Vaří se ve varném hrnci (&eCooking Pot&r): pekelná bradavice, kvašené pavoučí oko, ryba čtverzubec, jedovatá brambora, shnilé rajče a esence vrtáků (&eBorer Essence&r). Jako nádobu potřebuješ plátno (&eCanvas&r)."
		"Esence vrtáků padá z vrtáků (&eTowerwood Borer&r) v temné věži."
	]
	quest.47800B02FD8B3D86.title: "Prášek proměny"
	quest.47B5B34402D39D86.quest_desc: [
		"Ropa tryská z ropných pramenů nad hladinou oceánu. Naber ji kbelíkem (&eOil Bucket&r)."
		"&cRopa se neobnovuje. Nasbírej jí víc, na jeden let tam a zpět potřebuješ asi 6 kbelíků.&r"
		"&aDo rafinerie jde i ropa z modu Create Diesel Generators (&eCrude Oil Bucket&r).&r"
	]
	quest.47B5B34402D39D86.title: "Ropa"
	quest.47C13B6093DFBC98.quest_desc: [
		"Luk vyrobíš z klacků a provázku. Provázek padá z pavouků."
		"Šípy jsou z pazourku, klacku a pírka."
		"&aTip:&r Toulec ze &bSupplementaries&r unese hodně šípů (kapitola &eUžitečné mody&r)."
	]
	quest.47C13B6093DFBC98.title: "Luk a šípy"
	quest.47C600C1FC886AF5.quest_desc: [
		"Flamarang (&eFlamarang&r) je netheritová verze pickarangu. Věci, které sebere, neshoří v lávě ani v ohni."
		"Vylepšíš ho na kovářském stole: šablona netheritového vylepšení + pickarang + netheritový ingot."
	]
	quest.47C600C1FC886AF5.quest_subtitle: "Expert"
	quest.47C600C1FC886AF5.title: "Flamarang"
	quest.47D3F3A0AB4C8C45.quest_desc: [
		"&eSchéma s brkem&r (&eSchematic And Quill&r): prázdné schéma (papír + světle modré barvivo) a pírko."
		"Pravým klikem vyber 2 rohy stavby. Ctrl + kolečko myši posune stěnu výběru. Dalším pravým klikem stavbu ulož do souboru na svém počítači."
		"Teď už nemusíš stavět blok po bloku – stavbu jednou uložíš a pak ji postavíš znovu kdekoli."
	]
	quest.47D3F3A0AB4C8C45.quest_subtitle: "Pokročilý"
	quest.47D3F3A0AB4C8C45.title: "Uložení stavby"
	quest.47E126AFA6E34334.quest_desc: [
		"Logistický transportér (&eBasic Logistical Transporter&r) je trubka na předměty. Vyrobíš ho z oceli a základního obvodu."
		"Normálně sám z truhel nic nebere. Předměty do něj posílá stroj se zapnutým automatickým výstupem (&eAuto-eject&r) nebo logistický třídič."
		"Konfigurátorem ale můžeš napojení transportéru na truhlu přepnout na sání (&ePull&r). Pak si věci z truhly bere sám."
		"&aTip:&r Omezující transportér (&eRestrictive Transporter&r) se použije, jen když jiná cesta není. Odbočovací (&eDiversion Transporter&r) jde zapínat redstonem."
	]
	quest.47E126AFA6E34334.title: "Logistický transportér"
	quest.47E1821CABF3BCBD.quest_desc: [
		"Z každého prastrážce padne oko (&eElder Eye&r)."
		"Je to senzor: když před ním stojí živý tvor, vydá redstone signál. Hodí se na pasti a automatické dveře."
	]
	quest.47E1821CABF3BCBD.title: "Oko prastrážce"
	quest.47E272DB2DB104B0.quest_desc: [
		"&eMechanická paže&r (&eMechanical Arm&r) přenáší předměty mezi místy ve svém dosahu."
		"Před položením paži drž a klikej pravým na cíle: modrý = odkud bere, žlutý = kam dává. Levým klikem výběr zrušíš. Pak paži polož."
		"Umí desky, pásy, trychtýře, ohňohořáky, truhly a další. Mosazný trychtýř jako cíl jí předá svůj filtr."
	]
	quest.47E272DB2DB104B0.title: "Mechanická paže"
	quest.47E3930E8AAFC48F.quest_desc: [
		"Yetiové a zimní vlci pouštějí arktickou srst (&eArctic Fur&r). Z ní vyrobíš arktickou zbroj."
		"Arktickou zbroj můžeš obarvit jako koženou."
	]
	quest.47E3930E8AAFC48F.title: "Arktická zbroj"
	quest.4802CD65474C31EB.quest_desc: [
		"Tiskárna (&ePrinter&r) kopíruje knihy a další věci."
		""
		"Vyrobíš ji z mosazného plátu, dávkovače (&eSpout&r) a železného bloku."
		""
		"Do filtru vlož předlohu a přiveď správnou kapalinu. Umí kopírovat popsané i očarované knihy, pojmenovat předměty nebo změnit adresu balíčku. Co přesně potřebuje, ukáže JEI."
		""
		"Víc najdeš v kapitole Průmysl."
	]
	quest.4802CD65474C31EB.title: "Tiskárna"
	quest.4807602DC7CA8B18.quest_desc: [
		"Zkamenělé semínko (třeba &eFossilized Fern Spores&r) dej do kultivátoru. Vznikne živé semínko."
		"Zasaď ho a vyroste pravěká rostlina. &aBýložraví dinosauři je rádi jedí.&r"
	]
	quest.4807602DC7CA8B18.title: "Pravěké rostliny"
	quest.48147E89FBC5B0C1.quest_desc: [
		"Navštiv &ePopelový les&r (&eAsh Forest&r) v Netheru. Žijí tu duchové."
		"Z duchů padá &eGhostly Essence&r. Je potřeba na lucerny duchů a další věci z Luminous Nether."
	]
	quest.48147E89FBC5B0C1.title: "Popelový les"
	quest.4819359D6799A9FF.quest_desc: [
		"Teď už ani ocel nestačí – vydrží 8 náloží. Nethersteel (&eNethersteel Ingot&r) vydrží 10 a potřebuje jen 1 nálož na 3 kusy hlavně. Do děla z něj dáš nejvíc náloží."
		""
		"V míchačce smíchej netheritový šrot (&eNetherite Scrap&r) a 8 litinových ingotů (nebo 4 ocelové). Ohňohořák musí být přehřátý – nakrm ho ohňodortem (&eBlaze Cake&r). Vznikne 8 ingotů."
		""
		"Díly se dělají stejně jako ocelové: roztavit, odlít vrstvy, vyvrtat, složit stavěčem a zahřát."
		""
		"Šroubový závěr z nethersteelu dokončíš zámkem &eNethersteel Screw Lock&r. &cNethersteel nejde svařovat, dělo musí vzniknout vcelku.&r"
	]
	quest.4819359D6799A9FF.title: "Nethersteelové dělo"
	quest.482DBDD335577C37.quest_desc: [
		"Mlýnek (&eMincer&r) mele maso, obilí i kosti. Vlož do něj surovinu a pravým tlačítkem toč klikou."
		"Pekáč (&eRoaster&r) peče maso a hotová jídla. Stejně jako hrnec musí stát na zdroji tepla."
		"&aTip:&r Mlýnek umí z kosti kostní moučku a ze shnilého masa hnojivo."
	]
	quest.482DBDD335577C37.title: "Mlýnek a pekáč"
	quest.4845569A4A02253A.quest_desc: [
		"Navštiv všechny čtyři dungeony z &bYUNG's Better Dungeons&r: sklep s líhní, pevnost nemrtvých, katakomby a pavoučí jeskyni."
		"Quest se splní sám, až vstoupíš do posledního z nich."
	]
	quest.4845569A4A02253A.title: "Mistr dungeonů"
	quest.484B96A7113A6D92.quest_desc: [
		"&bDecorative Blocks Reborn&r: trámy, podpěry, palisády, sedátka, lustry a pánve s ohněm."
		"Trám (&eOak Beam&r) vyrobíš z oloupaných kmenů, podpěru (&eOak Support&r) z prken."
		"Sekerou klikni na podpěru – změníš velikost strany. Shift + sekera stranu skryje."
	]
	quest.484B96A7113A6D92.title: "Trámy a podpěry"
	quest.484F9DC43F36C6B5.quest_desc: [
		"Dřevěná věž, kde žijí nájezdníci s kušemi. &bTowns and Towers&r jim dává různý vzhled podle biomu."
		"&cPozor:&r kapitán s praporem upustí &eZlověstnou lahvičku&r. Když ji vypiješ, při příchodu do vesnice spustíš nájezd."
	]
	quest.484F9DC43F36C6B5.title: "Hlídka nájezdníků"
	quest.4850E516496B9E7D.quest_desc: [
		"Mosazná výhybka (&eBrass Track Switch&r) umí totéž co andezitová. Navíc ji přepneš přímo z vlaku, který k ní přijíždí. Na jejím panelu nastavíš, jestli ji smí přepínat i vlaky s jízdním řádem."
		"Výroba: páka, mosazné pouzdro a precizní strojek."
	]
	quest.4850E516496B9E7D.title: "Mosazná výhybka"
	quest.4855ACF6AE8409E9.quest_desc: [
		"Modifikační stanice (&eModification Station&r) instaluje moduly do MekaSuitu a Meka-Toolu."
		"Vlož do stanice díl brnění nebo nástroj a pak do něj přidej modul. Základem každého modulu je &eModule Base&r z HDPE, cínu a bronzu."
		"&aTip:&r Každý modul má v okně vlastní nastavení – třeba ho vypnout nebo změnit jeho sílu."
	]
	quest.4855ACF6AE8409E9.title: "Modifikační stanice"
	quest.485FCA5D78B8FBA1.quest_desc: [
		"Endermani z ostrovů Endu mohou upustit prastarou perlu (&eAncient Pearl&r)."
		"Když ji hodíš, vyvolá přátelského endermana, který za tebe bojuje. Shift + pravé tlačítko na něj ti perlu vrátí."
		"Jiné druhy endermanů v Overworldu a Netheru pouštějí jiné perly. Přečti si jejich popis v JEI."
	]
	quest.485FCA5D78B8FBA1.title: "Prastará perla"
	quest.4863A45E290585CA.quest_desc: [
		"Vylepšení truhly promění truhlu na vyšší úroveň i s obsahem – nemusíš nic přendávat. Vylepšení &eIron to Gold Chest Upgrade&r udělá ze železné truhly zlatou."
		"Drž ho v ruce a klikni na truhlu Shift + pravým tlačítkem."
		"&aTip:&r Obyčejnou truhlu z Minecraftu vylepšíš na železnou pomocí &eWood to Iron Chest Upgrade&r."
	]
	quest.4863A45E290585CA.title: "Vylepšení truhly"
	quest.48672E100491633D.quest_desc: [
		"V ohnivých truhlách může být jádro brokovnice (&eShotgun Core&r). Z něj vyrobíš brokovnicovou pěst (&eShotgun-Fist&r)."
		"Recept: jádro brokovnice, 2 netheritové ingoty a lebka kostlivce. Náboje (&eShotgun Shell&r) vyrobíš z &eWraithing Flesh&r, uhlí a železného nugetu."
	]
	quest.48672E100491633D.title: "Brokovnicová pěst"
	quest.488B4B1BAA890626.quest_desc: [
		"Krovky (elytra) najdeš na lodích u měst v Endu."
		"Díky modu &bElytra Slot&r je můžeš dát do slotu na záda. Na hrudi pak dál nosíš brnění. Sloty otevřeš tlačítkem u postavičky v inventáři."
		"Do slotu na záda patří i batoh, takže si možná budeš muset vybrat."
	]
	quest.488B4B1BAA890626.title: "Křídla a slot"
	quest.488EB63A63562DE9.quest_desc: [
		"Nejlepší háček (&eNether Star Hook&r): šetří prut jako diamantový a přidává štěstí."
		"Vyrobíš ho z diamantového háčku a netherové hvězdy (padá z Withera)."
	]
	quest.488EB63A63562DE9.title: "Hvězdný háček"
	quest.4892CE8C26538039.quest_desc: [
		"Štít drž v druhé ruce (klávesa &eF&r ho přesune). Pravým tlačítkem kryješ útoky a šípy."
		"Vyrobíš ho z 6 prken a 1 železného ingotu."
	]
	quest.4892CE8C26538039.title: "Štít"
	quest.48AFF40DFF70B0F2.quest_desc: [
		"&bEnder's Delight&r je další doplněk s jídly z Endu. Jeho sporák (&eEndstone Stove&r) vyrobíš z obsidiánu, cihel z endového kamene, dračího dechu a táboráku."
		"Endermani zabití nožem pustí oko (&eEnderman Sight&r), shulkeři měkkýše (&eShulker Mollusk&r) a endermiti kůrku (&eMite Crust&r)."
	]
	quest.48AFF40DFF70B0F2.title: "Ender's Delight"
	quest.48B397312820D2C1.quest_desc: [
		"Diamantový krumpáč je rychlý a vydrží dlouho. Vykope i obsidián, na který železný nestačí."
		"Vyrobíš ho ze 3 diamantů a 2 klacků."
	]
	quest.48B397312820D2C1.title: "Diamantový krumpáč"
	quest.48BBC37B15115268.quest_desc: [
		"Do lisu nalij mléko a přidej syřidlo (obojí pravým tlačítkem). Pak prázdnou rukou toč klikou dolů a nahoru."
		"Hotové kolo sýra (&eCheese Wheel&r) vezmi prázdnou rukou. Na pracovním stole ho rozkrojíš na 4 plátky."
		"&aTip:&r Mléko ovcí, koz, vodních buvolů a další dá jiné druhy sýra."
	]
	quest.48BBC37B15115268.title: "Kolo sýra"
	quest.48FC91FCF0CD27B8.quest_desc: [
		"Drť pošli větrákem přes vodu. Z každé drti je 9 nugetů a k tomu bonus:"
		"železo → redstone (75 %), měď → hrouda jílu (50 %), zlato → křemen (50 %), zinek → střelný prach (25 %)."
		"Praní se vyplatí víc než tavení: kovu je stejně, ale bonus máš navíc. Nugety slisuje lis v tyglíku zpátky na ingoty."
	]
	quest.48FC91FCF0CD27B8.title: "Praní drti"
	quest.49103EBCD927E6CE.quest_desc: [
		"Lodní dělo (&eShip Cannon&r) namontuješ v loděnici na levobok (&ePort&r) nebo pravobok (&eStarboard&r). Každá pozice stojí 1 dělo."
		"Dělové koule (&eCannon Ball&r) dej do inventáře lodi. Míření a střelbu ti ukáže nápověda na obrazovce."
		"&cS více děly je většina lodí pomalejší. Galeona ne.&r"
	]
	quest.49103EBCD927E6CE.title: "Lodní děla"
	quest.491802A4420DB4B8.quest_desc: [
		"Vinný sklep (&eWine Cellar&r) vyrobíš z prken, dřevěné desky a železných ingotů (nebo andezitové slitiny)."
		"Vlož do něj drť a nech ji zrát. Z drti se stane víno."
	]
	quest.491802A4420DB4B8.title: "Vinný sklep"
	quest.491DAB225953700A.quest_desc: [
		"Monarcha je oranžový motýl. Létá v lesích a květinových lesích."
		"Chyť ho síťkou a dej do sklenice. Plnou sklenici vezmeš do inventáře takto: Shift + pravé tlačítko prázdnou rukou (&eMonarch Jar&r)."
		"&aTip:&r Druhů motýlů je přes 20 a každý žije jinde – některé i v Netheru a v Endu."
	]
	quest.491DAB225953700A.title: "Monarcha ve sklenici"
	quest.493AC440C6065CDB.quest_desc: [
		"Kelímek (&eIced Coffee Cup&r) vyrobíš ze skla a desky z leštěného vápence."
		"Pokladač do něj vloží led, dávkovač dolije kávu – a ledová káva (&eIced Coffee&r) je hotová."
	]
	quest.493AC440C6065CDB.title: "Ledová káva"
	quest.49421439F3BC2FC4.quest_desc: [
		"Letecké brýle (&eAviator's Goggles&r) fungují stejně jako inženýrské brýle, jen vypadají jako pro pilota."
		"Výroba: inženýrské brýle a kůže."
		"&aS brýlemi uvidíš tah vrtulí, údaje o balónu a výšku i tlak vzduchu na výškoměru.&r"
	]
	quest.49421439F3BC2FC4.title: "Letecké brýle"
	quest.495601C96EF1C2A2.quest_desc: [
		"V bojové akademii (&eCombat Academy&r) se občan cvičí na rytíře bez rizika, že zemře."
		"Výzkum &eImproved Swords&r stojí 6 bloků železa a kasárny musí mít úroveň 3. Blok budovy: prkna, 3 železné meče a nástroj stavby."
	]
	quest.495601C96EF1C2A2.title: "Bojová akademie"
	quest.495982B165E6A824.quest_desc: [
		"Rostlina &ePickerelweed&r roste u řek, v bažinách a v džungli."
		"Upeč ji v peci nebo udírně a sněz &eBoiled Pickerelweed&r. Pod vodou ti vrátí bublinky vzduchu."
	]
	quest.495982B165E6A824.title: "Vzduch z rostliny"
	quest.4965FE56BDA54CAC.quest_desc: [
		"&bEnd's Delight&r přidává jídla z Endu: z chorusu, shulkerů a dokonce z draka."
		"Sporák z Endu (&eEnd Stove&r) vyrobíš z praženého chorusu, cihel z endového kamene a táboráku. Hřeje hrnec jako běžný sporák."
	]
	quest.4965FE56BDA54CAC.title: "End's Delight"
	quest.4978B86F57E43FCE.quest_desc: [
		"&eMlýnský kámen&r (&eMillstone&r) mele: štěrk na pazourek, pšenici na mouku, květiny na barviva, dlažební kámen na štěrk."
		"Roztoč ho ozubeným kolečkem ze strany. Předměty hoď nebo vlož shora, hotové vyber pravým tlačítkem nebo trychtýřem."
		"&cRudy mlýnský kámen nezpracuje,&r na ně potřebuješ drtící kola. Čím rychleji se točí, tím rychleji mele."
	]
	quest.4978B86F57E43FCE.title: "Mlýnský kámen"
	quest.498DAF25A40C961B.quest_desc: [
		"Netheritovou výbavu nevyrobíš přímo. Diamantovou věc vylepšíš na kovářském stole (&eSmithing Table&r)."
		"Do stolu dej šablonu, diamantový krumpáč a netheritový ingot. Očarování zůstanou."
		"Netheritové věci nehoří v lávě a vydrží víc než diamantové."
	]
	quest.498DAF25A40C961B.title: "Netheritová výbava"
	quest.49B18C523BD3A2C0.quest_desc: [
		"Mod &bCreate Stuff \\& Additions&r přidává brnění z mosazi. Kyrys (&eBrass Chestplate&r) vyrobíš z 8 mosazných ingotů."
		"Mosaz se vyrábí v míchačce z modu Create (viz kapitoly Create)."
	]
	quest.49B18C523BD3A2C0.title: "Mosazné brnění"
	quest.49BB7696CBA13B56.quest_desc: [
		"Křepelky (&eQuail&r) jsou zdejší slepice. Dávají syrové maso (&eRaw Quail&r) a snáší vejce."
		"Ve vodě plavou zářící ryby (&eAerglow Fish&r)."
	]
	quest.49BB7696CBA13B56.title: "Křepelka"
	quest.49F84C7BFF6888A2.quest_desc: [
		"Logistický třídič (&eLogistical Sorter&r) vytahuje předměty z inventáře za sebou a posílá je dál do transportéru nebo truhly."
		"Ve filtrech nastavíš, které předměty má posílat a kam. Nefiltrované věci může posílat také (volba &eEject unfiltered&r)."
		"&aTip:&r Třídič + transportéry = automatické třídění surovin do správných strojů a truhel."
	]
	quest.49F84C7BFF6888A2.title: "Logistický třídič"
	quest.49FF3701AA8DC514.quest_desc: [
		"&eZatížený katapult&r (&eWeighted Ejector&r): zlatý plát, odkládací deska a ozubené kolečko. Hází předměty i hráče na vybrané místo."
		"Drž ho a Shift + pravým klikem vyber cíl, pak ho polož. Cíl může být výš i níž, ale ne do strany. Potřebuje rotaci."
		"Na panelu nastavíš, kolik kusů má čekat, než hodí."
	]
	quest.49FF3701AA8DC514.title: "Zatížený katapult"
	quest.4A1360FE72C33E54.quest_desc: [
		"Řetězová střela (&eChained Shot&r) má o 25 % menší dostřel i poškození, ale silně ničí plachty."
		"Výroba: 4 dělové koule a řetěz dají 2 kusy."
	]
	quest.4A1360FE72C33E54.title: "Řetězová střela"
	quest.4A3194400EFD62C0.quest_desc: [
		"Hák (&eCandy Cane Hook&r) vystřelíš a přitáhne tě k místu, kam se zasekne. Můžeš držet dva najednou."
		"Vyrobíš ho z nabroušené cukrové hole (&eSharpened Candy Cane&r, padá z Caniaca), lékořicových šlahounů (&eLicoroot Vine&r) a tyče z cukrových holí (&eCandy Cane Pole&r)."
	]
	quest.4A3194400EFD62C0.title: "Hák z cukrové hole"
	quest.4A37766BD9857227.quest_desc: [
		"Největší mořská příšera Upgrade Aquatic. Objevuje se jen v hlubokém ledovém oceánu místo obyčejné mlátičky."
		"Padají z ní zuby a někdy &eÚlomek desky&r (&eDisc Fragment&r). Z 9 úlomků složíš gramofonovou desku."
	]
	quest.4A37766BD9857227.quest_subtitle: "Expert"
	quest.4A37766BD9857227.title: "Velká mlátička"
	quest.4A3E2EE591D81152.quest_desc: [
		"Sklář (&eGlassblower's Hut&r) taví písek na sklo a vyrábí tabulky a další skleněné věci."
		"Výzkum &eThose Lungs!&r stojí 64 skla a tavírny musí mít dohromady úroveň 3. Blok budovy: prkna, sklo a nástroj stavby."
	]
	quest.4A3E2EE591D81152.title: "Sklářství"
	quest.4A504BF943A028BA.quest_desc: [
		"Železný nůž (&eIron Knife&r) vydrží déle. Vyrobíš ho stejně jako pazourkový, jen místo pazourku dáš železný ingot."
		"Diamantový nůž (&eDiamond Knife&r) půjde později vylepšit na netheritový."
	]
	quest.4A504BF943A028BA.title: "Lepší nůž"
	quest.4A53C5CAF373F457.quest_desc: ["Šíp s pochodní (&eTorch Arrow&r) postaví pochodeň tam, kam dopadne. Rychle tak osvětlíš velkou jeskyni."]
	quest.4A53C5CAF373F457.title: "Šíp s pochodní"
	quest.4A56D9ED6D1884C6.quest_desc: [
		"Hluboká propast v ledu se zasněženými stěnami a modrým ledem."
		"Žijí tu králíci a vzácně lední medvědi. V noci sem chodí tuláci – kostlivci, jejichž šípy tě zpomalí."
		"&aTip:&r Modrý led je nejkluzčí blok ve hře – hodí se na rychlé ledové cesty."
	]
	quest.4A56D9ED6D1884C6.title: "Ledová propast"
	quest.4A5769EA7094BF78.quest_desc: [
		"Savanové hrozny rostou v savaně, tajgové hrozny v tajze a v horách."
		"Každá odrůda dá jinou šťávu a z každé šťávy se dělají jiná vína. Sud pojme vždy jen jeden druh šťávy."
	]
	quest.4A5769EA7094BF78.title: "Odrůdy z cest"
	quest.4A62CFF03E3DAD9E.quest_desc: [
		"Ledovec (&eTwilight Glacier&r) je zamrzlá krajina za zasněženým lesem. Stojí na něm polární palác (&eAurora Palace&r)."
		"Palác je vysoký a hlídaný. Vezmi si hodně bloků a jídla."
	]
	quest.4A62CFF03E3DAD9E.title: "Ledovec"
	quest.4A9A8448EBF61BB0.quest_desc: [
		"Spoj vše dohromady: truhla s rudou → trychtýř → drtící kola → pás → větrák s vodou → lis nad tyglíkem (nugety na ingoty) → trezor."
		"Úkol: roztoč drtící kola na 256 RPM, tak drtí nejrychleji. Pár kol pak bere 4 096 SU, na to už potřebuješ silný zdroj, třeba parní kotel."
		"&aTip:&r Drť padá pod kola, zachyť ji pásem nebo deskou. Na vstup dej trychtýř nebo šachtu."
	]
	quest.4A9A8448EBF61BB0.quest_subtitle: "Expert"
	quest.4A9A8448EBF61BB0.title: "Automatická rudná linka"
	quest.4AFAC74E4C426755.quest_desc: [
		"Rolku z řasy (&eKelp Roll&r) slož na pracovním stole z vařené rýže, mrkve a sušené řasy."
		"Lososovou rolku (&eSalmon Roll&r) slož ze 2 plátků lososa a vařené rýže. Plátky ryb nakrájíš nožem na prkénku."
	]
	quest.4AFAC74E4C426755.title: "Rýžové rolky"
	quest.4B7B1C9BAEB429C9.quest_desc: [
		"Kvasnicový hrnek (&eYeast Pot&r) slož z květináče, plátna, vody a sladidla (třeba cukru)."
		"Polož ho a počkej, až začne bublat. Pak na něj klikni prázdnou lahví a dostaneš kvasnice (&eYeast&r)."
	]
	quest.4B7B1C9BAEB429C9.title: "Kvasnice"
	quest.4B97BC3580748EFF.quest_desc: [
		"Střípky ambrosia (&eAmbrosium Shard&r) jsou zdejší uhlí. Ruda je ve svatém kameni a je nejčastější."
		"Pohání oltář. Když ho sníš, vyléčí ti půl srdce."
	]
	quest.4B97BC3580748EFF.title: "Ambrosium"
	quest.4BEE7D1D676FAFC2.quest_desc: [
		"Velká snídaně (&eFarmer's Breakfast&r) se skládá ze tří jídel: chleba, slaniny s vejci a pečené kukuřice."
		"Slanina s vejci (&eBacon with Eggs&r) vznikne na pekáči (slanina, vejce, máslo, miska). Pečená kukuřice (&eRoasted Corn&r) v kamnech (2 kukuřice a máslo)."
		"&aTip:&r Jídla z Farm \\& Charm často dávají užitečné efekty. Uvidíš je v popisku jídla."
	]
	quest.4BEE7D1D676FAFC2.title: "Farmářská snídaně"
	quest.4C119C0BF8488AE4.quest_desc: [
		"Mapa kolonie (&eColony Map&r) otevře okno s mapou tvé kolonie."
		"Vyrobíš ji z 8 prázdných map a nástroje stavby. Propoj ji Shift + pravým tlačítkem na radnici."
	]
	quest.4C119C0BF8488AE4.title: "Mapa kolonie"
	quest.4C1DCB2344D7B0E7.quest_desc: [
		"Na rycím stole (&eEtching Table&r) dej do slotů prázdnou desku a hudební štítek (&eMusic Label&r). Štítek vyrobíš ze 4 papírů."
		"Do textového pole vlož odkaz na písničku a vezmi si hotovou desku (&eEtched Music Disc&r)."
		"Hraje v obyčejném jukeboxu a uslyší ji všichni kolem."
	]
	quest.4C1DCB2344D7B0E7.title: "Vlastní písnička"
	quest.4C295028B86C89AD.quest_desc: [
		"Netheritovou helmu a láhev vyrobíš na kovářském stole: měděný díl + netheritový ingot + šablona netheritového vylepšení."
		"S plnou sadou tě chrání před ohněm a lávou a v lávě lépe vidíš. &cMusíš mít i netheritové kalhoty a boty.&r Vzduch v láhvi pořád ubývá."
	]
	quest.4C295028B86C89AD.quest_subtitle: "Expert"
	quest.4C295028B86C89AD.title: "Potápění v lávě"
	quest.4C48517725275505.quest_desc: [
		"Hrací skříň na alba (&eAlbum Jukebox&r) pojme víc desek a hraje je jednu po druhé."
		"Vyrobíš ji z jukeboxu, truhly, opakovače a redstonu."
	]
	quest.4C48517725275505.title: "Album"
	quest.4C75E0B0068270B5.quest_desc: [
		"Pekelná bradavice (&eNether Wart&r) roste na duší písku v pevnostech. Je základ skoro všech lektvarů."
		"Zasaď ji doma na duší písek (&eSoul Sand&r). Roste i v Overworldu, takže ji stačí najít jen jednou."
	]
	quest.4C75E0B0068270B5.title: "Pekelná bradavice"
	quest.4C9235810E1DAEA8.quest_desc: [
		"&bImmersive Aircraft&r přidává hotová letadla. Vyrobíš je v pracovním stole, položíš na zem a letíš. Nic nestavíš blok po bloku."
		"&bSmall Ships&r přidává plachetnice. Postaví je loděnice z prken, vlny a provázků."
		"&aTato letadla jsou jednodušší než stroje z Create Aeronautics. Hodí se, když chceš hlavně rychle cestovat.&r"
	]
	quest.4C9235810E1DAEA8.quest_subtitle: "Začátečník"
	quest.4C9235810E1DAEA8.title: "Letadla a lodě"
	quest.4CB314F55E2C22E6.quest_desc: [
		"Uvnitř hradu je sarkofág. Klikni na něj skarabeovým drahokamem."
		"&cTím probudíš Anu! Měj plné zdraví a dobrou výbavu.&r"
	]
	quest.4CB314F55E2C22E6.title: "Sarkofág"
	quest.4CD4E7B4F1695920.quest_desc: [
		"&eKufřík na nářadí&r (&eBrown Toolbox&r): ozubené kolečko, 2 zlaté pláty, truhla a kůže. Pojme hodně kusů z 8 různých druhů předmětů."
		"Polož ho v dílně. Hráči poblíž podrží klávesu kufříku a vezmou si nářadí na dálku. Když ho sebereš, obsah v něm zůstane."
	]
	quest.4CD4E7B4F1695920.title: "Kufřík na nářadí"
	quest.4CD87CF1E07529A1.quest_desc: [
		"&bCreate: Interiors&r přidává židle, křesla, polštáře a stolky."
		""
		"Bílé křeslo (&eWhite Chair&r) vyrobíš z dřevěného půlbloku, prken a bílé vlny. Jinou barvu dostaneš z jiné vlny nebo obarvením hotového křesla."
		""
		"Pravým tlačítkem si sedneš. Levým Shiftem vstaneš."
		"{@pagebreak}"
		"Montážním klíčem přidáš nebo sundáš opěrky. Shift + montážní klíč změní výšku opěradla."
		""
		"Křeslo funguje i na pohyblivé stavbě Create jako sedačka. Hráč na něm zůstane sedět, i když se stavba hýbe."
		""
		"&aTip: Židle z modu Bits 'n' Bobs jsou z vlny a dřevěných schodů.&r"
	]
	quest.4CD87CF1E07529A1.title: "Pohodlné křeslo"
	quest.4CF67DF0E07CA930.quest_desc: [
		"Vylepšení se vkládají do importéru, exportéru a dalších zařízení. Základ (&eUpgrade&r) je z křemenného železa, skla a vylepšeného procesoru."
		"Rychlost (&eSpeed Upgrade&r) zrychlí práci, stohování (&eStack Upgrade&r) přesune víc kusů naráz."
		"&aTip:&r Regulátor (&eRegulator Upgrade&r) v exportéru udrží v cíli jen nastavené množství."
	]
	quest.4CF67DF0E07CA930.title: "Vylepšení"
	quest.4CFE4ED9523B94A0.quest_desc: [
		"Vartýř je nejsilnější příšera v Overworldu. Je slepý, ale slyší každý krok a cítí tě nablízku."
		"Většina hráčů se mu radši vyhne. Porazit ho je opravdový úspěch – vezmi si tu nejlepší výbavu."
	]
	quest.4CFE4ED9523B94A0.title: "Vartýř"
	quest.4D031C9D9C2BD057.quest_desc: [
		"Forma (&eMold&r) se vkládá do tyglíku. Mechanický lis pak do formy lisuje a dávkovač do ní odlévá kapalinu."
		""
		"Formu nařeže mechanická pila (&eMechanical Saw&r) ze železného plátu. Tvarů je víc (řetěz, vlnky, miska, tyčka). Vybereš ho filtrem na pile."
		""
		"&aTip: Recepty ukáže JEI v záložkách Compression Molding a Casting. Třeba lis s řetězovou formou udělá z 6 železných nugetů řetěz.&r"
	]
	quest.4D031C9D9C2BD057.title: "Formy"
	quest.4D11985D5BC55021.quest_desc: [
		"Skluz (&eChute&r) pustí věci z násypky nebo podavače rovnou na zem pod sebe. Je to levná náhrada násypky."
		"Vyrobíš ho z prken a klacků."
	]
	quest.4D11985D5BC55021.title: "Skluz"
	quest.4D2A824C7F5E7FDC.quest_desc: [
		"Větrák přes &eoheň&r nebo &etáborák&r udí: syrové jídlo upeče a chaluhy usuší. Jídlo se tu nespálí."
		"Ohňohořák bez paliva udí taky."
		"&aTip:&r Ze sušených chaluh jsou mechanické pásy. Udírna u chaluhové farmy ti dá pásů, kolik chceš."
	]
	quest.4D2A824C7F5E7FDC.title: "Hromadné uzení"
	quest.4D2DE356B866F688.quest_desc: [
		"Osmiový kompresor (&eOsmium Compressor&r) lisuje prach a osmium do pevných ingotů."
		"Osmium do něj dodáš tak, že vložíš osmiový ingot do slotu na plyn. Z rafinovaného obsidiánového prachu pak vyrobí rafinovaný obsidián. Ze světlitového prachu vyrobí rafinovaný světlit."
		"&aTip:&r Oba ingoty potřebuješ na teleportér a nejlepší nástroje."
	]
	quest.4D2DE356B866F688.title: "Osmiový kompresor"
	quest.4D328D736B970AF1.quest_desc: [
		"Croissanty (&eCroissant&r) upečeš v kamnech ze sladkého těsta, kvasnic a cukru."
		"Pečivo z Bakery dává efekty, třeba &eSugar Rush&r (rychlejší chůze) nebo &eVitality&r (pomaleji ti ubývá hlad)."
	]
	quest.4D328D736B970AF1.title: "Croissanty"
	quest.4D5199BCE1608B31.quest_desc: [
		"Odemkni &ePokladnici&r v komnatách klání &eKlíčem klání&r."
		"Každý hráč může každou pokladnici otevřít jen jednou."
	]
	quest.4D5199BCE1608B31.title: "Pokladnice"
	quest.4D6C3CA7FA15E7B8.quest_desc: [
		"Zavlažovač (&eWater Sprinkler&r) zalévá ornici kolem sebe, takže nevyschne. Pravým tlačítkem přepínáš tlak vody."
		"Studna (&eTimber Well&r) pumpuje vodu ze zdroje pod sebou. Klikni na ni prázdnou rukou. Za deště se plní i sama a zvířata z ní pijí."
	]
	quest.4D6C3CA7FA15E7B8.title: "Zavlažování"
	quest.4D70347F5FCEE26B.quest_desc: [
		"Opuštěné dutiny zahaluje nepřirozená tma. Země je z guanového kamene (&eGuanostone&r) a koprolitu (&eCoprolith&r)."
		"&cSvětlo přiláká můry (Gloomoth) a za nimi dravce. Kultisté (Underzealot) rozbíjejí pochodně.&r"
		"&aV guanovém kameni je redstonová ruda, v koprolitu uhlí.&r"
	]
	quest.4D70347F5FCEE26B.title: "Opuštěné dutiny"
	quest.4D75DCB9FCD429F5.quest_desc: [
		"Ultimátní obvod (&eUltimate Control Circuit&r) = elitní obvod + 2 atomové slitiny."
		"Potřebuješ ho na stroje pro 5× zpracování rud, na QIO a na MekaSuit."
		"&aTip:&r Obvody jdou vyrábět i v infuzéru (obvod + zdroj infuze). V JEI porovnej, co je pro tebe levnější."
	]
	quest.4D75DCB9FCD429F5.title: "Ultimátní obvod"
	quest.4DB2C042EA38EEC1.quest_desc: [
		"Postav strážní věž na úrovni 1 a strážný se do ní nastěhuje."
		"Dej mu zbraň a zbroj. Lepší výbavu si řekne až s vyšší úrovní věže (kámen na úrovni 1, železo na 2, diamant na 3)."
		"&aTip:&r novou výbavu chce strážný až ve chvíli, kdy tu starou opotřebuje."
	]
	quest.4DB2C042EA38EEC1.quest_subtitle: "Začátečník"
	quest.4DB2C042EA38EEC1.title: "První strážný"
	quest.4DC8F44A3465B7F0.quest_desc: [
		"Vlakové pouzdro (&eTrain Casing&r) je základ všech dílů železnice: stanic, ovládání, návěstidel i podvozků."
		"Polož mosazné pouzdro (&eBrass Casing&r) a klikni na něj robustním plátem. Hromadně to za tebe udělá pokladač (&eDeployer&r)."
		"&aMosazné pouzdro vznikne, když klikneš mosazným ingotem na oloupaný kmen.&r"
	]
	quest.4DC8F44A3465B7F0.title: "Vlakové pouzdro"
	quest.4DCF55F11F67BEFF.quest_desc: [
		"Konvici (&eKettle&r) vyrobíš z mědi, kbelíku, kůže a klacků. Potřebuje teplo zespodu, stejně jako hrnec."
		"Nalij do konvice vodu kbelíkem a vlož lístky. Hotový čaj (&eGreen Tea&r) nabereš do lahví."
		"&aTip:&r Čaje a káva dávají různé užitečné efekty. Popis najdeš v popisku nápoje."
	]
	quest.4DCF55F11F67BEFF.title: "Konvice a čaj"
	quest.4DD50C3B0147A801.quest_desc: [
		"Wither kostlivci v pevnosti občas upustí svou lebku (&eWither Skeleton Skull&r). Potřebuješ 3."
		"&aTip:&r meč s očarováním Drancování (&eLooting&r) zvýší šanci, že lebka padne."
	]
	quest.4DD50C3B0147A801.title: "Lebka wither kostlivce"
	quest.4DDE61F66BABECBB.quest_desc: [
		"&bFossils and Archeology Revival&r ti dovolí oživit dinosaury a pravěká zvířata. Na verzi 1.21.1 jsme ho převedli jen pro tento pack."
		"Cesta: fosilie → analyzátor → DNA → kultivátor → vejce → dinosaurus."
		"K tomu archeologie: relikvie, starodávné zbraně, Nether a boss Anu."
	]
	quest.4DDE61F66BABECBB.quest_subtitle: "Začátečník"
	quest.4DDE61F66BABECBB.title: "Fossils \\& Archeology"
	quest.4DE6D6F93FFE52B4.quest_desc: [
		"Krčma je hotová. Teď do ní budou chodit návštěvníci."
		"Návštěvník řekne, co chce za to, že se stane občanem. Podívej se na jeho dovednosti – někteří jsou výborní dělníci."
		"&cKdyž návštěvník zemře, nějakou dobu pak žádní noví nepřijdou.&r"
	]
	quest.4DE6D6F93FFE52B4.title: "Krčma je otevřená"
	quest.4E4D12A972EFFEC3.quest_desc: [
		"Plážové poklady najdeš v truhlách zakopaných pokladů, vraků lodí, podmořských ruin a pyramid."
		"Pantofle (&eCrocs&r) ti dovolí běhat po vodě. Další poklady jsou třeba nafukovací kruhy (rychlejší plavání) nebo brýle (menší zranění ohněm)."
	]
	quest.4E4D12A972EFFEC3.title: "Plážový poklad"
	quest.4E4F50D2CA031B06.quest_desc: [
		"Do krmítka (&eFeeder&r) dej maso i rostliny. Dinosauři si z něj sami berou to, co jedí."
		"&cHladový dravec může zaútočit i na tebe.&r Dinopedie ti ukáže, jak má tvor hlad."
	]
	quest.4E4F50D2CA031B06.title: "Krmítko"
	quest.4E61F1E3321663BB.quest_desc: [
		"&bRefined Storage&r je digitální úložiště jako AE2, ale jednodušší: nemá kanály a všechno se prostě propojí kabelem."
		"Ovladač (&eController&r) dodává síti energii (FE), disky v diskové jednotce ukládají věci a v mřížce (&eGrid&r) je vidíš a bereš."
		"&aTip:&r Některé kroky jsou v kapitole &bÚložiště&r (mají v názvu „RS:“)."
	]
	quest.4E61F1E3321663BB.quest_subtitle: "Začátečník"
	quest.4E61F1E3321663BB.title: "Co je Refined Storage"
	quest.4E813ECB1CECCEC8.quest_desc: [
		"&eMechanický pluh&r (&eMechanical Plough&r) na udělátku dělá z hlíny ornici a rozbíjí měkké bloky, třeba trávu a květiny."
		"Farma: pole a nad ním udělátko se sklízeči a truhlou, které jezdí tam a zpět (píst s řadící pákou). Sklízeč plodinu sklidí a nechá ji znovu růst."
		"&aTip:&r Pokladač se semínky na udělátku zasadí prázdná místa."
	]
	quest.4E813ECB1CECCEC8.title: "Farma na plodiny"
	quest.4EAB6C53A4439F01.quest_desc: [
		"Velký sud (&eBig Barrel&r) vyrobíš ze 4 sudů."
		"Pravým tlačítkem do něj uložíš nápoj a v sudu zraje. Shift + pravé tlačítko ho vyndá."
		"&aTip:&r Podívej se na sud – uvidíš, jak moc nápoj už uzrál."
	]
	quest.4EAB6C53A4439F01.title: "Velký sud"
	quest.4EDD2E1AB99F697A.quest_desc: ["Obsidiánový štít (&eBulky Obsidian Shield&r) vyrobíš z dřevěného štítu a obsidiánu."]
	quest.4EDD2E1AB99F697A.title: "Obsidiánový štít"
	quest.4EF2F282B8BACADA.quest_desc: [
		"Kameník (&eStonemason's Hut&r) vyrábí věci z kamene: kamenné cihly, schody, půlbloky a zdi."
		"Výzkum &eStone Cake&r stojí 64 vytesaných kamenných cihel (&eChiseled Stone Bricks&r) a doly musí mít dohromady úroveň aspoň 3. Blok budovy: 3 kamenné cihly, prkna a nástroj stavby."
	]
	quest.4EF2F282B8BACADA.title: "Kameník"
	quest.4F0B22DFADB5F681.quest_desc: [
		"V jedovaté bažině (&eYagroot Swamp&r) je fialový jed. Když do něj hodíš některé předměty, promění se."
		"Brambora zezelená na jedovatou a očarované věci z oltáře se vrátí do původní podoby. Všechny přeměny ukazuje JEI v kategorii &ePoison Conversion&r."
	]
	quest.4F0B22DFADB5F681.title: "Fialová magie"
	quest.4F154226FB57B5B6.quest_desc: [
		"&eMontovna vozíků&r (&eCart Assembler&r) leží na kolejích. S redstone signálem připojí přilepené bloky k projíždějícímu vozíku, bez signálu je zase rozloží."
		"Udělátko na vozíku jezdí po obyčejných kolejích. Vrtáky a sklízeče tak pracují na dlouhé trase."
	]
	quest.4F154226FB57B5B6.title: "Montovna vozíků"
	quest.4F4D5A7128B90C22.quest_desc: [
		"Mod &bCreate Goggles&r připevní inženýrské brýle na helmu. V pracovním stole dej vedle sebe helmu a brýle."
		"Máš pak ochranu helmy i informace z brýlí. Jde to s každou helmou od kožené po netheritovou, i s potápěcí."
		"Drtící kola helmu s brýlemi zase rozeberou."
	]
	quest.4F4D5A7128B90C22.title: "Brýle na helmě"
	quest.4F62C0657F91BA9C.quest_desc: [
		"Rajčata, salát, cibule a jahody také nejdřív najdi divoké. Rajčata rostou hlavně na pláních a v savaně, jahody skoro všude, kde je tráva."
		"Z rajčete, salátu a jahody vyrobíš na pracovním stole semínka. Semínka pak zasaď na pole."
		"&aTip:&r Z hromady zeleniny si můžeš vyrobit pytel (&eBag of Tomatoes&r…) – ušetříš místo v truhle."
	]
	quest.4F62C0657F91BA9C.title: "Zelenina a jahody"
	quest.4F6F095C201A9182.quest_desc: [
		"Po prvním drakovi se na portálu objeví dračí vejce (&eDragon Egg&r). Když na něj klikneš, teleportuje se pryč."
		"Vezmeš ho tak, že pod něj dáš pochodeň a vejce nad ní rozbiješ. Spadne na pochodeň a vypadne jako předmět."
	]
	quest.4F6F095C201A9182.title: "Dračí vejce"
	quest.4F70A0DA32E495BB.quest_desc: [
		"Kvašené pavoučí oko zvýší, kolik příšer se objeví najednou."
		"Úkol: zvyš počet příšer ze spawneru až na 16."
	]
	quest.4F70A0DA32E495BB.title: "Velká farma"
	quest.4F7F6E7E48610A7F.quest_desc: [
		"Horník vykope pod kolonií šachtu a chodby a nosí kámen a rudy. Důl (&eMine&r) vyrobíš z prken, dřevěného krumpáče a nástroje stavby."
		"Potřebuje krumpáč a lopatu, někdy i sekeru. Na stavbu šachty chce bloky, půlbloky, ploty, žebříky a pochodně."
		"&aTip:&r když horník stojí nahoře a nic nedělá, chybí mu materiál. Podívej se do jeho požadavků."
	]
	quest.4F7F6E7E48610A7F.title: "Důl"
	quest.4F8AB12119B032CC.quest_desc: [
		"Větší disk (&e4k Storage Disk&r) pojme 4 000 předmětů. Jsou i 16k a 64k."
		"Disk vylepšíš tak, že ho v pracovním stole spojíš s větší paměťovou částí (&e4k Storage Part&r). Obsah zůstane."
		"&aTip:&r Prázdný disk rozebereš: drž ho v ruce a klikni pravým tlačítkem. Vrátí se ti paměťová část."
	]
	quest.4F8AB12119B032CC.title: "Větší disky"
	quest.4FC538FD8A71F351.quest_desc: [
		"Oko Enderu (&eEye of Ender&r) vyrobíš z perly Enderu a ohnivého prachu."
		"Perly padají z endermanů. Hodně jich získáš i výměnou s pigliny."
		"Potřebuješ jich až 12 – tolik chybí v rámu portálu do Endu. Několik se ti rozbije při hledání pevnosti."
	]
	quest.4FC538FD8A71F351.title: "Oči Enderu"
	quest.4FE1F45EA8DDF90A.quest_desc: [
		"Krmivo (&eHorse Feed&r) slož z balíku sena nebo balíku rýže, dvou jablek a zlaté mrkve."
		"Nakrm jím ochočeného koně nebo jiné jezdecké zvíře. Na 5 minut bude rychlejší a skočí výš."
	]
	quest.4FE1F45EA8DDF90A.title: "Krmivo pro koně"
	quest.501216086ACF7A84.quest_desc: [
		"Krokodýlí hrudní plát (&eCrocodile Chestplate&r) je pevná zbroj."
		"Vyrob ho z 8 krokodýlích šupin."
	]
	quest.501216086ACF7A84.title: "Krokodýlí brnění"
	quest.501D897C36FF7A8E.quest_desc: [
		"Destilační jednotka (&eDistillation Controller&r) promění obyčejnou nádrž v destilační věž. Ta rozdělí ropu na naftu a benzín."
		""
		"Jeden recept dá 4 kusy. Na každý blok věže potřebuješ jeden."
		""
		"Návod na stavbu věže najdeš v kapitole Ropa a palivo."
	]
	quest.501D897C36FF7A8E.title: "Destilace"
	quest.501F475929CEBB59.quest_desc: [
		"Úkol: zablokuj štítem šíp nebo jinou střelu."
		"Drž pravé tlačítko a dívej se na nepřítele. Kostlivci ti pak skoro neublíží."
	]
	quest.501F475929CEBB59.title: "Odraz šíp"
	quest.502028D8EC85A50B.quest_desc: [
		"Modul energie (&eEnergy Unit&r) zvětší zásobník energie obleku nebo nástroje."
		"Vyrobíš ho ze základu modulu, indukčního článku, infuzní slitiny a HDPE desek."
		"&aTip:&r Do jednoho dílu jde vložit víc stejných modulů – kolik, ukáže modifikační stanice."
	]
	quest.502028D8EC85A50B.title: "Modul energie"
	quest.50288924D216BDF3.quest_desc: ["Televize (&eTelevision&r) potřebuje elektřinu. Dálkovým ovladačem (&eTelevision Remote&r) ji ovládáš na dálku."]
	quest.50288924D216BDF3.title: "Televize"
	quest.502BF10FD13C4EA5.quest_desc: [
		"Sestava motoru (&eEngine Assembly&r) je hlavní díl přenosného motoru."
		"Vyrábí se sekvenční montáží ze železného plátu: mechanická pila ho ořízne a lis stiskne. Opakuje se to 8×."
	]
	quest.502BF10FD13C4EA5.title: "Sestava motoru"
	quest.50425844F94F6E18.quest_desc: [
		"&bMrCrayfish's Furniture: Refurbished&r: nábytek, který opravdu funguje – lednice, sporáky, toustovače, televize, počítače i poštovní schránky."
		"Skoro všechno se vyrábí na dílenském stole (&eWorkbench&r). Vyrobíš ho z řezačky kamene, redstonového bloku, železného ingotu, prken a dřevěných půlbloků."
		"&cDílenský stůl potřebuje elektřinu.&r Jak ji získat, najdeš v kapitole &eNábytek&r."
	]
	quest.50425844F94F6E18.title: "Furniture: Refurbished"
	quest.507C57FB4FC23E2B.quest_desc: [
		"V packu je obrovské množství dekorací. V této kapitole najdeš nástroje a stoly, které je zpřístupní."
		"Většina bloků se vyrábí normálně na pracovním stole. Když nevíš, jak něco vyrobit, najdi to v JEI (klávesa R na předmětu)."
		"Začni stoly &bChipped&r a dlátem &bRechiseled&r, pak pokračuj na &bMacaw's&r střechy, okna a mosty. Nábytek má vlastní kapitolu."
	]
	quest.507C57FB4FC23E2B.title: "Ráj stavitelů"
	quest.50C0C8955F84DBB2.quest_desc: [
		"Ocelolistý krumpáč (&eSteeleaf Pickaxe&r) má od výroby očarování Štěstí II. Víc rudy z každého bloku!"
		"Ocelolistý hrudní plát má od výroby Ochranu proti výbuchům II."
	]
	quest.50C0C8955F84DBB2.title: "Ocelolistý krumpáč"
	quest.50D624A74DA9493D.quest_desc: [
		"Třetí větev je zasněžený les (&eSnowy Forest&r). Dokud neporazíš Licha, zmrzneš tu."
		"Žijí tu yetiové. Jejich vůdce sedí v jeskyni (&eYeti Cave&r)."
	]
	quest.50D624A74DA9493D.title: "Zasněžený les"
	quest.5108FA81183881B5.quest_desc: [
		"Surový neodym získáš rozbíjením krystalů (sloupů a uzlů) v magnetických jeskyních."
		"Padá i z Teletora, létajícího nepřítele se železnou zbraní nad hlavou."
		"&aTip: Galenit obsahuje železo. Z 9 galenitu je lisovaný galenit (&ePacked Galena&r), který se v peci přetaví na železný nuget.&r"
	]
	quest.5108FA81183881B5.title: "Neodym"
	quest.51101FD88A9F7105.quest_desc: [
		"Vylepšení úrovně (&eBasic to Iron Tier Upgrade&r) zvětší sofistikovanou truhlu nebo sud přímo na místě – obsah zůstane uvnitř."
		"Drž ho v ruce a klikni pravým tlačítkem na postavenou truhlu."
		"&aTip:&r Vylepšení &eBasic Tier Upgrade&r promění obyčejnou truhlu nebo sud z Minecraftu na sofistikovanou verzi."
	]
	quest.51101FD88A9F7105.title: "Vylepšení úrovně"
	quest.511DD8974A5D5BF1.quest_desc: [
		"Osobní truhla (&ePersonal Chest&r) má 54 slotů a otevřeš ji i přímo z inventáře, když ji neseš u sebe."
		"Věci v ní zůstanou, i když ji vykopeš a přeneseš."
		"&aTip:&r Osobní truhla je v receptu na chemický oxidátor, robita a QIO."
	]
	quest.511DD8974A5D5BF1.title: "Osobní truhla"
	quest.5148422E97B6EB51.quest_desc: [
		"Stříbrný dungeon je velký chrám z andělského kamene (&eAngelic Stone&r), který se vznáší nad ostrovy."
		"Žijí v něm Valkýry (&eValkyrie&r). Bloky dungeonu nejdou rozbít, dokud neporazíš bosse."
	]
	quest.5148422E97B6EB51.title: "Stříbrný dungeon"
	quest.514E55D248B93AD6.quest_desc: [
		"&eParní píšťala&r (&eSteam Whistle&r): zlatý plát a měděný ingot. Polož ji na nádrž s teplem."
		"S redstone signálem píská. Další píšťalou na ní snížíš tón, klíčem přepneš oktávu. Hodí se jako alarm nebo signál."
	]
	quest.514E55D248B93AD6.title: "Parní píšťala"
	quest.515B7E460A667A54.quest_desc: [
		"Klikni na mrtvé tělo Anu. Přeneseš se do klenotnice."
		"V klenotnici je i portál, kterým se vrátíš domů."
	]
	quest.515B7E460A667A54.title: "Klenotnice"
	quest.5176C47A9CB5A0E5.quest_desc: [
		"Základní nářadí z Pam's: prkénko (&eCutting Board&r), hrnec (&ePot&r) a pánev (&eSkillet&r). Vyrobíš je z mědi a dřeva."
		"Nářadí dáš na pracovní stůl spolu se surovinami. Po vyrobení jídla ti nářadí zůstane."
		"&cPozor:&r Tohle jsou předměty z Pam's, ne bloky z Farmer's Delight. Prkénko a pánev se jmenují stejně, tak se v JEI dívej, z jakého jsou modu."
	]
	quest.5176C47A9CB5A0E5.title: "Kuchyňské nářadí"
	quest.5186B2ED963FDEFB.quest_desc: [
		"Strážnice (&eGatehouse&r) ubytuje 2 strážné. Umí také propojit tvou kolonii s jinou kolonií."
		"Blok budovy vyrobíš z prken, železného meče, luku a nástroje stavby."
	]
	quest.5186B2ED963FDEFB.title: "Strážnice u brány"
	quest.518FB39A7930462C.quest_desc: [
		"Obrovský chrám na dně hlubokého oceánu. &bYUNG's Better Ocean Monuments&r ho přestavěl."
		"Hlídají ho strážci, kteří střílí laserem."
		""
		"&aTip:&r Vezmi si lektvary dýchání pod vodou a vidění ve tmě."
	]
	quest.518FB39A7930462C.title: "Podmořský monument"
	quest.519C58CE222CC8D9.quest_desc: [
		"Bio palivo (&eBio Fuel&r) vyrobíš v drtiči z rostlin – semínek, jablek, listí, trávy a dalších."
		"Pálí ho bio-generátor a potřebuješ ho na substrát v tlakové reakční komoře."
		"&aTip:&r Co všechno jde na bio palivo, ukáže JEI u drtiče."
	]
	quest.519C58CE222CC8D9.title: "Bio palivo"
	quest.519DC7EB567A6482.quest_desc: [
		"&eMechanické ložisko&r (&eMechanical Bearing&r) otáčí bloky před sebou. Když dostane rotaci, spojí je do jednoho &eudělátka&r (&eContraption&r)."
		"&eVteřinové lepidlo&r (&eSuper Glue&r): klikni na dva rohy a vše v kvádru mezi nimi drží pohromadě."
		"Větrný mlýn má vlastní, větrné ložisko (další quest)."
	]
	quest.519DC7EB567A6482.title: "Ložisko a lepidlo"
	quest.51A0E26321BD2D76.quest_desc: [
		"Nástroje z nebeského dřeva (&eSkyroot Pickaxe&r) jsou nejslabší, ale mají bonus: ze svatého kamene a ambrosiové rudy padá dvojnásobek."
		"Hodí se i později na těžbu ambrosia."
	]
	quest.51A0E26321BD2D76.title: "Nástroje z kořene"
	quest.51B18ECE14000BC5.quest_desc: [
		"Teď z křečka uděláš pomocníka. Z kbelíku mléka vyrobíš 3 kusy sýra (&eCheese&r)."
		"Drž sýr u ochočeného křečka. Křeček ti vyskočí na rameno."
	]
	quest.51B18ECE14000BC5.quest_subtitle: "Pokročilý"
	quest.51B18ECE14000BC5.title: "Křeček na rameni"
	quest.51C41C82F2112C3B.quest_desc: [
		"&ePřenosné úložné rozhraní&r (&ePortable Storage Interface&r): andezitové pouzdro a šachta. Jedno dej na udělátko, druhé pevně na místo s mezerou 1–2 bloky."
		"Když se míjí, spojí se. Pevné rozhraní pak vybírá (nebo plní) všechny truhly udělátka. Když se nic nepřesouvá, udělátko jede dál."
	]
	quest.51C41C82F2112C3B.title: "Přenosné rozhraní"
	quest.51D3672B33165EAB.quest_desc: [
		"Pila (&eSawmill&r) je první řemeslník. Vyrábí ze dřeva prkna, schody, dveře a další věci, které stavitel potřebuje."
		"Výzkum &eWoodwork&r stojí 64 prken a dřevorubci musí mít dohromady úroveň aspoň 3. Blok budovy: 3 dřevěné sekery, prkna a nástroj stavby."
		"Řemeslníkovi musíš recepty naučit v jeho budově. Víc v kapitole &eŘemeslníci&r."
	]
	quest.51D3672B33165EAB.title: "Pila"
	quest.51F00906E91F0A96.quest_desc: [
		"Svítící prismarín (&eLuminous Prismarine&r) vyrobíš z 8 prismarínových střepů a &eVáčku světélkujícího inkoustu&r."
		"Svítí, takže se hodí na osvětlení staveb pod vodou."
	]
	quest.51F00906E91F0A96.title: "Svítící prismarín"
	quest.51F926AB754AAC65.quest_desc: [
		"Postav rám z obsidiánu: 4 bloky široký a 5 vysoký (rohy můžeš vynechat, stačí 10 obsidiánů). Vnitřek zapal křesadlem."
		"&cPozor:&r Nether je nebezpečný. Vezmi si brnění, jídlo a bloky na stavění. Postel tam vybuchne!"
		"Co v Netheru dělat, najdeš ve skupině &bPrůzkum a dimenze&r."
		"{@pagebreak}"
		"&aZajímavost:&r Mod &bMutated Items&r – když do portálu hodíš třeba pec, redstone, křemen, nůžky nebo ohnivou tyč, mají 10% šanci, že se na druhé straně promění v nového tvora."
	]
	quest.51F926AB754AAC65.title: "Portál do Netheru"
	quest.5219FC8148A84812.quest_desc: [
		"Endový výrobník (&eEnder Crafter&r) vyrábí pomalu a bez energie. Kolem něj do 3 bloků postav endové alternátory (&eEnder Alternator&r) – čím víc, tím rychleji."
		"Vyrábí se v něm třeba endová hvězda (&eEnder Star&r) z netherové hvězdy a endových očí."
		"&aTip:&r Endový ingot (&eEnder Ingot&r) = železný ingot + endová perla."
	]
	quest.5219FC8148A84812.title: "Endový výrobník"
	quest.5243376E0E9F4108.quest_desc: [
		"&eMosazný trychtýř&r (&eBrass Funnel&r): elektronka, mosazný ingot a sušená chaluha. Bere až celý stack najednou, přesný počet nastavíš na panelu."
		"Má filtrový slot: dej do něj předmět nebo filtr a trychtýř propustí jen to."
	]
	quest.5243376E0E9F4108.title: "Mosazný trychtýř"
	quest.524E43EC11B0DF0B.quest_desc: [
		"Hořká čokoláda: cukr, kakaové máslo, 2 kakaové boby a mléko. Bílá: cukr, kakaové máslo a mléko. Obě s ohřevem."
		"Tabulky z nich vylisuješ stejně jako mléčnou čokoládu."
	]
	quest.524E43EC11B0DF0B.title: "Hořká a bílá"
	quest.525E98A131F9C8DD.quest_desc: [
		"&bCreate: Connected&r přidává spoustu chytrých dílů. Tyhle dva patří k nejužitečnějším."
		""
		"Kinetická baterie (&eKinetic Battery&r) ukládá sílu. Bez signálu se nabíjí ze sítě. S redstonovým signálem se vybíjí a sama pohání stroje."
		""
		"Itemové silo (&eItem Silo&r) je trezor postavený na výšku. Vyrobíš ho ze sudu a železných plátů. Baterie vyrobíš z mosazného pouzdra, precizního strojku, 2 železných plátů a redstonu – recept dá rovnou 8 kusů."
		""
		"Víc najdeš v kapitole Průmysl."
	]
	quest.525E98A131F9C8DD.title: "Baterie a silo"
	quest.528B3E77711E941F.quest_desc: [
		"Lich je mocný čaroděj. Chrání ho štít, vyvolává stínové kopie a pomocníky."
		"Jeho kouzelné střely můžeš odrazit úderem zpátky na něj."
		"Upustí jedno ze 4 žezel. Jeho porážka zruší kletbu bažiny, temného lesa a zasněženého lesa."
	]
	quest.528B3E77711E941F.title: "Lich"
	quest.52A16DA1ABF522F7.quest_desc: [
		"Plynový generátor (&eGas-Burning Generator&r) spaluje plyny: vodík nebo etylen."
		"Etylen z tlakové reakční komory je mnohem lepší – 1 mB etylenu dá mnohonásobně víc energie než 1 mB vodíku."
		"&aTip:&r Etylen se vyrábí z bio paliva. Farma rostlin + drtič + reakční komora = stálý zdroj paliva."
	]
	quest.52A16DA1ABF522F7.title: "Plynový generátor"
	quest.52D28B6765F86609.quest_desc: [
		"Na obrazovce výběru cíle můžeš místo přistání zvolit oběžnou dráhu. Je tam nulová gravitace a vznášíš se."
		"Na oběžné dráze si za suroviny postavíš vesmírnou stanici. U Země stojí 64 železných plátů, 32 ocelí, 32 deshových ingotů a 32 deshových plátů."
		"&aSolární panely na oběžné dráze Země vyrábějí víc energie než na povrchu Země.&r"
	]
	quest.52D28B6765F86609.title: "Oběžná dráha"
	quest.52DEAB5285BE0490.quest_desc: [
		"Kalorit je ruda z Venuše. Přetav ji na ingoty (&eCalorite Ingot&r)."
		"Z kaloritu je raketa 4. stupně a jet suit."
	]
	quest.52DEAB5285BE0490.title: "Kalorit"
	quest.52FFCDE3B30A6194.quest_desc: [
		"Polož na balíkovač ceduli s nápisem, to je &eadresa&r. Každý balíček z něj ponese tento nápis."
		"&eFiltr balíčků&r (&ePackage Filter&r, vlna a zinkové nugety) v trychtýři nebo tunelu propustí jen balíčky s danou adresou."
	]
	quest.52FFCDE3B30A6194.title: "Adresy"
	quest.53169DEC00AACB80.quest_desc: [
		"Zlatá ruda se drtí stejně. Při drcení s 75% šancí padnou 2 nugety zkušeností, praním dostaneš navíc křemen."
		"&aTip:&r Netherová zlatá ruda dá v drtících kolech rovnou 18 zlatých nugetů, to jsou 2 ingoty z jednoho bloku."
	]
	quest.53169DEC00AACB80.title: "Zlato"
	quest.532780D9DB293403.quest_desc: [
		"&eMosaz&r (&eBrass&r) otevírá pokročilé stroje. Do tyglíku dej měděný a zinkový ingot, pod něj ohřátý ohňohořák a nad něj míchačku. Vzniknou 2 mosazné ingoty."
		"&cObyčejný oheň ani táborák pod tyglíkem nestačí,&r recept potřebuje ohňohořák s palivem."
		"Teď už nestačí jen andezit. Z mosazi uděláš mosazné pouzdro, mosazné pláty, pokladač a precizní strojek."
	]
	quest.532780D9DB293403.quest_subtitle: "Pokročilý"
	quest.532780D9DB293403.title: "Mosaz"
	quest.53364C980A1DC27B.quest_desc: [
		"Teď už palivo z rostlin na velké stroje nestačí. Nejsilnější palivo je z ropy. Díly pumpy máš z questu Ropná pumpa v kapitole Create: doplňky."
		""
		"Ropná pumpa je pohyblivá konstrukce. Postav ji nad chunkem, kde skener našel ropu."
		""
		"1. Postav sloup a na jeho vršek dej hlavní ložisko (&ePumpjack Bearing&r)."
		"2. Postav rameno – rovnou vodorovnou řadu bloků (např. kovové nosníky). Musí vést napříč těsně před přední stranou ložiska."
		"3. Na jeden konec ramene dej hlavu pumpy (&ePumpjack Head&r)."
		"4. Na druhý konec dej druhé ložisko a klikni na něj montážním klíčem. Změní se na kloub pro kliku."
		"{@pagebreak}"
		"5. Pod kloub postav kliku (&ePumpjack Crank&r) a přiveď do ní rotaci."
		"6. Celé rameno slep vteřinovým lepidlem (&eSuper Glue&r)."
		"7. Klikni prázdnou rukou na hlavní ložisko. Pumpa se sestaví. Když se klika točí, pumpa se kývá."
		""
		"Když pumpa napíše chybu, uprav délku ramene nebo velikost kliky (nastavuje se na klice)."
		"{@pagebreak}"
		"Teď vrt (&ePumpjack Hole&r):"
		"1. Pod hlavou pumpy vykopej díru až k podloží."
		"2. Do díry dej rovnou svislou řadu potrubí (&eFluid Pipe&r) až k podloží."
		"3. Navrch potrubí polož vrt."
		"4. Ropu z vrtu odsávej z boku mechanickým čerpadlem (&eMechanical Pump&r)."
	]
	quest.53364C980A1DC27B.title: "Postav ropnou pumpu"
	quest.5337CDC5DA3A13B5.quest_desc: [
		"Helma z rohu (&eFroststalker Helmet&r). Mrazivé šelmy (&eFroststalker&r) si pak myslí, že jsi jedna z nich. &cKdyž některou napadneš, obrátí se proti tobě.&r"
		"Vyrob ji z rohu (&eFroststalker Horn&r) a 5 bloků &eHutného ledu&r. Šelmy žijí na ledových hrotech a zamrzlých vrcholcích."
	]
	quest.5337CDC5DA3A13B5.title: "Mrazivá helma"
	quest.535597C3BD998495.quest_desc: ["Černé lístky (&eBlack Tea Leaves&r) dává jen nejstarší čajovník. Uvař z nich černý čaj (&eBlack Tea&r)."]
	quest.535597C3BD998495.title: "Černý čaj"
	quest.538F2A9BDED3A07A.quest_desc: [
		"Třídič (&eSifter&r) prosívá hlínu, štěrk, písek a duší písek a najde v nich užitečné věci, třeba rudy a drahokamy."
		"Výzkum &eSieving&r (po výzkumu &eWoodwork&r) stojí 64 vláken a rybáři musí mít dohromady úroveň 3. Blok budovy: prkna, 3 vlákna a nástroj stavby."
		"Třídič potřebuje síto (&eMesh&r). Nejdřív síto z vláken, lepší síta se odemknou s vyšší úrovní třídiče."
	]
	quest.538F2A9BDED3A07A.title: "Třídič"
	quest.5390BC8A59B9FBFC.quest_desc: [
		"Víno &eJellie Wine&r je nejsilnější víno. Dává podobné, ale lepší efekty než zlaté jablko."
		"Potřebuješ bílou šťávu a tři jiná vína: jablečné (&eApple Wine&r), &eChenet Wine&r a &eBolvar Wine&r. Každé je z jiné šťávy – recepty najdeš v JEI."
	]
	quest.5390BC8A59B9FBFC.title: "Lepší než zlaté jablko"
	quest.53D20AC90968C967.quest_desc: [
		"Teď už nejde jen o přežití. Netherit je nejlepší materiál běžného Minecraftu. Jeho ruda jsou starověké trosky (&eAncient Debris&r)."
		"Trosky jsou hluboko, nejčastěji kolem výšky Y 15. Vydrží výbuch, proto je hráči hledají pomocí TNT nebo vybuchujících postelí."
		"Těžíš je diamantovým krumpáčem. Trosky nehoří v lávě, takže se ti neztratí."
	]
	quest.53D20AC90968C967.quest_subtitle: "Pokročilý"
	quest.53D20AC90968C967.title: "Starověké trosky"
	quest.53E22E0DB38EA7A2.quest_desc: [
		"Create umí z rud dostat víc: &edrtící kola&r rozdrtí rudu, &evětrák&r drť vypere nebo roztaví a k tomu padají bonusy."
		"Postup: ruda → drtící kola → rozdrcená ruda (krátce &edrť&r) → praní (nugety + bonus) nebo tavení (ingot)."
		"Než budeš mít drtící kola, můžeš větrákem tavit, udit, prát štěrk a písek. To je začátek této kapitoly."
		"&cMlýnský kámen rudy nezpracuje.&r Je levný a hodí se na mouku a štěrk. Na rudy potřebuješ drtící kola – dražší, ale zvládnou drcení i mletí."
	]
	quest.53E22E0DB38EA7A2.quest_subtitle: "Začátečník"
	quest.53E22E0DB38EA7A2.title: "Víc z každé rudy"
	quest.53EFBA38CC28887B.quest_desc: [
		"Pokročilý gyroskop (&eAdvanced Gyroscope&r) umí totéž co gyroskop a přidá mechanickou palubní desku s ukazateli."
		"Výroba: gyroskop, 3 hodiny, nótový blok a páka."
	]
	quest.53EFBA38CC28887B.title: "Pokročilý gyroskop"
	quest.53FD2F6504F0E09D.quest_desc: [
		"Varpová deska (&eWarp Plate&r) teleportuje na druhou desku. Stačí si na ni stoupnout a chvíli počkat. Je to zdarma."
		"Jak je propojit: polož obě desky. Do první vlož spící střep (&eDormant Shard&r). Z něj se stane naladěný střep (&eAttuned Shard&r)."
		"Naladěný střep vezmi a vlož do druhé desky. Teď jsou desky propojené."
		"{@pagebreak}"
		"Desky i střepy se vyrábějí na mechanických craftovačích. Potřebuješ varpový prach (&eWarp Dust&r): ender perla + ametystový úlomek dají 4 kusy."
	]
	quest.53FD2F6504F0E09D.quest_subtitle: "Expert"
	quest.53FD2F6504F0E09D.title: "Teleportační desky"
	quest.54149DF58C0CF8B8.quest_desc: [
		"Vlastní waystone (&eWaystone&r) si postav u domu nebo u farmy. Pak se tam kdykoliv vrátíš."
		"Vyrábí se na mechanických craftovačích z kamenných cihel, andezitového pláště (&eAndesite Casing&r), ender perel a varpového kamene. Recept dá rovnou 2 kusy."
		"&aTip:&r Po položení mu dej jméno, ať se v seznamu vyznáš."
	]
	quest.54149DF58C0CF8B8.title: "Vlastní waystone"
	quest.54192C8F2285CD64.quest_desc: [
		"&eSkladový vysílač&r (&eStock Link&r): vysílač nad trezorem. Polož ho na balíkovač a zásoby jeho truhly se objeví v síti."
		"Další díly připojíš tak, že jimi před položením klikneš na skladový vysílač."
		"Signál má neomezený dosah, ale balíčky se musí dopravit: pásem, řetězem nebo vlakem."
	]
	quest.54192C8F2285CD64.title: "Skladový vysílač"
	quest.54288B1174CB0192.quest_desc: [
		"&eHadicová kladka&r (&eHose Pulley&r): měděné pouzdro, blok sušených chaluh a měděný plát. Spouští hadici a čerpá nebo plní tekutinu."
		"Ve velkém jezeře nebo moři (aspoň 10 000 bloků vody) bere vodu donekonečna a hladina neklesne. Ideální zdroj pro kotel."
		"Rotace spouští hadici, opačná ji navine. Rychlost čerpání určuje čerpadlo v potrubí."
	]
	quest.54288B1174CB0192.title: "Hadicová kladka"
	quest.543055530E829365.quest_desc: [
		"Na vrcholu věže létá &eUr-Ghast&r. Sám dolů nesleze."
		"V místnosti pod ním jsou pasti na ghasty (&eGhast Trap&r). Zabij v jejich blízkosti malé karminitové ghasty a past se nabije."
		"Nabitou past aktivuj redstonovým signálem (třeba páčkou). Past stáhne Ur-Ghasta dolů."
	]
	quest.543055530E829365.title: "Past na ghasta"
	quest.543CEEF55BCD305B.quest_desc: [
		"V pokladu zlatého dungeonu je fénixova zbroj (&ePhoenix Armor&r). Celá sada dá ohnivzdornost – můžeš plavat i v lávě."
		"&cVe vodě se fénixova zbroj promění na obsidiánovou.&r Obsidiánová zbroj je ještě silnější než diamantová."
	]
	quest.543CEEF55BCD305B.title: "Fénixova zbroj"
	quest.544CF30E9587FB48.quest_desc: [
		"Teď už nemusíš řídit sám. Dej jízdní řád strojvůdci a vlak bude jezdit podle něj."
		"Strojvůdce je zvíře nebo vesničan, který sedí na sedačce přímo před ovládáním. Klikni na něj s naprogramovaným jízdním řádem."
		"&aStrojvůdcem může být i ohňohořák (&eBlaze Burner&r) položený před ovládáním. Nemusíš chytat žádné zvíře.&r"
		"Jízdní řád si od strojvůdce kdykoli vezmeš zpět. Když ho vložíš do stanice, sám se zkopíruje do každého vlaku, který tam zastaví."
	]
	quest.544CF30E9587FB48.quest_subtitle: "Pokročilý"
	quest.544CF30E9587FB48.title: "Vlak jezdí sám"
	quest.54508BF41CCF1218.quest_desc: [
		"Poslední zkouška Aetheru. Zlatý dungeon je ukrytý uvnitř velkého ostrova, kde rostou zlaté duby. Uvnitř je pekelný kámen (&eHellfire Stone&r)."
		"Dokud boss žije, je v Aetheru stále den a pekelný kámen nejde rozbít."
	]
	quest.54508BF41CCF1218.quest_subtitle: "Expert"
	quest.54508BF41CCF1218.title: "Zlatý dungeon"
	quest.54519EFAC6FB64A7.quest_desc: [
		"Create Deco umí cihly v sedmi barvách. Barvu jim dá kámen z Create."
		""
		"Dej do mřížky 8 cihel a doprostřed kámen &eAsurine&r. Vzniknou 4 modré cihly (&eBlue Bricks&r). Asurine najdeš v podzemí ve vrstvách mezi jinými kameny."
		""
		"Jiné kameny z Create, například &eCrimsite&r nebo &eOchrum&r, dají jiné barvy. Všechny recepty ukáže JEI."
		""
		"&aTip: V kameníkovi z cihel uděláš krátké, dlouhé, rohové a dlaždicové varianty.&r"
	]
	quest.54519EFAC6FB64A7.title: "Barevné cihly"
	quest.545AE0121B265272.quest_desc: [
		"Drž plátek okurky a plíž se (Shift) ke křečkovi. Klikni na něj pravým tlačítkem a zkoušej to, dokud se neochočí."
		"Ochočený křeček tě následuje. Barva srsti záleží na tom, kde žil."
	]
	quest.545AE0121B265272.title: "Ochoč křečka"
	quest.5474DD8DA421D993.quest_desc: [
		"Syrová vepřová kotleta nakrájená nožem na prkénku dá 2 slaniny (&eRaw Bacon&r). Kuře, ryby a skopové se taky rozkrájí na menší kousky do receptů."
		"Mleté maso (&eMinced Beef&r) je v tomto packu na 3 kroky. Syrové hovězí dej na pracovní stůl a dostaneš mleté hovězí (&eGround Beef&r)."
		"Mleté hovězí nakrájej nožem na prkénku na 2 masové kuličky (&eRaw Beef Meatball&r). Každou kuličku dej na pracovní stůl a vznikne &eMinced Beef&r."
		"&aTip:&r Mleté maso upeč v peci, udírně nebo na táboráku a máš karbanátek (&eBeef Patty&r)."
	]
	quest.5474DD8DA421D993.title: "Krájení masa"
	quest.547BDD25E6F2E120.quest_desc: [
		"Pickarang (&ePickarang&r) je krumpáč, který se hází jako bumerang. Vykope blok, do kterého narazí, a přinese ti ho zpátky."
		"Vyrobíš ho z diamantů, prken a diamantového srdce. Dá se i očarovat."
	]
	quest.547BDD25E6F2E120.title: "Pickarang"
	quest.548067B1AEEA6446.quest_desc: [
		"Teď stroj naučíš řídit se sám. Senzory měří let a dávají redstonový signál – z nich postavíš autopilota."
		"Výškoměr (&eAltitude Sensor&r) dává signál podle výšky. Rozsah nastavíš v jeho okně a signál umí i obrátit. Napoj ho na hořák a stroj udrží výšku."
		"Rychloměr (&eVelocity Sensor&r) dává signál podle rychlosti ve směru, kam míří."
	]
	quest.548067B1AEEA6446.quest_subtitle: "Expert"
	quest.548067B1AEEA6446.title: "Přístroje"
	quest.548EA9BC7C820D63.quest_desc: [
		"Prastarý svazek (&eAncient Tome&r) zvýší očarování o jednu úroveň – až o jednu nad normální maximum."
		"Najdeš ho v truhlách: v knihovnách pevností (stronghold), v dungeonech, v pokladech bastionů, v lesních sídlech a v prastarých městech."
		"Spoj ho na kovadlině s předmětem nebo knihou, která má stejné očarování na maximu."
	]
	quest.548EA9BC7C820D63.title: "Prastarý svazek"
	quest.54A0D0A444B2888C.quest_desc: [
		"S modem &bApothic Spawners&r vykopeš spawner krumpáčem s očarováním Hedvábný dotek (Silk Touch)."
		"Spawner pak můžeš vylepšit: drž předmět v ruce a klikni na spawner pravým tlačítkem. Co který předmět dělá, ukáže JEI."
		"Úkol: uprav spawner. Třeba cukr zkrátí čekání mezi příšerami."
	]
	quest.54A0D0A444B2888C.quest_subtitle: "Pokročilý"
	quest.54A0D0A444B2888C.title: "Upravený spawner"
	quest.54AB96FF89E0902E.quest_desc: [
		"Mod &bJust-In NETHER&r přidává býčí bojovníky (&eBullkin&r). Silný &eBullkindar&r žije v netherových pustinách a ve zkřiveném lese."
		"Bullkindar po smrti upustí &eKindarx&r. Ten přetav ve vysoké peci (&eBlast Furnace&r) na kruorit (&eCruorite&r)."
		"Podobně z &ePigmar&r (pustiny a karmínový les) padá &ePigar&r a z něj je devourit (&eDevourite&r)."
		"&cV tomto packu z kruoritu ani devouritu nic nevyrobíš. Jsou to zatím sběratelské kovy.&r"
	]
	quest.54AB96FF89E0902E.title: "Kruorit"
	quest.54BF44687F30D3C9.quest_desc: [
		"Krabí král (&eHermit King&r). Sám se v tomto packu neobjevuje, musíš ho přivolat."
		"Postav &eJámu bestií&r na obyčejné pláži (&ePláž&r) a zapal ji. Když má krab málo životů, schová se do ulity a léčí se."
		"Může z něj padnout &eShellmet&r – helma, která tě zrychlí na písku."
	]
	quest.54BF44687F30D3C9.title: "Krab poustevník"
	quest.54D390AF6F950D40.quest_desc: ["Ingot &eNetherite-Gold Ingot&r vyrobíš z ingotu &eNetherite-Iron Ingot&r a 4 zlatých ingotů."]
	quest.54D390AF6F950D40.title: "Netherit-zlato"
	quest.54E5D16DAABED41C.quest_desc: [
		"V téhle kapitole najdeš všechno o ukládání věcí: větší truhly, šuplíky na velké množství jednoho předmětu a propojené úložiště."
		"Digitální úložiště má vlastní kapitoly: &bApplied Energistics 2&r a &bRefined Storage&r. Tady jsou jen jejich první kroky."
		"&aTip:&r Na konci kapitoly jsou stavební nástroje (&bBuilding Gadgets&r) a velké pracovní stoly (&bExtended Crafting&r)."
	]
	quest.54E5D16DAABED41C.quest_subtitle: "Začátečník"
	quest.54E5D16DAABED41C.title: "Kam s věcmi?"
	quest.54EEC7A1F47F8E29.quest_desc: [
		"Rybí kbelík (&eFish Bucket&r) je krmení pro žraloky. Vyrob ho z kbelíku, kostní moučky a 2 různých ryb (třeba treska a losos)."
		"&cNěkteří žraloci jsou nebezpeční.&r Než skočíš do moře, podívej se, co v něm plave."
	]
	quest.54EEC7A1F47F8E29.title: "Rybí kbelík"
	quest.54F45ECCC8F004BD.quest_desc: [
		"Zbraně a přístroje (&eAircraft Weapon&r) dáváš do slotu na zbraň. Většina letadel má jeden, hopper a válečná loď dva, nákladní vzducholoď žádný."
		"Teleskop (&eTelescope&r) je větší dalekohled. Výroba: dalekohled a měděný ingot."
	]
	quest.54F45ECCC8F004BD.title: "Teleskop"
	quest.54F856051CB82798.quest_desc: [
		"Cukrová hůl (&eCandy Cane&r) je běžná surovina dutiny, padá z Caniaců. Blok čokolády (&eBlock of Chocolate&r) vytěžíš ze stěn a země dutiny."
		"&aSladké jídlo ti občas dá efekt &eSugar Rush&a – na chvíli se pohybuješ a útočíš rychleji.&r"
	]
	quest.54F856051CB82798.title: "Sladkosti"
	quest.552866F163FA9C3B.quest_desc: [
		"Kanystr (&eCanister&r) je přenosná nádrž na 4 000 mB kapaliny. Když ho vykopeš, kapalina v něm zůstane."
		""
		"Vyrobíš ho ze sudu, 2 andezitových slitin a 3 železných plátů."
		""
		"Naplníš ho potrubím nebo dávkovačem."
		""
		"&aTip: Hodí se na převoz paliva k motoru, který stojí daleko od základny.&r"
	]
	quest.552866F163FA9C3B.title: "Kanystr"
	quest.5559129869F55350.quest_desc: [
		"Tryska (&eNozzle&r) na zapouzdřeném větráku odtlačuje fyzikální stroj od blízkých povrchů – od země, stěn i vody."
		"&aVětráky s tryskami pod strojem udělají vznášedlo, které se drží nad zemí nebo nad vodou.&r"
	]
	quest.5559129869F55350.title: "Vznášedlo"
	quest.555EA211F922DCBF.quest_desc: ["Pohovka (&eOak Couch&r) je z prken, vlny a polštáře. Polož víc pohovek vedle sebe a vznikne dlouhá sedačka."]
	quest.555EA211F922DCBF.title: "Pohovka"
	quest.55625BFA5DD44551.quest_desc: [
		"&ePotrubí&r (&eFluid Pipe&r) vede tekutiny. &eMechanické čerpadlo&r (&eMechanical Pump&r) je pohání. Šipka ukazuje směr toku, klíčem ho obrátíš."
		"Čerpadlo táhne až 16 bloků daleko. Rychlejší rotace = rychlejší tok. Víc čerpadel otočených stejně se sčítá."
		"&eNádrž&r (&eFluid Tank&r) se spojí se sousedními: základna až 3×3 a výška až 32 bloků. Ručně do ní nenaliješ, plní se potrubím."
	]
	quest.55625BFA5DD44551.title: "Tekutiny"
	quest.55662470D094F96F.quest_desc: [
		"&bYUNG's Better Desert Temples&r udělal z pouštní pyramidy velký chrám s chodbami, pastmi a hrobkami."
		"Hledej ho v poušti. Uvnitř máš &eÚnavu z těžby&r – nejde tedy prostě prokopat zdi."
		""
		"&cPozor na pasti a na truhly s nástrahou.&r"
	]
	quest.55662470D094F96F.title: "Pouštní chrám"
	quest.5592A0EC5B8695EA.quest_desc: [
		"Vystup ze sedačky ve vlaku víc než 5000 bloků od místa, kde jsi nastoupil."
		"&aVlaky jezdí i tam, kde svět není načtený (v nenačtených chuncích). Zastaví tam ve stanicích i na červené. Jen stroje na vlaku, třeba vrtáky, tam nepracují.&r"
	]
	quest.5592A0EC5B8695EA.title: "Dlouhá cesta"
	quest.559BA1FCACACD0C2.quest_desc: [
		"Základní motor má na velké stroje málo síly. Pokročilý motor (&eAdvanced Motor&r) dá 4× víc síly (SU) a může se točit 2× rychleji."
		""
		"Vyrobíš ho z mosazného pouzdra, nabitého železa, hřídele a zlatých nugetů."
		""
		"&aNejsilnější je zesílený motor (&eReinforced Motor&r) z nabitých diamantů.&r"
	]
	quest.559BA1FCACACD0C2.title: "Pokročilý motor"
	quest.55A662AB1364AF69.quest_desc: [
		"Zatím jsi jen sbíral a analyzoval. Teď z DNA poprvé vytvoříš život!"
		"Kultivátor (&eCulture Vat&r) vypěstuje vejce, injekci s embryem savce nebo živé semínko."
		"Vlož DNA a jako palivo biohmotu. Vyrobíš ho ze skla, slizu, kbelíku vody a železa."
		"&cNěkdy se pokus nepovede: kultivátor se rozbije a vyleze z něj zmetek Failuresaurus. Neměj ho v domě.&r"
	]
	quest.55A662AB1364AF69.quest_subtitle: "Pokročilý"
	quest.55A662AB1364AF69.title: "Kultivátor"
	quest.55AC32997802A54E.quest_desc: [
		"Optický senzor (&eOptical Sensor&r) vidí bloky před sebou až na 15 bloků. Síla signálu záleží na vzdálenosti překážky."
		"Hodí se na hlídání přistání nebo proti nárazu do skály. Filtrem nastavíš, na jaké bloky reaguje."
	]
	quest.55AC32997802A54E.title: "Optický senzor"
	quest.55C53E418A4CE4F3.quest_desc: [
		"Jízdní řád (&eTrain Schedule&r) je seznam příkazů pro strojvůdce: kam jet a na co čekat. Robustní plát a papír dají 4 jízdní řády."
		"Vezmi ho do ruky, klikni pravým tlačítkem a přidávej řádky. Hlavní příkaz je &eTravel to Station&r (jeď do stanice). Za něj dej podmínku, třeba &eScheduled Delay&r (počkej) nebo &eCargo Inactivity&r (počkej na konec nakládky)."
		"Zapni &eLoop Forever&r a vlak bude jezdit pořád dokola."
		"&aV názvu stanice můžeš použít hvězdičku *. Například „Nádraží *“ znamená jakékoli nástupiště, jehož jméno začíná slovem Nádraží. Vlak si vybere nejbližší volné.&r"
	]
	quest.55C53E418A4CE4F3.title: "Jízdní řád"
	quest.55CB7CD09C642505.quest_desc: [
		"Použij na oltář golema lahev dračího dechu. Probudí se obří golem z kamene Endu (&eEndstone Golem&r)."
		"Je to boss. Přijď s nejlepší zbraní, zbrojí a dostatkem léčení."
	]
	quest.55CB7CD09C642505.title: "Golem z kamene Endu"
	quest.55D084244BB3FB9B.quest_desc: [
		"Když stroje chtějí víc síly, než zdroje dávají, síť se přetíží a zastaví celá. Tyto díly ji ochrání."
		""
		"Přetěžovací spojka (&eOverstress Clutch&r) se při přetížení po chvíli rozpojí. Zpátky ji spojíš montážním klíčem (&eWrench&r)."
		""
		"Střižný kolík (&eShear Pin&r) se při přetížení zlomí a musíš ho vyměnit. Vyrobíš ho, když mechanickou pilou rozřežeš hřídel."
	]
	quest.55D084244BB3FB9B.title: "Pojistky proti přetížení"
	quest.55ED5A9B989E3E22.quest_desc: [
		"Nové plodiny nejdřív najdeš divoce rostoucí. Divoký ječmen (&eWild Barley&r) roste na pláních, u řek a v savaně, divoký oves (&eWild Oat&r) na loukách a v tajze."
		"Když divokou rostlinu rozbiješ, dostaneš úrodu i semínka. Semínka pak zasaď na ornici jako pšenici."
		"&aTip:&r Plodiny Farm \\& Charm rostou rychleji, když na ně prší."
	]
	quest.55ED5A9B989E3E22.title: "Ječmen a oves"
	quest.55EF8C4102014A22.quest_desc: [
		"Sušák (&eDrying Rack&r) vyrobíš z prken a provázků. Pomalu suší, co na něj položíš."
		"Usuš na něm ovoce a dostaneš sušené ovoce (&eDried Fruit&r)."
	]
	quest.55EF8C4102014A22.title: "Sušák"
	quest.55FCB17B7921727D.quest_desc: [
		"Teď to spoj dohromady: stanice, která sama těží ropu, destiluje ji a pohání motory."
		""
		"1. Ropné pumpy (nejlépe na nalezišti &eBottomless Supply&r) → čerpadlo → nádrž s ropou."
		"2. Destilační věž s ohňodorty. Ohňohořáky může krmit pokladač (&eDeployer&r) nebo mechanická paže. Ze 100 mB ropy tak dostaneš 75 + 75 mB místo 50 + 50."
		"{@pagebreak}"
		"3. Naftu ukládej do sudů na ropu (&eOil Barrel&r). Sudy položené k sobě se spojí do většího (nejvýš 3 bloky široko). Můžeš je dát nastojato i naležato."
		"4. Ze sudů veď naftu potrubím do obřích nebo modulárních motorů."
		"5. Benzín pal v hořácích, které hřejí tyglíky nebo věž, nebo v dalších motorech."
		"{@pagebreak}"
		"Inženýrskými brýlemi zkontroluj, kolik síly (SU) stanice dává a kolik jí stroje berou."
		""
		"&aTip: Alternátor z modu &bCreate Crafts \\& Additions&r změní rotaci na elektřinu (FE).&r"
		""
		"&cHořlavé kapaliny drž dál od ohně a lávy.&r"
	]
	quest.55FCB17B7921727D.quest_subtitle: "Expert"
	quest.55FCB17B7921727D.title: "Naftová elektrárna"
	quest.5606CA999C20A31D.quest_desc: [
		"Obohacovací komora udělá z uhlí obohacený uhlík (&eEnriched Carbon&r) a z redstonu obohacený redstone (&eEnriched Redstone&r)."
		"V infuzéru dá 1 uhlí jen 10 jednotek uhlíku, ale 1 obohacený uhlík 80. U redstonu je to stejné. Ušetříš tak hodně surovin."
		"&aTip:&r Diamant infuzér bere jen jako obohacený (&eEnriched Diamond&r) nebo jako prach. Obohať si pár diamantů na zesílenou slitinu."
	]
	quest.5606CA999C20A31D.title: "Obohacené materiály"
	quest.561E6B7F8FEF77EB.quest_desc: [
		"Digitální horník (&eDigital Miner&r) těží bloky v okolí bez kopání tunelů – až do vzdálenosti 32 bloků."
		"V okně nastav filtry (co má těžit, třeba jen rudy), poloměr a výšku. Volba &eSilk touch&r těží celé bloky."
		"Vytěžené věci ukládá do sebe. Automatický výstup (&eAuto-eject&r) je pošle do truhly nebo transportéru."
		"&aTip:&r Horník bere hodně energie. Vylepšení rychlosti ho zrychlí."
	]
	quest.561E6B7F8FEF77EB.title: "Digitální horník"
	quest.564FF7F92E6DF685.quest_desc: [
		"Krovky (&eElytra&r) visí v rámu na lodi u města v Endu. Město najdeš na vnějších ostrovech."
		"S krovkami plachtíš vzduchem. Ohňostroj (&eFirework Rocket&r) tě v letu urychlí."
		"Mod &bElytra Slot&r ti dá zvláštní slot na krovky, takže můžeš nosit i hrudní plát."
	]
	quest.564FF7F92E6DF685.title: "Krovky"
	quest.567A11584CD52916.quest_desc: [
		"Levitit je materiál, který sám nadnáší. Začíná prachem z endového kamene (&eEnd Stone Powder&r)."
		"Rozdrť endový kámen v drtících kolech. &cEndový kámen najdeš až v Endu.&r"
		"Pak je smíchej v míchačce: do tyglíku dej 4 prachy, 2 zinkové nugety a vodu, pod tyglík ohřátý ohňohořák. Vznikne tekutá směs levititu (&eLevitite Blend&r)."
	]
	quest.567A11584CD52916.title: "Prach z endového kamene"
	quest.56919A48FEC3B956.quest_desc: [
		"Pokročilý solární generátor (&eAdvanced Solar Generator&r) vyrábí víc energie než obyčejný."
		"Vyrobíš ho ze 4 obyčejných solárních generátorů, infuzní slitiny a železa."
		"&aTip:&r Stejně jako obyčejný funguje jen přes den pod volnou oblohou."
	]
	quest.56919A48FEC3B956.title: "Pokročilý solár"
	quest.569C5E450B1E7054.quest_desc: [
		"Teď vyrobíš nejsilnější kov nebe. Recept: 5 duhových mraků, očarovaný gravitit, zanit, ambrosium a jadeit."
		"Stratusovým ingotem vylepšíš gravititovou výbavu na kovářském stole."
	]
	quest.569C5E450B1E7054.quest_subtitle: "Expert"
	quest.569C5E450B1E7054.title: "Stratusový ingot"
	quest.56B3DAC22DD15156.quest_desc: [
		"Zhušťovací vylepšení (&eCompacting Upgrade&r) samo zhušťuje věci. Základní verze zvládá jen recepty 2×2, pokročilá i 3×3."
		"Vyrobíš ho ze základu vylepšení, pístů, železa a redstonu. Jde i ze zhušťovacího vylepšení pro batoh (&bSophisticated Backpacks&r) a prken."
		"&aTip:&r Vylepšení &eVoid Upgrade&r maže nechtěné věci – třeba hlínu z kopání."
	]
	quest.56B3DAC22DD15156.title: "Zhušťování a mazání"
	quest.56CB72AB7F148E92.quest_desc: [
		"V pevnosti žijí skřetí rytíři (&eGoblin Knight&r). Z jejich brnění padají úlomky (&eArmor Shard&r)."
		"V hrobce na konci pevnosti se probudí rytířští fantomové (&eKnight Phantom&r). Je jich víc a musíš porazit všechny."
		"Po posledním z nich zůstane trofej. Teprve potom tě pustí věž uprostřed temného lesa."
	]
	quest.56CB72AB7F148E92.title: "Rytířští fantomové"
	quest.56D0FDEEF7180644.quest_desc: [
		"&eVýtahová kladka&r (&eElevator Pulley&r) vozí kabinu mezi patry. Na kabinu přilep redstonový kontakt (&eRedstone Contact&r), druhý dej proti němu v patře."
		"Roztoč kladku a klikni na ni. Kontakty v patrech se změní na &ekontakty výtahu&r. Redstone puls na kontaktu zavolá výtah, posuvné dveře na kabině se otevírají samy."
	]
	quest.56D0FDEEF7180644.title: "Výtah"
	quest.57311FCC179F9ABD.quest_desc: [
		"Do pokoje patří i nízké křeslo a polštáře."
		""
		"Nízké křeslo (&eWhite Floor Chair&r) vyrobíš ze 2 dřevěných půlbloků a bílé vlny. Sedí se na něm stejně jako na křesle."
		""
		"Polštář (&eWhite Cushion&r) je z prken a vlny. Recept dá 2 kusy. Polštář je měkký a dá se na něm skákat."
		""
		"&aTip: Když k nízkému křeslu přidáš v mřížce dřevěný půlblok, vznikne z něj normální křeslo.&r"
	]
	quest.57311FCC179F9ABD.title: "Polštáře a nízké křeslo"
	quest.574D2A5C908D24BA.quest_desc: [
		"Polštář (&eWhite Cushion&r) je z vlny a pírek, povlečení (&eWhite Sheet&r) ze 3 vln. Přebarvíš je barvivem."
		"Kliknutím polštářem nebo povlečením na nábytek změníš jeho vzhled, třeba barvu sedáku nebo ubrusu."
	]
	quest.574D2A5C908D24BA.title: "Polštáře a povlečení"
	quest.5758FCAE6CBC0873.quest_desc: [
		"Vlakové dveře (&eTrain Door&r) jsou dveře do vagonů. Vyrobíš je z dřevěných dveří a vlakového pouzdra."
		"V základním režimu se samy otevřou, když vlak zastaví, a zavřou se, když se rozjede."
		"&aDo podlahy nebo střechy se hodí vlakový poklop (&eTrain Trapdoor&r).&r"
	]
	quest.5758FCAE6CBC0873.title: "Vlakové dveře"
	quest.579935AC91050B3E.quest_desc: [
		"Rudý magnet (&eScarlet Magnet&r) přitahuje kovové bloky, modrý (&eAzure Magnet&r) je odpuzuje."
		"Pohne až 27 bloky najednou. Musí být kovové, nebo k nim přilepené slizovým blokem."
		"&aDosah magnetu zvětšíš ingotem stejné barvy, ingotem opačné barvy ho zmenšíš.&r"
	]
	quest.579935AC91050B3E.title: "Magnety"
	quest.57D089E0D258B85B.quest_desc: [
		"Diamantový meč je velký skok proti železnému. Vyrobíš ho ze 2 diamantů a klacku."
		"Očaruj ho. Nejlepší jsou &eSharpness&r (víc poškození) a &eLooting&r (víc kořisti z příšer)."
	]
	quest.57D089E0D258B85B.title: "Diamantový meč"
	quest.57D26374CE323468.quest_desc: [
		"Brk hledače (&ePathfinder's Quill&r) najde biom, který je na něm napsaný. Až ho najde, změní se v mapu."
		"Koupíš ho od kartografa ve vesnici nebo od potulného obchodníka."
	]
	quest.57D26374CE323468.title: "Brk hledače"
	quest.57D84BC312FCB592.quest_desc: ["Plentifin (&eRaw Plentifin&r) žije v teplých a vlažných oceánech a v jeskyních (bujné a krápníkové)."]
	quest.57D84BC312FCB592.title: "Plentifin"
	quest.57F5996D923AE0B8.quest_desc: [
		"Další tři stoly &bChipped&r:"
		"Sklářský (&eGlassblower&r): sklo a tabulky skla. Tkalcovský (&eLoom Table&r): vlna a koberce. Kutilský (&eTinkering Table&r): lucerny, redstonové lampy, mříže a redstonové pochodně."
		"Sklářský potřebuje vysokou pec, tkalcovský vlnu a kutilský redstone."
	]
	quest.57F5996D923AE0B8.title: "Sklo, vlna a lampy"
	quest.57FFFCE7E7599421.quest_desc: [
		"Diamantový nůž vylepšíš na kovářském stole netheritovým ingotem a šablonou vylepšení, stejně jako jiné nástroje."
		"Je to nejlepší a nejodolnější nůž."
	]
	quest.57FFFCE7E7599421.title: "Netheritový nůž"
	quest.5826FAB144DFCD07.quest_desc: [
		"Nixie deska (&eNixie Board&r) je plochý svítící displej na text. Umí delší nápisy i víc řádků."
		""
		"Vyrobíš ji ze 6 leštěných růženínů a železného plátu. Dostaneš 8 kusů."
		""
		"Desky vedle sebe se spojí do delšího displeje. Desky nad sebou nebo pod sebou vytvoří vyšší displej."
		"{@pagebreak}"
		"Text nastavíš jmenovkou nebo psací podložkou (&eClipboard&r). Montážním klíčem přepínáš režimy zobrazení – některé ukážou víc znaků a víc řádků. Barvivem přebarvíš celý displej najednou."
		"{@pagebreak}"
		"Expertní trik: displejový vysílač (&eDisplay Link&r). Polož ho na zdroj informací, třeba na kukačkové hodiny nebo na sklad, a propoj ho s nixie deskou. Displej pak sám ukazuje aktuální stav. Jak se propojuje, ukáže ponder vysílače."
		""
		"&aTip: Takhle uděláš ceduli, která ukazuje, co se děje ve tvé továrně.&r"
	]
	quest.5826FAB144DFCD07.quest_subtitle: "Expert"
	quest.5826FAB144DFCD07.title: "Živé nápisy"
	quest.5837E5A1723204E8.quest_desc: [
		"&eChytrý detektor&r (&eSmart Observer&r) hlídá obsah kontejnerů, pásů, šachet a potrubí. S filtrem jen konkrétní věci."
		"U trychtýře vyšle puls pokaždé, když jím projde předmět."
	]
	quest.5837E5A1723204E8.title: "Chytrý detektor"
	quest.58471EA96B068B82.quest_desc: ["Třetí stupeň (&eStack Upgrade Tier 3&r) dá 8× víc. Potřebuje 8 diamantových bloků."]
	quest.58471EA96B068B82.title: "Stoh III"
	quest.58503B48E218D7A5.quest_desc: [
		"&eRuční klika&r (&eHand Crank&r) je nejjednodušší zdroj rotace. Vyrobíš ji ze 3 prken a andezitové slitiny."
		"Polož ji na hřídel a drž pravé tlačítko. Se Shiftem se točí opačně."
		"Každý zdroj dává &erychlost&r (otáčky, RPM) a &esílu&r (stres, jednotka SU). Klika dá 32 RPM a 256 SU. &cPři točení ti ubývá jídlo,&r na stálý provoz postav mlýnské kolo."
	]
	quest.58503B48E218D7A5.title: "Ruční klika"
	quest.58642FBCBDB51E0C.quest_desc: [
		"Klecová lampa (&eYellow Andesite Cage Lamp&r) je světlo v kovové kleci. Hodí se do továren a na lávky."
		""
		"Nejdřív lisem (&eMechanical Press&r) vylisuj z andezitové slitiny plát (&eAndesite Alloy Sheet&r). Do mřížky dej shora dolů: andezitovou slitinu, pochodeň a plát."
		""
		"Barvu lampy určí to, co dáš doprostřed: pochodeň = žlutá, redstonová pochodeň = červená, pochodeň duší = modrá, svítivé bobule = zelená."
		""
		"&aTip: Lampy z ostatních kovů se dělají stejně, jen z nugetu a plátu daného kovu.&r"
	]
	quest.58642FBCBDB51E0C.title: "Klecové lampy"
	quest.588AC31D95CF3FC8.quest_desc: ["Vylepši mystické místo na úroveň 5. Je to drahá stavba, ale spokojenost kolonie vyskočí nahoru."]
	quest.588AC31D95CF3FC8.title: "Divy světa"
	quest.5896E1B4AAE27CA2.quest_desc: [
		"Do klece (&eCage&r) chytíš malé zvíře a přeneseš ho. Některá zvířata musíš nejdřív ochočit."
		"Klec můžeš i položit jako blok – zvíře v ní bude vidět."
	]
	quest.5896E1B4AAE27CA2.title: "Klec"
	quest.58D879F7901B86FD.quest_desc: [
		"Krumpáčem kopeš kámen a rudy. Bez krumpáče z kamene nic nedostaneš."
		"Vyrobíš ho ze 3 prken a 2 klacků. Dřevěný krumpáč se brzy rozbije, tak ho hned vyměň za kamenný."
	]
	quest.58D879F7901B86FD.title: "Dřevěný krumpáč"
	quest.58FAE413745BCD38.quest_desc: [
		"Obří naftový motor (&eHuge Diesel Engine&r) dá ze všech motorů nejvíc síly z jednoho bloku a točí se nejrychleji. Vyrábí se z parního motoru."
		""
		"Klikni hřídelí (&eShaft&r) na motor a hřídel se sama položí na správné místo, dva bloky před motor. Palivo přiveď potrubím."
		""
		"Jakmile motor dostane palivo, hřídel se začne točit. Redstonový signál ho zastaví."
		""
		"&aTip: Nejsilnější palivo je nafta. Podrž Alt nad kbelíkem paliva a uvidíš, kolik dá který motor.&r"
	]
	quest.58FAE413745BCD38.title: "Obří naftový motor"
	quest.590E71ED32E32490.quest_desc: [
		"Lis nad tyglíkem slisuje 2 pazourky, štěrk a 100 mB lávy na andezit. Štěrk i pazourek udělá mlýnský kámen z dlažebního kamene."
		"Lávu dodá hadicová kladka v lávovém moři v Netheru (při aspoň 10 000 blocích lávy se nevyčerpá). Nebo ji udělá míchačka nad přehřátým ohňohořákem z dlažebního kamene."
		"Tím máš andezit na slitinu bez kopání."
	]
	quest.590E71ED32E32490.title: "Andezit bez těžení"
	quest.591982ED21BD8D91.quest_desc: [
		"Kohoutek (&eTap&r) z mědi, páky a dvou kbelíků vody je zdroj vody v kuchyni."
		"Dřez (třeba &eOak Sink&r) dokončí kuchyni. Druhy dřezů najdeš v JEI."
	]
	quest.591982ED21BD8D91.title: "Kohoutek a dřez"
	quest.592419D304B54525.quest_desc: [
		"Nákladní vzducholoď (&eCargo Airship&r) uveze celý sklad – má navíc 4 velké přihrádky."
		"Výroba: vzducholoď, trup a 4 truhly."
		"&cJe pomalá, spotřebuje hodně paliva a nemá místo na zbraň.&r"
	]
	quest.592419D304B54525.title: "Nákladní vzducholoď"
	quest.59244C08FE6AAB33.quest_desc: [
		"Obsidiánový TNT (&eObsidian TNT&r) vybuchne s poloměrem 12 bloků – obyčejný TNT má 4."
		"Vyrobíš ho ze 3 TNT a 6 obsidiánu."
		"&cPozor:&r Používej ho daleko od základny a zvířat."
	]
	quest.59244C08FE6AAB33.title: "Obsidiánový TNT"
	quest.59570E1F3747B5BA.quest_desc: [
		"V rohu obrazovky máš minimapu (mod &bXaero's Minimap&r). Klávesa &eM&r otevře velkou mapu světa."
		"Klávesa &eN&r vytvoří bod (waypoint), třeba u tvého domu. &eU&r otevře seznam bodů a &eY&r nastavení minimapy."
		"Když umřeš, mapa ti ukáže místo smrti."
		"Kompas ukazuje ke spawnu – k místu, kde ses poprvé objevil. Díky &bQuarku&r funguje i v Netheru: ukazuje k portálu, kterým jsi přišel."
		"Úkol: vyrob si kompas ze 4 železných ingotů a redstonu."
	]
	quest.59570E1F3747B5BA.title: "Mapa a body"
	quest.59780CB512650019.quest_desc: [
		"Nástroje a brnění vylepšíš na kovářském stole: šablona netheritového vylepšení + netheritový nástroj + ingot &eNetherite-Iron Ingot&r."
		"Výsledek je &eNetherite-Iron Pickaxe&r. Další stupně vylepšuješ stejně, vždy z předchozího stupně."
	]
	quest.59780CB512650019.title: "Lepší nástroje"
	quest.597AD28D02201790.quest_desc: [
		"Teď už posuvný závěr nestačí – dělo s ním vydrží nejvýš 4 nálože. Šroubový závěr dělo neoslabí."
		""
		"Ocel (&eSteel Ingot&r) je nejlepší běžný kov na děla. V míchačce s ohřevem vzniknou ze 2 železných ingotů a uhlí 2 ocelové ingoty. Je to stejná ocel jako z Mekanismu."
		""
		"Šroubový závěr (&eSteel Screw Breech&r) odlij z oceli ve formě &eScrew Breech Cast Mould&r a vyvrtej. Pak do něj klikni zámkem (&eSteel Screw Lock&r)."
		""
		"Odemkneš ho rotací. Pak ho odsuň Create strojem, dělo nabij a závěr zase zavři."
	]
	quest.597AD28D02201790.title: "Šroubový závěr"
	quest.59ABC3840F7542C8.quest_desc: [
		"&bApplied Energistics 2&r (AE2) je digitální úložiště a automatická výroba. Začíná se certusovým křemenem (&eCertus Quartz Crystal&r) z meteoritu."
		"Podrobný návod krok za krokem najdeš v kapitole &bApplied Energistics 2&r."
	]
	quest.59ABC3840F7542C8.title: "AE2: certusový křemen"
	quest.59B4787CA94DCEF8.quest_desc: [
		"Výrobní mřížka (&eCrafting Grid&r) je mřížka s pracovním stolem. Vyrábíš v ní přímo ze surovin v síti."
		"Vyrobíš ji z mřížky, pokročilého procesoru a pracovního stolu."
		"&aTip:&r Tlačítko + u receptu v JEI přenese recept rovnou do mřížky."
	]
	quest.59B4787CA94DCEF8.title: "Výrobní mřížka"
	quest.59BADBC5062480B3.quest_desc: [
		"Pastevci chovají zvířata. Kurník (&eChicken Farmer's Hut&r) dává vejce, pírka a maso, kravín (&eCowhand's Hut&r) mléko, kůži a hovězí."
		"Bloky budov: prkna, nástroj stavby a vajíčko (kurník) nebo syrový steak (kravín)."
		"&cPastevec začne pracovat, až mu přivedeš aspoň 2 zvířata.&r Potřebuje sekeru a krmení (slepicím semínka, kravám pšenici)."
	]
	quest.59BADBC5062480B3.title: "Kurník a kravín"
	quest.59D959065CE94F1A.quest_desc: ["Pastýřský koláč (&eShepherd's Pie&r) slož ze tří kusů pečeného skopového, pečených brambor, cibule, mléka a misky."]
	quest.59D959065CE94F1A.title: "Pastýřský koláč"
	quest.59DD68CCAC81C3E3.quest_desc: [
		"Rybí olej (&eFish Oil&r) vyrobíš z lahvičky a 4 ryb &eBlobfish&r. Ty žijí hluboko v oceánu."
		"Olejem ochočíš orla."
	]
	quest.59DD68CCAC81C3E3.title: "Rybí olej"
	quest.59EFCB07F0755BFC.quest_desc: [
		"Akáciový květ (&eAcacia Blossom&r) občas padá z &eAkáciového listí&r. Je vzácný (asi jednou ze 130 listů)."
		"Stejně jako u banánů nepoužívej nůžky ani Něžný dotek."
	]
	quest.59EFCB07F0755BFC.title: "Akáciový květ"
	quest.59F61604EE325A37.quest_desc: [
		"Stůl na překlady (&eSpelunkery Table&r) nejde vyrobit. Najdeš ho jen v podzemní chatce."
		"Vytěž ho a odnes si ho domů."
	]
	quest.59F61604EE325A37.title: "Stůl na překlady"
	quest.5A039619F7F07405.quest_desc: [
		"Octový hrnek (&eVinegar Pot&r) slož jako kvasnicový, jen přidej dva kusy ovoce."
		"Až začne bublat, nabereš z něj lahví ocet (&eVinegar&r)."
	]
	quest.5A039619F7F07405.title: "Ocet"
	quest.5A0528F13AECD5F2.quest_desc: [
		"Create má i nástroje: poznámky, kufřík, potápěčskou výstroj, dalekosáhlou ruku a dělo na brambory."
		"Na konci kapitoly se naučíš uložit stavbu do &eschématu&r a nechat ji postavit &eschématikanónem&r."
	]
	quest.5A0528F13AECD5F2.quest_subtitle: "Začátečník"
	quest.5A0528F13AECD5F2.title: "Výbava inženýra"
	quest.5A0A79D67A15456D.quest_desc: [
		"Síťka z modu &bLuminous Butterflies&r má stejný recept. U výsledku receptu přepni na druhou verzi."
		"Motýli z Luminous Butterflies se ale v tomto packu neobjevují. Tahle síťka je jen do sbírky."
	]
	quest.5A0A79D67A15456D.title: "Druhá síťka"
	quest.5A179C358C71DE51.quest_desc: [
		"Plamenný očarovávač (&eBlaze Enchanter&r) očarovává jako očarovací stůl. Místo tvých úrovní ale bere tekuté zkušenosti."
		""
		"Vyrobíš ho na kovářském stole: ohňohořák (&eBlaze Burner&r) + očarovací stůl + kovářská šablona plamene. Šablonu najdeš v truhlách v Netheru."
		""
		"Na panelu nastav úroveň očarování (u očarovacího stolu je nejvýš 30) a vlož předmět. &aVyšší úroveň není vždy lepší – některá očarování se pak neobjeví.&r"
		""
		"Víc najdeš v kapitole Průmysl."
	]
	quest.5A179C358C71DE51.title: "Plamenný očarovávač"
	quest.5A1D7F9812458614.quest_desc: [
		"Sesbírej všechny plážové poklady a namíchej všechny koktejly."
		"Odměnou je prapor (&eCompletionist Banner: Beachparty&r). Postavený dává hráčům v okolí dýchání pod vodou."
	]
	quest.5A1D7F9812458614.quest_subtitle: "Expert"
	quest.5A1D7F9812458614.title: "Král pláže"
	quest.5A334CDA9BCCFC4A.quest_desc: [
		"Síť teď umí vyrábět sama, když něco chybí. Vylepšení výroby (&eAutocrafting Upgrade&r) vlož do exportéru, rozhraní nebo konstruktoru."
		"Když chybí věc, kterou má zařízení posílat, síť ji sama nechá vyrobit."
		"&aTip:&r Exportér s tímto vylepšením a regulátorem udrží v truhle stálou zásobu."
	]
	quest.5A334CDA9BCCFC4A.quest_subtitle: "Expert"
	quest.5A334CDA9BCCFC4A.title: "Výroba na požádání"
	quest.5A3D3036F9DDDDA6.quest_desc: [
		"Olej sám je slabý. Na silnější bionaftu potřebuješ ještě etanol, a ten vzniká kvašením."
		""
		"Víko na tyglík (&eBasin Lid&r) udělá z tyglíku kvasnou nádobu. Vyrobíš ho ze 3 andezitových slitin a hodin. Polož ho na tyglík. Do tyglíku pak vhoď suroviny a víko je samo zpracuje, bez lisu i míchačky."
		""
		"&aTip: Recepty ukáže JEI v záložce Basin Processing. Takhle uděláš i těsto z mouky a vody.&r"
	]
	quest.5A3D3036F9DDDDA6.title: "Víko na tyglík"
	quest.5A47488E5A05A688.quest_desc: [
		"Rafinerie (&eFuel Refinery&r) mění ropu na raketové palivo (&eFuel Bucket&r). Potřebuje energii."
		"Ropu dej do levého slotu. Palivo pak nabereš do kbelíku."
		"Na start potřebuješ 3 kbelíky paliva. &aRaketa spálí i naftu a bionaftu z Create Diesel Generators (&eDiesel Bucket&r, &eBiodiesel Bucket&r).&r"
	]
	quest.5A47488E5A05A688.title: "Raketové palivo"
	quest.5A5846DC72BD3EAB.quest_desc: ["Usmaž cokoli na pánvi, kterou držíš v ruce. Quest se splní sám, jakmile se ti to povede."]
	quest.5A5846DC72BD3EAB.title: "Smažení na pánvi"
	quest.5ACFF749530A9E0E.quest_desc: [
		"Kruorit (&eCruorite&r) je vzácný kov z modu &bJust In Nether&r."
		"Získáš ho přetavením suroviny &eKindarx&r ve vysoké peci. &eKindarx&r padá z tvora &eBullkindar&r v Netheru."
		"&cV tomto packu ho zatím na nic nepoužiješ.&r Zbraně z něj vyrábí jiný mod, který v packu není. Ber ho jako sběratelský kov."
	]
	quest.5ACFF749530A9E0E.title: "Kruorit"
	quest.5AD2ACD78CF935A7.quest_desc: [
		"&bCreate: Mechanical Companion&r přidává mechanického vlka. Chrání tě a dá se vylepšovat moduly."
		""
		"Základní deska (&eMechanical Wolf Motherboard&r) vzniká sekvenční montáží na měděném plátu: zelené barvivo, lis, komparátor a elektronka."
		""
		"&aVíc najdeš v kapitole Pohyb a výbava.&r"
	]
	quest.5AD2ACD78CF935A7.quest_subtitle: "Robotický parťák"
	quest.5AD2ACD78CF935A7.title: "Mechanický vlk"
	quest.5ADF5B2B71E15CF7.quest_desc: [
		"Stavitel dokončil svou budovu na úrovni 1. Kolonie opravdu začala!"
		"Pravidlo úrovní: stavitel postaví jen budovu do stejné úrovně, jakou má jeho budova. Na budovu úrovně 3 potřebuješ stavitelovu budovu úrovně 3."
		"Co dál (v tomto pořadí): krčma (bydlení), dřevorubec (dřevo), farma a jídelna (jídlo), důl (kámen a rudy) a domy."
	]
	quest.5ADF5B2B71E15CF7.quest_subtitle: "Začátečník"
	quest.5ADF5B2B71E15CF7.title: "Stavitel má dům"
	quest.5B27FD17D99AD1E0.quest_desc: [
		"Jeden eskalátor už máš. Teď postav celou věž: vystoupej o 100 bloků výš jen po jedoucích eskalátorech."
		""
		"Navazuj eskalátory na sebe. Každý potřebuje pohon na svých koncích. Doprostřed eskalátoru hřídel přidat nejde."
		""
		"&aInženýrské brýle (&eEngineer's Goggles&a) ukážou, jestli máš dost síly pro všechny eskalátory.&r"
	]
	quest.5B27FD17D99AD1E0.quest_subtitle: "Expert"
	quest.5B27FD17D99AD1E0.title: "Schody do nebe"
	quest.5B351B1845BC8BA7.quest_desc: [
		"Doteď jsi stavěl na Zemi. Teď konečně poletíš! Raketa 1. stupně (&eTier 1 Rocket&r) doletí na Měsíc a na oběžnou dráhu Země."
		"Postav odpalovací rampu (&eLaunch Pad&r) a raketu polož doprostřed."
		"Shift + pravé tlačítko na raketu otevře její inventář. Nalij do ní 3 kbelíky paliva."
		"Nastup (pravé tlačítko) a stiskni mezerník. Nahoře si vybereš, kam poletíš."
	]
	quest.5B351B1845BC8BA7.quest_subtitle: "Pokročilý"
	quest.5B351B1845BC8BA7.title: "Raketa 1. stupně"
	quest.5B393551B8E664E0.quest_desc: [
		"Cínovou rudu (&eTin Ore&r) těžíš podobně jako osmium. Vytěžený cín (&eRaw Tin&r) přetav na ingot."
		"Cín potřebuješ na jetpack a na bronz. Cínový prach je i zdroj infuze v infuzéru."
		"&aTip:&r Cínový prach (&eTin Dust&r) dostaneš z obohacovací komory nebo z drtiče."
	]
	quest.5B393551B8E664E0.title: "Cín"
	quest.5B4A7A1391A38353.quest_desc: ["Redstonový randomizér (&eRedstone Randomizer&r) pošle signál náhodně doleva nebo doprava."]
	quest.5B4A7A1391A38353.title: "Náhodný signál"
	quest.5B7F620764D604C5.quest_desc: [
		"Kompresor (&eCompacting Upgrade&r) sám skládá věci do bloků, třeba 4 kusy do jednoho bloku. Ušetří místo."
		"Obyčejný umí jen recepty 2 × 2. Pokročilý (&eAdvanced Compacting Upgrade&r) umí i 3 × 3, třeba 9 ingotů na blok."
	]
	quest.5B7F620764D604C5.title: "Kompresor"
	quest.5B9158E319CCFFC9.quest_desc: ["Devilfish (&eRaw Devilfish&r) žije jen hluboko pod zemí ve vodě v jeskyních. Nežije v bujných jeskyních ani v Deep Dark."]
	quest.5B9158E319CCFFC9.title: "Devilfish"
	quest.5BAD63702B965DB3.quest_desc: [
		"Přepni plamenného kováře do režimu nanášení (&eApply&r)."
		""
		"Vlož do něj předmět a naplněnou šablonu. Kovář přenese očarování ze šablony na předmět."
		""
		"&aTip:&r I kováře umí mechanická paže plnit a vybírat."
	]
	quest.5BAD63702B965DB3.title: "Nanes šablonu"
	quest.5BBB4400C9FB0F7F.quest_desc: [
		"Filetovací nůž (&eIron Fillet Knife&r) je nástroj i zbraň."
		"Dej ho na pracovní stůl spolu s rybou z Aquaculture a dostaneš filety. Funguje i jiný nůž."
	]
	quest.5BBB4400C9FB0F7F.title: "Filetovací nůž"
	quest.5BCE8F5B57A2CBFA.quest_desc: [
		"&bMacaw's Lights and Lamps&r: pouliční lampy, lustry, papírové lampy a tiki pochodně."
		"Pouliční lampa (&eStreet Lamp Post&r) je z lucerny, dřevěného plotu a kamenné zídky. Tiki pochodeň (&eOak Tiki Torch&r) z pochodně a plotu."
		"Tiki pochodeň jde stavět do výšky. Některé lampy přebarvíš kliknutím barvivem."
	]
	quest.5BCE8F5B57A2CBFA.title: "Světla a lampy"
	quest.5BDED47FCDF71F3A.quest_desc: [
		"Ovladač (&eController&r) je srdce sítě &bRefined Storage&r. Dodává síti energii – napoj na něj zdroj FE, třeba generátor Mekanismu."
		"Podrobný postup najdeš v kapitole &bRefined Storage&r. Vyber si pro základnu jeden systém: AE2, nebo Refined Storage."
	]
	quest.5BDED47FCDF71F3A.title: "RS: ovladač"
	quest.5BFB641C2EC1276D.quest_desc: [
		"Paprsková pistole (&eRaygun&r) střílí radioaktivní paprsek. Jeden zásah ubere jen 1 bod zdraví, ale útočí 4× rychleji než běžná zbraň."
		"Cíl dostane ozáření. Jako střelivo spotřebovává uranové tyče."
	]
	quest.5BFB641C2EC1276D.title: "Paprsková pistole"
	quest.5C102FEF27D9ED53.quest_desc: [
		"Výbušný granát (&eHigh Explosive (HE) Shell&r) vybuchne o něco silněji než TNT."
		""
		"Složí ho mechanický výrobník (&eMechanical Crafter&r) z 5 železných ingotů, 2 &ePacked Guncotton&r a dřevěné desky."
		""
		"Aby vybuchl, potřebuje zapalovač. Ten je v dalším questu."
	]
	quest.5C102FEF27D9ED53.title: "Výbušný granát"
	quest.5C2CFC559A00B647.quest_desc: [
		"&bCreate Big Cannons&r přidává obří děla, která se staví z bloků. Dělo je řada bloků položená na lafetě."
		""
		"Odzadu dopředu: uzávěr (&eCannon End&r) nebo závěr (&eBreech&r), pak komory (&eCannon Chamber&r) na nálože a nakonec hlaveň (&eCannon Barrel&r)."
		""
		"Pojmy: nálož (&ePowder Charge&r) je pytel prachu, který střelu vystřelí. Komora je díl, kam patří nálože. Hlaveň je přední díl, kterým letí střela. Závěr je zadní díl, který jde otevřít."
		""
		"Postup: nejdřív jednoduché dělo z kovaného železa. Pak litinové dělo, které se odlévá do forem. Nakonec bronz a ocel, které vydrží víc náloží."
		""
		"&cŠpatně nabité dělo může prasknout a vybuchnout. Čti questy pozorně.&r"
	]
	quest.5C2CFC559A00B647.quest_subtitle: "Jak funguje dělo"
	quest.5C2CFC559A00B647.title: "Velká děla"
	quest.5C70DA530E408D14.quest_desc: [
		"Teď už nestačí jen sypat suroviny do mísy – suroviny se zpracovávají ve více krocích."
		"Mléko v míse ušlehej metlou na šlehačku (&eWhipped Cream&r). Když metlou šleháš šlehačku dál, vznikne máslo (&eButter&r). Přesný postup ukáže JEI."
	]
	quest.5C70DA530E408D14.quest_subtitle: "Pokročilý"
	quest.5C70DA530E408D14.title: "Šlehačka a máslo"
	quest.5C7D899028DFA6C1.quest_desc: [
		"Bedna (&eStorage Crate&r) pojme až 640 věcí bez ohledu na to, kolik se jich vejde do stohu."
		"Je skvělá na nástroje, výbavu a spoustu různých drobností."
	]
	quest.5C7D899028DFA6C1.title: "Bedna"
	quest.5CB7520DE09DB678.quest_desc: [
		"Jaderné palivo (&eNuclear Fuel&r) se vyrábí sekvenční montáží z radioaktivního thoria."
		""
		"Kroky: lis, pokladač přidá železný plát, lis. Postup najdeš v JEI."
		""
		"&aNa 2 reaktorové tyče potřebuješ 2 jaderná paliva, 4 reaktorová skla (&eReactor Glass&r), 4 reaktorové pláště a 6 zlatých plátů. Sestavíš je v mechanickém výrobníku.&r"
	]
	quest.5CB7520DE09DB678.title: "Jaderné palivo"
	quest.5CCACD10386AD84E.quest_desc: [
		"Kniha jeskyní (&eCave Compendium&r) je průvodce všemi šesti biomy přímo ve hře."
		"Vyrobíš ji z knihy, kamenné tabulky a zlatého nugetu."
		"&aKaždý kodex ti v ní odemkne víc informací o svém biomu.&r"
	]
	quest.5CCACD10386AD84E.title: "Kniha jeskyní"
	quest.5CD64687DC1F0763.quest_desc: [
		"&bCreate Ore Excavation&r: hluboko pod zemí jsou velké žíly rud. Vrtná souprava je těží pořád dokola."
		""
		"Hledač žil (&eOre Vein Finder&r) vyrobíš z endového oka, ametystu, redstonové rudy a 2 klacků. &cRedstonovou rudu musíš vytěžit krumpáčem s Hedvábným dotekem.&r"
		""
		"Klikni hledačem pravým tlačítkem. Řekne ti, jestli je žíla přímo v tomto chunku, poblíž, nebo jestli jsou dál jen její stopy."
		""
		"Vrtnou soupravu (&eDrilling Machine&r) složíš v mechanickém výrobníku. Polož ji v chunku se žílou. Víc najdeš v kapitole Průmysl."
	]
	quest.5CD64687DC1F0763.title: "Nekonečná ruda"
	quest.5CD86C529B6A3609.quest_desc: [
		"Lano (&eRope Coil&r) pověs pod strop a šplhej po něm."
		"Když klikneš lanem na lano, prodlouží se dolů. Se Shiftem ho zase vytáhneš nahoru."
		"Vyrobíš ho z 6 provázků."
	]
	quest.5CD86C529B6A3609.title: "Lano"
	quest.5CDC5F54A438FDC1.quest_desc: [
		"Díly děla položené rukou se nespojí. Svářečka (&eCannon Welder&r) spojí dva sousední díly."
		""
		"Klikni svářečkou pravým tlačítkem na dva sousední díly. Díly musí být ze stejného kovu a stejného typu děla."
		""
		"&cSvařené litinové dělo vydrží o 1 nálož méně.&r Lepší je dělo odlít celé. Bronz svařováním nezeslábne."
	]
	quest.5CDC5F54A438FDC1.title: "Svářečka"
	quest.5D06C9624FF81084.quest_desc: [
		"Andezitová vrtule (&eAndesite Propeller&r) je nejjednodušší pohon. Roztoč ji hřídelí a začne tlačit vzduch – a s ním celý stroj."
		"Výroba: vrtule z Create (&ePropeller&r), dřevěná deska a hřídel. V pracovním stole ji předěláš na dřevěnou vrtuli (&eWooden Propeller&r) a zase zpět."
		"Směr tahu otočíš opačnou rotací nebo montážním klíčem. Tah a proud vzduchu ukážou inženýrské brýle."
		"&cVe velké výšce a při velké rychlosti vrtule táhne slaběji.&r"
	]
	quest.5D06C9624FF81084.title: "Malá vrtule"
	quest.5D4A432770504ED0.quest_desc: [
		"Zhušťovací šuplík (&eCompacting Drawers (3-Tier)&r) sám převádí mezi úrovněmi: nugety ↔ ingoty ↔ bloky."
		"Vlož do něj třeba železné ingoty a hned si můžeš vzít i bloky nebo nugety."
		"&aTip:&r Skvělý na kovy, redstone, uhlí nebo lazurit."
	]
	quest.5D4A432770504ED0.title: "Zhušťovací šuplík"
	quest.5D60A7ADA339C299.quest_desc: [
		"Postav obyčejný generátor kamene: láva a voda stečou k sobě a vznikne dlažební kámen. Před to místo dej mechanický vrták – bude kámen těžit pořád dokola."
		"Vytěžený kámen vypadne na zem. Seber ho trychtýřem nebo pásem."
		"&aTip:&r Mlýnský kámen udělá z kamene štěrk, drtící kola ze štěrku písek a větrák s lávou z písku sklo."
	]
	quest.5D60A7ADA339C299.title: "Generátor kamene"
	quest.5D6EA2E0D3BF5031.quest_desc: [
		"&eDark Brew&r uvaříš v netheritové varně ze tří whisky: &eJoJannik Select&r, &eLilitu Single Malt&r a &eMaggoAllan, Aged&r."
		"Všechny tři whisky nejdřív uvař v měděné varně."
	]
	quest.5D6EA2E0D3BF5031.title: "Temný nápoj"
	quest.5D863EBE6E995E89.quest_desc: [
		"&eTovární měřidlo&r (&eFactory Gauge&r): skladový vysílač + precizní strojek dají 2 kusy. Před položením klikni na skladový vysílač."
		"Na balíkovači hlídá jeho truhlu a doplňuje ji ze sítě. Jinde hlídá celou síť: klikni na něj předmětem, který má sledovat."
		"Podrž na něm pravé tlačítko a nastav cílové množství. Když zásoba klesne pod cíl, měřidlo samo objedná, co je potřeba."
	]
	quest.5D863EBE6E995E89.quest_subtitle: "Expert"
	quest.5D863EBE6E995E89.title: "Tovární měřidlo"
	quest.5D9FAD78042F352D.quest_desc: [
		"Teď spojíš všechno, co jsi v Endu nasbíral. Perleťový ingot (&ePearlescent Ingot&r) je nejlepší kov z &bUnusual End&r."
		"Recept: železný ingot, lesklý krystal, kousek citrínu, prismalitový drahokam a přízračný šrot."
		"Z ingotů se vyrábí perleťová výbava a perleťový infuzér, který dává silné efekty."
	]
	quest.5D9FAD78042F352D.quest_subtitle: "Expert"
	quest.5D9FAD78042F352D.title: "Perleťový ingot"
	quest.5DF99CD6DF55B725.quest_desc: [
		"Pytlík na semínka (&eSeed Pouch&r) pojme hodně kusů jednoho druhu semínek nebo sazenic. Zabere jen jeden slot."
		"Semínka do něj dáš kliknutím. Když ho držíš, sám sbírá semínka. Kliknutím na pole zasadíš celou plochu 3 × 3."
		"Vyrobíš ho z kůže, provázku a semínka."
	]
	quest.5DF99CD6DF55B725.title: "Pytlík na semínka"
	quest.5E01B65CF36CDF34.quest_desc: [
		"Nástroj na tvary (&eShape Tool&r) vytvoří kouli, válec, jehlan, kužel, vlnu a další tvary. Vyrobíš ho ze 2 tyček a smaragdu."
		"Pravým tlačítkem otevřeš okno: vyber tvar, velikost, hlavní a výplňový blok a jestli má být dutý."
		"Skvělé na kopule, věže a velké dekorace."
	]
	quest.5E01B65CF36CDF34.quest_subtitle: "Expert"
	quest.5E01B65CF36CDF34.title: "Nástroj na tvary"
	quest.5E0D02A4BAA4F2F8.quest_desc: [
		"Přenosné rozhraní tekutin (&ePortable Fluid Interface&r) dělá totéž pro tekutiny. Vlak s nádržemi pak vozí vodu, lávu i jiné tekutiny."
		"Výroba: měděné pouzdro (&eCopper Casing&r) a šachta. Místo trychtýřů k němu připoj potrubí."
	]
	quest.5E0D02A4BAA4F2F8.title: "Cisterna"
	quest.5E5CC466FE095E67.quest_desc: [
		"Výměnný nástroj (&eExchanging Gadget&r) nahradí bloky, které už stojí, jiným blokem."
		"Nový blok vyber Shift + pravým tlačítkem a klikni na stěnu – vymění se celá plocha podle nastavené velikosti."
		"&aTip:&r Skvělé na přestavbu domu z hlíny na kámen."
	]
	quest.5E5CC466FE095E67.title: "Výměna bloků"
	quest.5E69DFE167E8EB27.quest_desc: [
		"Mimikrém (&eMimicream&r) padá z &eMimicube&r. Ten žije na vnějších ostrovech Endu u endových měst."
		"Z 8 mimikrémů a nástroje vyrobíš jeho kopii. &cKopie má ale nulovou výdrž&r – musíš ji opravit."
	]
	quest.5E69DFE167E8EB27.title: "Mimikrém"
	quest.5E77FAA5F69EDCBD.quest_desc: [
		"Stavitelovy brýle (&eBuilder's Goggles&r) si nasaď na hlavu. Uvidíš náhled budov, které se v okolí mají stavět."
		"Vyrobíš je ze zlatých nugetů, železného ingotu, tabulek skla, kůže a nástroje stavby. Náhled zapneš a vypneš klávesou v ovládání (&eToggle Goggles Preview&r)."
	]
	quest.5E77FAA5F69EDCBD.title: "Stavitelovy brýle"
	quest.5E88D30D06B5DD0E.quest_desc: [
		"Ovladač šuplíků (&eDrawer Controller&r) spojí šuplíky, které se ho dotýkají – i přes další šuplíky."
		"Když do ovladače vložíš předmět, sám ho pošle do správného šuplíku. Násypkou nebo trubkou do něj můžeš posílat celé dodávky."
		"&aTip:&r Vzdálený šuplík připojíš vylepšením &eRemote Upgrade&r."
	]
	quest.5E88D30D06B5DD0E.title: "Ovladač šuplíků"
	quest.5E9B22575735704D.quest_desc: ["Pouštní zahrádka (&eArid Garden&r) roste v suchých biomech. Dává třeba kaktusové ovoce, agáve nebo cizrnu."]
	quest.5E9B22575735704D.title: "Pouštní zahrádka"
	quest.5E9D44DB56D7F55C.quest_desc: [
		"Kvantový můstek (&eQuantum Network Bridge&r) spojí dvě sítě na libovolnou vzdálenost, i mezi dimenzemi. Přenese 32 kanálů."
		"Na každé straně postav 8 kvantových prstenců (&eME Quantum Ring&r) kolem jedné kvantové komory (&eME Quantum Link Chamber&r)."
		"Do obou komor vlož po jedné provázané singularitě (&eQuantum Entangled Singularity&r). Vzniknou v páru, když singularitu (&eSingularity&r) a endovou perlu zasáhne výbuch."
		"&aTip:&r Singularitu vyrobí kondenzátor hmoty (&eMatter Condenser&r) z 256 000 předmětů. &cObě strany musí být načtené&r – použij chunk loader."
	]
	quest.5E9D44DB56D7F55C.title: "Kvantový můstek"
	quest.5E9EE09647AEC9B3.quest_desc: [
		"&eProdlužo rameno&r (&eExtendo Grip&r) v druhé ruce výrazně prodlouží tvůj dosah. Vyrábí se v mechanickém výrobníku."
		"Normálně se opotřebovává. S tlakovou lahví na zádech bere místo toho vzduch."
	]
	quest.5E9EE09647AEC9B3.title: "Prodlužo rameno"
	quest.5EAAD655C635465C.quest_desc: [
		"Holý dron tě jen sleduje. Užitečný bude, až mu nasadíš modul: klikni na dron pravým tlačítkem s dílem v ruce."
		""
		"Trezorový díl (&eVault Component&r) vyrobíš z trezoru z Create a dá dronu úložiště. Mosazná vrtací hlava (&eBrass Drill Head&r) z něj udělá těžaře."
		""
		"Dál můžeš nasadit měděný magnet (&eCopper Magnet&r) nebo díl s vrtulí (&eFan Component&r). Ovladačem dronu moduly zapínáš a vypínáš."
	]
	quest.5EAAD655C635465C.title: "Moduly dronu"
	quest.5EF91B5C3A70AF0F.quest_desc: [
		"Medvědi z Naturalistu žijí v lesích a v tajze."
		"Hoď medvědovi &ePlástev medu&r na zem. Medvěd si ho vezme a sní."
	]
	quest.5EF91B5C3A70AF0F.title: "Med pro medvěda"
	quest.5EFF2143C816A2B5.quest_desc: [
		"Bedny a pytle uloží 9 kusů jedné plodiny do jednoho bloku. Šetří místo v truhlách."
		"Bednu cibule (&eOnion Crate&r) slož z 9 cibulí, bednu rajčat (&eTomato Crate&r) z 9 rajčat. Zpátky na plody je rozložíš na pracovním stole."
		"&aTip:&r Stejně fungují pytel rýže (&eBag of Rice&r) a balík rýže (&eRice Bale&r)."
	]
	quest.5EFF2143C816A2B5.title: "Zásoby do sklepa"
	quest.5F11788792EE1306.quest_desc: [
		"Čerstvé lístky se musí usušit. Z 9 lístků vyrob blok (&eGreen Tea Leaf Block&r) a polož ho venku na slunce."
		"Blok časem uschne. Když ho rozbiješ, dostaneš sušený zelený čaj (&eDried Green Tea&r)."
	]
	quest.5F11788792EE1306.title: "Sušení čaje"
	quest.5F41818EF64B1854.quest_desc: [
		"Yetti se objevuje v noci v zasněžených biomech."
		"&cDýchá mráz.&r Může z něj padnout &eYeti Horn&r. S ním se v chladných biomech rychleji léčíš."
	]
	quest.5F41818EF64B1854.title: "Yetti"
	quest.5F6E87E018BD0A0D.quest_desc: [
		"Farma na červy (&eWorm Farm&r) funguje jako kompostér. Házej do ní rostlinný odpad."
		"Když je plná, vybereš z ní červa."
	]
	quest.5F6E87E018BD0A0D.title: "Farma na červy"
	quest.5F71DBB1A5D94585.quest_desc: [
		"&ePrecizní strojek&r (&ePrecision Mechanism&r) se vyrábí &esekvenční montáží&r: jeden předmět projde řadou kroků, a to několikrát dokola."
		"Začni zlatým plátem na pásu. Nad pás dej 3 pokladače: první drží ozubené kolečko, druhý velké kolečko, třetí železný nuget. Kus musí celou řadou projít 5×."
		"Výsledek je náhodný: asi v 80 % případů vznikne strojek, jinak odpad (pláty, kolečka, nugety). Přesné kroky ukáže JEI."
		"&aTip:&r Pás veď do kruhu, nebo vracej rozpracovaný kus (&eIncomplete Precision Mechanism&r) na začátek řady."
	]
	quest.5F71DBB1A5D94585.quest_subtitle: "Expert"
	quest.5F71DBB1A5D94585.title: "Precizní strojek"
	quest.5F756CC64F7473BF.quest_desc: [
		"Občané občas onemocní. Nemocnice (&eHospital&r) je vyléčí a ošetří zraněné."
		"Nejdřív vyzkoumej na univerzitě &eStamina&r (stojí 1 mrkev). Blok budovy vyrobíš z prken, mrkve a nástroje stavby."
		"Nemocní chtějí jako lék obyčejné suroviny, třeba mrkev nebo brambory. Splň jejich požadavky – nemoc snižuje spokojenost celé kolonie."
	]
	quest.5F756CC64F7473BF.title: "Nemocnice"
	quest.5F7AE4589415AC7D.quest_desc: [
		"Farmář pěstuje plodiny pro celou kolonii. Farmu (&eFarm&r) vyrobíš z prken, dřevěné motyky a nástroje stavby."
		"Farmář potřebuje pole (&eField&r): balík slámy nebo dýně, kůže a tyčky. Polož ho blízko farmy na volné místo s vodou, nebo nech stavitele postavit hotové pole z nástroje stavby."
		"Pravým tlačítkem na pole vyber, co se na něm má pěstovat. Farmář zvládne jedno pole za každou úroveň farmy."
		"&cCukrovou třtinu, kaktus a bambus farmář nepěstuje – na to je plantáž.&r"
	]
	quest.5F7AE4589415AC7D.title: "Farma"
	quest.5F9F06AE1B31DB45.quest_desc: [
		"Boss mosazného dungeonu je &eEye of the Storm&r – dlouhý bouřkový had z větru."
		"Fouká silný vítr. Když se přiblíží, udeř ho."
		"Po smrti upustí mosazný klíč (&eBrass Key&r) k pokladu. V něm bývá bouřkový meč, bouřkový luk nebo plášť z mraků (&eCloud Cape&r), který dá dvojitý skok."
	]
	quest.5F9F06AE1B31DB45.title: "Oko bouře"
	quest.5FA024B0F93F7818.quest_desc: [
		"Velké nádraží potřebuje přehled. Displejová tabule (&eDisplay Board&r) ukáže, kdy přijede který vlak."
		"Postav tabuli a roztoč ji – potřebuje rotaci. Displejovým vysílačem (&eDisplay Link&r) klikni nejdřív na tabuli, pak ho polož na stanici. V jeho okně vyber &eTrain Station Summary&r."
		"&aOd teď stavíš velkou síť: víc vlaků, nástupišť a křižovatek. Další questy jsou pro zkušené.&r"
	]
	quest.5FA024B0F93F7818.quest_subtitle: "Expert"
	quest.5FA024B0F93F7818.title: "Odjezdová tabule"
	quest.5FA593FAD83C05C7.quest_desc: [
		"Poštovní schránku (&eOak Mailbox&r) si postav u domu a pojmenuj ji."
		"Z poštovní budky (&ePost Box&r) posíláš balíky do schránek ostatních. Najdi schránku podle jména, vlož věci, napiš vzkaz a odešli."
	]
	quest.5FA593FAD83C05C7.title: "Pošta mezi hráči"
	quest.5FC1BE1A7605F82F.quest_desc: [
		"&bRustic Delight&r přidává bavlnu, papriky, kávu, palačinky a smažená jídla."
		"Divoká bavlna roste v lesích, papriky a káva v džunglích. Z bavlny vyrobíš provázek."
	]
	quest.5FC1BE1A7605F82F.title: "Rustic Delight"
	quest.5FCCD52456D13626.quest_desc: [
		"Solární neutronový aktivátor (&eSolar Neutron Activator&r) využívá sluneční záření. Musí vidět oblohu a nejlépe pracuje za jasného dne."
		"Z jaderného odpadu vyrábí polonium, z plynného lithia tritium."
		"&aTip:&r Déšť jeho práci zpomalí."
	]
	quest.5FCCD52456D13626.title: "Neutronový aktivátor"
	quest.5FD18D32680AA4F3.quest_desc: [
		"&bAbnormals Delight&r propojuje Farmer's Delight s mody &bAutumnity&r a &bUpgrade Aquatic&r."
		"Slanina v sirupu (&eMaple Glazed Bacon&r) = pečená slanina a javorový sirup (&eSyrup Bottle&r). Sirup uvaříš v peci z lahve mízy (&eSap Bottle&r)."
		"Když sekerou oloupeš javorový kmen, někdy z něj vznikne kmen s mízou (&eSappy Maple Log&r). Prázdnou lahví z něj nabereš mízu."
	]
	quest.5FD18D32680AA4F3.title: "Abnormals Delight"
	quest.5FDC72F38C0B25B6.quest_desc: [
		"Tříslovina (&eTannin&r) = lahev vody, sazenice, kořenová vlákna a listí soumračného dubu. Tříslovina + kůže = upravená kůže."
		"Upravenou kůži polož na sušák (třeba &eTwilight Oak Drying Rack&r) ze 3 dřevěných půlbloků. Za 5 minut z ní je vyčiněná kůže (&eTanned Leather&r)."
		"Ze 4 vyčiněných kůží a 2 provázků vyrobíš cestovatelské boty (&eTraveller's Boots&r)."
	]
	quest.5FDC72F38C0B25B6.title: "Cestovatelská výbava"
	quest.5FDC91A00062717C.quest_desc: [
		"Ve světě občas stojí horkovzdušné balóny z modu &bCreate Aeronautics Structures&r. Jsou vzácné. Hledej je na pláních, loukách, v savaně, poušti nebo v badlands."
		"Uvnitř je hotový balón: hořáky, obaly i fyzikální sestavovač. Prohlédni si ho – je to dobrá předloha pro tvůj první let."
	]
	quest.5FDC91A00062717C.title: "Balón v divočině"
	quest.5FDFA168352932C5.quest_desc: [
		"Koryto (&eFeeding Trough&r) nakrmí zvířata za tebe. Dej do něj jejich jídlo a ona se z něj sama nakrmí a množí."
		"Když je kolem moc zvířat, přestanou se množit."
	]
	quest.5FDFA168352932C5.title: "Koryto"
	quest.600C5C3E85823812.quest_desc: [
		"Do svačinové krabice (&eLunchbox&r) dáš různá jídla. Když z ní jíš, sama vybere jídlo, které ti pomůže nejvíc – to, které jsi dlouho nejedl."
		"Nejdřív si vyrob svačinový pytlík (&eLunchbag&r) z papíru. Ten pak v pracovním stole spoj se železným blokem."
	]
	quest.600C5C3E85823812.title: "Svačinová krabice"
	quest.6015FED89C6C57FC.quest_desc: [
		"Kopí vyhynutí (&eExtinction Spear&r) je nejsilnější zbraň pravěkých jeskyní."
		"Vyrobíš ho z tektonických úlomků, vápencového kopí (&eLimestone Spear&r), jantarové zvláštnosti a těžké kosti."
		"Při zásahu zaútočí duch dinosaura. Hozené kopí vybuchne a vrátí se ti do ruky."
	]
	quest.6015FED89C6C57FC.title: "Kopí vyhynutí"
	quest.60230DA63B6145CE.quest_desc: [
		"Bastion je zřícenina z černého kamene, kde žijí piglini. Je tu hodně zlata a dobré truhly."
		"&cPozor na piglinské surovce (&ePiglin Brute&c) – zlatá zbroj na ně nefunguje a útočí hned.&r"
		"V truhlách najdeš šablonu na vylepšení netheritu. Bez ní netheritovou výbavu nevyrobíš."
	]
	quest.60230DA63B6145CE.title: "Bastion"
	quest.602B216BEBAF24D1.quest_desc: [
		"Loděnice (&eDockyard&r) staví lodě ze &bSmall Ships&r. Polož ji u vody a otevři ji."
		"V záložce stavby (&eBuild&r) vyber typ lodi a dřevo. Materiál se bere z tvého inventáře: hodně prken, bílá vlna, provázky a u většiny lodí železo. Loď se po chvíli objeví na vodě poblíž."
		"&cVoda musí být dost velká a hluboká. Loděnice napíše, kolik bloků hloubky loď potřebuje.&r"
		"Výroba loděnice: pracovní stůl, sud, papír, vlna, provázky, vodítka a železný ingot."
		"{@pagebreak}"
		"&eTypy lodí&r (cena v prknech): galéra, drakkar a dau 96, karavela 120, cog 192, briga 240, galeona 336."
		"&eGalley&r (galéra): plachta i vesla, 2 děla, taranuje bez poškození, rychlejší v teplých vodách. &eDrakkar&r: plachta i vesla, až 10 štítů na bocích, prorazí led, rychlejší ve studených vodách."
		"&eCog&r: 1 stěžeň, až 4 děla. &eBrigg&r (briga): 2 stěžně, až 6 děl. &eGalleon&r (galeona): 3 stěžně, až 10 děl a plná rychlost i se všemi děly."
		"&eCaravel&r (karavela): pluje i proti větru. &eDhow&r (dau): plná rychlost i s plným nákladem."
	]
	quest.602B216BEBAF24D1.title: "Loděnice"
	quest.603697A93C0C2497.quest_desc: [
		"V pokladu může být Valkýří kopí (&eValkyrie Lance&r), kladivo (&eHammer of Kingbdogz&r) nebo strážní boty (&eSentry Boots&r)."
		"Kopí má dlouhý dosah a skvěle se hodí na další dungeon. Quest se splní, až kopí získáš."
	]
	quest.603697A93C0C2497.title: "Poklad Slidera"
	quest.604AD490DFDA5E68.quest_desc: [
		"Občané musí jíst. Hladový občan pracuje pomalu a je nešťastný."
		"Dokud nemáš jídelnu, krm je sám: klikni na občana pravým tlačítkem, otevři jeho inventář a dej mu jídlo (třeba chleba nebo pečené brambory)."
		"&cSyrové jídlo občané jíst nechtějí. Shnilé maso je jen nouzové řešení.&r"
	]
	quest.604AD490DFDA5E68.title: "Hladoví občané"
	quest.604E538308F67D87.quest_desc: [
		"Svatyně (&eSanctum&r) je strašidelný hrad v údolí duší. V jejích truhlách najdeš jídlo a zásoby."
		"V aréně svatyně stojí svíce zrady (&eCierge of Treachery&r)."
	]
	quest.604E538308F67D87.title: "Svatyně v údolí duší"
	quest.6052A4851C1F7E64.quest_desc: [
		"Občané potřebují postele, jinak spí venku a nejsou v bezpečí. Krčma (&eTavern&r) má 4 místa na spaní."
		"Vyrobíš ji z prken, sudu a nástroje stavby. &cV kolonii může být jen jedna krčma.&r"
		"Do krčmy chodí návštěvníci. Klikni na návštěvníka – řekne ti, co chce za to, že zůstane. Potřebuješ ale volnou postel. &cNěkterý návštěvník si věci vezme a uteče.&r"
	]
	quest.6052A4851C1F7E64.title: "Krčma"
	quest.606D7598F3CB0BAC.quest_desc: [
		"&eMěděné pouzdro&r (&eCopper Casing&r) vznikne jako andezitové, jen kliknutím měděným ingotem na oloupaný kmen."
		"Je potřeba na dávkovač, cedník a hadicovou kladku. Kliknutím na potrubí ho i zakryje."
	]
	quest.606D7598F3CB0BAC.title: "Měděné pouzdro"
	quest.60712ED2AE12E7AC.quest_desc: [
		"Strom proměny (&eTree of Transformation&r) má srdce proměny (&eHeart of Transformation&r)."
		"Postupně mění biom v okolí. Stromy proto sázej s rozmyslem."
	]
	quest.60712ED2AE12E7AC.title: "Strom proměny"
	quest.608F6AE8B9940F47.quest_desc: [
		"Kvadrokoptéra (&eQuadrocopter&r) je skvělá na stavění ve výšce."
		"Výroba: 4 vrtule, 4 bambusy a motor. Má jen malý inventář a jeden slot na vylepšení."
	]
	quest.608F6AE8B9940F47.title: "Kvadrokoptéra"
	quest.609D3C2E04A14B68.quest_desc: [
		"Každé letadlo se skládá z dílů. Trup (&eHull&r) je z kmenů a železných ingotů. Plachta (&eSail&r) je z bílých koberců a provázku."
		"&aTyto díly si vyrob dopředu – budeš jich potřebovat hodně.&r"
	]
	quest.609D3C2E04A14B68.title: "Díly letadel"
	quest.60B524DF61A77D2D.quest_desc: [
		"Teď už neteleportuješ jen sebe, ale i náklad. Teleport předmětů (&eItem Teleporter&r) pošle celý stoh předmětů na uložené místo a přijímač nepotřebuje."
		""
		"Vyrobíš ho z mosazných pouzder, šachet, sudů a kvantového mechanismu. Vlož do něj odkaz a předměty a pošli do něj redstonový pulz."
		""
		"Předměty vypadnou nad uloženým blokem, tak tam dej násypku a truhlu. Stoh 64 kusů stojí 100 mB šťávy. Výchozí dosah je 500 bloků ve stejné dimenzi."
	]
	quest.60B524DF61A77D2D.quest_subtitle: "Pokročilý"
	quest.60B524DF61A77D2D.title: "Teleport předmětů"
	quest.60C41873E31EF0E6.quest_desc: [
		"Stropní světlo (&eLight Ceiling Light&r) a vypínač (&eLight Lightswitch&r) vyrobíš na dílenském stole."
		"Světlo připoj klíčem k síti. Vypínačem ho rozsvítíš a zhasneš."
	]
	quest.60C41873E31EF0E6.title: "Světlo a vypínač"
	quest.60E1E6DD14E02CF4.quest_desc: [
		"Teď už jen nevyrábíš proud – energizér z něj dělá nové suroviny. Nabité kovy potřebuješ na všechny lepší stroje z New Age."
		""
		"Energizér nabíjí předměty na odkládací desce nebo na pásu pod sebou. Potřebuje elektřinu a otáčení zároveň."
		"{@pagebreak}"
		"Železný ingot spotřebuje 1 000 ⚡, zlatý 2 000 ⚡ a diamant 10 000 ⚡. Recepty najdeš v JEI pod „Energizing“."
		""
		"&aČím rychleji se energizér točí, tím rychleji nabíjí. Dej ho nad pás a nabíjení poběží samo.&r"
	]
	quest.60E1E6DD14E02CF4.quest_subtitle: "Pokročilý"
	quest.60E1E6DD14E02CF4.title: "Nabité kovy"
	quest.60EAE74AD522424D.quest_desc: [
		"Mod &bSpice of Life Onion&r sleduje, jak pestře jíš. Hra si pamatuje tvých posledních 32 jídel."
		"Čím víc různých jídel jíš, tím víc bonusů dostaneš – třeba srdíčka navíc nebo sílu. Když jíš pořád to samé, bonusy ztratíš."
		"Kniha jídel (&eFood Book&r) ukáže tvoje bonusy a co jsi jedl. Vyrobíš ji z knihy a brambory."
		"Spoustu nových jídel najdeš ve skupině &bJídlo a farmaření&r."
	]
	quest.60EAE74AD522424D.title: "Kniha jídel"
	quest.60F5B4CDE5F20346.quest_desc: [
		"Teď potřebuješ skladovat opravdu hodně energie. Indukční matice (&eInduction Matrix&r) je obří baterie z více bloků."
		"Postav dutý kvádr z pláště (&eInduction Casing&r), stěny mohou být i ze skla (&eStructural Glass&r). Dovnitř dej články (&eBasic Induction Cell&r) – určují kapacitu – a poskytovatele (&eBasic Induction Provider&r) – určují rychlost."
		"Do stěny dej dva porty (&eInduction Port&r) a konfigurátorem přepni jeden na výstup. Jeden port pak energii přijímá, druhý vydává."
		"&aTip:&r Čím víc článků uvnitř, tím víc energie matice uloží."
	]
	quest.60F5B4CDE5F20346.quest_subtitle: "Pokročilý"
	quest.60F5B4CDE5F20346.title: "Indukční matice"
	quest.611307B7DC3A4C2F.quest_desc: [
		"Křišťálová truhla (&eCrystal Chest&r) je stejně velká jako diamantová, ale je průhledná. Skrz sklo vidíš, co je uvnitř."
		"Diamantovou truhlu obklop 8 skleněnými bloky."
	]
	quest.611307B7DC3A4C2F.title: "Křišťálová truhla"
	quest.6117A72CBB15361C.quest_desc: [
		"Vrtulové ložisko (&ePropeller Bearing&r) roztočí vrtuli, kterou si postavíš sám. Připojí se k bloku před sebou, podobně jako mechanické ložisko."
		"Listy vrtule postav z větrných plachet (&eWindmill Sail&r). Vrtule musí mít aspoň 2 bloky plachet. Víc plachet = účinnější vrtule."
		"Výroba: dřevěná deska, železný plát a mosazné pouzdro."
		"&aDřevěná vrtule z úkolu je hotová malá vrtule – stačí ji roztočit.&r"
	]
	quest.6117A72CBB15361C.title: "Velká vrtule"
	quest.6140318807E907C5.quest_desc: [
		"Teď už nestačí jen obohacovat. Čisticí komora (&ePurification Chamber&r) je druhý stupeň: z bloku rudy udělá 3 hrudky (např. &eIron Clump&r), z 1 vytěžené rudy 2. Potřebuje kyslík."
		"Linka: hrudka → drtič → špinavý prach (např. &eDirty Iron Dust&r) → obohacovací komora → prach → pec. Každý vyšší stupeň přidá na začátek nový stroj, zbytek linky už máš."
		"Kyslík přiveď trubkou ze separátoru. Nouzově stačí vložit pazourek do slotu na plyn v okně komory."
		"&aTip:&r Pokročilý obvod (&eAdvanced Control Circuit&r) vyrobíš ze základního obvodu a 2 infuzních slitin."
	]
	quest.6140318807E907C5.quest_subtitle: "Pokročilý"
	quest.6140318807E907C5.title: "3× rudy: čisticí komora"
	quest.61414051B4039DC0.quest_desc: ["Kimči (&eKimchi&r) vykvasíš v kádi z vody, zelí, zázvoru, česneku a chilli prášku. Během kvašení přidej sůl."]
	quest.61414051B4039DC0.title: "Kimči"
	quest.615193FCC437C5E6.quest_desc: [
		"Pouzdro metra (&eMetro Casing&r) je zelený plech pro moderní vlaky a metro. Železný plát a zelené barvivo dají 4 kusy."
		"Z pouzdra vyrobíš panely (&eMetro Panel&r) a okna (&eMetro Window&r). Vroubkovanou verzi (&eCorrugated Metro Casing&r) dostaneš v pracovním stole z jednoho pouzdra."
	]
	quest.615193FCC437C5E6.title: "Metro"
	quest.6152DED3FED68F58.quest_desc: [
		"Raketa se skládá ze špice (&eRocket Nose Cone&r), 4 ploutví (&eRocket Fin&r), 2 nádrží (&eSteel Tank&r) a motoru (&eSteel Engine&r)."
		"Motor potřebuje rám (&eEngine Frame&r) a větrák (&eFan&r). Oba jsou z ocelových plátů a ocelových tyčí (&eSteel Rod&r)."
		"Nádrž potřebuje plynovou nádrž (&eGas Tank&r)."
	]
	quest.6152DED3FED68F58.title: "Díly rakety"
	quest.6193A6802C075911.quest_desc: [
		"Žlutý koláč (&eYellow Cake Uranium&r) je první krok k jadernému palivu. Z 1 uranového ingotu udělá obohacovací komora 2 kusy."
		"V chemickém oxidátoru z něj vznikne plyn oxid uraničitý."
		"&aTip:&r Oxid uraničitý budeš potřebovat v dalším questu na jaderné palivo."
	]
	quest.6193A6802C075911.title: "Žlutý koláč"
	quest.6197406974D9DAA6.quest_desc: [
		"Teď se síť začne zvětšovat a narazíš na kanály. Kanál je jako USB port: většina zařízení (terminál, disková jednotka, sběrnice) potřebuje jeden."
		"Síť bez ovladače (&eME Controller&r) zvládne jen 8 takových zařízení. S ovladačem dá každá jeho strana 32 kanálů."
		"Obyčejný kabel unese 8 kanálů, hustý (&eFluix ME Dense Smart Cable&r) 32. Na hustý kabel ale nejde přímo dát sběrnici ani terminál."
		"{@pagebreak}"
		"Chytrý kabel (&eFluix ME Smart Cable&r) ukazuje světýlky, kolik kanálů jím vede. Používej ho, dokud kanálům nerozumíš."
		"Dobrá síť vypadá jako strom: od ovladače husté kabely, z nich obyčejné a na každém obyčejném nejvýš 8 zařízení."
		"&aTip:&r Barva kabelu s kanály nesouvisí. Barvy jen brání tomu, aby se dva kabely vedle sebe spojily."
	]
	quest.6197406974D9DAA6.quest_subtitle: "Pokročilý"
	quest.6197406974D9DAA6.title: "Kanály"
	quest.61CEEBDE48044DB9.quest_desc: [
		"Díky modu &bApothic Spawners&r můžeš líheň vykopat a odnést domů."
		"Potřebuješ krumpáč s očarováním &eNěžný dotek&r. Líheň pak polož, kam chceš – třeba nad farmu na příšery."
		"&cKrumpáč přitom ztratí 100 bodů výdrže.&r"
		""
		"&aTip:&r Líheň můžeš vylepšit různými předměty (další quest). Co který předmět dělá, ukáže JEI."
	]
	quest.61CEEBDE48044DB9.title: "Líheň domů"
	quest.61D37C5FF56EE84F.quest_desc: [
		"Navigační stůl (&eNavigation Table&r) dává signál směrem k cíli. Vlož do něj navigační předmět, třeba kompas."
		"Když stroj nemíří přímo k cíli, signál zeslábne. S tím postavíš autopilota, který stroj sám natáčí k cíli."
		"Výroba: mosazný plát, precizní strojek a mosazné pouzdro."
	]
	quest.61D37C5FF56EE84F.title: "Navigační stůl"
	quest.61F99C3720943661.quest_desc: [
		"Na cívce je navinutý drát. Cívkou spojuješ konektory a potřebuješ ji i do receptů."
		""
		"Ze 2 železných plátů a 1 železné tyče vyrobíš 24 prázdných cívek (&eEmpty Spool&r). Prázdnou cívku obklop 4 měděnými dráty a máš měděnou cívku (&eCopper Spool&r)."
		""
		"&aAlternátor potřebuje 4 měděné cívky, elektromotor 3.&r"
	]
	quest.61F99C3720943661.title: "Měděná cívka"
	quest.620C1C8B6F5E3201.quest_desc: [
		"&eRedstonový vysílač&r (&eRedstone Link&r) posílá redstone bez drátů až na 256 bloků. Vyrábí se z &evysílače&r (&eTransmitter&r) a andezitového pouzdra."
		"Do dvou slotů dej předměty – to je „frekvence“. Spolu mluví jen vysílače se stejnou dvojicí. Shift + pravé tlačítko přepne na příjem."
	]
	quest.620C1C8B6F5E3201.title: "Redstonový vysílač"
	quest.6222D3EA28471A09.quest_desc: [
		"Upgrade na sbírání (&ePickup Upgrade&r) pošle sebrané věci rovnou do batohu."
		"Vlož ho do slotu pro upgrady vlevo v okně batohu. Ve filtru nastavíš, které věci má sbírat."
		"Vyrábí se ze základu upgradu (&eUpgrade Base&r), lepivého pístu, provázku a redstonu."
	]
	quest.6222D3EA28471A09.title: "Batoh sbírá za tebe"
	quest.6256BEA6F197A271.quest_desc: [
		"Háček mění, jak prut funguje. Železný (&eIron Hook&r) šetří prut, zlatý (&eGold Hook&r) přidá štěstí – chytíš víc pokladů."
		"Lehký háček nahodí dál, těžký blíž, redstonový ti dá víc času na zaseknutí a hudební (&eNote Hook&r) zahraje tón, když ryba zabere."
		"Ze dvou železných háčků vyrobíš dvojitý (&eDouble Hook&r) – občas chytíš dvě věci najednou."
	]
	quest.6256BEA6F197A271.title: "Háčky"
	quest.626187BA2A63CB7B.quest_desc: [
		"Polož těsto na dort na pekařský stůl. Vznikne korpus."
		"Klikni na něj jahodovou marmeládou – a jahodový dort (&eStrawberry Cake&r) je hotový. Pravým tlačítkem ho vezmeš."
		"Dort pak polož a krájej nožem. Ze sladkého těsta se stejně dělají cupcaky a sušenky (váleček, nůž, marmeláda)."
	]
	quest.626187BA2A63CB7B.title: "Jahodový dort"
	quest.6264AF57414EB046.quest_desc: [
		"Kvasný sud (&eBulk Fermenter&r) je větší kvasná nádoba. Vyrobíš ho ze sudu a 2 andezitových slitin. Sudy položené k sobě se spojí do jednoho velkého, podobně jako nádrže."
		""
		"Ze stejné suroviny a kostní moučky dá 400 mB etanolu. To je dvakrát víc než tyglík s víkem."
		""
		"Předměty do něj dostaneš trychtýřem nebo násypkou, kapaliny potrubím."
		""
		"&aTip: S ohřevem zespodu umí z dlažebního kamene udělat lávu.&r"
	]
	quest.6264AF57414EB046.title: "Velký kvasný sud"
	quest.627198E9961E854B.quest_desc: [
		"Syrovou tortillu (&eRaw Tortilla&r) slož ze tří kukuřic a kbelíku vody a upeč ji."
		"Taco (&eTaco&r) pak slož z tortilly, zelí, cibule a pečeného masa."
	]
	quest.627198E9961E854B.title: "Tacos"
	quest.6297FF9AF6171F41.quest_desc: [
		"Velké jídlo z více kroků. Smažené kuře (&eFried Chicken&r) = hrnec, mouka, syrové kuře a olej."
		"Bramborová kaše (&eMashed Potatoes&r) = mísa, pečená brambora, máslo a sůl."
		"Kuřecí večeře (&eChicken Dinner&r) = prkénko, smažené kuře, bramborová kaše a zelenina."
	]
	quest.6297FF9AF6171F41.quest_subtitle: "Expert"
	quest.6297FF9AF6171F41.title: "Kuřecí večeře"
	quest.62A37910A6731F34.quest_desc: [
		"Visačka (&eDecorative Tag&r) z &bLuminous Tag&r. Vyrobíš ji ze železného ingotu, papíru a 3 červených barviv."
		"Je to přísada do dekorací z Luminous (lucerny, ohniště, svícny…). Při výrobě se nespotřebuje, jen se opotřebuje. Vydrží 3 výroby."
	]
	quest.62A37910A6731F34.title: "Ozdobná visačka"
	quest.62AD74DB96E3E8CA.quest_desc: [
		"&bCreate&r je mod o strojích, které pohání &erotace&r. Točící se hřídele a ozubená kolečka roztáčí lisy, míchačky, pásy a další stroje."
		"Tahle kapitola tě provede od první slitiny přes mosaz až k parnímu motoru. Další kapitoly Create jdou do hloubky: energie, rudy, logistika, automatizace a nástroje."
		"&aTip:&r Skoro každý předmět z Create má animovaný návod. Najeď myší na předmět a podrž klávesu z popisku („Podržte [W] pro dumání“ / „Hold [W] to Ponder“)."
	]
	quest.62AD74DB96E3E8CA.quest_subtitle: "Začátečník"
	quest.62AD74DB96E3E8CA.title: "Vítej v Create"
	quest.62DF5CE405C2178E.quest_desc: [
		"Olej (&eCooking Oil&r) uvaříš v hrnci ze 6 semínek bavlny do lahve."
		"S olejem a těstíčkem (&eBatter&r) smažíš kuře, ryby i houby. Těstíčko uvaříš z mléka, vejce a pšenice."
	]
	quest.62DF5CE405C2178E.title: "Olej na smažení"
	quest.62E84420FB5F7325.quest_desc: [
		"Návnadu dej na prut v rybářské krabičce. Ryba pak zabere dřív."
		"Návnadou jsou červ (&eWorm&r), pijavice (&eLeech&r) a střevle (&eMinnow&r). Pijavice a střevle občas chytíš na prut."
	]
	quest.62E84420FB5F7325.title: "Návnada"
	quest.62EA348FDD823A46.quest_desc: [
		"Když dáš plodinu na pracovní stůl, dostaneš z ní semínko, třeba ze salátu &eLettuce Seed&r."
		"Semínka zasaď na zoranou hlínu jako pšenici."
	]
	quest.62EA348FDD823A46.title: "Semínka"
	quest.62EBBDF5709C7299.quest_desc: [
		"&bExtended Crafting&r přidává větší pracovní stoly (3×3 až 9×9) a zvláštní způsoby výroby."
		"Začni černým železem (&eBlack Iron Ingot&r): železný ingot + černé barvivo."
		"&aTip:&r V tomhle packu se na velkých stolech vyrábějí jen materiály z &bExtended Crafting&r. Je to výzva navíc."
	]
	quest.62EBBDF5709C7299.title: "Extended Crafting"
	quest.62F7B17F7FAC5054.quest_desc: [
		"Po smrti tvoje věci nezmizí. Zůstanou na místě smrti v těle tvé postavy (mod &bCorpse&r)."
		"Dojdi tam, klikni na tělo a vezmi si věci zpátky. Tělo samo nezmizí, dokud v něm něco je."
		"Klávesa &eJ&r otevře historii smrtí – uvidíš, kde a kdy jsi zemřel."
		"{@pagebreak}"
		"Užitečné příkazy (&bFTB Essentials&r): &e/back&r tě vrátí na poslední místo (i místo smrti), &e/sethome&r uloží domov a &e/home&r tě tam přenese. &e/spawn&r tě pošle na spawn."
	]
	quest.62F7B17F7FAC5054.title: "Když umřeš"
	quest.62FE52109B7A640B.quest_desc: [
		"Biom &eGloopstone Highlands&r z modu &bUnusual End&r je plný zeleného gloopstonu."
		"Roste tu lesklý krystal a v hloubce prismalit. &cPozor na tvora &eEnder Trapper&c, který se schovává v kamení.&r"
	]
	quest.62FE52109B7A640B.title: "Gloopstonové kraje"
	quest.63081173614C51F6.quest_desc: [
		"Po prvních krocích přichází dungeon. Mosazný dungeon (&eBrass Dungeon&r) je postavený z mrakového kamene (&eNimbus Stone&r) a vznáší se velmi vysoko v mracích."
		"Hledej ho nad oblačnými biomy. Vezmi si padák a hodně bloků na stavění."
	]
	quest.63081173614C51F6.quest_subtitle: "Pokročilý"
	quest.63081173614C51F6.title: "Mosazný dungeon"
	quest.630858BC4F2894A2.quest_desc: [
		"Krmná směs pro křečky (&eHamster Food Mix&r) z modu &bAdorable Hamster Pets&r."
		"Vyrob ji ze 3 slunečnicových semínek, 2 dýňových semínek, mrkve a 3 semínek pšenice (dá 4 kusy)."
		"Směs křečka vyléčí a odemkne mu lícní torbu. &cKřečka s ní ale neochočíš&r – na to je okurka (kapitola &eMazlíčci a chov&r)."
	]
	quest.630858BC4F2894A2.title: "Křeččí směs"
	quest.630C376A12E5FF6A.quest_desc: [
		"Do pracovního stolu dej 3 kusy surového neodymu a 3 železné ingoty. Vznikne 1 neodymový ingot (&eScarlet Neodymium Ingot&r nebo &eAzure Neodymium Ingot&r)."
		"Ingoty jsou základ všech magnetických věcí."
	]
	quest.630C376A12E5FF6A.title: "Neodymové ingoty"
	quest.632313DD4D38B62C.quest_desc: [
		"Neptunium je vzácný kov z moře. Při rybaření občas vytáhneš neptuniový nuget (&eNeptunium Nugget&r) – 9 nugetů dá ingot."
		"Vzácně vytáhneš i Neptunovu truhlu (&eNeptune's Bounty&r) s hotovou neptuniovou výbavou."
	]
	quest.632313DD4D38B62C.title: "Neptunium"
	quest.632E39610F745927.quest_desc: [
		"Nejlepší prut (&eNeptunium Fishing Rod&r). Ryby na něj berou dřív."
		"Vyrobíš ho z neptuniových ingotů, klacků a provázku."
	]
	quest.632E39610F745927.quest_subtitle: "Expert"
	quest.632E39610F745927.title: "Neptunův prut"
	quest.63468567692B40D4.quest_desc: [
		"Syrové těstoviny (&eRaw Pasta&r) uvaříš v hrnci ze 2 pšenic a vejce. Dostaneš 4 kusy."
		"V hrnci pak uvař těstoviny s mletým masem (&eMinced Beef&r) a rajčatovou omáčkou. Vznikne &ePasta with Meatballs&r."
		"&aTip:&r Těstoviny dostaneš i tak, že nakrájíš těsto (&eWheat Dough&r) nožem na prkénku. Těsto se v tomto packu míchá v míse z &bExtraDelight&r."
	]
	quest.63468567692B40D4.title: "Těstoviny s kuličkami"
	quest.6351782FEB97C273.quest_desc: [
		"Strojní dláto (&eMechanical Chisel&r) je stroj pro &bCreate&r. Vyrobíš ho z andezitového pláště a dláta."
		"Pracuje jako mechanická pila: roztoč ho, do filtru dej blok, jaký chceš dostat, a pošli do něj bloky (třeba po pásu). Přetesá je sám."
	]
	quest.6351782FEB97C273.quest_subtitle: "Expert"
	quest.6351782FEB97C273.title: "Strojní dláto"
	quest.63561BF2101FD2FB.quest_desc: [
		"Závěs (&eWhite Curtain&r) je z vlny a tyček, lampa (&eWhite Lamp&r) z vlny, pochodně a tyčky, pohovka (&eWhite Sofa&r) z prken, vlny a tyček."
		"Závěs se dá roztáhnout a zatáhnout kliknutím."
	]
	quest.63561BF2101FD2FB.title: "Útulný pokoj"
	quest.635B0D72ABE52140.quest_desc: [
		"&bHerbalBrews&r je mod o čaji a kávě. Čaj se vaří v konvici (&eTea Kettle&r)."
		"Čajové lístky rostou na čajovníku. Jeho semínko je čajový květ (&eTea Blossom&r). Ten dostaneš z ibišku (roste v džungli), když ho utrhneš nůžkami. Zasaď ho a lístky (&eGreen Tea Leaf&r) sklízej."
		"&aTip:&r Čajový květ občas vypadne i z levandule (roste v horách), ale jen když ji utrhneš rukou, ne nůžkami."
	]
	quest.635B0D72ABE52140.title: "Čajové lístky"
	quest.6364AB15E1C4A780.quest_desc: [
		"Psí žrádlo (&eDog Food&r) uvaříš v hrnci ze shnilého masa, kostní moučky, syrového masa a rýže."
		"Nakrm jím ochočeného vlka. Na 5 minut dostane rychlost, sílu a odolnost."
	]
	quest.6364AB15E1C4A780.title: "Psí žrádlo"
	quest.638A0FAC92E3F527.quest_desc: [
		"Teď už jedna cívka a slabé magnety nestačí. Velký generátor má dlouhou řadu cívek – jedny kartáče sbírají elektřinu až z 8 cívek."
		""
		"Kolem cívek dej nejsilnější magnety: &eFluxuated Magnetite&r má sílu 8, &eNetherite Magnet&r dokonce 24. Fluxovaný magnetit vyrobíš z magnetitu, nabitého zlata a nabitého diamantu."
		"{@pagebreak}"
		"Silné magnety berou hodně SU. Generátor proto pohání velký zdroj otáčení, třeba velký parní stroj."
		""
		"Měděný drát velký proud neunese. Každý lepší drát přenese 2× víc: měděný, nabitý železný, nabitý zlatý (&eOvercharged Golden Wire&r) a nejlepší nabitý diamantový."
		""
		"&aZlatý drát nařežeš pilou z nabitého zlatého plátu.&r"
	]
	quest.638A0FAC92E3F527.quest_subtitle: "Expert"
	quest.638A0FAC92E3F527.title: "Velký generátor"
	quest.6394AD2269AF2E36.quest_desc: [
		"MekaSuit je nejlepší brnění v Mekanismu. Co umí, záleží na modulech, které do něj vložíš."
		"Každý díl vyrobíš z netheritového dílu brnění, HDPE desek, ultimátního obvodu, indukčního článku (&eBasic Induction Cell&r) a polonia."
		"&aTip:&r Moduly instaluješ v modifikační stanici (&eModification Station&r) – návod je v kapitole &bMekanism: pokročilé&r."
	]
	quest.6394AD2269AF2E36.title: "MekaSuit"
	quest.63AC4A56B123F9D3.quest_desc: [
		"Bezdrátový výrobní terminál (&eWireless Crafting Terminal&r) je výrobní terminál v kapse."
		"Zesilovače (&eWireless Booster&r) vložené do přístupového bodu zvětší jeho dosah."
		"&aTip:&r Přístupových bodů může být v síti víc – pokryješ tak celou základnu."
	]
	quest.63AC4A56B123F9D3.title: "Bezdrátová výroba"
	quest.63BF2434DC52102E.quest_desc: [
		"Postup výbavy: dřevo → kámen → železo → diamant → netherit → &bAdvanced Netherite&r."
		"Cestou si vyrobíš lepší štíty (&bSpartan Shields&r), ozdobíš brnění vzory s efekty (&bTrimsEffects&r) a získáš vzácné zbraně."
		"Základní nástroje a první brnění najdeš v kapitole &ePrvní dny&r."
	]
	quest.63BF2434DC52102E.quest_subtitle: "Začátečník"
	quest.63BF2434DC52102E.title: "Výbava a boj"
	quest.63D89D64A7AC666C.quest_desc: [
		"Melounový nanuk (&eMelon Popsicle&r) slož na pracovním stole ze 4 plátků melounu, 2 ledů a klacku. Tvar ukáže JEI."
		"&aTip:&r Sladkosti z Farmer's Delight (koláče, sušenky) se v tomto packu pečou jinak – hlavně v troubě z &bExtraDelight&r. Postup ukáže JEI."
	]
	quest.63D89D64A7AC666C.title: "Melounový nanuk"
	quest.640CAA77B2BA1626.quest_desc: [
		"Když máš prázdnou lištu jídla, přestaneš se léčit a začneš ztrácet život."
		"Úkol: sněz cokoliv. Syrové maso ze zvířat upeč v peci – syté je mnohem víc."
		"Snaž se jíst různá jídla. Pestrá strava ti dá bonusy (viz quest &eKniha jídel&r v kapitole Vítej)."
	]
	quest.640CAA77B2BA1626.title: "Nehladověj"
	quest.6416A52251F18544.quest_desc: [
		"Teď stavitelovi řekni, ať si budovu postaví."
		"Klikni pravým tlačítkem na blok jeho budovy, otevři „Možnosti budovy“ (&eBuild Options&r) a klikni na „Postavit budovu“ (&eBuild Building&r)."
		"Stejně zadáš stavbu, vylepšení nebo opravu každé budovy. Stavitel si zakázky bere postupně."
	]
	quest.6416A52251F18544.title: "První zakázka"
	quest.6426D8E6AD2A2068.quest_desc: [
		"&bCorn Delight&r přidává kukuřici (&eMaize&r). Divoká kukuřice roste v mírných biomech, třeba v pláních a lesích."
		"Z kukuřice na pracovním stole získáš zrno (&eCorn Kernel&r). Zrna zasadíš, nebo je upečeš v peci na popcorn (&ePopcorn&r)."
	]
	quest.6426D8E6AD2A2068.title: "Corn Delight"
	quest.642961BC6327F1E0.quest_desc: [
		"Biom &eWarped Reef&r jsou zelené ostrovy s vodou a zvláštními rybami. Žije tu ryba &eBolok&r, která umí proměňovat věci."
		"Na útesu najdeš zkřivené lodě a stanice s truhlami. Ve vodě se dá i rybařit."
	]
	quest.642961BC6327F1E0.title: "Zkřivený útes"
	quest.64698EEED5C07C34.quest_desc: [
		"Dinopedii (&eDinopedia&r) vyrobíš z knihy a libovolné fosilie."
		"Klikni s ní pravým tlačítkem na tvora. Uvidíš jeho věk, hlad, náladu a co jí."
		"&aNa vejci ukáže, jestli je mu teplo, nebo zima.&r"
	]
	quest.64698EEED5C07C34.title: "Dinopedie"
	quest.646EA6A5AE6D2EB1.quest_desc: [
		"Drž rybí kbelík v hlavní ruce a klikni pravým tlačítkem na tygřího žraloka (&eTiger Shark&r)."
		"Žralok se nají a za odměnu ti dá žraločí zub. Prázdný kbelík dostaneš zpět."
	]
	quest.646EA6A5AE6D2EB1.title: "Krmení žraloka"
	quest.646ED574763B4ED6.quest_desc: [
		"Mod &bMoog's End Structures&r přidává do Endu přes dvacet staveb: věže, zahrady, zříceniny i vesmírné lodě."
		"Najdi strážní věž (&eEnderwatch Tower&r)."
	]
	quest.646ED574763B4ED6.title: "Strážní věž"
	quest.649974532BD8C33E.quest_desc: [
		"Obyčejný odkaz už nestačí na portály ani na přesun bloků. Rozšířený odkaz (&eAdvanced Tp Link&r) vyrobíš ze dvou vysílačů, redstonové perly, kvantového pouzdra a kvantového mechanismu."
		""
		"Kvantové pouzdro (&eQuantum Casing&r) vznikne, když vlakové pouzdro (&eTrain Casing&r) naplníš dávkovačem 1000 mB šťávy. Z pouzder se staví rám portálu."
		""
		"&aZ teleportu předmětů, kvantových pouzder, kvantového mechanismu, pokladačů a pokročilého dílu vyrobíš teleport bloků (&eBlock Teleporter&r). Na redstonový signál přenese blok před sebou na místo uložené rozšířeným odkazem. Spotřebuje 1000 mB šťávy.&r"
	]
	quest.649974532BD8C33E.title: "Rozšířený odkaz"
	quest.649D99096F38C83C.quest_desc: [
		"Ve zřícenině nad rytířskou pevností stojí podstavec na trofej (&eTrophy Pedestal&r)."
		"Polož na něj trofej bosse, třeba nagy nebo Licha. Zmizí štíty, které zavírají vchod do pevnosti."
		"Podstavec reaguje jen na hráče, kteří už porazili Licha."
	]
	quest.649D99096F38C83C.title: "Podstavec trofejí"
	quest.64B0AD7BA9CC5D92.quest_desc: [
		"Křeček na rameni čenichá. Když jsi blízko diamantů (asi do 10 bloků), dá ti vědět."
		"&aTip:&r Choď s křečkem na rameni po jeskyních. Zlato ho mate, nenech se splést. Taky zapiští, když na tebe míří creeper."
	]
	quest.64B0AD7BA9CC5D92.title: "Nos na poklady"
	quest.64B0C2E522D0B2EC.quest_desc: [
		"Kápě (&eHood of Darkness&r) a plášť (&eCloak of Darkness&r) se vyrábějí ze stínového hedvábí a okultního drahokamu."
		"Když nosíš obojí a stojíš ve tmě, plní se ti ukazatel temnoty."
		"Plný ukazatel ti dovolí 10 sekund velmi rychle létat, ale jen ve tmě."
	]
	quest.64B0C2E522D0B2EC.title: "Plášť temnoty"
	quest.64F102DA9C452E34.quest_desc: [
		"Univerzální kabel (&eBasic Universal Cable&r) vede energii mezi generátory a stroji. Vyrobíš ho z oceli a redstonu."
		"Kabel se sám napojí na sousední stroje. Stačí ho vést od generátoru ke strojům."
		"&aTip:&r Infuzní slitinou (pravé tlačítko) vylepšíš kabel na rychlejší. Další úrovně vylepšíš lepšími slitinami."
	]
	quest.64F102DA9C452E34.title: "Kabely"
	quest.650FE79DEC5FAAFB.quest_desc: [
		"&bBuilding Gadgets&r: nástroje, které staví mnoho bloků najednou. Běží na energii (FE) – nabiješ je třeba v energetické kostce Mekanismu."
		"Stavební nástroj (&eBuilding Gadget&r): blok vyber Shift + pravým tlačítkem a pak stav celé řady nebo plochy. Menu s režimy a velikostí otevřeš klávesou G."
		"&aTip:&r Chyba? Klávesa U vrátí poslední stavbu zpět."
	]
	quest.650FE79DEC5FAAFB.title: "Building Gadgets"
	quest.651A12B22745FFE2.quest_desc: [
		"Velmi vzácný biom: ostrovy, které se vznášejí ve vzduchu. Padají z nich vodopády."
		"Mají čtyři druhy: jarní, letní, podzimní a zimní."
		"&aTip:&r Hledej je z výšky. Pomůžou ti Krovky nebo velká mapa."
	]
	quest.651A12B22745FFE2.title: "Létající ostrovy"
	quest.651D8612EDA4842C.quest_desc: [
		"Projdi portálem do doupěte Anu. Stojí v něm Anuův hrad."
		"&cHrad hlídají anubité (Anubite). Vezmi si dobrou zbroj a jídlo.&r"
	]
	quest.651D8612EDA4842C.title: "Doupě Anu"
	quest.6520DBDDA01DCCF8.quest_desc: [
		"&eSekvenční řadící páka&r (&eSequenced Gearshift&r): mosazné pouzdro, ozubené kolečko a elektronka."
		"Otáčí podle seznamu kroků, třeba „otoč o 90°, počkej, otoč zpět“. Kroky nastavíš pravým klikem."
		"Redstone signál spustí celou sekvenci. Hodí se na brány, plošiny a stroje, které mají udělat přesný pohyb."
	]
	quest.6520DBDDA01DCCF8.title: "Sekvenční řadící páka"
	quest.653B9B3580F4712E.quest_desc: [
		"Čelenka s parohy (&eAntler Headdress&r) zvýší, jak daleko odhodíš nepřítele úderem."
		"Vyrob ji ze 2 losích parohů (&eMoose Antler&r), železného ingotu a 2 vláken."
		"Los (&eMoose&r) žije v zasněžené tajze. Parohy sám shazuje jednou za několik dní."
	]
	quest.653B9B3580F4712E.title: "Losí parohy"
	quest.653D858FA4B1C9F2.quest_desc: [
		"Logistika znamená, že věci samy putují mezi stroji a truhlami."
		"Začneš trychtýři, šachtami a pásy. Pak se naučíš třídit filtry a hlídat zásoby. Nakonec postavíš balíčkovou poštu, která doručí cokoli kamkoli."
	]
	quest.653D858FA4B1C9F2.quest_subtitle: "Začátečník"
	quest.653D858FA4B1C9F2.title: "Věci, které jezdí samy"
	quest.653E0777F79D47CF.quest_desc: [
		"Pokladač se šmirglpapírem leští růženín. Se slitinou dělá pouzdra z oloupaných kmenů. Se semínky sází."
		"S prázdným kbelíkem podojí krávu. Klíčem ho přepneš na levé tlačítko, pak těží nebo útočí."
		"Redstone ho zastaví. &aTip:&r Krátké vypnutí signálu ho nechá udělat přesně jeden pohyb."
	]
	quest.653E0777F79D47CF.title: "Triky s pokladačem"
	quest.654AF12A1440277B.quest_desc: [
		"Talisman života (&eCharm of Life I&r) tě jednou zachrání před smrtí, jako totem. Stačí ho mít v inventáři."
		"Najdeš ho v truhlách – třeba v dutých stromech nebo ve skrýších pod padlými kmeny."
		"&aTip:&r 4 talismany I dají talisman II, který tě zachrání s víc životy."
	]
	quest.654AF12A1440277B.title: "Talisman života"
	quest.654F81C691BA4045.quest_desc: [
		"Válečná loď (&eWarship&r) je létající pevnost: pomalá, ale odolná a těžce ozbrojená."
		"Má 3 sloty na palivo, 2 na zbraně a 6 na vylepšení."
		"Výroba: nákladní vzducholoď, 2 motory, 3 trupy, 2 plachty a průmyslová ozubená kola."
	]
	quest.654F81C691BA4045.quest_subtitle: "Expert"
	quest.654F81C691BA4045.title: "Válečná loď"
	quest.654FCBEC5BED73A7.quest_desc: [
		"Zlověstný katalyzátor (&eOminous Catalyst&r) vyrobíš z 8 těžkých kostí a jantarové zvláštnosti (&eAmber Curiosity&r)."
		"Jantarová zvláštnost vzácně vypadne při těžbě jantaru (i bez Hedvábného doteku)."
		"&cKatalyzátor hozený do kráteru sopky v pravěké jeskyni probudí bosse. Připrav se dobře!&r"
	]
	quest.654FCBEC5BED73A7.title: "Zlověstný katalyzátor"
	quest.656197561BD4CDB7.quest_desc: [
		"Piglini milují zlato. Hoď piglinovi zlatý ingot (klávesa Q). Chvíli si ho prohlíží a pak ti hodí něco na oplátku."
		"Můžeš dostat třeba obsidián, perly Enderu, provázky nebo lektvar ohnivzdornosti."
		"&aTip:&r výměna je snadný zdroj perel Enderu, které budeš potřebovat na cestu do Endu."
	]
	quest.656197561BD4CDB7.title: "Výměna s pigliny"
	quest.6571548D53EECBE6.quest_desc: [
		"Radioaktivní thorium (&eRadioactive Thorium&r) získáš drcením thoria v drtících kolech."
		""
		"Vypadne jen v 10 % případů. Navíc často dostaneš železné nugety a zkušenosti. Připrav si víc thoria."
	]
	quest.6571548D53EECBE6.title: "Radioaktivní thorium"
	quest.657334C1CC5D6775.quest_desc: [
		"&bStorage Delight&r přidává kuchyňský nábytek s úložným prostorem: šuplíky, skříňky se sklem a skříňky s pracovní deskou."
		"Šuplík (&eOak Drawer&r) vyrobíš z dubových desek a 3 poklopů. Malé šuplíky (&eSmall Oak Drawers&r) z 8 desek a 1 poklopu."
	]
	quest.657334C1CC5D6775.title: "Storage Delight"
	quest.658E96902AB33378.quest_desc: [
		"V packu je spousta malých modů, které usnadňují hru. Tady je najdeš pohromadě."
		"&bLootr&r (kořist), &bSupplementaries&r a &bAmendments&r (užitečné bloky), &bEtched&r (vlastní hudba), &bChimes&r (zvonkohry), &bApothic Spawners&r (úprava spawnerů) a &bChunk Loaders&r."
		"Každá větev začíná jednoduše a končí věcmi pro zkušené hráče."
	]
	quest.658E96902AB33378.quest_subtitle: "Začátečník"
	quest.658E96902AB33378.title: "Užitečné mody"
	quest.65A3BBD1A145FC3F.quest_desc: [
		"Průvodčí (&eConductor&r) ze &bSteam 'n' Rails&r je malý pomocník. Vznikne, když nasadíš čepici průvodčího (třeba &eWhite Conductor's Cap&r) na blok andezitového pouzdra."
		"Čepice se vyrábí sekvenční montáží z vlny: pila ji ořízne, pokladače přidají precizní strojek a provázek. Barvu změníš barvivem v pracovním stole."
		"&aPrůvodčí může řídit vlak jako strojvůdce – posaď ho na sedačku před ovládání.&r"
	]
	quest.65A3BBD1A145FC3F.title: "Čepice průvodčího"
	quest.65BFA83E471597EF.quest_desc: [
		"Zlaté jablko tě rychle vyléčí a dá ti pár srdíček navíc. Vezmi si ho na každý těžký boj."
		"Vyrobíš ho z jablka a 8 zlatých ingotů."
	]
	quest.65BFA83E471597EF.title: "Zlaté jablko"
	quest.65C27EFDBEE185A6.quest_desc: [
		"Mísa (&eMixing Bowl&r), mouka, voda a sůl na pracovním stole dají dvě těsta (&eDough&r)."
		"Z těsta jsou koláče, pečivo a těstoviny."
	]
	quest.65C27EFDBEE185A6.title: "Těsto"
	quest.65C9DB5800A3BED8.quest_desc: [
		"Divoká káva (&eWild Coffee&r) roste v džungli. Dá ti kávová zrna (&eCoffee Beans&r), která můžeš zasadit."
		"V konvici uvaříš zrna se skleněnou lahví. Káva (&eCoffee&r) dává efekt &eDeeprush&r – čím hlouběji těžíš, tím rychleji."
		"&aTip:&r Káva s mlékem (&eMilk Coffee&r) má stejný efekt, ale vydrží déle."
	]
	quest.65C9DB5800A3BED8.title: "Káva"
	quest.65D466FD7B788377.quest_desc: [
		"Nejvyšší úroveň kotle je 18. Potřebuješ 9 přehřátých hořáků pod nádrží 3×3, aspoň 72 bloků nádrže (3×3×8) a 180 mB vody za tick (2 čerpadla na 256 RPM)."
		"Na kotel pak dej 18 parních motorů. Dohromady dají 294 912 SU – to utáhne celou továrnu."
		"&aTip:&r Hořáky krm automaticky (paže, pokladač) a vodu ber z hadicové kladky v moři. Jinak kotel časem klesne."
	]
	quest.65D466FD7B788377.quest_subtitle: "Expert"
	quest.65D466FD7B788377.title: "Plný výkon"
	quest.65F904B3008C64EE.quest_desc: [
		"Kamenný pancíř (&eRock Shell Chestplate&r): když sprintuješ, kutálíš se jako koule."
		"Vyrob ho z 8 kamenných ulit (&eRocky Shell&r). Padají z &eRocky Roller&r v &eKrápníkových jeskyních&r. &cTen útočí.&r"
	]
	quest.65F904B3008C64EE.title: "Kamenný pancíř"
	quest.660A16659CCB5847.quest_desc: [
		"Gravititový krumpáč (&eGravitite Pickaxe&r) vytěží každou rudu."
		"Pravým tlačítkem na blok ho nechá vyletět do vzduchu. Tak snadno přesuneš i velké kusy ostrova."
	]
	quest.660A16659CCB5847.title: "Gravititové nástroje"
	quest.660F60C9C50110A7.quest_desc: [
		"&bJade&r ukazuje nahoře na obrazovce, na co se díváš: jméno bloku nebo zvířete a z jakého je modu."
		"Ukáže i to, jaký nástroj potřebuješ. Když podržíš Shift, uvidíš víc podrobností."
		"Nastavení Jade otevřeš klávesou 0 na numerické klávesnici."
		"Úkol: vyrob si dřevěný krumpáč a vykopej kámen."
	]
	quest.660F60C9C50110A7.title: "Co je to za blok?"
	quest.6620895622948A40.quest_desc: [
		"&bMineColonies&r: založíš si vesnici s občany. Ty jsi starosta, práci dělají občané."
		"Občané staví budovy, kácí stromy, farmaří, těží a vaří. Ty jim dodáváš materiál a rozhoduješ, co se postaví."
		""
		"V této kapitole kolonii založíš a postavíš první budovy ve správném pořadí. Další kapitoly: &eŽivot občanů&r, &eŘemeslníci&r, &eVýzkum a obrana&r a &eNástroje a styly&r."
		"{@pagebreak}"
		"&aTip:&r MineColonies má i český překlad. Názvy tlačítek proto píšeme česky a v závorce anglicky – podle toho, jaký jazyk máš ve hře nastavený."
		"&aTip:&r &bJadeColonies&r: když se podíváš na budovu nebo občana, nahoře uvidíš jméno, práci a další informace. &bTownTalk&r dává občanům hlasy."
	]
	quest.6620895622948A40.title: "Starostou kolonie"
	quest.6631E7593AB46BA5.quest_desc: [
		"Dřevorubec (&eForester's Hut&r) kácí stromy a sází nové sazenice. Stavitel bude dřeva potřebovat hodně."
		"Vyrobíš ho z prken, dřevěné sekery a nástroje stavby. Dřevorubec potřebuje sekeru."
		"&aTip:&r stromy hledá až 150 bloků daleko. Kmen, pod kterým leží kamení, za strom nepovažuje – tak ochráníš své dřevěné stavby."
	]
	quest.6631E7593AB46BA5.title: "Dřevorubec"
	quest.664A65A8213A28E7.quest_desc: [
		"Vepřín (&eSwineherd's Hut&r) dává vepřové, ovčín (&eShepherd's Hut&r) vlnu a skopové."
		"Bloky budov: prkna, nástroj stavby a syrová kotleta (vepřín) nebo nůžky (ovčín)."
		"Prasata se krmí mrkví, ovce pšenicí. Ovčák potřebuje i nůžky. Na každou úroveň budovy chová pastevec 2 zvířata."
	]
	quest.664A65A8213A28E7.title: "Vepřín a ovčín"
	quest.665194F22DE46F15.quest_desc: [
		"9 úlomků brnění dá shluk úlomků (&eArmor Shard Cluster&r). Shluk přetav v peci na rytířský kov (&eKnightmetal Ingot&r)."
		"Z rytířského kovu je silná zbroj, nástroje a štít."
	]
	quest.665194F22DE46F15.title: "Rytířský kov"
	quest.6657AF0233B6CC77.quest_desc: [
		"Sopečný biom (vrchol sopky nebo kráter). Ze svahů tu teče láva."
		"&cNechoď sem bez ohnivzdorných lektvarů.&r Do lávy se snadno spadne."
	]
	quest.6657AF0233B6CC77.title: "Sopka"
	quest.6659A10AD19A2770.quest_desc: [
		"Etanol (&eEthanol&r) je palivo, které vzniká kvašením."
		""
		"Do tyglíku s víkem vhoď cukr, jablko, bramboru nebo cukrovou třtinu a k tomu kostní moučku. Z jedné suroviny a jedné kostní moučky vznikne 200 mB etanolu."
		""
		"&aTip: Etanol spálí motor, hořák i zapalovač.&r"
	]
	quest.6659A10AD19A2770.title: "Etanol"
	quest.66669FE770671D4C.quest_desc: [
		"Tlaková reakční komora (&ePressurized Reaction Chamber&r) zpracuje naráz pevnou látku, kapalinu a plyn."
		"2 bio paliva + voda + vodík = substrát (&eSubstrate&r) a k tomu plyn etylen (&eEthene&r). Etylen je skvělé palivo do plynového generátoru."
		"&aTip:&r Komora umí i uhlí + voda + kyslík = sirný prach a vodík."
	]
	quest.66669FE770671D4C.title: "Tlaková reakční komora"
	quest.666A0A06E79D4CFF.quest_desc: [
		"Farmy a stroje pracují jen tehdy, když je nějaký hráč poblíž. Chunk loader udrží svou oblast (chunk) zapnutou, i když jsi daleko."
		"Nejdřív vyrob základní chunk loader (&eBasic Chunk Loader&r) ze železa, obsidiánu a ender perly. Rozložíš ho na 9 malých (&eSingle Chunk Loader&r)."
		"Klikni na chunk loader pravým tlačítkem a na mapě vyber, které chunky má držet."
		"{@pagebreak}"
		"&cPozor:&r každý zapnutý chunk zatěžuje server. Zapínej jen to, co opravdu potřebuješ."
		"Když nebudeš týden online, tvoje chunk loadery se vypnou."
		"Větší chunk loadery najdeš v kapitole &eUžitečné mody&r."
	]
	quest.666A0A06E79D4CFF.title: "Ať to běží, i když tu nejsi"
	quest.666DAAD1D99676AA.quest_desc: [
		"&bMekanism Additions&r přidává drobnosti: vysílačky, balony, plastové bloky a obsidiánový TNT."
		"Vysílačka (&eWalkie-Talkie&r) slouží k hlasové komunikaci na zvoleném kanálu."
		"&cPozor:&r Hlas funguje jen tehdy, když je na serveru zapnutý hlasový server Mekanismu. Ve výchozím nastavení je vypnutý."
	]
	quest.666DAAD1D99676AA.title: "Vysílačka"
	quest.6672F140ED56DB69.quest_desc: [
		"Teď už síť nejen skladuje, ale i přesouvá věci sama. Importér (&eImporter&r) bere věci z bloku, na kterém je, a ukládá je do sítě. Exportér (&eExporter&r) posílá vybrané věci ze sítě do bloku."
		"Příklad: exportér na peci posílá rudu, importér pod pecí bere ingoty."
		"&aTip:&r Ve filtrech nastavíš, které věci mají projít."
	]
	quest.6672F140ED56DB69.quest_subtitle: "Pokročilý"
	quest.6672F140ED56DB69.title: "Import a export"
	quest.66A59A96ACF5AEF3.quest_desc: [
		"Uprostřed temného lesa stojí temná věž (&eDark Tower&r) z věžového dřeva."
		"Uvnitř jsou mizející bloky, zamčené dveře a karminitoví golemové. Klíč od zamčených dveří (&eTower Key&r) najdeš v truhlách věže."
	]
	quest.66A59A96ACF5AEF3.title: "Temná věž"
	quest.66B0BDDE38B7C6AB.quest_desc: [
		"Mod &bAmendments&r vylepšuje obyčejné bloky. Třeba lucernu můžeš pověsit na zeď."
		"Další vychytávky: koberec na schodech a půlblocích, zavěšený květináč, háček na nástroje a míchání lektvarů v kotli."
		"Lucernu vyrobíš z pochodně a železných nuggetů."
	]
	quest.66B0BDDE38B7C6AB.title: "Lucerna na zdi"
	quest.66E3A73D04D9BA1C.quest_desc: [
		"&bStructurize&r je mod, na kterém stojí nástroj stavby. Přidává i další nástroje pro stavitele."
		"Vzhled budov určují styly. Kromě stylů z MineColonies jsou v packu doplňky &bStylecolonies&r, &bByzantine&r a &bChristmasColonies&r."
		"V této kapitole poznáš styly, deník úkolů, mapu kolonie a nástroje na měření, skenování a tvary."
	]
	quest.66E3A73D04D9BA1C.title: "Nástroje stavitele"
	quest.66F685B21AF865ED.quest_desc: [
		"Lanová spojka (&eRope Coupling&r) je lano pro fyzikální stroje. Výroba: provázky a železné nugety."
		"Klikni s ní na naviják a pak na úchyt – natáhneš mezi nimi lano. Lano může být dlouhé nejvýš 40 bloků. Nůžkami ho přestřihneš."
	]
	quest.66F685B21AF865ED.title: "Lano"
	quest.6756716BA361D7C5.quest_desc: [
		"Trojitý luk (&eTri-Bow&r) vystřelí naráz tři šípy."
		"Sněhová královna upustí buď tento luk, nebo luk naváděných šípů. Možná ji budeš muset porazit znovu."
	]
	quest.6756716BA361D7C5.title: "Luk královny"
	quest.6758A7F5B468EBBC.quest_desc: [
		"Rajčatová omáčka (&eTomato Sauce&r) je základ těstovin, pizzy a mnoha dalších jídel."
		"Uvaříš ji v hrnci ze dvou rajčat."
	]
	quest.6758A7F5B468EBBC.title: "Rajčatová omáčka"
	quest.675C5557F88C8250.quest_desc: [
		"Kdo bydlí v lepším domě, chce i lepší jídlo. Šéfkuchař v kuchyni (&eChef's Kitchen&r) vaří speciální jídla."
		"Blok budovy vyrobíš z prken, udírny a nástroje stavby."
		"&aTip:&r jídla z MineColonies mají v popisku úroveň (1 až 3). Čím vyšší, tím spokojenější občané."
	]
	quest.675C5557F88C8250.title: "Kuchyně šéfkuchaře"
	quest.675DABE623A1491B.quest_desc: [
		"Lich upustí jedno ze 4 žezel: soumraku, čerpání života, zombíků nebo zpevnění."
		"Každé má omezený počet nábojů. Kolik jich zbývá, vidíš v popisu předmětu."
		"Získej všechna 4 – Licha budeš muset porazit vícekrát."
	]
	quest.675DABE623A1491B.title: "Žezla moci"
	quest.67633A169217F971.quest_desc: [
		"Kvasný sud (&eFermentation Barrel&r) vyrobíš z obyčejného sudu a 2 klacků."
		"Otevři ho a nalij do něj šťávu z lahví. Pak přidej přísady a prázdnou vinnou lahev. Po chvíli kvašení je víno hotové."
		"Každé víno potřebuje jinou šťávu a jiné přísady. Najdeš je v JEI u sudu."
	]
	quest.67633A169217F971.title: "Kvasný sud"
	quest.6765D00F154E6859.quest_desc: [
		"Zapal svíci zrady křesadlem. Spustí se vlny nepřátel, které chtějí svíci zničit. Ubraň ji!"
		"Za výhru dostaneš jiskru zrady (&eSpark of Treachery&r). Otevřeš s ní zamčené ohnivé truhly (&eBrazier Chest&r) ve svatyni."
		"&aTip:&r rozbitou svíci opravíš plástvemi medu."
	]
	quest.6765D00F154E6859.title: "Svíce zrady"
	quest.677709DB54F26BCA.quest_desc: [
		"Mlýnský kámen (&eMillstone&r) semele pšenici na mouku (&eWheat Flour&r)."
		"Mouka a voda v míchačce dají těsto (&eDough&r). Stačí i mouku poslat větrákem přes vodu (praní)."
	]
	quest.677709DB54F26BCA.title: "Těsto"
	quest.67854AD74FBBF01E.quest_desc: [
		"Základní motor (&eBasic Motor&r) mění elektřinu zpět na otáčení."
		""
		"Rychlost nastavíš montážním klíčem. Síla (SU) zůstává stejná. Redstonovým signálem motor vypneš. Kliknutím pravým tlačítkem tohle chování obrátíš."
		""
		"&aElektřinu přivedeš konektorem položeným přímo na motor.&r"
	]
	quest.67854AD74FBBF01E.title: "Základní motor"
	quest.6790278D76E50FBF.quest_desc: ["75 občanů. Usadil ses, přežil a vybudoval jsi opravdové město."]
	quest.6790278D76E50FBF.title: "Velkoměsto"
	quest.679ED5C7F336373C.quest_desc: [
		"Pila pokácí celý strom, když přeřízne kmen u země. Pokladač naproti zasadí novou sazenici. Kmeny padají na zem, seber je trychtýřem nebo pásem."
		"&eHnojivo&r (&eTree Fertilizer&r): 2 květiny, korál a kostní moučka dají 2 kusy. Vypěstuje strom i ve stísněném místě."
		"&aTip:&r Druhý pokladač s hnojivem nebo kostní moučkou růst stromu urychlí."
	]
	quest.679ED5C7F336373C.title: "Farma na stromy"
	quest.67AF577F67B140B6.quest_desc: [
		"Jadeitový krumpáč (&eSkyjade Pickaxe&r) těží rychleji než diamantový. Čím víc je ale opotřebený, tím je pomalejší."
		"Je to opak zanitu. Jadeitové nástroje si proto často opravuj na oltáři."
	]
	quest.67AF577F67B140B6.title: "Jadeitové nástroje"
	quest.67B9D31BB2341E51.quest_desc: [
		"Knihovna se vyrábí ze 6 prken a 3 knih. Kniha je z papíru a kůže, papír z cukrové třtiny."
		"Postav knihovny kolem očarovacího stolu s mezerou jednoho bloku. Mezi stolem a knihovnou nesmí nic stát."
	]
	quest.67B9D31BB2341E51.title: "Knihovny"
	quest.67CF1D6C34601F93.quest_desc: [
		"Ingot &eNetherite-Iron Ingot&r vyrobíš z netheritového ingotu a 4 železných ingotů."
		"Každý stupeň Advanced Netherite je silnější než ten předchozí a má vlastní bonusy. Podrž Shift nad předmětem a uvidíš je."
		"Bonusy jsou třeba víc surovin z rud, víc kořisti z příšer nebo to, že tě některé příšery nechají na pokoji."
	]
	quest.67CF1D6C34601F93.title: "Netherit-železo"
	quest.67D9FC42F59390FE.quest_desc: [
		"Tahle kapitola je pro úplné nováčky. Naučíš se přežít první noc a pak se dostaneš až k diamantům a do Netheru."
		"Plán na první den: nasbírej dřevo, vyrob nástroje, najdi jídlo a do setmění si postav úkryt nebo postel."
		"Když nevíš, jak se něco vyrábí, najeď na předmět v questu a zmáčkni &eR&r (recept v JEI)."
	]
	quest.67D9FC42F59390FE.quest_subtitle: "Začátečník"
	quest.67D9FC42F59390FE.title: "První dny"
	quest.67EA9A402A1E0884.quest_desc: [
		"Na Venuši je 464 °C a na Merkuru 167 °C. Obyčejný skafandr tě neochrání."
		"Netheritový skafandr má trvalou odolnost proti ohni a lepší ochranu."
		"Vyrobíš ho z netheritové zbroje, ostrových a deshových plátů."
	]
	quest.67EA9A402A1E0884.title: "Netheritový skafandr"
	quest.67FBD9C9076B7A0B.quest_desc: [
		"Sporák (&eLight Stove&r) potřebuje elektřinu. V jeho troubě upečeš třeba pizzu. Pánev (&eFrying Pan&r) polož na sporák a udělej na ní marmeládu nebo grilovaný sýr (&eGrilled Cheese&r)."
		"Lednice (&eLight Fridge&r) je velká úložná skříň na jídlo."
		"Všechno vyrobíš na dílenském stole, hlavně ze železa a redstonu. Lednice potřebuje i měď."
	]
	quest.67FBD9C9076B7A0B.title: "Sporák a lednice"
	quest.6801DA77427DFD83.quest_desc: [
		"Dřevěné formy vyřežeš z kmenů na mechanické pile (&eMechanical Saw&r). Filtrem na pile vybereš, kterou formu chceš."
		""
		"&eVery Small Cast Mould&r je na hlaveň, &eMedium Cast Mould&r na komoru a &eCannon End Cast Mould&r na uzávěr."
		""
		"Licí písek (&eCasting Sand&r) uděláš na stole ze 2 písků, hlíny a jílu."
		"{@pagebreak}"
		"Polož formu a kolem ní 8 bloků licího písku (čtverec 3 × 3). Klikni na formu licím pískem a pak prázdnou rukou. Vznikne vrstva odlitku."
		""
		"Další vrstvy stav na sebe. Celé dělo tak odliješ najednou a bude spojené v jeden kus."
		""
		"Tekutý kov nalij shora trubkou. Hlaveň potřebuje 7 ingotů, komora 12 a uzávěr 9."
		"{@pagebreak}"
		"Plný odlitek chvíli tuhne. Komparátor u něj ukáže, jak je plný. Hotový odlitek otevřeš kliknutím nebo rozbitím."
		""
		"&cOdlitý díl děla se po rozbití bez krumpáče s Hedvábným dotekem rozpadne na nugety. Dělo přesouvej stroji z Create (ložisko, píst), aby zůstalo vcelku.&r"
	]
	quest.6801DA77427DFD83.title: "Formy a licí písek"
	quest.6803AAC5D2BADD76.quest_desc: [
		"&eTrojzubec&r obvykle padá jen z utopenců. Tady si ho můžeš vyrobit."
		"&bBen's Sharks&r: 3 zuby v prismarínu (&eDent&r, žraločí zub nad prismarínovým střepem) a 2 prismarínové střepy."
		"&bUpgrade Aquatic&r: 3 zuby mlátičky a 2 prismarínové tyčky (&ePrismarine Rod&r)."
	]
	quest.6803AAC5D2BADD76.title: "Trojzubec"
	quest.6805FE4ABDAA7BF0.quest_desc: [
		"Sněz stroganov od Minoshrooma. Tvoje tělo si zvykne na žár ohnivé bažiny."
		"Bez toho tě v ohnivé bažině pálí oheň a nedá se tam přežít."
	]
	quest.6805FE4ABDAA7BF0.title: "Mocný stroganov"
	quest.680AF8189238535A.quest_desc: [
		"Polož talíř na stůl a dej na něj hotový pokrm. Když ho sníš z talíře, dostaneš efekt &eWell Served&r – dokud trvá, nebudeš mít opravdový hlad."
		"Ubrousek (&eNapkin&r), sklenice na víno (&eWine Glass&r) a svíčka nebo lampa poblíž vylepší prostírání (&eTable Setting&r)."
		"&aTip:&r Podívej se na talíř – nápověda ukáže, co na stole ještě chybí."
	]
	quest.680AF8189238535A.title: "Prostřený stůl"
	quest.682143834F309275.quest_desc: [
		"Ocel (&eSteel Ingot&r) potřebuješ skoro na všechno. Vyrábí se v infuzéru ve dvou krocích. Zdrojem infuze je uhlí nebo dřevěné uhlí."
		"1) Železný ingot + uhlík = obohacené železo (&eEnriched Iron&r). 2) Obohacené železo + uhlík = ocelový prach (&eSteel Dust&r). Prach přetav v peci na ingot."
		"&aTip:&r V packu se používá jen tahle ocel. Ocel z jiných modů sjednocuje mod &bAlmost Unified&r."
	]
	quest.682143834F309275.title: "Ocel"
	quest.6839B239E5678257.quest_desc: [
		"Magnetit má sílu jen 1, takže generátor mění na elektřinu malou část otáčení. Silnější magnety zvýší účinnost. Cívka pak ale bere víc SU."
		""
		"Síla magnetů: magnetit 1, redstonový magnet (&eRedstone Magnet&r) 2, vrstvený magnet (&eLayered Magnet&r) 4."
		""
		"&aRedstonový magnet je z redstonového bloku a železných nugetů. Vrstvený je z nabitého železa a nabitého zlata.&r"
	]
	quest.6839B239E5678257.title: "Silnější magnety"
	quest.684DAA31EEE956B2.quest_desc: [
		"Dvě potrubí, která vedou těsně vedle sebe, se normálně samy spojí. Barvivo tomu zabrání."
		""
		"Klikni barvivem na nádrž (&eFluid Tank&r). Obarví se celá. Se Shiftem obarvíš jen jeden blok nádrže."
		""
		"Potrubí obarvíš tak, že při pokládání držíš barvivo ve druhé ruce."
		"{@pagebreak}"
		"Obarvené potrubí se samo spojí jen s potrubím stejné barvy. Neobarvené potrubí se spojí se vším."
		""
		"Quest se splní, až poprvé obarvíš nádrž nebo potrubí."
		""
		"&aTip: Každá kapalina může mít svou barvu potrubí. Hned uvidíš, kde teče voda a kde láva.&r"
	]
	quest.684DAA31EEE956B2.title: "Barevné potrubí"
	quest.6859E5E271CB517D.quest_desc: [
		"Do tyglíku nad ohřátým ohňohořákem posílej měděné a zinkové ingoty v poměru 1 : 1. Míchačka z nich dělá mosaz pořád dokola."
		"Hořák musí mít pořád palivo. Krm ho mechanickou paží nebo pokladačem."
	]
	quest.6859E5E271CB517D.title: "Mosaz ve velkém"
	quest.685DB26599ECD1D2.quest_desc: [
		"Ostrum je ruda z Marsu. Přetav ji na ingoty (&eOstrum Ingot&r)."
		"Z ostra je netheritový skafandr, kryomrazák, energizér a raketa 3. stupně."
	]
	quest.685DB26599ECD1D2.title: "Ostrum"
	quest.6868EE89F56412CA.quest_desc: [
		"&bAquaculture Delight&r dělá jídla z ryb z modu &bAquaculture&r."
		"Křupavého okouna (&eCrispy Fried Perch&r) uvaříš v hrnci z okouna nebo okounka (&eSmallmouth Bass&r), pšenice a vejce. Dostaneš dva."
	]
	quest.6868EE89F56412CA.title: "Aquaculture Delight"
	quest.6877A063263E4156.quest_desc: [
		"Tohle je sekvenční montáž (&eSequenced Assembly&r): sušenka jede po pásu několika stroji za sebou."
		"Těsto z mouky, kakaa a vody slisuj a upeč v udírně. Pak dávkovač přidá krém (rozpuštěný cukr + voda v míchačce) a pokladač přiloží druhou půlku. Výsledek: &eOreo&r."
		"&aTip:&r Celý postup ukáže JEI u &eOreo&r."
	]
	quest.6877A063263E4156.quest_subtitle: "Expert"
	quest.6877A063263E4156.title: "Sušenka na lince"
	quest.687D5B78F46EAC63.quest_desc: [
		"Perleťový levitit (&ePearlescent Levitite&r) je růžová varianta levititu."
		"Vznikne, když směs zapálíš ohněm duší: pochodní duší, táborákem duší nebo ohněm duší."
	]
	quest.687D5B78F46EAC63.title: "Perleťový levitit"
	quest.687F33534124B44D.quest_desc: [
		"Průmyslová ozubená kola (&eIndustrial Gears&r): spotřeba paliva −20 %. Výroba: měděné a železné ingoty a páka."
		"&aPotřebuješ je i na válečnou loď a na rotační dělo.&r"
	]
	quest.687F33534124B44D.title: "Průmyslová ozubená kola"
	quest.688F15F5AB64471A.quest_desc: [
		"Magnety jsou srdce generátoru z &bCreate: New Age&r. Nejslabší magnet je magnetitový blok (&eMagnetite Block&r)."
		""
		"Najdeš ho v podzemí normálního světa, ve výšce zhruba od -20 do 60. Když ho vytěžíš, padne ti celý blok."
		""
		"&aMagnetit potřebuješ i do základního motoru.&r"
	]
	quest.688F15F5AB64471A.title: "Magnetit"
	quest.689C65C0F1E4E1CE.quest_desc: [
		"Teď už lov těžších a vzácnějších tvorů. Na mnoho z nich potřebuješ dobrou zbroj."
		"Jeskynní stonožka (&eCave Centipede&r) je vzácná a žije hluboko v jeskyních. &cJe pomalá, ale silná a její kousnutí otráví.&r"
	]
	quest.689C65C0F1E4E1CE.quest_subtitle: "Pokročilý"
	quest.689C65C0F1E4E1CE.title: "Jeskynní stonožka"
	quest.68BA776A6748C666.quest_desc: ["Vyleť až do mraků, třeba svým létajícím strojem, a vyhoď tam hudební disk. Promění se v nový disk s písní &eCloud Skipper&r."]
	quest.68BA776A6748C666.title: "Píseň oblaků"
	quest.68BB005C302A2F72.quest_desc: [
		"Když je nálož moc slabá, střela uvízne v hlavni. Vytáhneš ji vytahovákem (&eWorm&r) z hlavice (&eWorm Head&r) a dvou klacků."
		""
		"Každý kov potřebuje určitou sílu nálože na každý kus hlavně. Litina potřebuje 1 nálož na každý kus. Počítá se i kus, ve kterém leží střela."
		""
		"&cDělo může prasknout, když: dáš víc náloží, než vydrží; nálož leží v hlavni místo v komoře; střela v hlavni do něčeho narazí.&r"
		""
		"&cMezi náložemi nenechávej mezery. Jinak nemusí shořet všechny.&r"
		"{@pagebreak}"
		"&aTip:&r Náboje zatopené vodou nevybuchnou od ohně ani od výbuchu. Mokrá nálož je ale slabší a jako první nálož v děle nevzplane."
		""
		"Mokrá nálož časem sama vyschne. V Netheru je hned po položení suchá."
	]
	quest.68BB005C302A2F72.title: "Bezpečné nabíjení"
	quest.68C7FEE837C5C4CE.quest_desc: [
		"Projdi trním (&eThornlands&r) až na poslední náhorní plošinu (&eFinal Plateau&r)."
		"Stojí tu Poslední hrad (&eFinal Plateau Castle&r). V této verzi modu (4.8) ještě není dokončený – tady postup lesa končí."
		"Gratulujeme, prošel jsi celým Soumračným lesem!"
	]
	quest.68C7FEE837C5C4CE.title: "Konec cesty"
	quest.68CC08AA69654F63.quest_desc: [
		"Kalhoty z buše (&eOutback Leggings&r) ti dávají šanci, že se tě nedotkne šíp ani jiná střela."
		"Vyrob je ze 4 pírek emu (&eEmu Feather&r) a 3 klokaních kůží (&eKangaroo Hide&r)."
		"Emu i klokan žijí na savaně a v pustině. &cEmu se brání ve skupině.&r"
	]
	quest.68CC08AA69654F63.title: "Kalhoty z buše"
	quest.68D27BDA07B24728.quest_desc: [
		"Teď už slunce ani palivo v ohňohořáku nestačí. Reaktor vyrábí obrovské množství tepla pro parní kotle."
		""
		"Reaktorové tyče postav do řady. Na jeden konec řady dej vstup paliva (&eReactor Fuel Acceptor&r), na druhý výdech tepla (&eReactor Heat Vent&r)."
		"{@pagebreak}"
		"Do vstupu paliva vkládej jaderné palivo, třeba trychtýřem. Z výdechu veď tepelné trubky k ohřívačům pod parními kotli."
		""
		"&cTeplo musí mít vždy kam odtékat. Jinak se reaktor přehřeje, tyče vybuchnou a reaktor se roztaví.&r"
		""
		"&cNerozbíjej tyč, ve které je palivo – vybuchne.&r"
		""
		"&aPonder reaktoru (klávesa W nad tyčí) ukazuje celou stavbu.&r"
	]
	quest.68D27BDA07B24728.quest_subtitle: "Expert"
	quest.68D27BDA07B24728.title: "Spusť reaktor"
	quest.68DF60507DB927F0.quest_desc: [
		"Nejlepší jetpack modu. Netheritový jetpack (&eNetherite Jetpack&r) je vylepšený mosazný jetpack a jako předmět neshoří v ohni ani v lávě."
		""
		"Vyrobíš ho na kovářském stole: mosazný jetpack a netheritový ingot. Místo šablony tam dej nádrž (&eFluid Tank&r) z Create."
		""
		"&aStejně jako mosazný potřebuje vodu i palivo. Nos u sebe plnicí i palivovou nádrž a o doplňování se nestaráš.&r"
	]
	quest.68DF60507DB927F0.quest_subtitle: "Expert"
	quest.68DF60507DB927F0.title: "Netheritový jetpack"
	quest.6908FA1CBA42624E.quest_desc: [
		"Šunka (&eHam&r) občas padá z prasat a hoglinů, ale jen když je zabiješ nožem."
		"Šunku nakrájíš na prkénku na kotlety, nebo ji vyudíš v udírně na uzenou šunku (&eSmoked Ham&r)."
		"&aTip:&r Uzená šunka se hodí na hostinu s medem."
	]
	quest.6908FA1CBA42624E.title: "Šunka"
	quest.691F720D92352757.quest_desc: [
		"Na lukostřelnici (&eArchery&r) se občan cvičí na lučištníka."
		"Výzkum &eImproved Bows&r stojí 6 bloků železa a kasárny musí mít úroveň 3. Blok budovy: prkna, 3 luky a nástroj stavby."
	]
	quest.691F720D92352757.title: "Lukostřelnice"
	quest.6946BDB9D5AB99DC.quest_desc: [
		"Draka můžeš vyvolat znovu. Polož 4 krystaly Endu (&eEnd Crystal&r) na okraje portálu uprostřed ostrova, na každou stranu jeden."
		"Každý nový drak dá hodně zkušeností a otevře další bránu na vnější ostrovy."
	]
	quest.6946BDB9D5AB99DC.title: "Návrat draka"
	quest.694E2FD62A3F2F5B.quest_desc: [
		"Kryopalivo je mnohem lepší palivo: na start stačí 1 kbelík místo 3."
		"Vyrábí ho kryomrazák (&eCryo Freezer&r) z ledu. Nejvíc ho dá ledový střep (&eIce Shard&r). Jeho ruda je na Měsíci, Marsu a Glaciu."
		"Jde i obyčejný, zhutněný a modrý led, ale dají méně."
	]
	quest.694E2FD62A3F2F5B.title: "Kryopalivo"
	quest.694FEE5A01E05038.quest_desc: [
		"Odporový štít (&eResistor Shield&r) chrání jako běžný štít. Když se jím bráníš, vysílá magnetický puls, který zraňuje okolní nepřátele."
		"Když se kryješ a držíš Shift, přepneš, jestli puls nepřátele odhazuje (modrá), nebo přitahuje (rudá)."
	]
	quest.694FEE5A01E05038.title: "Odporový štít"
	quest.6967D1592236E775.quest_desc: [
		"V teplém soudku vykvas z mléka, hnědé houby, dýňových semínek a cukru sýrovou hmotu. Nalij ji do plástve – vznikne nezralý sýr."
		"Nezralý sýr (&eUnripe Flaxen Cheese Wheel&r) polož jako blok. Časem dozraje na sýr (&eFlaxen Cheese Wheel&r)."
		"Nožem z něj na prkénku nakrájíš klínky sýra (&eFlaxen Cheese Wedge&r)."
	]
	quest.6967D1592236E775.title: "Zrající sýr"
	quest.69C42A5DCDF006F6.quest_desc: [
		"&eLanová kladka&r (&eRope Pulley&r) spouští a zvedá bloky svisle. Směr a rychlost určuje rotace."
		"&aTip:&r Prahový spínač u kladky změří, jak daleko je lano vysunuté."
	]
	quest.69C42A5DCDF006F6.title: "Lanová kladka"
	quest.69C7ACEF35C21398.quest_desc: [
		"Máslo (&eButter&r) je potřeba do spousty jídel."
		"Vlož do míchací misky kbelík mléka a míchej. Z jednoho kbelíku jsou 4 kusy másla."
	]
	quest.69C7ACEF35C21398.title: "Máslo"
	quest.69D098E0C40F4EC8.quest_desc: [
		"Zahrádky vypadají jako malé keříky. Rozbij je a dostaneš náhodnou plodinu."
		"Větrná zahrádka (&eWindy Garden&r) roste v pláních a savanách. Dává třeba salát, kukuřici, cibuli nebo jahody."
		"Každý biom má jinou zahrádku s jinými plodinami."
	]
	quest.69D098E0C40F4EC8.title: "Divoká zahrádka"
	quest.6A41D4E12AE7321F.quest_desc: [
		"Teď vaříš ve velkém. Hostina je velké jídlo pro celý tým. Pečené kuře (&eRoast Chicken&r) slož na pracovním stole z pečeného kuřete, pečených brambor, mrkví, cibule, vejce, chleba a misky."
		"Hostinu polož jako blok. Kdokoli si z ní pravým tlačítkem s miskou nabere porci."
		"&aTip:&r Porce z hostin patří k nejlepším jídlům ve hře. Dávají dlouhý efekt &eNourishment&r."
	]
	quest.6A41D4E12AE7321F.quest_subtitle: "Expert"
	quest.6A41D4E12AE7321F.title: "Hostina"
	quest.6A4E2310EA56C7C4.quest_desc: [
		"50 občanů! Z vesnice je opravdové město."
		"Teď se vyplatí vylepšovat budovy na úroveň 5 a dělat výzkumy, které zrychlují práci."
	]
	quest.6A4E2310EA56C7C4.quest_subtitle: "Expert"
	quest.6A4E2310EA56C7C4.title: "Město"
	quest.6A6230C4F0112F83.quest_desc: [
		"Tahle kapitola ukazuje doplňky Create pro rychlé cestování a pro tvou výbavu."
		""
		"&bCreate: Hypertubes&r – trubky, které tě přenesou po základně. &bCreate: Teleporters&r – teleporty pro hráče, předměty, bloky a velké portály."
		""
		"&bCreate Stuff 'N Additions&r – jetpacky, exoskelety, drony a plamenomet. &bCreate: Mechanical Companion&r – mechanický vlk, který tě chrání."
		""
		"&bCreate: Escalated&r – pohyblivé chodníky a eskalátory. &bCreate: Aquatic Ambitions&r – klec pro konduit a nový druh zpracování větrákem."
		""
		"Každá linka vede od začátečníka přes pokročilého až po experta. Úrovně poznáš podle šestiúhelníků. &aPrvní quest hypertrubek, teleportů, jetpacku, dronu a vlka je v kapitole Create: doplňky.&r"
		"{@pagebreak}"
		"&ePojmy, které tu potkáš:&r"
		""
		"&eRPM&r = otáčky za minutu, tedy jak rychle se hřídel točí. &emB&r = tisícina kbelíku kapaliny (1000 mB = 1 kbelík)."
		""
		"&eSekvenční montáž&r = výroba po krocích. Předmět jede po pásu pod stroji a každý stroj přidá jeden krok. Přesné kroky ukáže JEI."
		""
		"Pokladač (&eDeployer&r) přikládá předměty, dávkovač (&eSpout&r) plní kapalinou. Mechanický výrobník (&eMechanical Crafter&r) skládá velké recepty, které se na pracovní stůl nevejdou."
	]
	quest.6A6230C4F0112F83.quest_subtitle: "Cestování a vybavení s Create"
	quest.6A6230C4F0112F83.title: "Pohyb a výbava"
	quest.6A6F4535B6EFE324.quest_desc: [
		"Kladivo (&eHammer&r) z &bAnother Furniture&r mění tvar nábytku z tohoto modu. Klikni s ním na nábytek."
		"Vyrobíš ho z prken, dřevěného půlbloku a tyček."
	]
	quest.6A6F4535B6EFE324.title: "Nábytkové kladivo"
	quest.6A7A863777ED7392.quest_desc: [
		"&eTrezor&r (&eItem Vault&r): 2 železné pláty a sud. Velké úložiště pro stroje."
		"Trezory vedle sebe se spojí: základna až 3×3, délka až trojnásobek šířky."
		"&cRučně do trezoru nic nedáš ani nevezmeš.&r Použij trychtýř, šachtu, paži nebo dvířka na předměty (kapitola Logistika)."
	]
	quest.6A7A863777ED7392.title: "Trezor"
	quest.6A98999506693395.quest_desc: [
		"Kolonii ohrožují monstra a nájezdníci. Občané se sami neubrání – potřebují strážné."
		"Nájezdy přicházejí v noci. Kolonii napadnou barbaři, piráti, seveřané, amazonky nebo mumie – podle okolí."
		"Piráti a seveřané připlouvají na lodi. &cDokud loď nezničíš, útočí dál.&r"
		"{@pagebreak}"
		"V této kapitole postavíš obranu od první věže po kasárny a výcvik a k tomu se naučíš výzkum na univerzitě."
		"&aTip:&r Osvětli kolonii pochodněmi. Méně monster = méně zraněných občanů."
	]
	quest.6A98999506693395.title: "Ochrana kolonie"
	quest.6AA2742E6DA0E59E.quest_desc: [
		"Dokovací spojka (&eDocking Connector&r) pevně spojí dva stroje, třeba loď s přístavem."
		"Vysunuté spojky se k sobě natočí a po vyrovnání zacvaknou. Pak jimi tečou předměty a tekutiny oběma směry. Zasunutím jedné spojky se odpojíš."
		"Komparátor ukáže, jak daleko je dokování. Vyrábí se v mechanickém výrobníku (2 kusy)."
	]
	quest.6AA2742E6DA0E59E.title: "Dokování"
	quest.6AC05E41D721865C.quest_desc: [
		"Luxusní postel (&eOak Fancy Bed&r) je z prken, vlny, polštáře a povlečení. Spí se v ní jako v normální posteli."
		"Polštářem na ni klikneš a změníš barvu polštáře, povlečením změníš prostěradlo."
	]
	quest.6AC05E41D721865C.title: "Luxusní postel"
	quest.6AE61091417A6991.quest_desc: [
		"Bramborová polévka (&ePotato Soup&r) je nejjednodušší polévka: brambora a cibule v hrnci, k tomu miska."
		"Polévky dobře zasytí. Další recepty (guláš, rajská, ječná) najdeš v JEI u hrnce."
	]
	quest.6AE61091417A6991.title: "Bramboračka"
	quest.6AF8280566D420EB.quest_desc: [
		"Vak sytosti (&eSack of Sating&r) sní jídlo, které na něj přetáhneš, a uloží si ho."
		"Když máš hlad, sám tě nakrmí. Unese skoro nekonečně jídla."
		"Vyrobíš ho ze sladkého zubu, želatiny a lékořicových šlahounů."
	]
	quest.6AF8280566D420EB.title: "Vak sytosti"
	quest.6B4CCAC6770F1404.quest_desc: [
		"Ovládací prvky vlaku (&eTrain Controls&r) jsou volant a pedály vlaku. Každý vlak je musí mít."
		"Výroba: páka, vlakové pouzdro a precizní strojek."
		"&aDruhé ovládání otočené na opačnou stranu dovolí vlaku odjíždět ze stanic oběma směry. Hodí se pro trať tam a zpět.&r"
	]
	quest.6B4CCAC6770F1404.title: "Ovládání vlaku"
	quest.6B4D06D4AB738B14.quest_desc: [
		"&eBramborové dělo&r (&ePotato Cannon&r) střílí vhodné předměty z tvého inventáře, třeba brambory. Vyrábí se v mechanickém výrobníku."
		"S tlakovou lahví na zádech bere vzduch místo životnosti."
	]
	quest.6B4D06D4AB738B14.title: "Bramborové dělo"
	quest.6B81F853DB48C92C.quest_desc: [
		"Netheritový jetpack vyrobíš na kovářském stole: jetpack + netheritový ingot + šablona netheritového vylepšení."
		"Je to netheritová tlaková láhev s tryskami. Ovládá se stejně jako obyčejný jetpack."
	]
	quest.6B81F853DB48C92C.title: "Netheritový jetpack"
	quest.6B9CEEEFBF8CBB95.quest_desc: [
		"Upgrade koše (&eVoid Upgrade&r) maže věci, které nechceš – třeba hlínu nebo dlažební kámen."
		"&cPozor:&r smaže všechno, co dáš do filtru. Nastav ho pečlivě."
	]
	quest.6B9CEEEFBF8CBB95.title: "Koš na smetí"
	quest.6BBCEE5787B66DF5.quest_desc: [
		"Andezit a železný (nebo zinkový) nuget v tyglíku pod míchačkou dají andezitovou slitinu. Teplo není potřeba."
		"Linka: trychtýře sypou andezit a nugety do tyglíku, výstup jde do truhly. Nugety dá praní štěrku nebo drti."
		"&aTip:&r 9 slitin slisuj na blok, ušetříš místo."
	]
	quest.6BBCEE5787B66DF5.title: "Slitina ve velkém"
	quest.6BCF555370BC9CDE.quest_desc: [
		"Kokosy (&eCoconut&r) visí na palmách – rozbij je. Z palmového dřeva vyrobíš bar (&ePalm Bar&r)."
		"Kokos otevřeš tak, že ho hodíš (pravé tlačítko). Na zemi se rozbije na otevřený kokos (&eOpen Coconut&r)."
	]
	quest.6BCF555370BC9CDE.title: "Kokosy a bar"
	quest.6BDBCAB666D31891.quest_desc: [
		"Exoskelet nosíš místo hrudního plátu a dává ti efekty navíc. Spotřebovává přitom palivo nebo vodu."
		""
		"Andezitový (&eAndesite Exoskeleton&r) běží na palivo: rychleji těžíš (Spěch II), ale slaběji útočíš (Slabost). Měděný (&eCopper Exoskeleton&r) běží na vodu: silněji útočíš (Síla II), ale pomaleji těžíš."
		""
		"Mosazný (&eBrass Exoskeleton&r) dává Spěch i Sílu a potřebuje palivo i vodu. Na kovářském stole ho stejně jako jetpack vylepšíš na netheritový."
	]
	quest.6BDBCAB666D31891.title: "Exoskelet"
	quest.6C09E821C47BD8DA.quest_desc: [
		"Nůž (&eFlint Knife&r) je hlavní nástroj kuchaře. Vyrobíš ho z pazourku nad klackem."
		"Nožem sklízíš slámu z trávy a obilí. Zvíře zabité nožem má šanci pustit i něco navíc, třeba šunku z prasete."
		"&aTip:&r Nůž je i rychlá zbraň. Lepší nože vyrobíš ze železa, zlata nebo diamantu."
	]
	quest.6C09E821C47BD8DA.title: "Pazourkový nůž"
	quest.6C0EF7A6D606A86D.quest_desc: [
		"Diamantové srdce (&eHeart of Diamond&r) nosí kamenný tvoreček &eStoneling&r. Najdeš ho hluboko v jeskyních."
		"Rozbij jeho skořápku a srdce vypadne. Neboj, Stonelingovi se nic nestane."
		"Srdce potřebuješ na pickarang a na malou bramboru."
	]
	quest.6C0EF7A6D606A86D.title: "Diamantové srdce"
	quest.6C2AA59E3F2311DA.quest_desc: [
		"Endový sledovač (&eEnder Watcher&r) vyšle redstonový signál, když se na něj díváš. Čím přesněji míříš na střed, tím silnější signál."
		"Hodí se na tajné dveře."
	]
	quest.6C2AA59E3F2311DA.title: "Endový sledovač"
	quest.6C2B8E4177842108.quest_desc: [
		"Bronz (&eBronze Ingot&r) vzniká v infuzéru: zdrojem infuze je cínový prach, doprostřed dej 3 měděné ingoty. Vyjdou 4 bronzové ingoty."
		"Bronz potřebuješ na solární neutronový aktivátor a na moduly MekaSuitu. Z bronzu jsou i nástroje a brnění z &bMekanism Tools&r."
		"&aTip:&r Bronz z jiných modů je v packu sjednocený na tenhle."
	]
	quest.6C2B8E4177842108.title: "Bronz"
	quest.6C3366D11B183028.quest_desc: [
		"Sklenice (&eGlass Jar&r) se vyrábí z dřevěné desky a skla."
		"Polož ji na zem. Pak na ni klikni síťkou, ve které máš chyceného motýla – motýl se přesune do sklenice."
	]
	quest.6C3366D11B183028.title: "Sklenice"
	quest.6C4F838C1079AFFB.quest_desc: [
		"Metalurgický infuzér (&eMetallurgic Infuser&r) napustí kov jinou látkou, třeba uhlíkem nebo redstonem. Je to první a nejdůležitější stroj Mekanismu."
		"Do levého slotu dej zdroj infuze (uhlí, redstone…), do prostředního předmět, který chceš upravit. Stroj musí mít energii."
		"&aTip:&r Vyrobíš ho ze železa, dvou pecí, redstonu a osmiového ingotu."
	]
	quest.6C4F838C1079AFFB.title: "Metalurgický infuzér"
	quest.6C6506A05B72E622.quest_desc: [
		"Tahle kniha je &eprůvodce&r modpackem. Každá kapitola tě krok za krokem provede jedním modem nebo tématem."
		""
		"Úkoly se plní samy. Stačí mít věc v inventáři – nic se ti nevezme."
		"Když quest splníš, klikni na něj a vyzvedni si odměnu (většinou zkušenosti)."
		"{@pagebreak}"
		"&aTip:&r Klikni v questu na obrázek předmětu. Otevře se jeho recept v &bJEI&r."
		"Čáry mezi questy ukazují pořadí. Začni vlevo a pokračuj po čarách doprava."
		"Kapitoly najdeš v levém sloupci. Po této kapitole pokračuj kapitolou &ePrvní dny&r."
	]
	quest.6C6506A05B72E622.quest_subtitle: "Začátečník"
	quest.6C6506A05B72E622.title: "Vítej!"
	quest.6CAD7393A0ABE08F.quest_desc: [
		"Zásobovací tábor (&eSupply Camp&r) je startovní balíček kolonie."
		"Vyrobíš ho z 5 truhel (do tvaru písmene U). Klikni s ním pravým tlačítkem na zem a umístění potvrď."
		"Potřebuje rovné místo aspoň 16 × 17 bloků bez trávy, květin a děr. Když chceš začít u vody, vyrob místo něj zásobovací loď (&eSupply Ship&r) z 5 člunů a polož ji na moře nebo řeku."
		""
		"V táboře najdeš truhlu se zásobami, radnici a nástroj stavby. &cTábor nebo loď položíš jen jednou.&r"
	]
	quest.6CAD7393A0ABE08F.title: "Zásobovací tábor"
	quest.6CDD46E3C0D99532.quest_desc: ["Kyj se žraločími zuby (&eShark Tooth Club&r). Vyrob ho ze 4 žraločích zubů, 2 prken a tyčky."]
	quest.6CDD46E3C0D99532.title: "Žraločí kyj"
	quest.6CEF27F130DEC054.quest_desc: [
		"Gyroskopický mechanismus (&eGyroscopic Mechanism&r) je díl pro chytré vrtule a senzor náklonu."
		"Vyrábí se sekvenční montáží jako precizní strojek: na železný plát pokladače přidají ozubené kolečko, hřídel a mosazný nuget. Postup se opakuje 5×."
	]
	quest.6CEF27F130DEC054.title: "Gyroskopický mechanismus"
	quest.6D06F4039E57FBF9.quest_desc: [
		"Střelná bavlna (&eGuncotton&r) je silná výbušnina do granátů."
		""
		"V míchačce smíchej papír, střelný prach, redstone a 200 mB vody. Ohřev není potřeba."
		""
		"Lis nad tyglíkem slisuje 3 kusy na lisovanou střelnou bavlnu (&ePacked Guncotton&r)."
	]
	quest.6D06F4039E57FBF9.title: "Střelná bavlna"
	quest.6D151FC09844AC07.quest_desc: [
		"Rostlinná fosilie (&ePlant Fossil&r) padá z bloků fosilií a ze síta."
		"V analyzátoru z ní dostaneš zkamenělá semínka a pravěké sazenice."
	]
	quest.6D151FC09844AC07.title: "Rostlinná fosilie"
	quest.6D1A69CDD35FA687.quest_desc: [
		"Síťka (&eButterfly Net&r) z &bLuminous Overworld&r. Vyrob ji ze 2 zlatých ingotů, vlákna a 2 tyček."
		"Recept je stejný jako u síťky z &bLuminous Butterflies&r. Kterou síťku dostaneš, vybereš tlačítkem u výsledku receptu."
		"&cMotýly chytíš jen touto síťkou z Luminous Overworld.&r"
	]
	quest.6D1A69CDD35FA687.title: "Síťka na motýly"
	quest.6D1CDC40980D9EA3.quest_desc: [
		"Zvěřina (&eVenison&r) padá z jelena (&eDeer&r) z modu Naturalist. Jeleni žijí v lesích a sakurových hájích."
		"Jsou plaší a rychle utíkají, takže se k nim musíš připlížit. Zvěřinu si upeč."
	]
	quest.6D1CDC40980D9EA3.title: "Zvěřina"
	quest.6D24FE3EA5B73247.quest_desc: [
		"Ohnivý ingot (&eFiery Ingot&r) = železný ingot + ohnivá krev (od hydry) nebo ohnivé slzy (od Ur-Ghasta)."
		"Z ohnivých ingotů je ohnivá zbroj, meč a krumpáč, který rovnou taví rudy."
	]
	quest.6D24FE3EA5B73247.title: "Ohnivý ingot"
	quest.6D3B1CC2EB485285.quest_desc: [
		"Teď se pustíš do hlubin a za mořskými příšerami."
		"Zkamenělina (&eEmbedded Ammonite&r) je blok v kameni pod plážemi a oceány. Když ji upečeš v peci, dostaneš &eUlitu loděnky&r."
	]
	quest.6D3B1CC2EB485285.quest_subtitle: "Pokročilý"
	quest.6D3B1CC2EB485285.title: "Zkamenělá loděnka"
	quest.6D4F78DFCA534C07.quest_desc: [
		"Těžká kuše (&eHeavy Crossbow&r) střílí silné šípy. Munice: šípy v inventáři letadla."
		"Výroba: kuše, háček na nástražný drát a kmen."
	]
	quest.6D4F78DFCA534C07.title: "Těžká kuše"
	quest.6D63CC2383ECC6BB.quest_desc: [
		"Drak během boje plive fialový dech. Naber ho do prázdné lahve (&eGlass Bottle&r)."
		"Dračí dech (&eDragon's Breath&r) je potřeba na lektvary s dlouhým oblakem (&eLingering Potion&r)."
		"&aTip:&r drak se dá vyvolat znovu – stačí položit 4 krystaly Endu na okraj portálu."
	]
	quest.6D63CC2383ECC6BB.title: "Dračí dech"
	quest.6D668EB648F9F994.quest_desc: [
		"Jantarová ruda (&eAmber Ore&r) je pod zemí. Padá z ní kousek jantaru."
		"Kousek s komárem (&eMosquito Amber Chunk&r) padne jen asi v 1 z 20 případů. Je to vzácná sběratelská ozdoba."
	]
	quest.6D668EB648F9F994.title: "Komár v jantaru"
	quest.6D72B844FAEADD22.quest_desc: [
		"Červené víno (&eRed Wine&r) je nejjednodušší: šťáva z červených hroznů a cukr."
		"Víno dává efekt – červené víno pomalé padání. Jiná vína dávají třeba skok, neviditelnost nebo chůzi po vodě."
		"Další vína, zrání a vzácné odrůdy najdeš v kapitole &bLet's Do: víno, pivo a čaj&r."
	]
	quest.6D72B844FAEADD22.quest_subtitle: "Pokročilý"
	quest.6D72B844FAEADD22.title: "První víno"
	quest.6D850A6BDA9784EC.quest_desc: [
		"&bLuminous Nether&r přidává do Netheru popelový les s duchy, houbové pláně s kultem piglinů a nové bestie."
		"Další questy v této větvi se plní v Netheru. Vždy si tam vezmi ohnivzdorné lektvary."
	]
	quest.6D850A6BDA9784EC.title: "Luminous Nether"
	quest.6D9E51080A6D1690.quest_desc: [
		"&bChef's Delight&r přidává dvě nová povolání vesničanů: kuchaře (&eCook&r) a šéfkuchaře (&eChef&r)."
		"Vesničan bez práce se stane kuchařem u pánve a šéfkuchařem u hrnce. Ve vesnicích mají i vlastní domky."
		"Prodávají hotová jídla za smaragdy a kupují suroviny, třeba cukr nebo bobule. Quest se splní po prvním obchodu s jakýmkoli vesničanem."
	]
	quest.6D9E51080A6D1690.title: "Kuchař ve vesnici"
	quest.6DAC10E124A880D5.quest_desc: [
		"Jet suit je nejlepší skafandr: víc ochrany, víc kyslíku a umí létat."
		"Mezerník = stoupání, mezerník + sprint = rychlý let. Let funguje na energii, nabij ho v energizéru."
		"Vyrobíš ho z netheritového skafandru, kaloritu, kaloritových nádrží a motoru."
	]
	quest.6DAC10E124A880D5.title: "Jet suit"
	quest.6DDC47E42B4786F6.quest_desc: [
		"Plastové bloky (&eWhite Plastic Block&r) vyrobíš ze 4 HDPE desek a barviva. Vyjdou 4 kusy v barvě barviva."
		"Z nich jdou další varianty: kluzký plast, svítící plast, plastová cesta nebo zesílený plast."
		"&aTip:&r Svítící panely (&eWhite Glow Panel&r) jsou pěkné osvětlení do základny."
	]
	quest.6DDC47E42B4786F6.title: "Plastové bloky"
	quest.6DE18E99A754A231.quest_desc: [
		"Vykopej jámu 2 × 2 a naplň ji vodou. Kolem jámy musí být bloky hlíny nebo trávy. Na každý z nich zasaď květinu nebo trávu."
		"Do vody hoď diamant (klávesa Q). Udeří blesk a voda se změní na portál."
		"&cBlesk může zapálit okolí – nestav portál vedle dřevěného domu.&r"
	]
	quest.6DE18E99A754A231.title: "Portál"
	quest.6DEEBF92DCFA60F9.quest_desc: [
		"Zvadlý les (&eWithered Forest&r) je staré bojiště piglinů a wither kostlivců."
		"Bloudí tu neklidní duchové. Zabij jednoho z nich."
	]
	quest.6DEEBF92DCFA60F9.title: "Neklidný duch"
	quest.6DFCD844C6EFF560.quest_desc: [
		"Blok nástupiště (&eStation Platform&r) postav podél koleje u stanice. Cestující pak nastupují pohodlně."
		"Vyrobíš ho v kamenořezu z hladkého kamene (2 kusy) nebo v pracovním stole z hladkého kamene a hladké kamenné desky."
	]
	quest.6DFCD844C6EFF560.title: "Nástupiště"
	quest.6DFD41C194A0DF40.quest_desc: [
		"&bMekanism Tools&r přidává nástroje, štíty a brnění z osmia, bronzu, oceli, lazuritu, rafinovaného světlitu a rafinovaného obsidiánu."
		"Paxel (&eSteel Paxel&r) je krumpáč, sekera a lopata v jednom. Vyrobíš ho z ocelového krumpáče, sekery, lopaty a dvou železných ingotů."
		"&aTip:&r Ocel je dobrý začátek. Později přejdi na rafinovaný obsidián."
	]
	quest.6DFD41C194A0DF40.title: "Mekanism Tools"
	quest.6DFF8B4FD3C35A49.quest_desc: [
		"Teď už klec nejen dává efekty, ale i vyrábí. Větrák, který fouká skrz probuzenou klec, zpracovává předměty novým způsobem (&eConduit Channeling&r)."
		""
		"Z podezřelého kamene tak dostaneš s šancí 50 % ulitu loděnky a s šancí 10 % ostnatou lasturu (&eSpiky Shell&r)."
		""
		"Stejně vyrobíš srdce moře z oka Endu, prismarinové střepy z pazourku nebo oživíš mrtvé korály."
		""
		"&aZe 3 ostnatých lastur a 2 prismarinových tyčí vyrobíš trojzubec!&r"
	]
	quest.6DFF8B4FD3C35A49.quest_subtitle: "Expert"
	quest.6DFF8B4FD3C35A49.title: "Ostnatá lastura"
	quest.6E0B4DAE21234453.quest_desc: [
		"Ve stole na buňky (&eCell Workbench&r) nastavíš buňce filtr: bude přijímat jen vybrané věci."
		"Do buňky tu vložíš i karty – třeba kartu přetečení (&eOverflow Destruction Card&r), která maže, co se už nevejde."
		"&aTip:&r Filtr se hodí pro farmy: buňka jen na kámen nezaplní ostatní buňky."
	]
	quest.6E0B4DAE21234453.title: "Rozdělení buněk"
	quest.6E29AC6B6663CFA1.quest_desc: [
		"Chyť motýla (&eButterfly&r) sítí. Motýli létají v lesích, na nížinách a v bažinách."
		"Chycený motýl je v inventáři jako předmět."
	]
	quest.6E29AC6B6663CFA1.title: "Motýl"
	quest.6E3CD9E05F102742.quest_desc: [
		"&bJEI&r je seznam všech předmětů vpravo vedle inventáře. Ukáže ti, jak se co vyrábí."
		"Najeď myší na předmět a zmáčkni &eR&r – uvidíš recept. Klávesa &eU&r ukáže, k čemu se předmět používá."
		"Do hledání skočíš klávesami &eCtrl + F&r. Klávesa &eA&r uloží předmět do záložek."
		"&aTip:&r Napiš do hledání @ a jméno modu (třeba @create) a uvidíš jen věci z toho modu."
		"Zkus to hned: najdi recept na truhlu a vyrob si ji."
	]
	quest.6E3CD9E05F102742.title: "Recepty v JEI"
	quest.6E430BE9B60F06FA.quest_desc: [
		"Obsidiánová truhla (&eObsidian Chest&r) má také 108 slotů. Diamantovou truhlu obklop 8 obsidiány."
		"Až budeš mít opravdu hodně věcí, podívej se na úložné systémy v kapitole &eÚložiště&r."
	]
	quest.6E430BE9B60F06FA.title: "Obsidiánová truhla"
	quest.6E4713E15FE7F816.quest_desc: [
		"Ocelové krytí (&eSteel Casing&r) je základ skoro všech strojů Mekanismu."
		"Recept: 4 ocelové ingoty, 4 sklo a 1 osmiový ingot uprostřed."
		"&aTip:&r Vyrob si jich rovnou víc – každý stroj potřebuje jedno."
	]
	quest.6E4713E15FE7F816.title: "Ocelové krytí"
	quest.6E5CD2045236F6EC.quest_desc: [
		"Výrobce šípů (&eFletcher's Hut&r) vyrábí věci z vlny, vlákna a kůže, třeba postele a koberce."
		"Výzkum &eStringwork&r stojí 16 vláken a potřebuje pilu úrovně 1. Blok budovy: prkna, vlákno a nástroj stavby."
	]
	quest.6E5CD2045236F6EC.title: "Výrobce šípů"
	quest.6E65828699E602E2.quest_desc: [
		"Teď poprvé obchoduješ bez klikání."
		""
		"Na obchodní stolek polož to, co vesničan za obchod chce (třeba smaragdy). Filtrem na stolku vyber, jaké zboží chceš dostat. Zboží se objeví na stolku."
		""
		"&aVesničan obchoduje jen v pracovní době, tedy přes den. V noci stolek čeká.&r"
	]
	quest.6E65828699E602E2.quest_subtitle: "Začátečník"
	quest.6E65828699E602E2.title: "Automatický obchod"
	quest.6E6F0F80A13EA95B.quest_desc: [
		"Mod &bIron Chests&r přidává větší truhly. Měděná truhla (&eCopper Chest&r) má 45 slotů (obyčejná 27)."
		"Obyčejnou truhlu obklop 8 měděnými ingoty."
		"Další je železná truhla (&eIron Chest&r) s 54 sloty – najdeš ji v kapitole &eÚložiště&r."
	]
	quest.6E6F0F80A13EA95B.title: "Měděná truhla"
	quest.6E730F09D60399C1.quest_desc: [
		"Náhodné očarování ti nestačí? Očaruj místo předmětu prázdnou šablonu."
		""
		"Do panelu na očarovávači vlož vzorový předmět, třeba diamantový meč. Pak do očarovávače vlož prázdnou šablonu."
		""
		"Šablona dostane očarování, která se hodí pro vzorový předmět. Různé materiály a druhy předmětů dávají různá očarování."
	]
	quest.6E730F09D60399C1.title: "Naplň šablonu"
	quest.6E9E877DBE8B8833.quest_desc: ["Chorusový džus (&eChorus Juice&r) slož na pracovním stole z plodu chorusu, cukru a lahve."]
	quest.6E9E877DBE8B8833.title: "Chorusový džus"
	quest.6EA381396F8998C4.quest_desc: [
		"Antihmota vzniká v SPS jako plyn. Krystalizátor z 1000 mB udělá peletu antihmoty (&eAntimatter Pellet&r)."
		"Pelety potřebuješ na antiprotonový nukleosyntetizátor."
		"&aTip:&r Antihmotu ukládej do chemických nádrží, ať o ni nepřijdeš."
	]
	quest.6EA381396F8998C4.title: "Antihmota"
	quest.6EAC1A844434D4AA.quest_desc: [
		"Jaderná pec taví všechno, co vysoká pec, ale 5× rychleji."
		"Postav ji z 8 dílů (&eNuclear Furnace Component&r) do kostky 2×2×2. Díly jsou z uranu, vysoké pece a zuhelnatělých zbytků (&eCharred Remnant&r, padají z Brainiaca)."
		"Palivem jsou uranové tyče. Jedna utaví celý stack, ale vzniká odpad."
		"&cDo pece vkládej kovové sudy (&eMetal Barrel&r). Odpad se do nich uloží. Jinak pec vybuchne!&r"
		"Kovový sud vyrobíš z obyčejného sudu a 8 železných ingotů."
	]
	quest.6EAC1A844434D4AA.title: "Jaderná pec"
	quest.6EC575EC5405BBA1.quest_desc: [
		"Ocelový list (&eSteeleaf&r) najdeš v truhlách – v dutých kopcích, labyrintu, rytířské pevnosti a temné věži."
		"Železodřevo vyrobíš: živý kořen (&eLiveroot&r) + surové železo + zlatý nuget = 2 surová železodřeva (&eRaw Ironwood&r). Ty přetav v peci."
		"Živý kořen vytěžíš z živých kořenů pod zemí. Co z obou materiálů vyrobit, ukazuje kapitola výbavy."
	]
	quest.6EC575EC5405BBA1.title: "Ocelový list a železodřevo"
	quest.6EC809EC0971B208.quest_desc: [
		"Vlak jezdí i bez paliva, ale s palivem jede rychleji. Hledá ho v truhlách a sudech, které jsou součástí vlaku. Palivo v trezoru (&eItem Vault&r) vlak nespotřebuje."
		"Palivová nádrž (&eFuel Tank&r) ze &bSteam 'n' Rails&r veze tekuté palivo, například lávu. Obyčejnou vodu nepřijme."
		"Výroba: nádrž (&eFluid Tank&r) mezi dvěma robustními pláty."
	]
	quest.6EC809EC0971B208.title: "Palivo pro vlak"
	quest.6EDC3C84AA4E1319.quest_desc: [
		"Plášť stroje (&eMachine Casing&r) je základ bloků Refined Storage: 8 křemenného železa a kámen."
		"Kabel (&eCable&r) spojuje zařízení. Zařízení se propojí i tím, že stojí přímo vedle sebe."
		"&aTip:&r Obarvené kabely a bloky se spojí jen se stejnou barvou nebo s neobarvenými (ve výchozí barvě)."
	]
	quest.6EDC3C84AA4E1319.title: "Plášť a kabely"
	quest.6EE057CB034A6E2F.quest_desc: [
		"Váleček (&eRoller&r) vyrobíš z kmene a dvou klacků."
		"Váleček a zelenina (mrkev, brambora, řepa nebo dýně) na pracovním stole dají olej (&eCooking Oil&r)."
	]
	quest.6EE057CB034A6E2F.title: "Váleček a olej"
	quest.6EF6CEBCE3296864.quest_desc: [
		"Jmenovka (&eNameplate&r) dá tvému stroji jméno. Papír, tyčka a andezitová slitina dají 4 jmenovky."
		"Klikni na ni a napiš jméno. Barvivem změníš barvu písma, plástvem medu text zamkneš. Všechny jmenovky na jednom stroji ukazují stejné jméno."
	]
	quest.6EF6CEBCE3296864.title: "Jmenovka"
	quest.6F495425FAFB1FF4.quest_desc: [
		"Vrchol Netheru: hoď na oltář hvězdu Netheru (klávesa Q). Objeví se boss &eHovering Inferno&r."
		"Boss létá, sesílá ohnivá kouzla a před smrtí zkusí poslední velké kouzlo. Přežij ho a porazíš ho."
		"&cPotřebuješ ohnivzdornost, hodně léčení a dobrou zbraň na dálku.&r"
	]
	quest.6F495425FAFB1FF4.quest_subtitle: "Expert"
	quest.6F495425FAFB1FF4.title: "Vznášející se peklo"
	quest.6F500547CAD9E310.quest_desc: [
		"&bAnother Furniture&r: židle, stoličky, pohovky, police, závěsy, okenice a lampy."
		"Židli (&eOak Chair&r) z &bAnother Furniture&r vyrobíš z prken a tyček. Dá se zasunout pod stůl."
	]
	quest.6F500547CAD9E310.title: "Zasunovací židle"
	quest.6F540C0CF0F27C00.quest_desc: [
		"Katalyzátor nahradí blok před větrákem (&eEncased Fan&r) při hromadném zpracování."
		""
		"Prázdný katalyzátor (&eEmpty Fan Catalyst&r) vyrobíš z mosazi a železných mříží. Dávkovačem ho naplň lávou a vznikne tavný katalyzátor (&eFan Blasting Catalyst&r)."
		""
		"Polož ho před větrák místo lávy. Láva v katalyzátoru nic nezapálí a nikam neteče. S vodou vyrobíš prací katalyzátor, kliknutím netherrackem uzený katalyzátor."
	]
	quest.6F540C0CF0F27C00.title: "Katalyzátor větráku"
	quest.6F61596C00BE510E.quest_desc: [
		"Jemný prach (&eFine-Grain Powder&r) se spotřebuje při nabíjení a zvýší dostřel o 50 %."
		"Výroba: kostní moučka, střelný prach a dřevěné uhlí dají 3 kusy."
	]
	quest.6F61596C00BE510E.title: "Jemný prach"
	quest.6F968C7E66259108.quest_desc: [
		"Dojdi k meteoritu. Je to kráter s koulí z nebeského kamene (&eSky Stone&r)."
		"Prokopej se do středu. Najdeš certusový křemen, rostoucí krystaly, pučící certus a uprostřed tajemnou kostku (&eMysterious Cube&r)."
		"Vykopej tajemnou kostku obyčejným krumpáčem, ne Něžným dotekem. Vypadnou z ní všechny lisy pro razítkovač (&eInscriber&r)."
	]
	quest.6F968C7E66259108.title: "Najdi meteorit"
	quest.6F9E5FEF03BB4570.quest_desc: [
		"Prut občas vytáhne místo ryby bednu: krabici (&eBox&r), schránku (&eLockbox&r) nebo truhlu s pokladem (&eTreasure Chest&r)."
		"Pravým tlačítkem ji otevřeš. V truhle s pokladem jsou železo, zlato, smaragdy i diamanty."
		"&aTip:&r Zlatý háček a očarování Štěstí moří zvyšují šanci na poklad."
	]
	quest.6F9E5FEF03BB4570.title: "Poklad z hlubin"
	quest.6FBCAAAFAABBA06D.quest_desc: [
		"Železný sekáček (&eIron Cleaver&r) je kuchyňský nůž i zbraň."
		"Polož ho na krájecí prkénko. Pak se surovinou v ruce drž pravé tlačítko a surovina se nakrájí: z vepřového je slanina, z hovězího mleté maso, z těsta těstoviny."
		"Na prkénku bez nástroje můžeš skládat jídla: polož na něj suroviny a klikni prázdnou rukou. Tak vzniknou třeba krmiva pro zvířata."
	]
	quest.6FBCAAAFAABBA06D.title: "Sekáček"
	quest.6FE1B7AF17E70C1C.quest_desc: [
		"Vylepšení kapacity (&eStorage Upgrade (I)&r a vyšší) zvětší, kolik se do šuplíku vejde. Vyrábí se ze šablony (&eUpgrade Template&r) a materiálu: obsidiánu, mědi, železa, zlata, smaragdu, diamantu nebo netheritu."
		"Vylepšení vložíš tak, že s ním v ruce klikneš pravým tlačítkem na šuplík."
		"&aTip:&r Vylepšení prázdnoty (&eVoid Upgrade&r) maže, co se už nevejde – hodí se k farmám."
	]
	quest.6FE1B7AF17E70C1C.title: "Větší šuplíky"
	quest.703AF89C4077863C.quest_desc: [
		"Guláš (&eBass Stew&r) uvaříš v hrnci z okounka nebo okouna, zelí a houby. Servíruje se do misky."
		"&aTip:&r Z křupavého okouna, pečené brambory a rajčatové omáčky složíš rybu s hranolky (&eFish and Chips&r)."
	]
	quest.703AF89C4077863C.title: "Rybí guláš z okounka"
	quest.7041F9C5A2BC0D3A.quest_desc: [
		"Ve stáji (&eStable&r) se chovají koně pro jezdce. Jízdní strážný je rychlý a odolný."
		"Výzkum &eMounted Combat&r stojí sedlo a vodítko. Blok budovy: prkna, zlaté jablko a nástroj stavby."
	]
	quest.7041F9C5A2BC0D3A.title: "Stáj"
	quest.7042903AB74FBC54.quest_desc: [
		"Bloky fosilií (&eStone Fossil Block&r, &eDeepslate Fossil Block&r a další) jsou pod zemí. Vypadají jako kámen s otiskem kostí."
		"Z kamenných bloků padá biofosilie (&eBio Fossil&r), střepy relikvie, rostlinná fosilie, kosti a vzácně i něco cenného. Z bloků v hlubinné břidlici padá místo biofosilie břidlicová fosilie."
		"&aBlok fosilie vytěžený s Hedvábným dotekem rozdrtí i drtící kola z Create.&r"
	]
	quest.7042903AB74FBC54.title: "Vykopej fosilii"
	quest.7054E71D7A76FCA7.quest_desc: [
		"&eVýrobní plánek&r (&eCrafting Blueprint&r): obraz a pracovní stůl. Pověs ho na zeď a do jeho políček nastav recepty."
		"Pak stačí kliknout na políčko a předmět se vyrobí ze surovin, které neseš. Nemusíš chodit k pracovnímu stolu."
	]
	quest.7054E71D7A76FCA7.title: "Výrobní plánek"
	quest.705AF46C239A0D62.quest_desc: [
		"Biom je druh krajiny: les, poušť, hory, oceán… Každý biom má jiné stromy, zvířata a stavby."
		"&bTerralith&r přidává přes 90 nových biomů, i podzemních. &bTectonic&r dělá krajinu vyšší a dramatičtější."
		""
		"Název biomu uvidíš po stisku F3 (vlevo, řádek &eBiome&r). Biomy z Terralithu mají jméno jako &eterralith:yellowstone&r."
	]
	quest.705AF46C239A0D62.quest_subtitle: "Začátečník"
	quest.705AF46C239A0D62.title: "Nové biomy"
	quest.705E53EE145EE994.quest_desc: [
		"V monumentu žijí prastrážci. Dávají ti &eÚnavu z těžby&r, takže zdi neprokopeš."
		"Poraz je. Únava pak zmizí a můžeš v klidu kopat a hledat poklady."
		""
		"&aTip:&r Mléko únavu na chvíli smaže."
	]
	quest.705E53EE145EE994.title: "Prastrážce"
	quest.706DDD55B20D74E3.quest_desc: [
		"Normálně líheň pracuje jen tehdy, když je hráč blízko."
		"&eNetherová hvězda&r (z Withera) to změní. Líheň pak běží, i když jsi daleko – třeba pro automatickou farmu."
	]
	quest.706DDD55B20D74E3.title: "Líheň bez hráče"
	quest.706EEB0644E303E5.quest_desc: [
		"Rozpadlý hrad od &bMoog's Voyager Structures&r. Může stát skoro kdekoli na pevnině."
		"V sutinách jsou truhly a sudy."
	]
	quest.706EEB0644E303E5.title: "Zřícenina hradu"
	quest.707486F1C543C40D.quest_desc: [
		"Prizmarínové kopí (&ePrismarine Spear&r) vyrobíš z humřích ostnů (&eLobster Spike&r) a prizmarínových střepů."
		"Střepy padají ze strážců u oceánských monumentů."
	]
	quest.707486F1C543C40D.title: "Prizmarínové kopí"
	quest.708C617D1C521C66.quest_desc: [
		"Glóbus (&eGlobe&r) je ozdoba s mapou světa. Když ho roztočíš hodně rychle, dostaneš ocenění."
		"Najdeš ho v pokladech vraků lodí nebo ho prodává potulný obchodník."
	]
	quest.708C617D1C521C66.title: "Glóbus"
	quest.70A87C6B54D5C8C8.quest_desc: [
		"Správce šablon (&eTemplate Manager&r) uloží zkopírovanou stavbu do šablony (&eTemplate&r)."
		"Šablonu si můžeš schovat nebo dát kamarádovi a stavbu pak postavit znovu."
		"&aTip:&r Hodí se na výměnu návrhů staveb mezi hráči na serveru."
	]
	quest.70A87C6B54D5C8C8.title: "Šablony staveb"
	quest.70C1E7953703AFFF.quest_desc: [
		"Teslova cívka (&eTesla Coil&r) nabíjí předměty pod sebou: baterie, nástroje s energií i suroviny podle receptů (třeba zlato na elektrum)."
		""
		"Vyrobíš ji v mechanickém výrobníku z měděných cívek, kondenzátorů, mosazného pouzdra, mosazných plátů, elektronky a andezitové slitiny. Energii jí přiveď konektorem."
		""
		"&cRedstonový signál ji přepne do útoku – pak dává elektrické rány hráčům i příšerám kolem.&r"
		""
		"&aVíc najdeš v kapitole Elektřina.&r"
	]
	quest.70C1E7953703AFFF.title: "Teslova cívka"
	quest.70E40375539D67F8.quest_desc: [
		"V peci roztavíš rudy na ingoty a upečeš maso. Vyrobíš ji z 8 kusů dlažebního kamene."
		"Nahoru dej to, co chceš upéct. Dolů palivo – uhlí, dřevo nebo prkna."
	]
	quest.70E40375539D67F8.title: "Pec"
	quest.70FFF39189CE694C.quest_desc: [
		"Sklad obchodu napoj přes balíkovač a skladový vysílač. Do obchodu dej skladový ticker se skladníkem."
		"S ubrusem (třeba &eWhite Table Cloth&r) v ruce klikni na skladníka a ubrus polož. Na boku nastav cenu."
		"Ostatní hráči pak u ubrusu nakupují. Zboží se zabalí a doveze k pultu, platby se schovají ve skladovém tickeru."
	]
	quest.70FFF39189CE694C.title: "Vlastní obchod"
	quest.71405227009524EC.quest_desc: [
		"Úkol pro experty: získej celou sadu brnění &eNetherite-Diamond&r (všechny 4 kusy)."
		"Každý kus musíš vylepšit přes všechny čtyři stupně. Šablon budeš potřebovat hodně."
	]
	quest.71405227009524EC.title: "Nejlepší brnění"
	quest.715165A7801BB96F.quest_desc: [
		"Růžové víno (&eRosé&r) zraje ze dvou druhů drti najednou: červené a bílé."
		"Hroznový džus bez zrání namícháš v míchačce z drti a cukru."
	]
	quest.715165A7801BB96F.title: "Růžové víno"
	quest.715D76E51DFBFDE6.quest_desc: [
		"Píšťala průvodčího (&eConductor Whistle&r) přivolá vlak k tobě."
		"Klikni píšťalou na průvodčího, který sedí ve vlaku. Tím ji s vlakem spojíš. Pak klikni píšťalou na kolej nebo stanici a vlak tam přijede."
		"Výroba: měděný ingot a mosazný nuget."
	]
	quest.715D76E51DFBFDE6.title: "Píšťala průvodčího"
	quest.715EED262FA26428.quest_desc: [
		"Čím víc různých jídel sníš, tím víc srdíček máš. Stroje ti pomůžou vyrábět pestré menu."
		"Do svačinového pytlíku (&eLunchbag&r) si dej různá jídla a nos je s sebou. Vyrobíš ho z papíru."
	]
	quest.715EED262FA26428.title: "Pestrá strava"
	quest.7162048B47B43800.quest_desc: [
		"Teď už stolek nebudeš plnit ručně. Cíl: získej 64 smaragdů z jednoho obchodního stolku. Smaragdy dostaneš, když vesničanovi něco prodáváš, třeba farmáři pšenici."
		""
		"Zboží přivez na stolek pásem. Hotové věci odebírej trychtýřem (&eFunnel&r) nebo mechanickou paží a pošli je do truhly."
		"{@pagebreak}"
		"Obchod, který chce dvě různé věci, zvládnou 2 stolky vedle sebe. Na prvním nastav filtr, aby nedělal jiné obchody. Stolky sdílejí obsah, jen když mají stejný filtr nebo je druhý prázdný."
		""
		"&aDíky &bCreate: Dynamic Village&a jsou ve vesnicích i řemeslníci z Create. Vesničan dostane povolání podle bloku.&r"
		""
		"&aSchématický stůl = mechanický inženýr, cedník (&eItem Drain&a) = hydraulický inženýr, mechanický vrták = horník, vlaková stanice = mechanik vlaků. Prodávají díly Create za smaragdy.&r"
	]
	quest.7162048B47B43800.quest_subtitle: "Pokročilý"
	quest.7162048B47B43800.title: "Obchodní linka"
	quest.71810FC627312895.quest_desc: [
		"Palivo už umíš. Druhým pohonem je voda pod tlakem. Využívá ji hydraulický motor (&eHydraulic Engine&r)."
		""
		"Vyrobíš ho sekvenční montáží: měděný plát naplň dávkovačem 250 mB vody a dvakrát ho slisuj. Celé se to opakuje třikrát."
		""
		"&aZ hydraulického motoru vyrobíš měděný jetpack, měděný exoskelet a chytač bloků (&eBlock Picker&r).&r"
	]
	quest.71810FC627312895.title: "Hydraulický motor"
	quest.71921454BEAD66FB.quest_desc: [
		"Rozpuštěnou mléčnou čokoládu nech v chladničce ztuhnout ve formě. Dostaneš tabulku (&eMilk Chocolate Bar&r)."
		"Celý postup od kakaových bobů po čokoládu ukáže JEI."
	]
	quest.71921454BEAD66FB.title: "Čokoládová tabulka"
	quest.71ACF51C11C5757C.quest_desc: [
		"Truhly ve stavbách jsou z modu &bLootr&r. Každý hráč v nich najde svůj vlastní poklad."
		"Otevři vozík s truhlou (nákladní vozík) v opuštěném dole."
		""
		"&cTruhly z Lootru nerozbíjej!&r Jdou rozbít jen se Shiftem a ostatní hráči by pak o svůj poklad přišli."
	]
	quest.71ACF51C11C5757C.title: "Vozík s pokladem"
	quest.71CBE6010D9CB8D5.quest_desc: [
		"Břidlicová fosilie (&eShale Fossil&r) padá z bloků fosilií hluboko v hlubinné břidlici."
		"Má v sobě DNA nejstarších tvorů, třeba dimetrodona nebo obří vážky."
	]
	quest.71CBE6010D9CB8D5.title: "Břidlicová fosilie"
	quest.71E1EA8530A71998.quest_desc: [
		"Ender nádrž (&eEnder Tank&r) funguje jako Ender truhla, jen na tekutiny. Dvě nádrže se stejnými barvami sdílejí obsah – i přes dimenze."
		"Barvy nastavíš tak, že klikneš barvivem na jeden ze tří barevných proužků."
		"Když klikneš diamantem na zámek, bude nádrž (i truhla) jen tvoje."
		"Vyrobíš ji z ohnivých tyčí, vlny, obsidiánu, kotle a ender perly."
	]
	quest.71E1EA8530A71998.quest_subtitle: "Expert"
	quest.71E1EA8530A71998.title: "Sdílená nádrž"
	quest.71F11530A627455C.quest_desc: [
		"Úložná sběrnice (&eME Storage Bus&r) připojí do sítě obyčejnou truhlu, sud nebo šuplíky. Síť pak vidí jejich obsah a umí do nich ukládat."
		"Skvěle funguje s šuplíky ze &bStorage Drawers&r: jejich obsah uvidíš v terminálu."
		"&aTip:&r Velké neoptimalizované truhly s mnoha sloty síť zpomalují. Šuplíky jsou v pořádku."
	]
	quest.71F11530A627455C.title: "Úložná sběrnice"
	quest.71FF1B3EE1A6D06C.quest_desc: [
		"Kovářská šablona na stratus (&eStratus Smithing Template&r) je v pokladu zlatého dungeonu."
		"Při vylepšení se spotřebuje. Kopii vyrobíš ze šablony, 7 diamantů (nebo očarovaného gravititu) a svatého kamene – dostaneš 2 šablony."
	]
	quest.71FF1B3EE1A6D06C.title: "Stratusová šablona"
	quest.72101D2F6F434D03.quest_desc: [
		"Teď už surová ropa nestačí – v motoru nehoří. Destilační věž ji rozdělí na naftu (&eDiesel&r) a benzín (&eGasoline&r)."
		""
		"1. Postav nádrž (&eFluid Tank&r) vysokou aspoň 3 bloky."
		"2. Klikni na ni destilační jednotkou (&eDistillation Controller&r). Potřebuješ jednu na každý blok nádrže. Na věž 1×1×3 tedy tři."
		"3. Pod věž dej ohňohořáky (&eBlaze Burner&r) a krm je. Ponder ukazuje jeden ohňohořák pod každým blokem spodku. Čím víc rozpálených ohňohořáků, tím rychleji věž pracuje."
		"{@pagebreak}"
		"4. Ropu napumpuj do spodního patra věže."
		"5. Nafta se objeví ve 2. patře, benzín ve 3. patře. Odčerpej je potrubím z boku těchto pater."
		""
		"&cKdyž se patro s výstupem zaplní, věž se zastaví. Výstupy průběžně odčerpávej.&r"
		""
		"&aTip: Ohňodort (&eBlaze Cake&r) ohňohořák rozžhaví víc. Pak ze 100 mB ropy vznikne 75 mB nafty a 75 mB benzínu místo 50 a 50 a jde to rychleji.&r"
	]
	quest.72101D2F6F434D03.quest_subtitle: "Expert"
	quest.72101D2F6F434D03.title: "Nafta a benzín"
	quest.72111BA2231D5F6F.quest_desc: [
		"Forsaken je nejsilnější tvor dutin (250 bodů zdraví). Vznikne, když kultisté obětují netopýra Vespera."
		"&cÚtočí zvukovými vlnami i na dálku. Když je slabý, zčerná a ve tmě se rychle léčí. Bojuj na světle!&r"
	]
	quest.72111BA2231D5F6F.quest_subtitle: "Expert"
	quest.72111BA2231D5F6F.title: "Forsaken"
	quest.7221C1A6BB8D2815.quest_desc: [
		"Dosud jsi létal na studené planety. Teď míříš do žáru a pak až do jiné sluneční soustavy."
		"Raketa 3. stupně (&eTier 3 Rocket&r) je z ostra: 6 bloků ostra, ostrové nádrže a ostrový motor."
		"Doletí na Venuši a Merkur."
	]
	quest.7221C1A6BB8D2815.quest_subtitle: "Expert"
	quest.7221C1A6BB8D2815.title: "Raketa 3. stupně"
	quest.723048BF1737D4ED.quest_desc: [
		"&ePokladač&r (&eDeployer&r) je robotická ruka. Recept: elektronka, andezitové pouzdro a &emosazná ruka&r (&eBrass Hand&r = mosazné pláty + slitina)."
		"Pracuje na místě 2 bloky před sebou: pokládá bloky, používá předměty, kliká na bloky, sklízí a útočí. Předmět mu dáš pravým klikem na jeho čelo."
		"Nad deskou nebo pásem zpracovává předměty (v JEI recepty „Umístění“ / &eDeploying&r). Klíčem ho přepneš na levé tlačítko. Redstone signál ho zastaví."
	]
	quest.723048BF1737D4ED.title: "Pokladač"
	quest.723A1D46DE4C4FC2.quest_desc: [
		"Vícepíst (&eMulti-Piston&r) posune bloky o víc políček než obyčejný píst. Hodí se na tajné dveře a mosty."
		"Vyrobíš ho z kamene, 2 redstonových bloků a 3 pístů."
		"Pravým tlačítkem nastavíš směr vstupu (&eInput&r), výstupu (&eOutput&r), dosah (&eRange&r) a rychlost (&eSpeed&r). Spouští se redstonem."
	]
	quest.723A1D46DE4C4FC2.title: "Vícepíst"
	quest.724FA60203D2F5B8.quest_desc: [
		"Rozpouštěcí hrnec (&eMelting Pot&r) slož ze dvou hrnců z Farmer's Delight."
		"Rozpouští čokoládu, led a další věci na tekutinu."
	]
	quest.724FA60203D2F5B8.title: "Rozpouštěcí hrnec"
	quest.725AC3014C92671B.quest_desc: ["Robustní potrubí (&eSturdy Pipes&r): výkon motoru +8 %. Výroba: měděné a železné ingoty."]
	quest.725AC3014C92671B.title: "Robustní potrubí"
	quest.72843CCC09A07012.quest_desc: [
		"Dvouplošník (&eBiplane&r) je rychlé a spolehlivé letadlo. Výroba: 3 trupy, motor a vrtule."
		"&cPotřebuje dlouhou rovnou plochu na rozjezd.&r Vylepšený podvozek rozjezd zrychlí."
	]
	quest.72843CCC09A07012.title: "Dvouplošník"
	quest.72912BA1C34AB071.quest_desc: [
		"Některé bloky z dláta se umí spojit do jednoho velkého vzoru. V okně dláta zapni &eConnected textures: On&r."
		"Vyrob 4 bloky &eOak Planks Crate&r se spojitou texturou a polož je vedle sebe – splynou v jednu velkou bednu."
	]
	quest.72912BA1C34AB071.title: "Spojité textury"
	quest.729287D928D7E21E.quest_desc: [
		"Teď už železné dělo nestačí – vydrží jen 1 nálož. Litinové vydrží 2, takže dostřelí dál."
		""
		"Litina (&eCast Iron Ingot&r) se ale nedá skládat na stole. Díly se z ní odlévají do forem."
		""
		"Vyrobíš ji mechanickým lisem nad tyglíkem (&eBasin&r). Pod tyglíkem musí hořet ohňohořák (&eBlaze Burner&r). Do tyglíku dej železný ingot a uhlí."
		""
		"&aTip:&r Železný blok a uhelný blok dají rovnou litinový blok."
	]
	quest.729287D928D7E21E.title: "Litina"
	quest.72930201846FF2AE.quest_desc: [
		"Rafinovaný světlit (&eRefined Glowstone Ingot&r) vyrobíš v osmiovém kompresoru ze světlitového prachu."
		"Potřebuješ ho na rámy teleportéru (&eTeleporter Frame&r)."
		"&aTip:&r Z rafinovaného světlitu jsou i svítící nástroje a brnění z &bMekanism Tools&r."
	]
	quest.72930201846FF2AE.title: "Rafinovaný světlit"
	quest.72B2259ABDADB3D8.quest_desc: [
		"Pevnost je obrovská stavba z netherových cihel. Mod &bYUNG's Better Nether Fortresses&r ji přestavěl – je větší a má víc místností a truhel."
		"Žijí v ní ohniváci (&eBlaze&r) a wither kostlivci (&eWither Skeleton&r). Roste tu i pekelná bradavice."
		"&aTip:&r v pevnosti je snadné se ztratit. Značkuj si cestu pochodněmi na jedné straně chodby."
	]
	quest.72B2259ABDADB3D8.title: "Netherová pevnost"
	quest.72C559EAB6C33688.quest_desc: [
		"Psací stroj (&eLinked Typewriter&r) promění klávesnici v dálkové ovládání. Každé klávese přiřadíš frekvenci redstonového vysílače (&eRedstone Link&r)."
		"Klikni na něj a zapne se – převezme tvé klávesy pohybu i přiřazené klávesy. Se Shiftem otevřeš nastavení."
		"Vyrábí se v mechanickém výrobníku z tlačítek, vysílače, zlatých plátů a precizního strojku."
	]
	quest.72C559EAB6C33688.title: "Dálkové ovládání"
	quest.72D0C99388277431.quest_desc: [
		"Těsto (&eDough&r) zamícháš v misce z mouky, kvasnic a kbelíku vody."
		"Z těsta upečeš chleba, nakrájíš těstoviny nebo uděláš preclíky."
	]
	quest.72D0C99388277431.title: "Těsto"
	quest.72FE716A87035676.quest_desc: [
		"Horkou čokoládu namícháš s ohřevem z cukru, 2 kakaových prášků a mléka."
		"Dávkovač ji naleje do skleněné lahve. Když k ní na pracovním stole přidáš marshmallow, vznikne uklidňující čokoláda (&eSoothing Hot Chocolate&r)."
	]
	quest.72FE716A87035676.title: "Horká čokoláda"
	quest.732282577FD84F89.quest_desc: [
		"Jsi na plovoucích ostrovech. Dokud neporazíš posledního bosse (ducha slunce), je tu pořád den."
		"&cKdyž spadneš z ostrova, propadneš se zpátky do Overworldu – a dopadneš z velké výšky.&r Padák (quest níže) tě zachrání."
		"Nástroje z Aetheru těží bloky Aetheru rychleji než obyčejné nástroje. Začni tedy znovu od dřeva."
	]
	quest.732282577FD84F89.quest_subtitle: "Začátečník"
	quest.732282577FD84F89.title: "Vstup do Aetheru"
	quest.733D23273280AD9D.quest_desc: [
		"Shromažďovací prapor (&eRallying Banner&r) svolá strážné k tobě."
		"Vyrobíš ho ze 3 železných mečů, 2 strážních věží, 3 luků a žlutého praporu."
		"Shift + pravé tlačítko na strážní věž ji přidá do seznamu. Shift + pravé tlačítko do vzduchu strážné svolá nebo propustí."
	]
	quest.733D23273280AD9D.title: "Shromažďovací prapor"
	quest.7345D1713DD9FD28.quest_desc: [
		"Sekvenční generátor signálu (&eSequenced Pulse Generator&r) vysílá redstonový signál podle seznamu kroků s časováním."
		""
		"Potřebuje řídicí čip (&eControl Chip&r). Vyrobíš ho sekvenční montáží ze zlatého plátu: pokladač přidá elektronku, pak redstone a nakonec lis. Celé se to opakuje třikrát."
		""
		"Pravým tlačítkem otevřeš nastavení. Signál zezadu spustí sekvenci, signál z boku ji zastaví a vynuluje."
	]
	quest.7345D1713DD9FD28.title: "Sekvenční generátor"
	quest.734752DB74A8CBFD.quest_desc: [
		"Opuštěné nádraží z &bCreate: Structures Arise&r. Je v něm míchačka, lis, drtící kola i mechanická paže."
		"&aTip:&r Stroje můžeš rozebrat a odnést si je. Ušetříš tak hodně surovin."
	]
	quest.734752DB74A8CBFD.title: "Ztracené nádraží"
	quest.734E10D61C4DC87F.quest_desc: [
		"Velmi vysoká věž z ochrumu (asi 176 bloků) z &bCreate: Structures Arise&r."
		"Uvnitř jsou líhně tuláků, přízraků a jedna líheň mágů. V truhlách najdeš poklad."
	]
	quest.734E10D61C4DC87F.title: "Věž z ochrumu"
	quest.73592E38E1594132.quest_desc: [
		"&eMěděná potápěcí helma&r (&eCopper Diving Helmet&r) s nabitou tlakovou lahví na zádech ti dovolí dýchat pod vodou. Vzduch v láhvi pomalu ubývá."
		"&eMěděné potápěcí boty&r (&eCopper Diving Boots&r): pod vodou rychleji klesáš, chodíš a skáčeš. Mechanický pás tě v nich neveze."
	]
	quest.73592E38E1594132.title: "Potápěčská výstroj"
	quest.7366DE742C5F25A0.quest_desc: [
		"Otevři bar a smíchej v něm koktejl. Kokosový koktejl (&eCoconut Cocktail&r) je z otevřeného kokosu, ledu a lahve medu."
		"Další koktejly (melounový, medový, dýňový…) najdeš v JEI u baru."
	]
	quest.7366DE742C5F25A0.title: "Koktejl"
	quest.737BE59B311EAF17.quest_desc: [
		"Levitit (&eLevitite&r) udrží stroj ve vzduchu bez hořáku a bez vrtulí. Sám ale stroj nahoru nezvedne – na stoupání potřebuješ vrtule nebo balón."
		"Vzniká ze směsi teplem. Natoč směs do kbelíku a vylij do formy. Pak ji zapal: dej k ní pochodeň, táborák, magmatický blok nebo oheň, nebo ji zapal křesadlem."
		"Krystal se pak rozroste celou směsí. Formu postav z jílu nebo bahna – tyto bloky se při krystalizaci rozpadnou a zůstane jen levitit. Quest se splní, jakmile ti levitit poprvé vykrystalizuje."
		"&cZtuhlý levitit nejde vytěžit – při rozbití zmizí. Odlévej ho proto rovnou do stroje, kde ho chceš mít.&r"
		"&aPři pomalém pohybu levitit silně brzdí, při rychlém skoro vůbec.&r"
	]
	quest.737BE59B311EAF17.title: "Levitit"
	quest.737EE8DE14563959.quest_desc: [
		"Devourit (&eDevourite&r) získáš přetavením suroviny &ePigar&r ve vysoké peci. &ePigar&r padá z tvora &ePigmar&r v Netheru."
		"&cStejně jako kruorit ho v tomto packu zatím na nic nepoužiješ.&r Je to sběratelský kov."
	]
	quest.737EE8DE14563959.title: "Devourit"
	quest.738B3DB2B12C34B2.quest_desc: [
		"Selenitová lampa (&eSelenite Lamp&r) omezí líhnutí příšer ve velkém okolí. Musí být nabitá selenitovými střepy."
		"Výroba: selenitový střep obklopený železnými nugety."
	]
	quest.738B3DB2B12C34B2.title: "Selenitová lampa"
	quest.738CF6544762A006.quest_desc: [
		"Kouzelné stromy pracují za tebe. Každý má uvnitř jádro, které pracuje samo."
		"Ze sazenice stromu času (&eTree of Time Sapling&r) vyroste strom s časovými hodinami (&eTimewood Clock&r). Urychlují růst rostlin a dalších bloků v okolí."
		"Jádro zapneš a vypneš pravým tlačítkem. &cKdyž jádro vytěžíš, dostaneš jen obyčejný kmen!&r"
	]
	quest.738CF6544762A006.quest_subtitle: "Expert"
	quest.738CF6544762A006.title: "Strom času"
	quest.73C9C14279AE5AA4.quest_desc: ["Do odšťavňovače dej jablko a cukr a jako nádobu lahev. Vznikne jablečný džus (&eApple Juice&r)."]
	quest.73C9C14279AE5AA4.title: "Čerstvý džus"
	quest.73FA830EB899917A.quest_desc: [
		"Bambusový hopper (&eBamboo Hopper&r) je velké letadlo pro tři lidi. Má plováky, takže přistane i na vodě."
		"Výroba je drahá: 2 dvouplošníky, trup, motor a bambusové bloky. Má 2 sloty na zbraně a 4 na vylepšení."
	]
	quest.73FA830EB899917A.title: "Bambusový hopper"
	quest.7400D20955D7FBC3.quest_desc: [
		"Úkol: vyrob si kus diamantového brnění."
		"Celá sada stojí 24 diamantů. Diamantové brnění se později vylepší na netheritové, takže se neztratí."
	]
	quest.7400D20955D7FBC3.quest_subtitle: "Pokročilý"
	quest.7400D20955D7FBC3.title: "Diamantové brnění"
	quest.741D67E9BF645E91.quest_desc: [
		"Ruční vaření umíš. Teď si farmu vylepšíš. Silo (&eWooden Silo&r) suší věci. Víc sil postavených vedle sebe a na sebe se spojí v jedno velké."
		"Pravým tlačítkem do sila vlož kostní moučku. Po chvíli z ní je hnojivo (&eFertilizer&r). Prázdnou rukou otevřeš poklop a hotové věci vybereš."
		"Silo suší i obilí pro pivovar (sušený ječmen, pšenici, kukuřici a oves). Hnojivo použité na pole pohnojí několik plodin najednou."
	]
	quest.741D67E9BF645E91.quest_subtitle: "Pokročilý"
	quest.741D67E9BF645E91.title: "Silo a hnojivo"
	quest.742B38091D6A60E7.quest_desc: [
		"Žraločí zub (&eShark Tooth&r) z &bBen's Sharks&r nepadá ze zabitého žraloka."
		"Vezmi do hlavní ruky rybí kbelík (&eFish Bucket&r) a klikni pravým tlačítkem na tygřího žraloka (&eTiger Shark&r). Žralok ho sní a upustí zub."
		"Tygří žraloci žijí v teplých a vlažných oceánech a u pláží."
	]
	quest.742B38091D6A60E7.title: "Žraločí zub"
	quest.74317AD324C6BE9E.quest_desc: [
		"Úkol: otevři 10 různých truhel, sudů nebo jiných nádob s kořistí."
		"Kořist je i ve vozících v dolech a v rámečcích na zdi."
	]
	quest.74317AD324C6BE9E.title: "Sběratel kořisti"
	quest.7435A812D974BD4F.quest_desc: [
		"Úkol: pomocí prastarého svazku dej předmětu očarování nad normální maximum, třeba &eSharpness VI&r."
		"&aTip:&r Mistr knihovník ti svazek vymění, když mu dáš knihu se stejným očarováním na maximu."
	]
	quest.7435A812D974BD4F.quest_subtitle: "Expert"
	quest.7435A812D974BD4F.title: "Nad maximum"
	quest.743AAF6C859F6819.quest_desc: [
		"Věžový štít (&eWooden Tower Shield&r) je větší a kryje víc těla. Je základem všech věžových štítů."
		"Vyrobíš ho z prken a klacku (víc prken než malý štít)."
	]
	quest.743AAF6C859F6819.title: "Dřevěný věžový štít"
	quest.744B9578D04535C2.quest_desc: [
		"Surová ropa (&eCrude Oil&r) teče z vrtu ropné pumpy. Sama v motoru nehoří, musíš ji nejdřív vydestilovat."
		""
		"Pumpa těží, jen když se točí klika. Ropu odváděj čerpadlem do velké nádrže."
		""
		"&aTip: Podívej se na vrt inženýrskými brýlemi (&eEngineer's Goggles&a). Uvidíš, kolik ropy v chunku zbývá. Obyčejné naleziště se časem vyčerpá, naleziště &eBottomless Supply&a je nekonečné.&r"
	]
	quest.744B9578D04535C2.title: "Surová ropa"
	quest.745072410CAF2FE0.quest_desc: [
		"Zapalovač (&eFuze&r) určí, kdy granát vybuchne. Dej granát a zapalovač spolu do pracovního stolu."
		""
		"Nárazový zapalovač (&eImpact Fuze&r) vybuchne při nárazu, ale ne vždy. Je z kamenného tlačítka a redstonu. Časový (&eTimed Fuze&r) vybuchne po nastaveném čase. Čas nastavíš pravým tlačítkem. Je ze železného ingotu, hodin a redstonu. Oba recepty dají 4 kusy."
		""
		"&eInertia Fuze&r je spolehlivější nárazový. &eProximity Fuze&r vybuchne blízko bloku. &eWired Fuze&r odpálíš redstonem, za letu nevybuchne."
		""
		"&aTip:&r Zapalovač z položeného granátu sundáš pravým tlačítkem prázdnou rukou."
	]
	quest.745072410CAF2FE0.title: "Zapalovače"
	quest.745E5A7EDCC4D1D4.quest_desc: [
		"Šablona očarování (&eEnchanting Template&r) nese očarování, která později přeneseš na předmět."
		""
		"Vyrobíš ji, když blok zkušeností rozmáčkneš mechanickým lisem (&eMechanical Press&r)."
		""
		"Zatím je prázdná. Naplníš ji v plamenném očarovávači a na předmět ji naneseš plamenným kovářem."
	]
	quest.745E5A7EDCC4D1D4.title: "Šablona očarování"
	quest.746620FBEE0F8970.quest_desc: [
		"Chladničku (&eChiller&r) slož ze železného bloku, kuchyňské skříňky a soudku (&eKeg&r). Soudek vyrobíš ze skla a sudu."
		"Tekutina v ní ztuhne ve formě. Forma na tabulky (&eBar Mold&r) je z těžké nášlapné desky a 7 železných nugetů."
	]
	quest.746620FBEE0F8970.title: "Chladnička"
	quest.74E4D2853716DBD5.quest_desc: [
		"&bMekanism&r je technický mod. Stavíš v něm elektrické stroje, které zpracují rudy až na pětinásobek, vyrábějí plyny a chemikálie a nakonec i jaderné palivo."
		"Postup: osmium → metalurgický infuzér → ocel a obvody → ocelové krytí → první stroje. Každý další quest navazuje na předchozí."
		"&aTip:&r Recept každé věci ukáže JEI: najeď na předmět a stiskni R. Stroje Mekanismu potřebují energii – první zdroj postavíš hned na začátku."
	]
	quest.74E4D2853716DBD5.quest_subtitle: "Začátečník"
	quest.74E4D2853716DBD5.title: "Co je Mekanism"
	quest.74E5109CDC22E0EF.quest_desc: [
		"&eŘadící páka&r (&eGearshift&r): andezitové pouzdro, ozubené kolečko a redstone. Vede rotaci rovně."
		"S redstone signálem obrátí směr. Hodí se pro písty, kladky a jeřáby, které mají jezdit tam a zpět."
	]
	quest.74E5109CDC22E0EF.title: "Řadící páka"
	quest.74E7851DBFB905BC.quest_desc: [
		"Pravěkou zbroj vyrobíš z tvrdé kůže (&eTough Hide&r), kostních bloků a těžkých kostí. Tvrdá kůže padá z Grottoceratopse."
		"Každý kus zvýší, kolik zdraví a nasycení ti dá syrové maso."
	]
	quest.74E7851DBFB905BC.title: "Pravěká zbroj"
	quest.74EA9CB718A07447.quest_desc: [
		"&eCedník&r (&eItem Drain&r): železné mříže nad měděným pouzdrem. Vylévá tekutiny z předmětů, třeba z kbelíků a lahví."
		"Předmět vlož z boku, přejede přes cedník a vyprázdní se. Tekutinu pak odčerpá potrubí."
		"Spolu s dávkovačem přeléváš tekutiny mezi kbelíky a nádržemi."
	]
	quest.74EA9CB718A07447.title: "Cedník"
	quest.74FE0680D74B8599.quest_desc: [
		"Stormfish (&eRaw Stormfish&r) se objevuje hlavně v oceánech a jen za deště nebo bouřky. Když prší, vyraz k moři."
		"Teď už chytáš ryby, které mají zvláštní podmínky – sleduj počasí a stavby."
	]
	quest.74FE0680D74B8599.quest_subtitle: "Pokročilý"
	quest.74FE0680D74B8599.title: "Stormfish"
	quest.75030E0A40D2A068.quest_desc: [
		"&bImmersive Paintings&r: nahraj jakýkoli obrázek a pověs ho na zeď."
		"Obraz (&ePainting&r) vyrobíš z 8 papírů a barviva. Pověs ho a klikni na něj pravým tlačítkem: vlož obrázek (soubor nebo odkaz), nastav velikost a rám."
		"Obrázky ostatních hráčů najdeš na kartě &ePlayers&r."
	]
	quest.75030E0A40D2A068.title: "Vlastní obrazy"
	quest.7509D21E5ED7C7C3.quest_desc: [
		"Zvonkohra (&eBamboo Wind Chime&r) z modu &bChimes&r je ozdoba, která sama od sebe tiše cinká."
		"Pověs ji pod strop nebo pod větev. Vyrobíš ji z dřevěného půlbloku, provázku a bambusu."
		"Další druhy jsou ze železa, mědi, ametystu nebo skla."
	]
	quest.7509D21E5ED7C7C3.title: "Zvonkohra"
	quest.750C87019AF8ADCA.quest_desc: [
		"V jídelně (&eDining Hall&r) pracuje číšník. Na peci uvaří maso a brambory a rozdává jídlo hladovým občanům."
		"Vyrobíš ji z prken, jablka a nástroje stavby. Dodej jí palivo (třeba uhlí) a jídlo a v nastavení zapni, co se má podávat (&eMenu&r)."
		"&aTip:&r Syrové jídlo občané nejedí. Kdo bydlí v lepším domě, chce i lepší jídlo – to uvaří šéfkuchař (kapitola &eŽivot občanů&r)."
	]
	quest.750C87019AF8ADCA.title: "Jídelna"
	quest.751D3AC6A075CB71.quest_desc: [
		"Vesnice obehnaná kamennými hradbami od &bTerralithu&r. Stojí na nížinách, horských loukách a vysočinách, další verze v poušti."
		"Má hostinec, kováře a další dílny s truhlami."
	]
	quest.751D3AC6A075CB71.title: "Opevněná vesnice"
	quest.75236E791673032D.quest_desc: [
		"&eDisplejová tabule&r (&eDisplay Board&r): 2 slitiny a elektronka dají 2 kusy. Bloky vedle sebe tvoří jednu velkou obrazovku. Potřebuje rotaci."
		"Pevný text napíšeš psací podložkou, živá data pošle displejový vysílač. Barvivem obarvíš řádek."
	]
	quest.75236E791673032D.title: "Displejová tabule"
	quest.752F057EBF13CB4B.quest_desc: [
		"Semafor (&eSemaphore&r) je klasické rameno, které ukazuje stav návěstidla pod ním."
		"Postav nad návěstidlo sloup, třeba z plotu nebo kovového nosníku, a semafor dej na něj. Výroba: železné pláty, plot, andezitové pouzdro a elektronka dají 4 semafory."
		"&aU návěstidla pro křižovatky můžeš dát dva semafory nad sebe. Spodní se zavře, když je zablokovaná aspoň jedna cesta, horní až když jsou zablokované všechny.&r"
	]
	quest.752F057EBF13CB4B.title: "Semafor"
	quest.7565253BC574B6D2.quest_desc: [
		"Postel vyrobíš ze 3 bloků vlny a 3 prken. Vlnu získáš z ovcí."
		"Když se v posteli vyspíš, oživíš se po smrti u ní. Spát jde jen v noci nebo za bouřky."
		"Na serveru se noc přeskočí, jen když spí dost hráčů najednou."
		"Úkol: vyspi se v posteli."
	]
	quest.7565253BC574B6D2.title: "Postel"
	quest.7565C71CB50232D5.quest_desc: [
		"Teď z bloků uděláš jedoucí vlak. Postup:"
		"1. Otevři stanici (pravé tlačítko) a přepni ji do režimu sestavování (&eAssembly Mode&r)."
		"2. Klikni vlakovým pouzdrem na kolej u stanice. Vznikne podvozek. Dalším kliknutím změníš jeho vzhled."
		"3. Na podvozek postav vagon a slep ho vteřinovým lepidlem (&eSuper Glue&r). Přidej ovládání vlaku."
		"4. V okně stanice potvrď sestavení. Z bloků se stane vlak."
		"{@pagebreak}"
		"Řízení: klikni na ovládání. Klávesy pohybu = jízda a zatáčení, kolečko myši = nejvyšší rychlost, drž mezerník = zastav u blízké stanice, Shift = konec řízení."
		"&cVlak se dá rozebrat zpět na bloky jen ve stanici.&r Montážním klíčem ho můžeš přesunout na blízkou kolej."
	]
	quest.7565C71CB50232D5.title: "Sestav první vlak"
	quest.75A24BA000D4B534.quest_desc: [
		"Kousek citrínu (&eCitrine Chunk&r) získáš z citrínových shluků, rybařením v &eWarped Reef&r nebo z truhel na lodích."
		"Z citrínu a provázků vyrobíš citrínový amulet."
	]
	quest.75A24BA000D4B534.title: "Citrín"
	quest.75B2AA030EA3A1D7.quest_desc: [
		"Kola jsou ve čtyřech velikostech: malá (&eSmall Tire&r), běžná, velká (&eLarge Tire&r) a obří (&eMonstrous Tire&r)."
		"Obří kolo vyrobíš z bloků sušené chaluhy a hřídele, velké z mechanických pásů."
	]
	quest.75B2AA030EA3A1D7.title: "Obří kola"
	quest.75DCFEEC967CC852.quest_desc: [
		"Větrák přes &eduší oheň&r nebo duší táborák věci &eprokleje&r: písek na duší písek, dlažební kámen na černý kámen (&eBlackstone&r)."
		"Takhle vznikne i &eprokletý zvon&r (&eHaunted Bell&r) z &epodivuhodného zvonu&r (&ePeculiar Bell&r = blok mosazi + mosazný plát)."
		"Prokletý zvon v ruce nebo po zazvonění ukáže tmavá místa, kde se můžou rodit monstra."
	]
	quest.75DCFEEC967CC852.title: "Hromadné prokletí"
	quest.75EF15289FC3C80D.quest_desc: [
		"Občané ti občas dají vlastní úkol. Deník úkolů (&eQuest Log&r) ukáže rozdělané, dostupné i hotové úkoly."
		"Vyrobíš ho z tyček, kůže, papíru a nástroje stavby. Propoj ho Shift + pravým tlačítkem na radnici."
		"Úkoly od občanů provedou i celým začátkem kolonie a dávají malé odměny."
	]
	quest.75EF15289FC3C80D.title: "Úkoly od občanů"
	quest.75F97BC4BF899AAB.quest_desc: [
		"Teď už nemusíš šablonu pokaždé vyrábět znovu. Klasický plamenný očarovávač (&eClassic Blaze Enchanter&r) očaruje každý předmět podle šablony ve filtru a šablona se nespotřebuje."
		""
		"Vyrobíš ho na kovářském stole z ohňohořáku, kovářské šablony plamene a příručky (&eBlaze's Enchanting Handbook&r). Příručku vyrobíš z kovářské šablony plamene, 2 robustních plátů, 2 lahviček zkušeností a magmového bloku."
		""
		"Předměty mu posílej po pásu, zkušenosti trubkou. Když šablona nese víc očarování, dá na předmět náhodně jedno. V super režimu (se super šablonou) zvedne o jednu úroveň očarování, které už předmět má ve stejné úrovni."
	]
	quest.75F97BC4BF899AAB.title: "Očarovací linka"
	quest.760848936EEA446C.quest_desc: ["&eAndezitový tunel&r (&eAndesite Tunnel&r) zakryje pás. Když má otevřené boky, odebere z každého stacku 1 kus do strany. Zbytek jede dál."]
	quest.760848936EEA446C.title: "Andezitový tunel"
	quest.760B350D845A6689.quest_desc: [
		"Whisky &eJoJannik Select&r uvaříš v měděné varně ze 2 sušených ječmenů a kvasnic."
		"Každá whisky je z jiné kombinace sušeného obilí. Stáčí se do skleněných lahví."
	]
	quest.760B350D845A6689.title: "Whisky"
	quest.7615ABDBEAE46F0B.quest_desc: [
		"Pšeničné pivo (&eWheat Beer&r) uvaříš z chmele, sušené pšenice a kvasnic. Pšenici usuš v silu."
		"Hotové pivo stočíš do korbele (&eBeer Mug&r) – vyrobíš ho z prken. Whisky se stáčí do skleněných lahví."
		"&cPozor:&r Moc pití způsobí opilost (&eIntoxication&r). Od úrovně III se motáš, od úrovně VI můžeš omdlít."
	]
	quest.7615ABDBEAE46F0B.title: "Na zdraví!"
	quest.762A77D23FC0C4D7.quest_desc: [
		"&cBez netheritového skafandru na Venuši rychle uhoříš!&r"
		"Venuše je rozpálená a nemá vzduch. Těž tu kalorit."
	]
	quest.762A77D23FC0C4D7.title: "Venuše"
	quest.7634202A672F2ECA.quest_desc: [
		"Při drcení rud padají &enugety zkušeností&r (&eNugget of Experience&r). Pravým tlačítkem z nich získáš zkušenosti."
		"9 nugetů dá &eblok zkušeností&r (&eBlock of Experience&r). Šetři je na opravy a očarování."
	]
	quest.7634202A672F2ECA.title: "Nugety zkušeností"
	quest.7654D76F0DEF51D2.quest_desc: [
		"&bOcean's Delight&r přidává jídla z mořských tvorů: olihní, strážců a ryb."
		"Čtverzubec (&ePufferfish&r) nakrájený nožem na prkénku dá 6 plátků fugu (&eFugu Slice&r). Dva plátky a vařená rýže dají rolku (&eFugu Roll&r)."
		"&aTip:&r Oliheň zabitá nožem pustí chapadla (&eTentacles&r)."
	]
	quest.7654D76F0DEF51D2.title: "Ocean's Delight"
	quest.76638DAF47513A53.quest_desc: [
		"Bloky se k udělátku musí přilepit. &eVteřinovým lepidlem&r klikni na dva rohy a vše v kvádru se slepí. Úderem s lepidlem v ruce oblast zrušíš."
		"Bloky, které na něčem visí (pochodně, cedule), lepidlo většinou nepotřebují. Plachty se lepí samy."
	]
	quest.76638DAF47513A53.title: "Lepení"
	quest.76B7998BEDE43D51.quest_desc: [
		"Stříbrný mrak očaruj v oltáři. Vznikne duhový mrak (&eChromatic Aercloud&r)."
		"Očarování trvá dlouho a spotřebuje hodně ambrosia. Připrav si zásobu."
	]
	quest.76B7998BEDE43D51.title: "Duhový mrak"
	quest.76F9ACD74D91A641.quest_desc: [
		"Divoká rýže (&eWild Rice&r) roste v mělké vodě v bažinách a džunglích."
		"Rýži zasaď do mělké vody. Nad hladinou vyroste lata (&eRice Panicle&r)."
		"&aTip:&r Latu nakrájej nožem na prkénku. Dostaneš rýži a slámu."
	]
	quest.76F9ACD74D91A641.title: "Rýže"
	quest.76FC0D7AD98086BF.quest_desc: [
		"Obrovské město hluboko dole v biomu &eTemná hlubina&r."
		"&cBuď potichu.&r Sculková čidla slyší tvoje kroky. Sculkový kvílák pak přivolá vartýře. Choď se Shiftem."
		""
		"&aTip:&r Vlna na podlaze tlumí zvuk tvých kroků."
	]
	quest.76FC0D7AD98086BF.title: "Prastaré město"
	quest.7703F39C9C6EF1F8.quest_desc: [
		"Údolí duší (&eSoul Sand Valley&r) je modrý biom z duší písku. Mod &bJaden's Nether Expansion&r ho zaplnil duchy a novými stavbami."
		"Žijí tu duchové &eApparition&r, &eVessel&r a &eEcto Slab&r. Z &eEcto Slab&r padají fantomové střepy (&ePhasmo Shard&r)."
	]
	quest.7703F39C9C6EF1F8.title: "Údolí duší"
	quest.770432A5C0C712D1.quest_desc: [
		"Perutýn (&eLionfish&r) žije v teplých oceánech. Chytíš ho i na prut."
		"&cPozor, umí otrávit.&r Upeč si ho (&eCooked Lionfish&r)."
	]
	quest.770432A5C0C712D1.title: "Perutýn"
	quest.771176B06CA501B6.quest_desc: [
		"Zaklínač (&eEnchanter's Tower&r) sbírá zkušenosti ostatních občanů a vyrábí očarované knihy a kouzelné svitky."
		"Blok budovy vyrobíš z prken, oltáře očarování a nástroje stavby. Zaklínač potřebuje mytické knihy (&eAncient Tome&r), které padají z nájezdníků."
	]
	quest.771176B06CA501B6.title: "Věž zaklínače"
	quest.77255D3C2EA07E44.quest_desc: [
		"&eInženýrské brýle&r (&eEngineer's Goggles&r): provázek, 2 skla a zlatý plát. Nasaď si je na hlavu."
		"Když se díváš na stroj, brýle ukážou jeho &estres&r: kolik SU stroj spotřebuje nebo kolik zdroj dodá. Ukazují i obsah nádrží a stav kotle."
		"&cKdyž stroje chtějí víc SU, než zdroje dají, síť se přetíží a zastaví se celá.&r Pak přidej zdroj nebo stroje zpomal."
	]
	quest.77255D3C2EA07E44.title: "Inženýrské brýle"
	quest.7726F67FBE38921D.quest_desc: [
		"Modré bobule (&eBlue Berry&r) rostou na keřích po celém Aetheru. Dej je do oltáře."
		"Vznikne očarovaná bobule (&eEnchanted Berry&r), která zasytí mnohem víc."
		"Stejně v oltáři vyrobíš léčivý kámen ze svatého kamene nebo sklo z rychlopísku (&eQuicksoil&r)."
	]
	quest.7726F67FBE38921D.title: "První očarování"
	quest.772D809C5A8BE831.quest_desc: ["Kotel (&eBoiler&r) je srdce motoru. Výroba: měděné ingoty a pec."]
	quest.772D809C5A8BE831.title: "Kotel"
	quest.77390EEB15023315.quest_desc: [
		"Rozdělovač kyslíku (&eOxygen Distributor&r) naplní uzavřenou místnost vzduchem, až 6 000 bloků. Potřebuje vodu a energii."
		"V jeho okně je tlačítko, které ukáže, kam se kyslík šíří. Když je zvýrazněná celá místnost, je těsná a můžeš sundat helmu."
		"&cKdyž do místnosti prorazíš díru, vzduch uteče a vysaje všechno ven!&r"
		"Solární panel (&eSolar Panel&r) vyrábí energii ze slunce. &aNekonečnou vodu dá vodní čerpadlo (&eWater Pump&r) postavené nad zdrojem vody.&r"
	]
	quest.77390EEB15023315.title: "Měsíční základna"
	quest.7745257914AD717C.quest_desc: [
		"Ze srsti alfa yetiho vyrobíš yetiho zbroj (&eYeti Jacket&r). Má očarování Ochrana."
		"Zchladí a zpomalí útočníky, kteří tě zasáhnou."
	]
	quest.7745257914AD717C.title: "Yetiho zbroj"
	quest.776438D2CFD81BB2.quest_desc: [
		"&eŽelezný plát&r (&eIron Sheet&r) vznikne lisováním železného ingotu. Stejně uděláš měděné, zlaté a mosazné pláty."
		"Pláty jsou v receptech všude: vrtule, metla, brýle, potrubí, nádrže."
		"&aTip:&r Lis nad pásem zpracuje celý proud ingotů sám. Pás zastaví předmět pod lisem a pustí ho dál až po vylisování."
	]
	quest.776438D2CFD81BB2.title: "Železné pláty"
	quest.7764E4A71A3174E2.quest_desc: [
		"Úkol: poraz jakoukoliv nepřátelskou příšeru."
		"&cPozor na creepery:&r tiše se připlíží a vybuchnou. Když syčí, rychle uteč."
		"Kostlivci střílejí šípy – schovej se za roh a nech je přijít k sobě."
	]
	quest.7764E4A71A3174E2.title: "Lovec příšer"
	quest.776BB51B7A1D0BE7.quest_desc: [
		"&eRedstonový žadatel&r (&eRedstone Requester&r) pošle stejnou objednávku při každém redstone pulsu. Nastavíš ji v jeho okně."
		"&aTip:&r S časovačem signálu (&ePulse Timer&r) dostaneš pravidelné zásilky, třeba uhlí do pecí."
	]
	quest.776BB51B7A1D0BE7.title: "Redstonový žadatel"
	quest.777688E7CD1B3A99.quest_desc: [
		"Se slámkou (&eStraw&r) pije ohňohořák (&eBlaze Burner&r) tekutá paliva. Nemusíš ho pak pořád krmit uhlím."
		""
		"Slámku vyválcuješ ve válcovací stolici z bambusu nebo papíru. Klikni s ní pravým tlačítkem na ohňohořák. Palivo pak naleješ kbelíkem nebo přivedeš potrubím."
		""
		"&aHoří třeba láva, rostlinný olej, nafta nebo biopalivo. Seznam paliv je v JEI pod „Liquid Burning“.&r"
	]
	quest.777688E7CD1B3A99.quest_subtitle: "Začátečník"
	quest.777688E7CD1B3A99.title: "Ohňohořák na kapaliny"
	quest.7792808EDF14CBD0.quest_desc: [
		"Tavič v tavírně (&eSmeltery&r) taví rudy na ingoty."
		"Výzkum &eHot!&r stojí 4 kbelíky lávy a doly musí mít dohromady úroveň 2. Blok budovy: prkna, železný ingot a nástroj stavby."
		"Tavírna úrovně 3 dává z rudných bloků víc jako štěstí II, úroveň 5 jako štěstí IV."
	]
	quest.7792808EDF14CBD0.title: "Tavírna"
	quest.77B7A1F97A074AE0.quest_desc: [
		"Superkritický fázový posunovač (SPS) mění polonium na antihmotu. Spotřebuje na to obrovské množství energie."
		"Je to velká stavba z pláště (&eSPS Casing&r) a portů (&eSPS Port&r). Energii dodáš přes nabitou cívku (&eSupercharged Coil&r) položenou na port."
		"&aTip:&r Je to konec Mekanismu – připrav si indukční matici plnou energie."
	]
	quest.77B7A1F97A074AE0.title: "SPS: antihmota"
	quest.77CF2771B8B83377.quest_desc: [
		"Teď už nemusíš nabíjet ručně – zvládne to stroj."
		""
		"Nabíječ (&eCannon Loader&r) funguje jako mechanický píst. Prodlužuje se prodlužovacími ojnicemi (&ePiston Extension Pole&r) a na konec potřebuje beranidlo (&eRam Head&r)."
		""
		"Nabíječ, náboje a dělo musí ležet v jedné řadě. Před nabíjením musí být dělo rozložené."
		""
		"&aTip:&r S hlavicí vytahováku (&eWorm Head&r) nabíječ vytáhne uvízlou střelu. Nabíjet umí i mechanický píst, portálový jeřáb (&eGantry Carriage&r) nebo lanová kladka (&eRope Pulley&r)."
	]
	quest.77CF2771B8B83377.title: "Nabíjecí stroj"
	quest.77DB75B8DC8ECF55.quest_desc: [
		"Ohnivá bažina (&eFire Swamp&r) je plná lávy a ohnivých trysek. Uprostřed je doupě hydry."
		"Vezmi si lektvary ohnivzdornosti a hodně jídla."
	]
	quest.77DB75B8DC8ECF55.title: "Ohnivá bažina"
	quest.77DC14B5A033335A.quest_desc: [
		"Duhové sklo (&eRainbow Glass&r) je barevné a svítí."
		"Vyrob 8 kusů z 8 skel a duhového želé (&eRainbow Jelly&r). To padá z mořských žebernatek (&eComb Jelly&r) v ledových oceánech."
	]
	quest.77DC14B5A033335A.title: "Duhové sklo"
	quest.77E74C29137C0283.quest_desc: [
		"Polonium vzniká v solárním neutronovém aktivátoru z jaderného odpadu (10 mB odpadu = 1 mB polonia)."
		"Peletu (&ePolonium Pellet&r) vyrobíš v tlakové reakční komoře: polonium + voda + fluoritový prach. Na 1 peletu je potřeba 1000 mB polonia."
		"&aTip:&r Polonium je v MekaSuitu, modifikační stanici, přenosném QIO panelu a fúzním reaktoru."
	]
	quest.77E74C29137C0283.title: "Polonium"
	quest.77E8B646A0048E38.quest_desc: [
		"Srst (&eHair of Bear&r) padá z medvěda grizzly (&eGrizzly Bear&r). Ten žije v lesích a v tajze."
		"&cMedvěd je klidný jen z dálky.&r Když se přiblížíš, zaútočí. Mívá u sebe mláďata."
	]
	quest.77E8B646A0048E38.title: "Medvědí srst"
	quest.77F08747A34396FE.quest_desc: [
		"Výrobní terminál (&eME Crafting Terminal&r) je terminál s pracovním stolem. Vyrábíš v něm přímo ze surovin v síti."
		"Vyrobíš ho z terminálu, pracovního stolu a výpočetního procesoru."
		"&aTip:&r Tlačítko + u receptu v JEI přenese recept rovnou do mřížky terminálu."
	]
	quest.77F08747A34396FE.title: "Výrobní terminál"
	quest.77F5A1B169CB1326.quest_desc: [
		"Luk hrůzy (&eDreadbow&r) se nabíjí pomaleji, ale na cíl z výšky spadne celá sprška šípů."
		"Vyrobíš ho z čisté temnoty, stínového hedvábí a křídel Vespera (&eVesper Wing&r)."
	]
	quest.77F5A1B169CB1326.title: "Luk hrůzy"
	quest.780148112B854015.quest_desc: [
		"Na mosaz potřebuješ hodně zinku. Drť zinkovou rudu, nebo kámen &eazurín&r (&eAsurine&r): dá 30 % drti a 30 % zinkového nugetu."
		"Podobně &ešarlanit&r (&eCrimsite&r) dá železo, &eokrum&r (&eOchrum&r) zlato a &everidium&r (&eVeridium&r) měď. Tyto kameny najdeš pod zemí ve vrstvách."
	]
	quest.780148112B854015.title: "Zinek ve velkém"
	quest.788327B17F0A09FF.quest_desc: [
		"Diamantový věžový štít (&eDiamond Tower Shield&r) vydrží mnohem víc ran."
		"Vyrobíš ho z dřevěného věžového štítu a 6 diamantů."
	]
	quest.788327B17F0A09FF.title: "Diamantový věžový štít"
	quest.788C17A3C1433043.quest_desc: [
		"Ocelový kotel (&eSteel Boiler&r): výkon motoru +20 %, ale spotřeba paliva +50 %."
		"Výroba: kotel, vysoká pec a železné ingoty."
	]
	quest.788C17A3C1433043.title: "Ocelový kotel"
	quest.78F955C2839C7283.quest_desc: [
		"Kelímek (&eEmpty Boba Cup&r) je ze skla a desky z leštěného dioritu. Pokladač do něj vloží perly."
		"Ovocný čaj namícháš s ohřevem z ovoce, mléka a rozpuštěného cukru. Dávkovač ho naleje do kelímku – třeba jablečný (&eApple Milk Tea&r)."
	]
	quest.78F955C2839C7283.title: "Bubble tea"
	quest.790A44A82804BD25.quest_desc: [
		"Základy umíš. S dalším nářadím uvaříš stovky receptů. Každý kus vyrob jen jednou – při vaření se nespotřebuje."
		"Kastrůlek (&eSaucepan&r) je z mědi a klacku, mísa (&eMixing Bowl&r) z prken a klacku. Pekáč (&eBakeware&r) a odšťavňovač (&eJuicer&r) z terakoty. Mlýnek (&eGrinder&r) z andezitu a klacku."
	]
	quest.790A44A82804BD25.quest_subtitle: "Pokročilý"
	quest.790A44A82804BD25.title: "Další nářadí"
	quest.791B776586DF3693.quest_desc: [
		"Urychlovač (&eHypertube Accelerator Block&r) zrychlí každého, kdo jím projíždí. Hodí se hlavně na dlouhé trasy."
		""
		"Vyrobíš ho z precizního strojku, dvou trychtýřů (&eHypertube Funnel&r) a dvou ozubených koleček. Zapoj ho do trasy a roztoč ho jako ozubené kolečko."
		""
		"&aKlíčem ho přepneš do režimu brzdy (&eBrake Mode&r). Pak cestující naopak zpomalí, třeba před cílem.&r"
	]
	quest.791B776586DF3693.title: "Urychlovač"
	quest.793B39F654141C86.quest_desc: [
		"Spojka (&eStorage Link&r) připojí k ovladači skupinu truhel, která se ho nedotýká."
		"Propoj je nástrojem (&eStorage Tool&r) – použij ho na ovladač a na spojku."
		"&aTip:&r Nástroj umí i zamknout sloty nebo skrýt čísla na sudech. Režim přepneš Shift + kolečkem myši."
	]
	quest.793B39F654141C86.title: "Spojka a nástroj"
	quest.794D340D2EBAE177.quest_desc: [
		"Reaktor při spalování vyrábí jaderný odpad (&eNuclear Waste&r). Musíš ho odvádět portem v režimu výstupu odpadu."
		"Ulož ho do sudu na radioaktivní odpad (&eRadioactive Waste Barrel&r), nebo ho rovnou zpracuj na polonium a plutonium."
		"&cPozor:&r Odpad je radioaktivní. Když se sud, nádrž nebo trubka s odpadem zničí (třeba výbuchem), radiace unikne do okolí."
	]
	quest.794D340D2EBAE177.title: "Jaderný odpad"
	quest.795A52315AC6E9AF.quest_desc: [
		"Kniha &eHamster Tips&r (průvodce o křečcích) vysvětluje všechno o křečcích. Je v angličtině."
		"Vyrob ji z knihy a plátku okurky."
	]
	quest.795A52315AC6E9AF.title: "Kniha o křečcích"
	quest.7964CFA4507A532C.quest_desc: [
		"Každá poražená Valkýra upustí medaili vítězství (&eVictory Medal&r)."
		"Královna Valkýr s tebou bude bojovat, až jí přineseš 10 medailí."
		"&aTip:&r Valkýry tvrdě bijí. Valkýří kopí z bronzového dungeonu má dlouhý dosah a hodí se na ně."
	]
	quest.7964CFA4507A532C.title: "Medaile vítězství"
	quest.7976792C653D8437.quest_desc: [
		"Zmrzlé maso (&eFrozen Meat&r) padá z permafrostu (&ePermafrost Block&r). Ten je v hlíně studených biomů."
		"V analyzátoru z něj získáš DNA mamuta, šavlozubého tygra, dronte a dalších zvířat doby ledové."
	]
	quest.7976792C653D8437.title: "Zmrzlé maso"
	quest.79789332569F70E1.quest_desc: [
		"V téhle kapitole zvětšíš batoh, naučíš ho sbírat, třídit a tavit věci a postavíš si větší truhly."
		"Batoh se vylepšuje v pracovním stole. Věci a upgrady v něm při vylepšení zůstanou."
		"Upgrady vkládáš do slotů vlevo v okně batohu. Lepší batoh má víc slotů na upgrady."
		"{@pagebreak}"
		"&aTip:&r Batoh můžeš položit i na pohyblivou stavbu z modu &bCreate&r (třeba na vlak). Funguje tam dál jako úložiště."
	]
	quest.79789332569F70E1.quest_subtitle: "Začátečník"
	quest.79789332569F70E1.title: "Víc místa!"
	quest.79A51C9A2BDF1411.quest_desc: [
		"Mod &bNullscape&r přetvořil vnější ostrovy na obří skály, krystalové vrcholy a stínové pustiny."
		"Quest se splní, až vstoupíš do kteréhokoli jeho biomu. Mezi skalami se snadno ztratíš – měj u sebe souřadnice brány."
	]
	quest.79A51C9A2BDF1411.title: "Pustina"
	quest.79B73F428EA115DA.quest_desc: [
		"Mrazivá jeskyně pod zemí. Na stropě a na zemi je &eModrý led&r a na zemi hoří modrý &eOheň duší&r."
		"Z příšer tu žijí jen kostlivci a tuláci. Ukrývá se tu ledový dungeon z Terralithu."
		"&cPozor:&r do ohně duší nešlapej."
	]
	quest.79B73F428EA115DA.title: "Mrazivý oheň"
	quest.79BE67174B38E35E.quest_desc: [
		"Energetická tableta (&eEnergy Tablet&r) je malá baterie. Je součástí generátorů, energetických kostek a nástrojů."
		"Vyrobíš ji z redstonu, zlatých ingotů a infuzní slitiny."
		"&aTip:&r Na solární generátor potřebuješ jednu tabletu, na větrný dvě."
	]
	quest.79BE67174B38E35E.title: "Energetická tableta"
	quest.79D8069DA8C3D0CA.quest_desc: [
		"Addon je mod, který rozšiřuje Create o nové stroje a věci. Tahle kapitola je rozcestník: každý addon tu má jeden vstupní quest."
		""
		"Vstupní quest ti řekne, co addon dělá a k čemu je dobrý. Pak pokračuj v jeho tematické kapitole."
		"{@pagebreak}"
		"Tematické kapitoly: &eElektřina&r, &eRopa a palivo&r, &ePrůmysl&r, &eVelká děla&r, &ePohyb a výbava&r a &eDekorace&r."
		""
		"Addony staví na základním Create. Některé questy se proto odemknou až po questech z kapitoly &eCreate&r (třeba po mosazi)."
		""
		"&aMilníky (šestiúhelníky) s podnázvem Začátečník, Pokročilý a Expert ukazují, jak daleko v addonu jsi.&r"
	]
	quest.79D8069DA8C3D0CA.quest_subtitle: "Rozcestník"
	quest.79D8069DA8C3D0CA.title: "Addony pro Create"
	quest.79D88CC55EDDBEA8.quest_desc: [
		"Plachtu rozvineš nebo svineš klávesou R. Nápověda s dalšími klávesami se ukazuje na obrazovce, když lodi velíš."
		"Na lodi záleží na větru. Vítr do zad dá většině lodí velký bonus, boční vítr menší. Galéru a drakkar můžeš se svinutou plachtou pohánět vesly."
		"Bavlněné plachty (&eCotton Sails&r) jsou vylepšení: loď je rychlejší. Instaluješ je v loděnici v záložce úprav (&eModify&r). Loď musí být do 16 bloků od loděnice."
	]
	quest.79D88CC55EDDBEA8.title: "Pod plachtami"
	quest.79E7751F5A52DEBD.quest_desc: [
		"Fyzikální sestavovač (&ePhysics Assembler&r) je srdce každého létajícího stroje. Z bloků udělá fyzikální stroj (&eSimulated Contraption&r)."
		"Výroba: páka, andezitové pouzdro a dvě andezitové slitiny."
		"Postup: slep bloky vteřinovým nebo medovým lepidlem. Sestavovač musí být uvnitř slepené oblasti. Pak drž na sestavovači pravé tlačítko a stáhni páku. Připojí se i bloky, které se dotýkají jen hranou."
		"{@pagebreak}"
		"Rozebrat stroj zpět na bloky umí kterýkoli sestavovač. &cStroj ale musí stát skoro rovně, skoro v klidu a blízko země. Ve vzduchu ho rozebrat nejde.&r"
		"&aČásti stroje, které nic nedrží, se odtrhnou. Dva stroje spojíš kliknutím slizovou koulí.&r"
	]
	quest.79E7751F5A52DEBD.title: "Fyzikální sestavovač"
	quest.79E87B93462C806A.quest_desc: [
		"&bWaystones&r jsou kameny na rychlé cestování. Najdeš je v některých vesnicích a občas i volně v krajině."
		"Klikni na waystone pravým tlačítkem. Tím ho aktivuješ. Pak se můžeš teleportovat mezi všemi waystony, které jsi aktivoval."
		"Teleport stojí zkušenosti. Čím delší cesta, tím víc. Cesta do jiné dimenze stojí nejvíc."
		"{@pagebreak}"
		"Varpový kámen (&eWarp Stone&r) otevře menu waystonů odkudkoliv. Používáním se pomalu opotřebovává."
		"Vyrobíš ho z ender perel, ametystových úlomků a smaragdů."
		"&cPozor:&r v tomhle packu se waystonové věci vyrábějí na mechanických craftovačích (&eMechanical Crafter&r) z modu &bCreate&r. JEI ti ukáže tvar receptu."
	]
	quest.79E87B93462C806A.quest_subtitle: "Pokročilý"
	quest.79E87B93462C806A.title: "Waystones"
	quest.79F4290B8B690C82.quest_desc: [
		"Archeologův stůl (&eArcheology Workbench&r) vyrobíš z kůže a pracovního stolu."
		"Opravuje starodávné zbraně, figurky a vázy. Palivem jsou střepy relikvie, u keramiky úlomky keramiky."
	]
	quest.79F4290B8B690C82.title: "Archeologův stůl"
	quest.79F70BE29DE7FA7C.quest_desc: [
		"Nejtěžší výbava z Alex's Mobs. Na to potřebuješ zkušenosti i dobrou zbroj."
		"Křídlo (&eTarantula Hawk Wing&r) složíš z 9 roztrhaných kousků (&eTattered Tarantula Hawk Wing&r). Padají z obří vosy &eTarantula Hawk&r v poušti."
	]
	quest.79F70BE29DE7FA7C.quest_subtitle: "Expert"
	quest.79F70BE29DE7FA7C.title: "Křídlo jestřábníka"
	quest.79FC3C12C5837DA4.quest_desc: [
		"Laser (&eLaser&r) vystřelí paprsek energie. Ničí bloky, na které míří, a &czraní i tebe&r!"
		"Zesilovač (&eLaser Amplifier&r) sbírá energii z laserů a vystřelí ji podle nastavení, třeba na redstonový signál."
		"&aTip:&r Laser a zesilovač budeš potřebovat k zapálení fúzního reaktoru a na nabitou cívku pro SPS."
	]
	quest.79FC3C12C5837DA4.title: "Laser"
	quest.7A2AE46FF50DDAC7.quest_desc: [
		"&bCreate: New Age&r je druhý mod na elektřinu. Má generátory s magnety, motory, energizér, teplo a jaderný reaktor."
		""
		"Generátorovou cívku (&eGenerator Coil&r) vyrobíš z 8 měděných ingotů a bloku andezitové slitiny. Uhlíkové kartáče (&eCarbon Brushes&r) z andezitové slitiny, uhlí a hřídele."
		""
		"&aVíc najdeš v kapitole Elektřina.&r"
	]
	quest.7A2AE46FF50DDAC7.title: "Create: New Age"
	quest.7A509B20CCB43C29.quest_desc: [
		"Skladiště (&eWarehouse&r) je hlavní sklad kolonie. Vyrobíš ho z prken, truhly a nástroje stavby."
		"Všechno, co dáš do skladiště, kurýři sami rozvezou tomu, kdo to potřebuje. Stavitel si tak materiál vezme sám."
		"Postav ho doprostřed kolonie. &cV kolonii smí být jen jedno. Nepřidávej do něj vlastní truhly – kurýři je nevidí.&r"
		"&aTip:&r místa přidáš vylepšením budovy. Na úrovni 5 můžeš regály ještě zvětšit za smaragdový blok."
	]
	quest.7A509B20CCB43C29.title: "Skladiště"
	quest.7A6FE05DC1FBA64D.quest_desc: [
		"Rajčata umí růst do výšky, když nad nimi visí lano."
		"Zasaď rajčata a přímo nad ně dej lano. Keř po laně vyleze nahoru a sklidíš z něj víc rajčat."
		"Zralá rajčata utrhneš pravým tlačítkem. Quest se splní, až sklidíš rajčata z keře na laně."
	]
	quest.7A6FE05DC1FBA64D.title: "Rajčata na laně"
	quest.7A718A8AFB72CE32.quest_desc: [
		"Fantomová kolej (&ePhantom Train Track&r) je neviditelná. Uvidíš ji jen tehdy, když ji držíš v ruce."
		"Vyrábí se z blány fantoma: pokladače přidají dva železné ingoty a lis ji stiskne. Vznikne rovnou 32 kusů."
		"&aS neviditelným podvozkem z nabídky podvozků pak vlak vypadá, jako by jel vzduchem.&r"
	]
	quest.7A718A8AFB72CE32.title: "Neviditelná kolej"
	quest.7AABDA263E16A81B.quest_desc: [
		"Měj v kolonii 8 strážných. Víc strážných = víc spokojenosti a větší šance při nájezdu."
		"Strážní věže navíc zvětšují území kolonie. Když potřebuješ víc místa na budovy, postav a vylepši další věže."
	]
	quest.7AABDA263E16A81B.title: "Malá armáda"
	quest.7AAE8D741E1EF50D.quest_desc: [
		"Teď už tě nebrzdí dosah ani dimenze. Ovladač portálu (&eCustom Portal Controller&r) postaví portál bez omezení dosahu, i do jiné dimenze. Recept v mechanickém výrobníku dá rovnou dva."
		""
		"Postav obdélníkový rám z kvantových pouzder. Vnitřek musí mít na šířku i na výšku 3 až 21 bloků a musí být prázdný. Ovladač dej do spodní řady rámu."
		""
		"Po obou stranách ovladače nech jeden volný blok, doplní se sám. Rám musí být celý, i s rohy."
		"{@pagebreak}"
		"Oba ovladače přepni do režimu &ePortal to portal&r a klikni na oba stejným rozšířeným odkazem. Potom ten odkaz vlož do jednoho z nich."
		""
		"Do každého ovladače napumpuj aspoň 256 mB šťávy. Při cestě se šťáva bere z portálu, kterým odcházíš."
		""
		"&aPortálem projede i vlak. Oba konce ale musí být v režimu Portal to portal.&r"
	]
	quest.7AAE8D741E1EF50D.quest_subtitle: "Expert"
	quest.7AAE8D741E1EF50D.title: "Kvantový portál"
	quest.7AD8CF5B0FCB81D7.quest_desc: [
		"Kamna (&eStove&r) jsou trouba s vlastním okénkem. Pečou chleby, koláče a pečeně. Potřebují palivo (uhlí, dřevo)."
		"Hrnec (&eCooking Pot&r) vaří polévky a guláš. Musí stát na zdroji tepla: na kamnech, táboráku nebo magmatu."
		"&aTip:&r Polévky se nalévají do misky – tu dej do hrnce spolu se surovinami."
	]
	quest.7AD8CF5B0FCB81D7.title: "Kamna a hrnec"
	quest.7ADFC7A5F2888D81.quest_desc: [
		"&bMiner's Delight&r přidává jídla do jeskyní: jeskynní mrkev, netopýří křídla, chapadla a měděný hrnec."
		"Měděný hrnec (&eCopper Pot&r) je menší hrnec z mědi. Polévky z něj nabereš do měděných hrnků (&eCopper Cup&r)."
		"&aTip:&r Netopýři pouštějí křídla (&eBat Wing&r). Upeč je a máš jídlo na cesty."
	]
	quest.7ADFC7A5F2888D81.title: "Miner's Delight"
	quest.7AE19FD14432A7DA.quest_desc: [
		"Ohřívací sud (&eHeating Cask&r) postavený u soudku zvýší teplotu. Bedna s ledem (&eIce Crate&r) ji sníží."
		"Ohřívací sud vyrobíš z uhelných bloků, magmatického bloku, ohnivého prášku a dřeva. Bednu s ledem ze zhutněného ledu, provázku a dřeva."
	]
	quest.7AE19FD14432A7DA.title: "Teplo a chlad"
	quest.7B01D03AEBD5BDEA.quest_desc: [
		"Nůž ze železného dřeva (&eIronwood Knife&r) vyrobíš z ingotu železného dřeva a klacku."
		"Twilight Forest má i další nože: z ocelového listí, rytířského kovu, ohnivý a ledový."
	]
	quest.7B01D03AEBD5BDEA.title: "Nůž ze železného dřeva"
	quest.7B400666C2BE7F7A.quest_desc: [
		"Železný věžový štít (&eIron Tower Shield&r) vyrobíš z dřevěného věžového štítu a 6 železných ingotů."
		"Porovnej popisky malého a věžového štítu a vyber si, co ti víc vyhovuje."
	]
	quest.7B400666C2BE7F7A.title: "Železný věžový štít"
	quest.7B644D49D63CAF21.quest_desc: [
		"Gravitační normalizátor (&eGravity Normalizer&r) nastaví v uzavřené místnosti gravitaci od 0 do 2 G."
		"Spotřebuje hodně energie. Stav ho jen tam, kde ho opravdu potřebuješ."
	]
	quest.7B644D49D63CAF21.title: "Umělá gravitace"
	quest.7B9F08791AC49DDF.quest_desc: [
		"Teď už síť nebudeš přepínat ručně – řídí ji redstone. Senzory se vkládají do vstupů, urychlovačů a rozbočovačů, klidně na víc stran najednou."
		""
		"Redstonový detektor (&eRedstone Detector Tube Attachment&r) přepíná redstonovým signálem režim urychlovače nebo vstupu. U rozbočovače přepíná mezi oběma pevnými směry."
		""
		"Skener (&eTube Scanner Attachment&r) vyrobíš sekvenční montáží z detektoru: mosazný plát, elektronka a znovu mosazný plát. Když trubkou někdo jede, vyšle signál 8 (mládě) nebo 15 (dospělý)."
		""
		"&aSignál ze skeneru můžeš vést do detektoru u rozbočovače nebo urychlovače. Tak síť sama rozhodne, kam koho pošle.&r"
	]
	quest.7B9F08791AC49DDF.quest_subtitle: "Expert"
	quest.7B9F08791AC49DDF.title: "Chytrá síť"
	quest.7BAE5A98D0EA2865.quest_desc: [
		"&eZapouzdřený větrák&r (&eEncased Fan&r): hřídel, andezitové pouzdro a vrtule. Fouká vzduch, směr a sílu určuje rotace."
		"Když vzduch projde blokem, zpracuje předměty za ním: voda = &epraní&r, láva = &etavení&r, oheň nebo táborák = &euzení&r, duší oheň = &eprokletí&r."
		"&cJídlo přes lávu shoří,&r na jídlo použij oheň. Rychlost větráku mění jen dosah, ne rychlost zpracování. Funguje i na pás a desku."
	]
	quest.7BAE5A98D0EA2865.title: "Zapouzdřený větrák"
	quest.7BBF5DD9EC3E1FF5.quest_desc: [
		"&eRambutan&r je chlupaté ovoce z Netheru. Když ho sníš, dostaneš regeneraci."
		"Z 5 rambutanů vyrobíš rambutanovou helmu (&eRambutan Helmet&r). Když zakroutíš hlavou, vystřelí trny."
	]
	quest.7BBF5DD9EC3E1FF5.title: "Rambutanová helma"
	quest.7BD8B8B4A0ADC118.quest_desc: [
		"Drcením obsidiánu vznikne &eobsidiánová moučka&r (&ePowdered Obsidian&r). S 75% šancí se ti obsidián navíc vrátí celý."
		"Z moučky se sekvenční montáží dělá &erobustní plát&r (&eSturdy Sheet&r) na vlaky. Postup je v kapitole Vlaky."
	]
	quest.7BD8B8B4A0ADC118.title: "Obsidiánová moučka"
	quest.7BFD3898333F54FD.quest_desc: [
		"Měděné trubky (&eCopper Pipe&r) posílají věci dál. Věci do nich dostaneš násypkou nebo podavačem."
		"Věci padají nejdřív dolů, pak dopředu, pak do stran a až nakonec nahoru. Redstonový signál trubku vypne."
		"Ze 2 měděných ingotů a skla vyrobíš 6 trubek."
	]
	quest.7BFD3898333F54FD.title: "Trubky"
	quest.7C030215012DC389.quest_desc: [
		"Velký hostinec od &bExplorify&r. Stojí v lese, v květinovém lese nebo na nížině."
		"Uvnitř je hodně truhel s jídlem a věcmi z vesnice."
	]
	quest.7C030215012DC389.title: "Hostinec"
	quest.7C0FFB917DD2F3BD.quest_desc: [
		"Výměník nástrojů (&eTool Swapper Upgrade&r) ti při kopání sám vezme z batohu správný nástroj."
		"Kopeš kámen? Vezme krumpáč. Kácíš strom? Vezme sekeru."
	]
	quest.7C0FFB917DD2F3BD.title: "Správný nástroj"
	quest.7C319C3D0115308E.quest_desc: [
		"Hořák horkého vzduchu (&eHot Air Burner&r) plní balón horkým vzduchem. Postav ho pod balón."
		"Nepotřebuje palivo, stačí mu redstonový signál. Čím silnější signál, tím víc vzduchu. Nejvyšší výkon nastavíš na jeho panelu."
		"Výroba: železné pláty, uhelný blok, redstone a andezitová slitina."
		"&aJeden balón může plnit víc hořáků. Vztlak je ale omezený velikostí balónu – větší balón unese víc.&r"
	]
	quest.7C319C3D0115308E.title: "Hořák"
	quest.7C326FCD9109D543.quest_desc: [
		"Hedvábí (&eSilk&r) z &bCritters and Companions&r najdeš v hedvábných kokonech na stromech v lesích a džunglích a v bujných jeskyních. Padá i ze skákavého pavouka."
		"Z hedvábí vyrobíš vodítko, hák nebo obyčejné vlákno."
	]
	quest.7C326FCD9109D543.title: "Hedvábí"
	quest.7C3FC9FA21FF785D.quest_desc: [
		"Teď už nemusíš závěr otvírat rotací – rychlopalný se otevře kliknutím."
		""
		"Mechanismus (&eQuick-Firing Mechanism&r) změní posuvný závěr na rychlopalný. Klikni s ním na závěr."
		""
		"Rychlopalný závěr otevřeš a zavřeš kliknutím na jeho bok. Nejdřív vlož střelu, pak nálož a závěr zavři."
		""
		"Prázdné nábojnice po výstřelu vyhodí sám. &cVydrží ale jen 2 nálože, ať je z jakéhokoli kovu.&r"
		""
		"&aTip:&r Nabíjet ho umí mechanická paže (&eMechanical Arm&r). Montážním klíčem ho vrátíš na posuvný závěr."
	]
	quest.7C3FC9FA21FF785D.title: "Rychlopalný závěr"
	quest.7C491800D89759CA.quest_desc: [
		"Brzda (&eBrake&r) zastaví stroje, aniž bys rozpojoval hřídele."
		""
		"Když dostane redstonový signál, vytvoří obrovské zatížení. Síť se přetíží a zastaví."
		""
		"Vyrobíš ji z andezitového pouzdra, hřídele, redstonu a obsidiánu."
	]
	quest.7C491800D89759CA.title: "Brzda"
	quest.7C5823FBD81C89A3.quest_desc: [
		"Silnější verze pece, hoří ohněm duší. Žije v &eÚdolí duší&r."
		"Je vzácná, ale trofej z ní padá vždy."
	]
	quest.7C5823FBD81C89A3.title: "Pec duší"
	quest.7C64ED5D65176282.quest_desc: [
		"Po Lichovi se otevírají tři větve. Můžeš je dělat v libovolném pořadí."
		"První je bažina (&eTwilight Swamp&r). Dokud neporazíš Licha, trápí tě tu hlad a roje komárů."
		"Pod bažinou je labyrint s minotaury."
	]
	quest.7C64ED5D65176282.quest_subtitle: "Pokročilý"
	quest.7C64ED5D65176282.title: "Bažina"
	quest.7C8185AA502E8974.quest_desc: [
		"Dláto (&eChisel&r) z modu &bRechiseled&r mění bloky na jiné vzory: cihličky, dlaždice, sloupy a další. Díky &bRechiseled: Create&r umí i kameny, okna a růženínové dlaždice z Create."
		""
		"Vezmi dláto do ruky a stiskni pravé tlačítko. Do okna vlož bloky a klikni na vzor, který chceš. Tlačítko &eChisel all&r přetesá celý stoh najednou."
		"{@pagebreak}"
		"Úkol: vyrob si dubové okno (&eOak Window&r) z Create – je z prken a skla. Pak ho dlátem přetesej na okno s mřížkou (&eOak Window Bars&r)."
		""
		"Stejně přetesáš kameny z Create, třeba &eAsurine&r nebo &eCrimsite&r, a dlaždice z růženínu."
		""
		"&aTip: Všechny vzory ukáže JEI v záložce Chiseling. Tesat se dá i automaticky mechanickým dlátem (&eMechanical Chisel&r).&r"
	]
	quest.7C8185AA502E8974.title: "Tesání bloků Create"
	quest.7C84CDEA0D79A2B8.quest_desc: [
		"Mody &bMacaw's&r přidávají střechy, okna, dveře, ploty, mosty, světla, nábytek a sváteční dekorace ve všech druzích dřeva a kamene."
		"Okenní kladivo (&eWindow Hammer&r) mění tvar položených oken &bMacaw's Windows&r. Klikni s ním pravým tlačítkem na okno."
		"Vyrobíš ho ze železného ingotu, železného nugetu a 2 tyček."
	]
	quest.7C84CDEA0D79A2B8.title: "Okenní kladivo"
	quest.7C9560DFE8981664.quest_desc: [
		"Hrnec na fondue (&eFondue Pot&r) postav na zdroj tepla a vlož do něj sýr. Míchej ho, než se roztaví."
		"Pak do něj namoč chleba – dostaneš sýrovou tyčinku (&eCheese Stick&r)."
	]
	quest.7C9560DFE8981664.title: "Fondue"
	quest.7CA007E171EA2312.quest_desc: [
		"Vylepšení truhly (&eWood to Iron Chest Upgrade&r) změní položenou truhlu na lepší. Věci uvnitř zůstanou."
		"Klikni s ním pravým tlačítkem na truhlu. Vyrábí se z 8 železných ingotů a prkna."
		"Podobná vylepšení jsou i pro další stupně – najdeš je v JEI."
	]
	quest.7CA007E171EA2312.title: "Vylepšení bez stěhování"
	quest.7CB92EC9454F4BC7.quest_desc: [
		"Vytiž síť přesně na 100 %. Spočítej spotřebu strojů a uber nebo přidej stroj, až stresometr ukáže plné vytížení."
		"Pak zkus přidat ještě jeden stroj: síť se přetíží, všechno se zastaví a brýle ukážou „Přetížené“. Odeber ho a síť se zase rozjede."
	]
	quest.7CB92EC9454F4BC7.title: "Přesně na hraně"
	quest.7CB994E7E2AFA454.quest_desc: [
		"Základní deska je jen tělo. Mozek vlka je procesor (&eMechanical Wolf Processor&r). Vznikne, když pokladač nasadí na základní desku optický senzor (&eOptical Sensor&r)."
		""
		"Růženínovou čočku (&eRose Quartz Lens&r) vybrousíš šmirglpapírem z elektronky. Senzor pak vyrobíš sekvenční montáží: andezitové pouzdro dvakrát slisuj a nasaď na něj čočku."
		""
		"&aZákladní desku, senzor i čočku najdeš také v truhlách dílny illagerů.&r"
	]
	quest.7CB994E7E2AFA454.title: "Procesor vlka"
	quest.7CC50F3EDA01CCC0.quest_desc: [
		"Mlýnský kámen nebo drtící kola semelou pražená zrna na mletou kávu (&eCoffee Grounds&r)."
		"V míchačce s ohřevem smíchej mletou kávu s vodou. Tekutou kávu nabereš kbelíkem z tyglíku nebo nádrže."
	]
	quest.7CC50F3EDA01CCC0.title: "Káva ze stroje"
	quest.7CD52C8A11AA9CC5.quest_desc: [
		"Vypadá jako obyčejný strašák, dokud se nepohne. Objevuje se v noci na nížinách, jen za úplňku."
		"Přivolává si pomocníky. Snazší je přivolat ho &eJámou bestií&r na nížině. Trofej z něj padá vždy."
	]
	quest.7CD52C8A11AA9CC5.title: "Strašák"
	quest.7CD52D30B06DC368.quest_desc: [
		"Základní energizér je na velkou výrobu pomalý. Pokročilý energizér (&eAdvanced Energiser&r) nabíjí 4× rychleji."
		""
		"Vyrobíš ho ze základního energizéru, 2 nabitých zlatých ingotů (&eOvercharged Gold&r) a 2 hromosvodů."
		""
		"&aZesílený energizér (&eReinforced Energiser&r) s nabitými diamanty je zase 4× rychlejší než pokročilý.&r"
	]
	quest.7CD52D30B06DC368.title: "Pokročilý energizér"
	quest.7CE2041A7468CF71.quest_desc: [
		"Střípek ambrosia nad nebeským klackem dá 4 ambrosiové pochodně (&eAmbrosium Torch&r)."
		"Svítí stejně jako běžná pochodeň. Slouží i jako palivo do inkubátoru pro moa."
	]
	quest.7CE2041A7468CF71.title: "Ambrosiová pochodeň"
	quest.7CE9B90F160FDF61.quest_desc: [
		"Pravěké jeskyně jsou obří jeskyně z vápence (&eLimestone&r). Jantar na stropě je osvětluje jako ve dne, proto se tu nespawnují příšery."
		"Žijí tu dinosauři! Býložravci jsou klidní, dokud na ně nezaútočíš."
		"&cDravci jako Vallumraptor (loví ve smečkách) nebo obří Tremorsaurus útočí i na tebe.&r"
	]
	quest.7CE9B90F160FDF61.title: "Pravěké jeskyně"
	quest.7D04401B64A23881.quest_desc: [
		"Ochočené zvíře je tvoje: chodí za tebou, brání tě nebo ti pomáhá. Většinu zvířat ochočíš tak, že jim dáš správné jídlo."
		"Jaké jídlo které zvíře chce, ukáže &bJust Enough Breeding&r v JEI. Najeď na jídlo a stiskni U – uvidíš záložky &eBreeding&r (rozmnožování) a &eTaming&r (ochočení)."
		"&cPozor:&r zvířata z Fowl Play a křečky JEI neukazuje. Pro ně čti questy v této kapitole."
	]
	quest.7D04401B64A23881.quest_subtitle: "Začátečník"
	quest.7D04401B64A23881.title: "Ochoč si zvíře"
	quest.7D09691C28E05501.quest_desc: [
		"Gyroskopické vrtulové ložisko (&eGyroscopic Propeller Bearing&r) drží vrtuli svisle, i když se stroj nakloní. Proto se hodí na vrtulníky."
		"Otočené dolů pomůže udržet stabilní i stavbu, která je nahoře těžší. Redstonový signál vrátí náklon vrtule na nulu."
		"Výroba: dřevěná deska, gyroskopický mechanismus a mosazné pouzdro."
	]
	quest.7D09691C28E05501.title: "Vrtulník"
	quest.7D0E40BDD40D663B.quest_desc: [
		"Mod &bIncendium&r přidává do Netheru nové biomy a v nich vlastní stavby a nepřátele."
		"Quest se splní, až vstoupíš do jednoho z nich: popelavé pustiny, pekelné duny, křemenné pláně, zvadlý les, sopečné delty, převrácený les nebo plačící údolí."
	]
	quest.7D0E40BDD40D663B.title: "Biomy Incendia"
	quest.7D1D88A0158D4769.quest_desc: [
		"Teď už vyraz dál od domova. Tyhle biomy jsou vzácnější a nebezpečnější."
		"Yellowstone má barevnou zem, jezírka a místa, ze kterých stoupá kouř."
		""
		"&cPozor na bloky magmatu&r – pálí, když na nich stojíš. Choď se Shiftem nebo se jim vyhni."
	]
	quest.7D1D88A0158D4769.quest_subtitle: "Pokročilý"
	quest.7D1D88A0158D4769.title: "Yellowstone"
	quest.7D3370833EAF1BAD.quest_desc: [
		"Drak se léčí z krystalů na vrcholcích obsidiánových věží. Nejdřív je rozstřel lukem. Některé mohou být chráněné klecí – k nim vylez."
		"Mod &bYUNG's Better End Island&r přestavěl hlavní ostrov, takže vypadá jinak než ve vanille."
		"Když drak sedí na portálu uprostřed, bij ho mečem. &cNedívej se endermanům do očí.&r"
	]
	quest.7D3370833EAF1BAD.title: "Enderův drak"
	quest.7D38A3A6AE37D9DD.quest_desc: [
		"Drtič (&eCrusher&r) drtí kamení na štěrk, štěrk na písek a písek na jíl."
		"Výzkum &eRocking Roll&r stojí 64 kamene a potřebuje kameníka úrovně 1. Blok budovy: prkna, kamení, železný ingot a nástroj stavby."
	]
	quest.7D38A3A6AE37D9DD.title: "Drtič"
	quest.7D6B2207F21BDCE7.quest_desc: ["Hrnec a mléko na pracovním stole dají máslo (&eButter&r). Hrnec, mléko a sůl dají sýr (&eCheese&r)."]
	quest.7D6B2207F21BDCE7.title: "Máslo a sýr"
	quest.7D76E5B6D84253B5.quest_desc: [
		"Teď přijdou opravdové výzvy. V popelavých pustinách (&eAsh Barrens&r) stojí zakázaný hrad (&eForbidden Castle&r)."
		"Hrad je plný piglinů s kušemi, meči i lektvary. Vezmi si nejlepší zbroj, jídlo a lektvary léčení."
		"V truhlách jsou vzácné zbraně a artefakty."
	]
	quest.7D76E5B6D84253B5.quest_subtitle: "Pokročilý"
	quest.7D76E5B6D84253B5.title: "Zakázaný hrad"
	quest.7D8F973E98412348.quest_desc: [
		"Olovo (&eLead Ore&r) těžíš jako ostatní rudy Mekanismu. Dobře chrání před radiací."
		"Z olova je ochranný oblek, plášť jaderného reaktoru i části systému QIO."
		"&aTip:&r Zpracuj ho ve strojích na zpracování rud – dostaneš víc ingotů."
	]
	quest.7D8F973E98412348.title: "Olovo"
	quest.7D996D2DF8650E07.quest_desc: [
		"&eSpojka&r (&eClutch&r): andezitové pouzdro, hřídel a redstone. Vede rotaci rovně."
		"Když dostane redstone signál, rozpojí se a stroje za ní stojí. Je to vypínač pro celou linku."
	]
	quest.7D996D2DF8650E07.title: "Spojka"
	quest.7DA617A538D1463C.quest_desc: [
		"Teď už nemusíš do Endu pro každý endový kámen. Větrák, který fouká přes dračí hlavu nebo dračí dech, předměty „endí“."
		""
		"Z dlažebního kamene udělá endový kámen, z jablka chorusové ovoce a z kůže blánu fantoma."
		""
		"Dračí hlavu najdeš na lodi u endového města."
	]
	quest.7DA617A538D1463C.quest_subtitle: "Expert"
	quest.7DA617A538D1463C.title: "Hromadné endování"
	quest.7DB8ADE6AD52F040.quest_desc: [
		"Druhá větev je temný les (&eDark Forest&r) s hustými stromy. Dokud neporazíš Licha, oslepuje tě tma."
		"Pod lesem je rytířská pevnost (&eKnight Stronghold&r). Na povrchu nad ní je zřícenina s podstavcem."
	]
	quest.7DB8ADE6AD52F040.title: "Temný les"
	quest.7DD4633C9701A3F7.quest_desc: [
		"Levandule roste v horách, ibišek v džungli. Na čaj potřebuješ květ levandule (&eLavender Blossom&r) – ten dostaneš, když levanduli utrhneš nůžkami."
		"Levandulový čaj dává &eFeral&r (víc útoku a brnění), ibiškový &eLifeleech&r (bereš nepřátelům životy)."
	]
	quest.7DD4633C9701A3F7.title: "Květinové čaje"
	quest.7DEB64FA8836D876.quest_desc: [
		"Obří zářící můra se líhne z velkého kokonu. Kokony visí na smrkovém jehličí v tajze."
		"Rozbij kokon (bez Něžného doteku) a můra se vylíhne."
		"&aTip:&r Kokon v &eTemném hvozdu&r skrývá vzácnou bílou můru."
	]
	quest.7DEB64FA8836D876.title: "Zářící můra"
	quest.7DEF0C580DB08144.quest_desc: [
		"Naviják (&eRope Winch&r) lano navíjí a odvíjí, když ho roztočíš. Úchyt (&eRope Connector&r) je pevný konec lana. Dva navijáky spojit nejde, dva úchyty ano."
		"Tak spustíš náklad z lodi, vytáhneš auto nebo odtáhneš jiný stroj."
		"&bClimbable Ropes&r ti dovolí po lanech šplhat. S montážním klíčem v ruce po laně sjedeš dolů."
	]
	quest.7DEF0C580DB08144.title: "Naviják"
	quest.7DF39C3061EE1364.quest_desc: [
		"Kbelík vody na pracovním stole dá 8 čerstvé vody (&eFresh Water&r). Kbelík mléka dá 8 čerstvého mléka (&eFresh Milk&r)."
		"Recepty pak nespotřebují celý kbelík, ale jen jeden kus."
	]
	quest.7DF39C3061EE1364.title: "Voda a mléko do receptů"
	quest.7E09C58499854EF8.quest_desc: [
		"Kovář (&eBlacksmith's Hut&r) vyrábí nástroje, zbraně a zbroj, takže je už nemusíš kovat sám."
		"Výzkum &eHitting Iron!&r stojí kovadlinu a doly musí mít dohromady úroveň aspoň 3. Blok budovy: 3 železné ingoty, prkna a nástroj stavby."
	]
	quest.7E09C58499854EF8.title: "Kovář"
	quest.7E5DA9B492FBAC22.quest_desc: [
		"Whisky dřevěná varna neuvaří. Potřebuješ měděnou (&eCopper Brewing Station&r)."
		"Vylepšíš ji v kovářském stole: dřevěná varna + měděný ingot + kovářská šablona zdobení „Sentry“. Šablonu najdeš v truhlách na základnách nájezdníků."
	]
	quest.7E5DA9B492FBAC22.quest_subtitle: "Pokročilý"
	quest.7E5DA9B492FBAC22.title: "Měděná varna"
	quest.7E6FD53CB580706F.quest_desc: [
		"Lucerna (&eTooth Lantern&r) ze 2 zubů mlátičky a prismarínového krystalu."
		"Z 9 zubů vyrobíš i blok zubů na stavbu."
	]
	quest.7E6FD53CB580706F.title: "Zubová lucerna"
	quest.7E728C7FA23D8467.quest_desc: [
		"Velký temný dům v biomu &eTemný hvozd&r. Je plný kostlivců a líhní."
		"Za odvahu tě čekají truhly s poklady a nářadím."
	]
	quest.7E728C7FA23D8467.title: "Strašidelné sídlo"
	quest.7E77349139382340.quest_desc: [
		"Toulec (&eQuiver&r) unese hodně šípů na jednom místě. Klávesou &eV&r vybíráš, který druh šípu z toulce se bude střílet."
		"Nedá se vyrobit. Najdeš ho jen v truhlách, třeba v dungeonech, v lesních sídlech nebo v základnách pillagerů."
		"Můžeš ho nosit i ve slotu na doplňky. Ten otevřeš tlačítkem u postavičky v inventáři."
	]
	quest.7E77349139382340.title: "Toulec"
	quest.7E79CA5804E095EE.quest_desc: [
		"Vařečka (&eWooden Spoon&r) z prken a klacků a metla (&eWhisk&r) ze železných nugetů a klacku jsou nářadí k míchací míse."
		"Pravým tlačítkem otevřeš mísu. Suroviny dej do políček, kbelík s tekutinou (mléko, voda) do políčka pro tekutinu."
		"Pak na mísu opakovaně klikej vařečkou nebo metlou, dokud se vše nepromíchá. Vejce rozbiješ kliknutím vejcem na mísu."
	]
	quest.7E79CA5804E095EE.title: "Vařečka a metla"
	quest.7E8A99ED9715E90C.quest_desc: [
		"Postav všech pět pastevců: kurník, kravín, vepřín, ovčín a k tomu králíkárnu (&eRabbit Hutch&r)."
		"Králíkárna se vyrábí z prken, syrového králíka a nástroje stavby."
	]
	quest.7E8A99ED9715E90C.title: "Celá farma zvířat"
	quest.7E9A1228539E8975.quest_desc: [
		"Uran (&eUranium&r) získáš z uranové rudy (&eRadrock Uranium Ore&r), která je v radrocku."
		"Uran je palivo a surovina pro všechny jaderné věci tohoto biomu."
	]
	quest.7E9A1228539E8975.title: "Uran"
	quest.7EA1E022DCE68CC8.quest_desc: [
		"Velký podzemní dungeon plný kostlivců a líhní (&eFortress of the Undead&r). Je tmavý a má hodně chodeb."
		"Teď už nestačí jen proběhnout – potřebuješ železnou zbroj, štít a hodně pochodní."
		""
		"&aTip:&r Každou líheň hned zakryj pochodněmi nebo ji vykopej. Pak se vrať pro truhly."
	]
	quest.7EA1E022DCE68CC8.quest_subtitle: "Pokročilý"
	quest.7EA1E022DCE68CC8.title: "Pevnost nemrtvých"
	quest.7ECB1A63C1D73CBC.quest_desc: [
		"Upgrade s pracovním stolem (&eCrafting Upgrade&r) přidá do batohu záložku s mřížkou 3 × 3."
		"Vyrábíš pak kdekoliv, přímo z věcí v batohu."
	]
	quest.7ECB1A63C1D73CBC.title: "Stůl v batohu"
	quest.7ED393A0A664D098.quest_desc: [
		"Asfalt (&eAsphalt Block&r) je blok na silnice. Chodí se po něm o čtvrtinu rychleji."
		""
		"V tyglíku pod míchačkou s ohřevem smíchej 2 štěrky, 2 písky a 100 mB ropy. Vzniknou 4 bloky asfaltu."
		""
		"Jde to i ručně: 4 písky, 4 štěrky a kbelík ropy dají na pracovním stole 8 bloků."
		""
		"&aTip: Na řezačce kamene z asfaltu uděláš schody a desky.&r"
	]
	quest.7ED393A0A664D098.title: "Asfaltová silnice"
	quest.7ED4D83D24D020B5.quest_desc: [
		"Navštiv &eHoubové pláně&r (&eFungal Plains&r). Žije tu kult piglinů a houbové bytosti."
		"Z vůdce kultu může padnout jejich prapor (&eCultist Flag&r)."
	]
	quest.7ED4D83D24D020B5.title: "Houbové pláně"
	quest.7EF2794D7DA3B5CE.quest_desc: [
		"Spřáhlo (&eTrain Coupler&r) ze &bSteam 'n' Rails&r spojí nebo rozpojí vagony bez rozebírání vlaku."
		"Pokládá se jako stanice. Má dvě značky na koleji a na každé musí stát podvozek. Mezeru mezi značkami měníš kolečkem myši s montážním klíčem."
		"Montážním klíčem přepínáš režim: spojování, rozpojování nebo obojí. Akci spustí redstonový signál."
		"&aTak postavíš nákladní nádraží, kde lokomotiva nechá vagony a odjede pro další.&r"
	]
	quest.7EF2794D7DA3B5CE.title: "Spřáhlo"
	quest.7EF6C1C06B44339E.quest_desc: [
		"Starodávný klíč (&eAncient Key&r) padá jen z poraženého Anu."
		"Otevře starodávnou truhlu (&eAncient Chest&r) v klenotnici."
	]
	quest.7EF6C1C06B44339E.title: "Starodávný klíč"
	quest.7EFA5FC12A0C877F.quest_desc: [
		"Obohacovací komora (&eEnrichment Chamber&r) je první stupeň zpracování rud. Z bloku rudy udělá 2 prachy, ze 3 kusů vytěžené rudy 4 prachy."
		"Prach přetav v peci na ingot. Získáš tak víc kovu než přímým tavením."
		"&aTip:&r Krumpáč se Štěstím dá víc kusů vytěžené rudy, krumpáč s Něžným dotekem celé bloky rudy. Stroje zpracují obojí."
	]
	quest.7EFA5FC12A0C877F.title: "2× rudy: obohacovací komora"
	quest.7F0150EDB232A99A.quest_desc: [
		"Parní výduch (&eSteam Vent&r) plní balón párou místo horkého vzduchu."
		"Potřebuje to samé co parní motor: kotel z nádrží, vodu a teplo. Výkon nastavíš panelem a redstonem. Víc výduchů potřebuje dost silný kotel."
		"Výroba: zlatý plát na měděném bloku."
	]
	quest.7F0150EDB232A99A.title: "Parní výduch"
	quest.7F1DF407C45C512F.quest_desc: [
		"Propoj měřidla do receptu: měřidlo výrobku a měřidla surovin. V okně měřidla zadej adresu stroje, který výrobek dělá."
		"Když výrobku ubude, síť tam pošle suroviny. Hotové výrobky musí jet zpátky do připojeného skladu. Zelené spojení = cíl je splněný."
		"Na recepty z pracovního stolu stačí 3×3 mechanické výrobníky spojené klíčem. Měřidlo do nich balíčky rovnou rozbalí."
	]
	quest.7F1DF407C45C512F.title: "Továrna na objednávku"
	quest.7F218C900B720D34.quest_desc: [
		"Návěstidlo (&eTrain Signal&r) rozdělí trať na úseky. V jednom úseku smí být jen jeden vlak, takže se vlaky nesrazí."
		"Výroba: vlakové pouzdro a elektronka dají 4 návěstidla. Pokládá se jako stanice: klikni na kolej a polož ho vedle ní."
		"&cNávěstidla řídí jen vlaky s jízdním řádem. Když řídíš sám, musíš dávat pozor.&r"
		"Redstonem návěstidlo přepneš na červenou. Červené návěstidlo naopak dává signál pro komparátor."
		"{@pagebreak}"
		"&eDvoukolejka:&r vlak s jízdním řádem nikdy neprojede návěstidlo z opačné strany. Výjimka je, když tam stojí druhé návěstidlo otočené opačně."
		"Na dvou souběžných kolejích proto dej návěstidla na každé koleji jen jedním směrem. Každá kolej bude jednosměrná a vlaky se nepotkají čelně."
		"&eKřižovatky:&r montážním klíčem přepneš návěstidlo do druhého režimu. Pak pustí vlak dál, jen když může další úsek hned zase opustit. Dej ho před křižovatku, ať se v ní vlaky nezaseknou."
	]
	quest.7F218C900B720D34.title: "Návěstidla"
	quest.7F44078A5ECCB447.quest_desc: [
		"&bChipped&r: pracovní stoly, které z jednoho bloku udělají desítky jiných vzhledů. Funguje to jako řezačka kamene."
		"Do stolu vlož blok a vyber si nový vzhled. Každý stůl umí jiné bloky:"
		"Botanický (&eBotanist Workbench&r): hlína, listí, led, houby, dýně. Kamenický (&eMason Table&r): kámen, cihly, terakota, beton. Truhlářský (&eCarpenters Table&r): prkna, kmeny, dveře, poklopy."
		"Všechny se vyrábí z pracovního stolu a surovin, které ke stolu patří (květináče, cihly, železná sekera…)."
	]
	quest.7F44078A5ECCB447.quest_subtitle: "Začátečník"
	quest.7F44078A5ECCB447.title: "Stoly Chipped"
	quest.7F51B2904EBC7F67.quest_desc: [
		"Když v královském hradu otevřeš truhlu, objeví se král vyvolávačů (&eEvoker King&r)."
		""
		"&cMá mnohem víc životů než obyčejný vyvolávač a drží totem nesmrtelnosti, takže ho porazíš až napodruhé. Šípy blízko něj zmizí a místo čelistí na tebe posílá drtící kola.&r"
		""
		"&aZ krále padá Roh nenávisti (&eHorn of Hatred&a), který ti dá efekt Zlé znamení (&eBad Omen&a). Někdy upustí i brýle s Ochranou V.&r"
	]
	quest.7F51B2904EBC7F67.quest_subtitle: "Expert"
	quest.7F51B2904EBC7F67.title: "Král vyvolávačů"
	quest.7F55DB06AD1EA208.quest_desc: [
		"Elektrická pumpa (&eElectric Pump&r) žene kapaliny potrubím jako mechanické čerpadlo. Nepotřebuje ale otáčení – stačí jí elektřina z konektoru."
		""
		"Vyrobíš ji v mechanickém výrobníku z mechanického čerpadla, kondenzátoru, měděných cívek a sušené chaluhy."
		""
		"&aŠipka ukazuje, kterým směrem teče kapalina. Montážním klíčem směr otočíš.&r"
	]
	quest.7F55DB06AD1EA208.title: "Elektrická pumpa"
	quest.7F587B04E8DE96F8.quest_desc: [
		"Pírko kukačky (&eRoadrunner Feather&r) padá z kukačky (&eRoadrunner&r). Ta běhá v poušti a v pustině."
		"Je rychlá, takže ji musíš dohnat nebo zaskočit."
	]
	quest.7F587B04E8DE96F8.title: "Pírko kukačky"
	quest.7F62B7EAE5617B32.quest_desc: [
		"Ochranný oblek (&eHazmat Mask&r, &eHazmat Chestplate&r, &eHazmat Leggings&r, &eHazmat Boots&r) snižuje poškození a účinky ozáření i kyseliny."
		"Celý oblek potřebuje 24 polymerových desek."
		"&aKusy obleku občas najdeš i v truhlách toxických ruin.&r"
	]
	quest.7F62B7EAE5617B32.title: "Ochranný oblek"
	quest.7F7C5E35EA750870.quest_desc: [
		"Graffiti (&eGraffiti&r) je obrázek bez pozadí. Hodí se na obrázky s průhledností."
		"Vyrobíš ho z barviv, střelného prachu a kbelíku (dostaneš 8 kusů)."
		"Se světélkujícím inkoustem uděláš svítící obraz (&eGlowing Painting&r) nebo svítící graffiti."
	]
	quest.7F7C5E35EA750870.title: "Graffiti"
	quest.7F9C66554004643F.quest_desc: [
		"Brnění snižuje zranění. Úkol: vyrob si kus železného brnění. Pak si ho obleč."
		"Celá sada (helma, kyrys, kalhoty a boty) stojí 24 železných ingotů."
		"Lepší výbavu najdeš v kapitole &eVýbava a boj&r."
	]
	quest.7F9C66554004643F.title: "Brnění"
	quest.7F9C758CAEC34961.quest_desc: [
		"Procesory se vyrábějí ve dvou krocích. 1) Surový procesor: pojivo (&eProcessor Binding&r) + kov + křemík + redstone. 2) Surový procesor upeč v peci."
		"Základní (&eBasic Processor&r) je ze železa, vylepšený (&eImproved Processor&r) ze zlata a pokročilý (&eAdvanced Processor&r) z diamantu."
		"&aTip:&r Pojivo vyrobíš z vlákna a slizu – z jednoho receptu je ho 8 kusů."
	]
	quest.7F9C758CAEC34961.title: "Procesory"
	quest.7FBC76C000607A4D.quest_desc: [
		"Slon (&eElephant&r) žije ve stádech na savaně. Ochočíš ho akáciovým květem."
		"Ochočit jde jen sloní mládě nebo slon bez klů. Na slonovi můžeš jezdit a s truhlou ti nese věci."
	]
	quest.7FBC76C000607A4D.title: "Sloní jízda"
	quest.7FE10A1B17B47871.quest_desc: [
		"Mod &bEnderman Overhaul&r dal každému biomu vlastní druh endermana. Endermani v Endu mohou upustit zub (&eEnderman Tooth&r)."
		"Ze 2 zubů a klacku vyrobíš zkažený meč (&eCorrupted Blade&r). Zasažené nepřátele náhodně teleportuje."
	]
	quest.7FE10A1B17B47871.title: "Zub endermana"
	quest.7FF60CA28E5EEEAD.quest_desc: [
		"Plnič kyslíku (&eOxygen Loader&r) mění vodu na kyslík. Potřebuje energii."
		"Vodu dej do levé nádrže. Kyslík pak nabereš do skafandru, kbelíku nebo plynové nádrže (&eGas Tank&r)."
		"&aNáhradní plynovou nádrž s kyslíkem si vezmi s sebou. Když ji držíš a podržíš pravé tlačítko, doplní kyslík do skafandru.&r"
	]
	quest.7FF60CA28E5EEEAD.title: "Plnič kyslíku"
}
