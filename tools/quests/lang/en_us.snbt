	]
	quest.1C6FF91D4AC58B74.title: "Steam Engine"
	quest.1D7A5D198B0058FC.quest_desc: ["Put it in front of a villager and it trades automatically."]
	quest.1D7A5D198B0058FC.title: "Trading Floor"
	quest.1DF14DEAF5C79808.quest_desc: [
		"&bCreate Aeronautics&r turns Create contraptions into real physical objects that fly, float and drive."
		"You should know the Create basics first (shafts, bearings, glue)."
		"The server allows flight, so don't worry about being kicked while riding a ship."
	]
	quest.1DF14DEAF5C79808.quest_subtitle: "Create Aeronautics + Simulated"
