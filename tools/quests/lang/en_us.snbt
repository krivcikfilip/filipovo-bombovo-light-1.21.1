	quest.B9B357B4E049960F.quest_desc: ["Fill it with water through pipes to water crops - faster growth."]
	quest.B9B357B4E049960F.title: "Sprinkler"
	quest.BA0F97042370EA0C.quest_desc: [
		"&eRotation&r is Create's power. Shafts carry it in a straight line, cogwheels carry it sideways."
		"Small cog to large cog changes the speed - faster or slower."
	]
	quest.BA0F97042370EA0C.title: "Shafts & Cogs"
	quest.BA4D264B38434C38.title: "Tier 4 Rocket"
	quest.BC6B28CEBE6B307D.quest_desc: ["Desh ore is found on the Moon."]
	quest.BC6B28CEBE6B307D.title: "The Moon"
	quest.BCE14D97441773CB.quest_desc: ["&bAdvanced Netherite&r lets you upgrade netherite further with iron, gold, emerald and diamond."]
	quest.BCE14D97441773CB.title: "Netherite"
	quest.BCEE744AA57E29F5.quest_desc: ["&bNether Exotics&r adds armour and tools made from Nether fruit."]
	quest.BCEE744AA57E29F5.title: "Kiwano armour"
	quest.BD39D58490ECDCDF.title: "Crusher"
	quest.BD51399C97F3C37F.title: "Tier 2 Rocket"
	quest.BD8A84366753A8E9.quest_desc: ["Nixie displays, flanged cogwheels, chain pulleys, lamps and industrial decoration."]
	quest.BD8A84366753A8E9.title: "Bits 'n' Bobs"
	quest.BF452D140A574530.quest_desc: ["Machines that break blocks or cut trees. Put them on a contraption to make them move."]
	quest.BF452D140A574530.title: "Drill & Saw"
	quest.BFD1E196C8480A68.quest_desc: ["Your first power source. Place it in flowing water - more water on the blades means more power."]
	quest.BFD1E196C8480A68.title: "Water Wheel"
	quest.C0B73277F0D1A7FC.title: "Altar & Freezer"
	quest.C0ECA47E46E32C70.quest_desc: ["Ferment drinks and age cheese in a keg."]
	quest.C0ECA47E46E32C70.title: "Brewin' and Chewin'"
