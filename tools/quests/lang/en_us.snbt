	quest.C15BA16357CD55B4.title: "Wild crops"
	quest.C17A0B58BAD06B21.quest_desc: ["Mixing bowl, oven, mortar and many more kitchen machines."]
	quest.C17A0B58BAD06B21.title: "ExtraDelight"
	quest.C1B89DC3CE373DEA.quest_desc: ["Presses ingots into &esheets&r. Put a depot or belt under it."]
	quest.C1B89DC3CE373DEA.title: "Mechanical Press"
	quest.C22F25920638EE28.quest_desc: ["Powered by redstone, it pushes or pulls metal blocks - a new kind of redstone contraption."]
	quest.C22F25920638EE28.title: "Magnet"
	quest.C2313C7F139CF77B.title: "Engine & propeller"
	quest.C328CD94686BFEBA.quest_desc: ["Fills items on a belt or depot: water bottles, honey bottles and lots of food recipes."]
	quest.C328CD94686BFEBA.title: "Spout"
	quest.C4C1BBBCE0E6C548.quest_desc: ["Made from cold aerclouds. Saves you from a long fall."]
	quest.C4C1BBBCE0E6C548.title: "Parachute"
	quest.C54174B9AF268664.title: "My Nether's Delight"
	quest.C63007E46BAE9555.quest_desc: ["&bCreate Stuff & Additions&r: jetpacks, exoskeletons, drones, flamethrowers and metal tools."]
	quest.C63007E46BAE9555.title: "Brass jetpack"
	quest.C6485DCF7D8233E3.quest_desc: ["Scary bats and the darkest place in the game."]
	quest.C6485DCF7D8233E3.title: "Forlorn Hollows"
	quest.C65B3BBDB3340722.quest_desc: ["&bNaturalist&r: deer, bears, snails, butterflies, lions and more. The net catches small animals."]
	quest.C65B3BBDB3340722.title: "Catch a critter"
	quest.C6DEA49E467B6702.quest_desc: ["Stores hooks, bait and fishing line. Hooks change how the rod behaves."]
	quest.C6DEA49E467B6702.title: "Tackle box"
	quest.C7E126AFA6E34334.title: "Logistical Transporter"
	quest.C7E272DB2DB104B0.quest_desc: ["Moves items between inputs and outputs. Right-click blocks with the arm in hand before placing to set targets."]
	quest.C7E272DB2DB104B0.title: "Mechanical Arm"
	quest.C802CD65474C31EB.quest_desc: ["Copies written books, enchanted books and name tags."]
	quest.C802CD65474C31EB.title: "Printer"
	quest.C82DBDD335577C37.title: "Mincer & Roaster"
	quest.C8BBC37B15115268.title: "Cheese wheel"
	quest.C9103EBCD927E6CE.title: "Ship cannons"
	quest.C91802A4420DB4B8.title: "Create Winery"
	quest.C9421439F3BC2FC4.title: "Aviator's Goggles"
	quest.C965FE56BDA54CAC.quest_desc: ["Cook dragon, shulker and chorus food in the End."]
	quest.C965FE56BDA54CAC.title: "End's Delight"
	quest.C9B18C523BD3A2C0.quest_desc: ["&bCreate Stuff & Additions&r adds copper, zinc and brass tools and armour."]
	quest.C9B18C523BD3A2C0.title: "Brass armour"
	quest.CB97BC3580748EFF.quest_desc: ["Ambrosium powers the altar, freezer and incubator."]
	quest.CB97BC3580748EFF.title: "Ambrosium"
	quest.CD11985D5BC55021.quest_desc: ["Drops items straight down - a cheap hopper alternative."]
	quest.CD11985D5BC55021.title: "Chute"
	quest.CDCF55F11F67BEFF.quest_desc: ["Tea and coffee from a kettle - drinks with nice buffs."]
	quest.CDCF55F11F67BEFF.title: "Farmer's Respite"
	quest.CDD50C3B0147A801.title: "Wither skull"
	quest.CE4F50D2CA031B06.quest_desc: ["Dinosaurs eat from a feeder (plants on one side, meat on the other)."]
	quest.CE4F50D2CA031B06.title: "Feeder"
	quest.CEF2F282B8BACADA.title: "Stonemason"
	quest.CFC538FD8A71F351.title: "Eyes of Ender"
	quest.D021195E9AB3352E.quest_desc: ["Deep under the ocean, total darkness. A submarine is the best way to explore it."]
	quest.D021195E9AB3352E.title: "Abyssal Chasm"
	quest.D0425844F94F6E18.quest_desc: ["MrCrayfish's furniture - working fridges, stoves, TVs, mailboxes and more. Everything is crafted in the workbench."]
	quest.D0425844F94F6E18.title: "Furniture: Refurbished"
	quest.D07C57FB4FC23E2B.quest_desc: ["This pack has a huge amount of decoration. Here are the main tools to find it all."]
	quest.D07C57FB4FC23E2B.title: "Builder's paradise"
	quest.D18FB39A7930462C.title: "Ocean monument"
	quest.D19DC7EB567A6482.quest_desc: [
		"A bearing or piston moves a whole structure. Glue blocks together with super glue."
		"Windmills are a bearing + sails - great free power."
	]
	quest.D19DC7EB567A6482.title: "Contraptions"
	quest.D1D3672B33165EAB.title: "Sawmill"
	quest.D25E98A131F9C8DD.quest_desc: ["Extra kinetic parts: clutches, gearboxes, brakes, a kinetic battery that stores rotation and fan catalysts for new bulk-processing types."]
	quest.D25E98A131F9C8DD.title: "Create: Connected"
	quest.D4149DF58C0CF8B8.quest_desc: [
		"Waystones spawn in villages and you can craft your own."
		"Right-click one to activate it, then teleport between all activated waystones for a bit of XP."
		"A &ewarp stone&r or &ereturn scroll&r lets you travel without standing at a waystone."
	]
	quest.D4149DF58C0CF8B8.title: "Waystones"
	quest.D48EA9BC7C820D63.quest_desc: ["Found in dungeon loot. Combine it at an anvil with a maxed-out enchanted book to go one level above the normal maximum."]
	quest.D48EA9BC7C820D63.title: "Ancient Tome"
	quest.D4AB96FF89E0902E.quest_desc: ["New Nether mobs and materials. Cruorite makes modular weapons - see Gear & Combat."]
	quest.D4AB96FF89E0902E.title: "Just-In Nether"
	quest.D4BF44687F30D3C9.quest_desc: ["Another big beast - its trophy proves you beat it."]
	quest.D4BF44687F30D3C9.title: "Hermit King"
	quest.D4D390AF6F950D40.title: "Gold-infused netherite"
	quest.D5A662AB1364AF69.quest_desc: [
		"DNA + bio goo in the culture vat grows an egg (dinosaurs) or an embryo (mammals, injected into an animal with a syringe). Watch out - sometimes it fails and something nasty comes out."
		"Place eggs somewhere warm and wait for them to hatch. Babies imprint on the first player they see."
	]
	quest.D5A662AB1364AF69.title: "Culture Vat"
	quest.D5C53E418A4CE4F3.quest_desc: ["A schedule tells the train where to go and how long to wait. Give it to a mob seated at the controls and the train drives by itself."]
	quest.D5C53E418A4CE4F3.title: "Timetable"
	quest.D61E6B7F8FEF77EB.quest_desc: ["Mines ores in a large radius without digging tunnels. Set filters for what to mine."]
	quest.D61E6B7F8FEF77EB.title: "Digital Miner"
	quest.D6CB72AB7F148E92.quest_desc: ["Inside the goblin stronghold."]
	quest.D6CB72AB7F148E92.title: "Knight Phantoms"
	quest.D7D26374CE323468.quest_desc: ["Shows the way to a specific biome."]
	quest.D7D26374CE323468.title: "Pathfinder's Quill"
	quest.D92419D304B54525.title: "Cargo Airship"
	quest.D9244C08FE6AAB33.quest_desc: ["A much stronger TNT. Use it far away from your base."]
	quest.D9244C08FE6AAB33.title: "Obsidian TNT"
	quest.DACFF749530A9E0E.quest_desc: ["&bJust-In Nether&r materials make modular weapons: swords, katanas, spears, hammers, bows and more."]
	quest.DACFF749530A9E0E.title: "Cruorite"
	quest.DAD2ACD78CF935A7.quest_desc: ["Build a mechanical wolf that follows you and can be upgraded with modules (radar, crossbow, light...)."]
	quest.DAD2ACD78CF935A7.title: "Mechanical companion"
	quest.DB351B1845BC8BA7.title: "Tier 1 Rocket"
	quest.DCD64687DC1F0763.quest_desc: ["&bCreate Ore Excavation&r: find ore veins deep below and mine them forever with a drilling machine."]
	quest.DCD64687DC1F0763.title: "Endless ore"
	quest.DD4A432770504ED0.quest_desc: ["&bStorage Drawers&r hold lots of one item and show it on the front. The compacting drawer also converts nuggets / ingots / blocks automatically."]
	quest.DD4A432770504ED0.title: "Compacting Drawer"
	quest.DE77FAA5F69EDCBD.quest_desc: ["Show building outlines and the work orders of builders."]
	quest.DE77FAA5F69EDCBD.title: "Build Goggles"
	quest.DE88D30D06B5DD0E.title: "Drawer Controller"
	quest.DF41818EF64B1854.quest_desc: ["A beast of the cold lands."]
	quest.DF41818EF64B1854.title: "Yeti"
	quest.DF71DBB1A5D94585.quest_desc: ["A &esequenced assembly&r: press, deploy and deploy again on a belt. JEI shows the steps."]
	quest.DF71DBB1A5D94585.title: "Precision Mechanism"
	quest.DF756CC64F7473BF.title: "Hospital"
	quest.DFC1BE1A7605F82F.title: "Rustic Delight"
	quest.E00C5C3E85823812.quest_desc: ["A lunchbox automatically feeds you the food you haven't eaten recently."]
	quest.E00C5C3E85823812.title: "Packed lunch"
	quest.E0230DA63B6145CE.title: "Bastion"
	quest.E0EAE74AD522424D.quest_desc: [
		"&bSpice of Life&r rewards variety: every new food you eat increases your maximum health."
		"The food book shows what you have already eaten. Lunchboxes let you carry many different meals."
		"The pack has hundreds of foods - see the Food & Farming chapters."
	]
	quest.E0EAE74AD522424D.title: "Eat a varied diet"
	quest.E26187BA2A63CB7B.title: "A real cake"
	quest.E27198E9961E854B.title: "Taco night"
	quest.E2F7B17F7FAC5054.quest_desc: [
		"Your items stay in a &ecorpse&r where you died - nothing despawns. Walk back and open it."
		"&e/back&r takes you back to where you died, &e/sethome&r and &e/home&r save your favourite places."
	]
	quest.E2F7B17F7FAC5054.title: "If you die"
	quest.E32313DD4D38B62C.quest_desc: ["A rare metal from treasure - makes great tools."]
	quest.E32313DD4D38B62C.title: "Neptunium"
	quest.E4698EEED5C07C34.quest_desc: ["Right-click a creature to see its age, hunger and mood."]
	quest.E4698EEED5C07C34.title: "Dinopedia"
	quest.E54F81C691BA4045.title: "Warship"
	quest.E5C9DB5800A3BED8.title: "Coffee"
	quest.E631E7593AB46BA5.title: "Forester"
	quest.E65194F22DE46F15.title: "Knightmetal"
	quest.E66DAAD1D99676AA.quest_desc: ["&bMekanism Additions&r: walkie-talkies, balloons, coloured plastic blocks and obsidian TNT."]
	quest.E66DAAD1D99676AA.title: "Walkie-talkie"
	quest.E77709DB54F26BCA.quest_desc: ["Flour (millstone) + water in a mixer."]
	quest.E77709DB54F26BCA.title: "Dough"
	quest.E7CF1D6C34601F93.quest_desc: ["Each tier is stronger than the last and adds its own bonus. JEI shows how to upgrade tools and armour."]
	quest.E7CF1D6C34601F93.title: "Iron-infused netherite"
	quest.EA41D4E12AE7321F.quest_desc: ["Feasts are placed as a block and served with bowls - one meal for the whole team."]
	quest.EA41D4E12AE7321F.title: "A feast"
	quest.EAA2742E6DA0E59E.quest_desc: ["Docking connectors join two contraptions together or to the ground."]
	quest.EAA2742E6DA0E59E.title: "Docking"
	quest.EB4CCAC6770F1404.quest_desc: ["The controls make the train drivable. Assemble the train in the station screen."]
	quest.EB4CCAC6770F1404.title: "Train controls"
	quest.EBCF555370BC9CDE.quest_desc: ["Palm trees, coconuts and cocktails. Find palm beaches."]
	quest.EBCF555370BC9CDE.title: "Beachparty"
	quest.EC6506A05B72E622.quest_desc: [
		"This quest book is a &etutorial&r for the mods in this pack."
		"Every chapter walks you through one mod (or a group of similar mods) from the first step to the cool stuff."
		""
		"Item quests complete as soon as the item is in your inventory - nothing gets taken. If you already made something, just open the book and claim it."
		"Rewards are small on purpose: the pack is already being played, so they are a thank-you, not a shortcut."
	]
	quest.EC6506A05B72E622.title: "Welcome!"
	quest.ECAD7393A0ABE08F.quest_desc: [
		"&bMineColonies&r: you are the mayor, your citizens do the work."
		"Start with a &esupply camp&r (on land) or a &esupply ship&r (on water). Right-click to preview, rotate it and confirm."
		"It gives you a chest with starting supplies, including the town hall."
	]
	quest.ECAD7393A0ABE08F.title: "Supply Camp"
	quest.ED1CDC40980D9EA3.title: "Venison"
	quest.ED668EB648F9F994.quest_desc: ["Just like in the movies."]
	quest.ED668EB648F9F994.title: "Mosquito in amber"
	quest.EDFCD844C6EFF560.title: "Station platform"
	quest.EEC575EC5405BBA1.title: "Steeleaf & Ironwood"
	quest.EF9E5FEF03BB4570.quest_desc: ["Sometimes the rod pulls up a lockbox or treasure chest."]
	quest.EF9E5FEF03BB4570.title: "Treasure"
	quest.F15D76E51DFBFDE6.quest_desc: ["&bSteam 'n' Rails&r adds conductors - little helpers for your trains - and the conductor whistle to command them."]
	quest.F15D76E51DFBFDE6.title: "Train crew"
	quest.F15EED262FA26428.quest_desc: ["The more different foods you eat, the more hearts you get. Automate a menu!"]
	quest.F15EED262FA26428.title: "Food variety"
	quest.F23048BF1737D4ED.quest_desc: ["A robotic hand. It can use, place and click - needed for many sequenced recipes."]
	quest.F23048BF1737D4ED.title: "Deployer"
	quest.F2FE716A87035676.title: "Hot chocolate"
	quest.F366DE742C5F25A0.title: "Cocktail"
	quest.F37BE59B311EAF17.quest_desc: [
		"A block that floats. Enough levitite and your ship lifts off without any engine."
		"Pearlescent levitite is even stronger."
	]
	quest.F37BE59B311EAF17.title: "Levitite"
	quest.F37EE8DE14563959.title: "Devourite"
	quest.F52F057EBF13CB4B.quest_desc: ["A classic semaphore arm that shows a signal's state."]
	quest.F52F057EBF13CB4B.title: "Semaphore"
	quest.F615ABDBEAE46F0B.title: "Cheers!"
	quest.F6F9ACD74D91A641.quest_desc: ["Wild rice grows in shallow water in swamps and jungles. Plant it in water."]
	quest.F6F9ACD74D91A641.title: "Rice"
	quest.F6FC0D7AD98086BF.quest_desc: ["Deep below in the deep dark. Be quiet - the Warden hears everything."]
	quest.F6FC0D7AD98086BF.title: "Ancient City"
	quest.F7255D3C2EA07E44.quest_desc: [
		"Engineer's goggles show speed and &estress&r. Every machine uses stress units (SU); sources provide capacity."
		"If a network is overstressed, everything stops."
	]
	quest.F7255D3C2EA07E44.title: "See the stress"
	quest.F7390EEB15023315.quest_desc: ["An oxygen distributor fills a sealed room with air."]
	quest.F7390EEB15023315.title: "Moon base"
	quest.F76438D2CFD81BB2.title: "Iron Sheets"
	quest.F7E8B646A0048E38.title: "Bear fur"
	quest.F88327B17F0A09FF.title: "Diamond shield"
	quest.F9D88CC55EDDBEA8.quest_desc: [
		"&bSmall Ships&r - real sailing ships (cog, brigg, galley, drakkar and more) in every wood type."
		"Wind direction and the sail matter; galleys and drakkars can also be rowed."
		"Every ship needs sails - start here."
	]
	quest.F9D88CC55EDDBEA8.title: "Sail away"
	quest.F9F4290B8B690C82.quest_desc: ["Repairs ancient tools and restores broken swords."]
	quest.F9F4290B8B690C82.title: "Worktable"
